@page
@model CaseMovesModel
@{
    ViewData["Title"] = "Case Moves Audit Log Report";
}

<div>
    @await Html.PartialAsync("_AuditReportHeading", new BSE.Host.Models.ViewModels.AuditReportHeading("Case Moves Audit Log Report", "Case moves"))

    @{ var dateRange = new BSE.Host.Models.ViewModels.AuditDateRangeViewModel(Model.StartDate, Model.EndDate, Model.StartDateError, Model.EndDateError); }
    @await Html.PartialAsync("_AuditDateErrors", dateRange)
    <partial name="_AuditDateRangeForm" model="dateRange" />

    @if (Model.Entries.Any())
    {
        @await Html.PartialAsync("_AuditResults", new BSE.Host.Models.ViewModels.AuditResultsViewModel(
            Model.PagedEntries(), Model.SortColumn, Model.SortDesc, Model.PageNumber, Model.TotalPages,
            "Case move audit log entries", "case-moves-results",
            [BSE.Host.Models.ViewModels.AuditExtraColumn.Of<BSE.Modules.AuditLog.Models.AuditLogCaseMoveEntry>("Recorded in batch?", "HasBatches", e => e.HasBatches,
                labelHtml: "Recorded<br />in batch?", headerClass: "bse-batch-header", cellClass: "bse-batch-flag-column")]))
    }
    else if (Model.HasSearched)
    {
        @await Html.PartialAsync("_AuditNoResults", new BSE.Host.Models.ViewModels.AuditNoResults("case-moves-info-title", "No case moves found in this period."))
    }
</div>
