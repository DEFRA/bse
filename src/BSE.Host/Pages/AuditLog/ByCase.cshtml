@page
@model ByCaseModel
@{
    ViewData["Title"] = "Audit log by case";
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        @if (!string.IsNullOrWhiteSpace(Model.Rbse))
        {
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Case/Details" asp-route-rbse="@Model.Rbse">@BseFormat.FormatRbse(Model.Rbse)</a></li>
        }
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Audit log by case</li>
    </ol>
</nav>

<h1 class="govuk-heading-l">Audit log by case</h1>

<form method="get" novalidate class="govuk-!-margin-bottom-6">
    <div class="govuk-form-group">
        <label asp-for="Rbse" class="govuk-label">RBSE number</label>
        <div id="rbse-hint" class="govuk-hint">RBSE Format: NN/NN/NNNNN</div>
        <input asp-for="Rbse" type="text" class="govuk-input govuk-input--width-20" aria-describedby="rbse-hint" spellcheck="false" autocomplete="off" />
    </div>
    <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
        <a asp-page="/AuditLog/ByCase" class="govuk-link">Clear search</a>
    </div>
</form>

@if (Model.HasSearched)
{
    if (Model.TotalCount == 0)
    {
        <p class="govuk-body">No audit log entries found for <strong>@BseFormat.FormatRbse(Model.Rbse)</strong>.</p>
    }
    else
    {
        <div class="govuk-button-group govuk-!-margin-bottom-4">
            <a asp-page="/AuditLog/ByCase" asp-page-handler="Export" asp-route-rbse="@Model.Rbse"
               class="govuk-button govuk-button--secondary">Export to CSV</a>
        </div>

        <h2 class="govuk-heading-m">@Model.TotalCount entries for @BseFormat.FormatRbse(Model.Rbse)</h2>
        <table class="govuk-table">
            <caption class="govuk-visually-hidden">Audit log entries for case @BseFormat.FormatRbse(Model.Rbse)</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header" aria-sort="@(Model.SortBy=="table" ? (Model.SortDir=="asc" ? "ascending" : "descending") : "none")"><a class="govuk-link govuk-link--no-visited-state" href="@Model.SortUrl("table")">Table</a></th>
                    <th scope="col" class="govuk-table__header" aria-sort="@(Model.SortBy=="field" ? (Model.SortDir=="asc" ? "ascending" : "descending") : "none")"><a class="govuk-link govuk-link--no-visited-state" href="@Model.SortUrl("field")">Field</a></th>
                    <th scope="col" class="govuk-table__header" aria-sort="@(Model.SortBy=="datetime" ? (Model.SortDir=="asc" ? "ascending" : "descending") : "none")"><a class="govuk-link govuk-link--no-visited-state" href="@Model.SortUrl("datetime")">Date/time</a></th>
                    <th scope="col" class="govuk-table__header" aria-sort="@(Model.SortBy=="user" ? (Model.SortDir=="asc" ? "ascending" : "descending") : "none")"><a class="govuk-link govuk-link--no-visited-state" href="@Model.SortUrl("user")">User</a></th>
                    <th scope="col" class="govuk-table__header" aria-sort="@(Model.SortBy=="before" ? (Model.SortDir=="asc" ? "ascending" : "descending") : "none")"><a class="govuk-link govuk-link--no-visited-state" href="@Model.SortUrl("before")">Before</a></th>
                    <th scope="col" class="govuk-table__header" aria-sort="@(Model.SortBy=="after" ? (Model.SortDir=="asc" ? "ascending" : "descending") : "none")"><a class="govuk-link govuk-link--no-visited-state" href="@Model.SortUrl("after")">After</a></th>
                    <th scope="col" class="govuk-table__header" aria-sort="@(Model.SortBy=="reason" ? (Model.SortDir=="asc" ? "ascending" : "descending") : "none")"><a class="govuk-link govuk-link--no-visited-state" href="@Model.SortUrl("reason")">Reason</a></th>
                    <th scope="col" class="govuk-table__header" aria-sort="@(Model.SortBy=="key" ? (Model.SortDir=="asc" ? "ascending" : "descending") : "none")"><a class="govuk-link govuk-link--no-visited-state" href="@Model.SortUrl("key")">Key</a></th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var e in Model.Entries)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@e.TableName</td>
                        <td class="govuk-table__cell">@e.FieldName</td>
                        <td class="govuk-table__cell">@e.DateTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="govuk-table__cell">@e.UserName</td>
                        <td class="govuk-table__cell">@e.BeforeValue</td>
                        <td class="govuk-table__cell">@e.AfterValue</td>
                        <td class="govuk-table__cell">@e.Reason</td>
                        <td class="govuk-table__cell">@e.Key</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)
        {
            <nav class="govuk-pagination" role="navigation" aria-label="Results pagination">
                <div class="govuk-pagination__prev">
                    @if (Model.PageNumber > 1)
                    {
                        <a class="govuk-link govuk-pagination__link" href="@Model.PageUrl(Model.PageNumber - 1)" rel="prev">
                            <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13"><path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z" /></svg>
                            <span class="govuk-pagination__link-title">Previous<span class="govuk-visually-hidden"> page</span></span>
                        </a>
                    }
                </div>
                <ul class="govuk-pagination__list">
                    @{
                        int pgStart = Math.Max(1, Model.PageNumber - 4);
                        int pgEnd   = Math.Min(Model.TotalPages, pgStart + 9);
                        if (pgEnd - pgStart < 9) pgStart = Math.Max(1, pgEnd - 9);
                    }
                    @for (int p = pgStart; p <= pgEnd; p++)
                    {
                        bool isCur = p == Model.PageNumber;
                        <li class="govuk-pagination__item @(isCur ? "govuk-pagination__item--current" : "")">
                            @if (isCur)
                            {
                                <a class="govuk-link govuk-pagination__link" href="@Model.PageUrl(p)" aria-label="Page @p" aria-current="page">@p</a>
                            }
                            else
                            {
                                <a class="govuk-link govuk-pagination__link" href="@Model.PageUrl(p)" aria-label="Page @p">@p</a>
                            }
                        </li>
                    }
                </ul>
                <div class="govuk-pagination__next">
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a class="govuk-link govuk-pagination__link" href="@Model.PageUrl(Model.PageNumber + 1)" rel="next">
                            <span class="govuk-pagination__link-title">Next<span class="govuk-visually-hidden"> page</span></span>
                            <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13"><path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7246z" /></svg>
                        </a>
                    }
                </div>
            </nav>
        }
    }
}

@if (!string.IsNullOrWhiteSpace(Model.Rbse))
{
    <div class="govuk-!-margin-top-4">
        <a asp-page="/Case/Edit" asp-route-rbse="@Model.Rbse" class="govuk-link">Back to case @BseFormat.FormatRbse(Model.Rbse)</a>
    </div>
}
