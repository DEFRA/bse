@page
@model RbseChangesModel
@{
    ViewData["Title"] = "Audit log — RBSE changes";
}

<div>
    <h1 class="govuk-heading-l">Audit log — RBSE changes</h1>
    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/AuditLog/Menu">Audit log</a></li>
            <li class="govuk-breadcrumbs__list-item" aria-current="page">RBSE changes</li>
        </ol>
    </nav>
    <partial name="_AuditDateRangeForm" model="@(new BSE.Host.Models.ViewModels.AuditDateRangeViewModel(Model.StartDate, Model.EndDate))" />

    @if (Model.Entries.Any())
    {
        <h2 class="govuk-heading-m">@Model.Entries.Count() RBSE changes</h2>
        <table class="govuk-table">
            <caption class="govuk-visually-hidden">RBSE change audit log entries</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row"><th scope="col" class="govuk-table__header">Date/time</th><th scope="col" class="govuk-table__header">User</th><th scope="col" class="govuk-table__header">Key</th><th scope="col" class="govuk-table__header">Before</th><th scope="col" class="govuk-table__header">After</th><th scope="col" class="govuk-table__header">Has batches</th></tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var e in Model.Entries)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@e.DateTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="govuk-table__cell">@e.UserName</td>
                        <td class="govuk-table__cell">@e.Key</td>
                        <td class="govuk-table__cell">@e.BeforeValue</td>
                        <td class="govuk-table__cell">@e.AfterValue</td>
                        <td class="govuk-table__cell">@e.HasBatches</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (Model.HasSearched)
    {
        <div class="govuk-notification-banner" role="region" aria-labelledby="rbse-changes-info-title" data-module="govuk-notification-banner">
            <div class="govuk-notification-banner__header">
                <h2 class="govuk-notification-banner__title" id="rbse-changes-info-title">Information</h2>
            </div>
            <div class="govuk-notification-banner__content">
                <p class="govuk-notification-banner__heading">No RBSE changes found in this period.</p>
            </div>
        </div>
    }
</div>
