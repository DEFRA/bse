@page
@model CphhChangesModel
@{
    ViewData["Title"] = "CPHH Changes Audit Log Report";
}

<div>
    @await Html.PartialAsync("_AuditReportHeading", new BSE.Host.Models.ViewModels.AuditReportHeading("CPHH Changes Audit Log Report", "CPHH changes"))

    @{ var dateRange = new BSE.Host.Models.ViewModels.AuditDateRangeViewModel(Model.StartDate, Model.EndDate, Model.StartDateError, Model.EndDateError); }
    @await Html.PartialAsync("_AuditDateErrors", dateRange)
    <partial name="_AuditDateRangeForm" model="dateRange" />

    @if (Model.Entries.Any())
    {
        @await Html.PartialAsync("_AuditResults", new BSE.Host.Models.ViewModels.AuditResultsViewModel(
            Model.PagedEntries(), Model.SortColumn, Model.SortDesc, Model.PageNumber, Model.TotalPages,
            "CPHH change audit log entries", "cphh-changes-results",
            [BSE.Host.Models.ViewModels.AuditExtraColumn.Of<BSE.Modules.AuditLog.Models.AuditLogCphhChangeEntry>("No. of Cases", "Cases", e => e.CaseCount)]))
    }
    else if (Model.HasSearched)
    {
        @await Html.PartialAsync("_AuditNoResults", new BSE.Host.Models.ViewModels.AuditNoResults("cphh-changes-info-title", "No CPHH changes found in this period."))
    }
</div>
