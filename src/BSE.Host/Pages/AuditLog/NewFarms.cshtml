@page
@model NewFarmsModel
@{
    ViewData["Title"] = "New Farms Audit Log Report";
}

<div>
    @await Html.PartialAsync("_AuditReportHeading", new BSE.Host.Models.ViewModels.AuditReportHeading("New Farms Audit Log Report", "New farms"))

    @{ var dateRange = new BSE.Host.Models.ViewModels.AuditDateRangeViewModel(Model.StartDate, Model.EndDate, Model.StartDateError, Model.EndDateError); }
    @await Html.PartialAsync("_AuditDateErrors", dateRange, new ViewDataDictionary(ViewData) { ["ErrorSuffix"] = "." })
    <partial name="_AuditDateRangeForm" model="dateRange" />

    @if (Model.Entries.Any())
    {
        @await Html.PartialAsync("_AuditResults", new BSE.Host.Models.ViewModels.AuditResultsViewModel(
            Model.PagedEntries(), Model.SortColumn, Model.SortDesc, Model.PageNumber, Model.TotalPages,
            "New farms audit log entries", "new-farms-results",
            [
                BSE.Host.Models.ViewModels.AuditExtraColumn.Of<BSE.Modules.AuditLog.Models.AuditLogNewFarmEntry>("Owner Name", "Owner", e => e.OwnerName),
                BSE.Host.Models.ViewModels.AuditExtraColumn.Of<BSE.Modules.AuditLog.Models.AuditLogNewFarmEntry>("Address", "Address", e => e.Address),
                BSE.Host.Models.ViewModels.AuditExtraColumn.Of<BSE.Modules.AuditLog.Models.AuditLogNewFarmEntry>("County", "County", e => e.County),
            ]))
    }
    else if (Model.HasSearched)
    {
        @await Html.PartialAsync("_AuditNoResults", new BSE.Host.Models.ViewModels.AuditNoResults("new-farms-info-title", "No new farms found in this period."))
    }
</div>
