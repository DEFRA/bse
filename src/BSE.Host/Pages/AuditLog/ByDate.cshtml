@page
@model ByDateModel
@{
    ViewData["Title"] = "Daily Audit Log Report";
}

<div>
    @await Html.PartialAsync("_AuditReportHeading", new BSE.Host.Models.ViewModels.AuditReportHeading("Daily Audit Log Report", "Audit log by date"))

    @if (Model.LogDateError is not null)
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list">
                        <li><a href="#LogDate">@Model.LogDateError</a></li>
                    </ul>
                </div>
            </div>
        </div>
    }

    <form method="get" novalidate class="govuk-!-margin-bottom-6">
        <div class="bse-date-search-row">
            <div class="govuk-form-group @(Model.LogDateError is not null ? "govuk-form-group--error" : "")">
                <label class="govuk-label" for="LogDate">Log Entries On</label>
                @if (Model.LogDateError is not null)
                {
                    <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Model.LogDateError</p>
                }
                <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                    <input id="LogDate" name="LogDate" type="text" class="govuk-input govuk-input--width-10 moj-js-datepicker-input @(Model.LogDateError is not null ? "govuk-input--error" : "")" autocomplete="off" placeholder="dd/mm/yyyy" value="@(Model.LogDate?.ToString("dd/MM/yyyy") ?? "")" />
                </div>
            </div>
            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
                <a asp-page="/AuditLog/Menu" class="govuk-button govuk-button--secondary" data-module="govuk-button">Audit Log Menu</a>
            </div>
        </div>
    </form>

    @if (Model.Entries.Any())
    {
        @await Html.PartialAsync("_AuditResults", new BSE.Host.Models.ViewModels.AuditResultsViewModel(
            Model.PagedEntries(), Model.SortColumn, Model.SortDesc, Model.PageNumber, Model.TotalPages,
            "Audit log entries by date", "daily-audit-results"))
    }
    else if (Model.HasSearched)
    {
        @await Html.PartialAsync("_AuditNoResults", new BSE.Host.Models.ViewModels.AuditNoResults("audit-info-title", $"No audit log entries found for {Model.LogDate?.ToString("dd/MM/yyyy")}."))
    }
</div>
