@page
@model ByDateModel
@{
    ViewData["Title"] = "Audit log by date";
}

<div>
    <h1 class="govuk-heading-l">Audit log by date</h1>
    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
            <li class="govuk-breadcrumbs__list-item" aria-current="page">Audit log by date</li>
        </ol>
    </nav>

    <form method="get" novalidate class="govuk-!-margin-bottom-6">
        <div class="govuk-form-group">
            <label asp-for="LogDate" class="govuk-label">Date</label>
            <input asp-for="LogDate" type="date" class="govuk-input govuk-input--width-10" />
        </div>
        <div class="govuk-button-group">
            <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
            <a asp-page="/AuditLog/ByDate" class="govuk-link">Clear search</a>
        </div>
    </form>

    @if (Model.Entries.Any())
    {
        <h2 class="govuk-heading-m">@Model.Entries.Count() entries on @Model.LogDate.ToShortDateString()</h2>
        <table class="govuk-table">
            <caption class="govuk-visually-hidden">Audit log entries by date</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Time</th>
                    <th scope="col" class="govuk-table__header">User</th>
                    <th scope="col" class="govuk-table__header">Table</th>
                    <th scope="col" class="govuk-table__header">Field</th>
                    <th scope="col" class="govuk-table__header">Key</th>
                    <th scope="col" class="govuk-table__header">Before</th>
                    <th scope="col" class="govuk-table__header">After</th>
                    <th scope="col" class="govuk-table__header">Reason</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var e in Model.Entries)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@e.DateTime.ToShortTimeString()</td>
                        <td class="govuk-table__cell">@e.UserName</td>
                        <td class="govuk-table__cell">@e.TableName</td>
                        <td class="govuk-table__cell">@e.FieldName</td>
                        <td class="govuk-table__cell">@e.Key</td>
                        <td class="govuk-table__cell">@e.BeforeValue</td>
                        <td class="govuk-table__cell">@e.AfterValue</td>
                        <td class="govuk-table__cell">@e.Reason</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (Model.HasSearched)
    {
        <div class="govuk-notification-banner" role="region" aria-labelledby="audit-info-title" data-module="govuk-notification-banner">
            <div class="govuk-notification-banner__header">
                <h2 class="govuk-notification-banner__title" id="audit-info-title">Information</h2>
            </div>
            <div class="govuk-notification-banner__content">
                <p class="govuk-notification-banner__heading">No audit log entries found for @Model.LogDate.ToShortDateString().</p>
            </div>
        </div>
    }
</div>
