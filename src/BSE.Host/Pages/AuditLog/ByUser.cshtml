@page
@model ByUserModel
@{
    ViewData["Title"] = "User Audit Log Report";
}

<div>
    @await Html.PartialAsync("_AuditReportHeading", new BSE.Host.Models.ViewModels.AuditReportHeading("User Audit Log Report", "Audit log by user"))

    @if (Model.ValidationError is not null || Model.StartDateError is not null || Model.EndDateError is not null)
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list">
                        @if (Model.ValidationError is not null)
                        {
                            <li><a href="#UserId">@Model.ValidationError</a></li>
                        }
                        @if (Model.StartDateError is not null)
                        {
                            <li><a href="#StartDate">@Model.StartDateError</a></li>
                        }
                        @if (Model.EndDateError is not null)
                        {
                            <li><a href="#EndDate">@Model.EndDateError</a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    <form method="get" novalidate class="govuk-!-margin-bottom-6">
        <div class="bse-date-search-row">
            <div class="govuk-form-group @(Model.StartDateError is not null || Model.EndDateError is not null ? "govuk-form-group--error" : "")">
                <span class="govuk-label">Log Entries Between</span>
                @if (Model.StartDateError is not null || Model.EndDateError is not null)
                {
                    @if (Model.StartDateError is not null)
                    {
                        <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Model.StartDateError</p>
                    }
                    @if (Model.EndDateError is not null)
                    {
                        <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Model.EndDateError</p>
                    }
                }
                <div class="bse-date-range-input-wrapper">
                    <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                        <input id="StartDate" name="StartDate" type="text" aria-label="Log entries from date"
                               class="govuk-input govuk-input--width-10 moj-js-datepicker-input @(Model.StartDateError is not null ? "govuk-input--error" : "")"
                               autocomplete="off"
                            placeholder="dd/mm/yyyy"
                               value="@(Model.StartDate?.ToString("dd/MM/yyyy"))" />
                    </div>
                    <span class="bse-date-range-separator govuk-label">and</span>
                    <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                        <input id="EndDate" name="EndDate" type="text" aria-label="Log entries to date"
                               class="govuk-input govuk-input--width-10 moj-js-datepicker-input @(Model.EndDateError is not null ? "govuk-input--error" : "")"
                               autocomplete="off"
                            placeholder="dd/mm/yyyy"
                               value="@(Model.EndDate?.ToString("dd/MM/yyyy"))" />
                    </div>
                </div>
            </div>
        </div>
        <div class="bse-date-search-row">
            <div class="govuk-form-group @(Model.ValidationError is not null ? "govuk-form-group--error" : "")">
                <label asp-for="UserId" class="govuk-label">User</label>
                @if (Model.ValidationError is not null)
                {
                    <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Model.ValidationError</p>
                }
                <select asp-for="UserId" asp-items="Model.Users"
                        class="govuk-select @(Model.ValidationError is not null ? "govuk-select--error" : "")">
                    <option value="0">Select a user</option>
                </select>
            </div>
            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
                <a asp-page="/AuditLog/Menu" class="govuk-button govuk-button--secondary" data-module="govuk-button">Audit Log Menu</a>
            </div>
        </div>
    </form>

    @if (Model.Entries.Any())
    {
        @await Html.PartialAsync("_AuditResults", new BSE.Host.Models.ViewModels.AuditResultsViewModel(
            Model.PagedEntries(), Model.SortColumn, Model.SortDesc, Model.PageNumber, Model.TotalPages,
            "Audit log entries by user", "audit-user-results"))
    }
    else if (Model.HasSearched)
    {
        @await Html.PartialAsync("_AuditNoResults", new BSE.Host.Models.ViewModels.AuditNoResults("audit-user-info-title", "No entries found."))
    }
</div>
