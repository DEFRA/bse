@page
@model ByUserModel
@{
    ViewData["Title"] = "Audit log by user";
}

<div>
    <h1 class="govuk-heading-l">Audit log by user</h1>
    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/AuditLog/Menu">Audit log</a></li>
            <li class="govuk-breadcrumbs__list-item" aria-current="page">Audit log by user</li>
        </ol>
    </nav>

    <form method="get" novalidate class="govuk-!-margin-bottom-6">
        <div class="govuk-form-group @(Model.ValidationError is not null ? "govuk-form-group--error" : "")">
            <label asp-for="UserId" class="govuk-label">User</label>
            @if (Model.ValidationError is not null)
            {
                <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Model.ValidationError</p>
            }
            <select asp-for="UserId" asp-items="Model.Users"
                    class="govuk-select @(Model.ValidationError is not null ? "govuk-select--error" : "")">
                <option value="0">Select a user</option>
            </select>
        </div>
        <div class="govuk-form-group">
            <label asp-for="StartDate" class="govuk-label">From</label>
            <input asp-for="StartDate" type="date" class="govuk-input govuk-input--width-10"
                   value="@Model.StartDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="govuk-form-group">
            <label asp-for="EndDate" class="govuk-label">To</label>
            <input asp-for="EndDate" type="date" class="govuk-input govuk-input--width-10"
                   value="@Model.EndDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="govuk-button-group">
            <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
            <a asp-page="/AuditLog/ByUser" class="govuk-link">Clear search</a>
        </div>
    </form>

    @if (Model.Entries.Any())
    {
        <h2 class="govuk-heading-m">@Model.Entries.Count() entries</h2>
        var sortBase = "?" + string.Join("&", HttpContext.Request.Query
            .Where(k => !string.Equals(k.Key, "SortColumn", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "SortDesc", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "PageNumber", StringComparison.OrdinalIgnoreCase))
            .SelectMany(k => k.Value, (k, v) => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}"));
        var sortCol  = Model.SortColumn;
        var sortDesc = Model.SortDesc;
        <table class="govuk-table">
            <caption class="govuk-visually-hidden">Audit log entries by user</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    @{ ViewData["Label"] = "Date/time"; ViewData["Column"] = "DateTime"; ViewData["SortColumn"] = sortCol; ViewData["SortDesc"] = sortDesc; ViewData["BaseUrl"] = sortBase; ViewData["Prefix"] = ""; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "User";   ViewData["Column"] = "User"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Table";  ViewData["Column"] = "Table"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Field";  ViewData["Column"] = "Field"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Key";    ViewData["Column"] = "Key"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Before"; ViewData["Column"] = "Before"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "After";  ViewData["Column"] = "After"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Reason"; ViewData["Column"] = "Reason"; }
                    <partial name="_SortableHeader" />
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var e in Model.PagedEntries)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@e.DateTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="govuk-table__cell">@e.UserName</td>
                        <td class="govuk-table__cell">@e.TableName</td>
                        <td class="govuk-table__cell">@e.FieldName</td>
                        <td class="govuk-table__cell">@e.Key</td>
                        <td class="govuk-table__cell">@e.BeforeValue</td>
                        <td class="govuk-table__cell">@e.AfterValue</td>
                        <td class="govuk-table__cell">@e.Reason</td>
                    </tr>
                }
            </tbody>
        </table>
        @await Html.PartialAsync("_Pagination", null, new ViewDataDictionary(ViewData) { ["CurrentPage"] = Model.PageNumber, ["TotalPages"] = Model.TotalPages })
    }
    else if (Model.HasSearched)
    {
        <div class="govuk-notification-banner" role="region" aria-labelledby="audit-user-info-title" data-module="govuk-notification-banner">
            <div class="govuk-notification-banner__header">
                <h2 class="govuk-notification-banner__title" id="audit-user-info-title">Information</h2>
            </div>
            <div class="govuk-notification-banner__content">
                <p class="govuk-notification-banner__heading">No entries found.</p>
            </div>
        </div>
    }
</div>
