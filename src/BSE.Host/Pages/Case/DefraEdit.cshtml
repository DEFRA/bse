            <input asp-for="Case.SummarySheetReceivedDate" type="date" class="govuk-input govuk-input--width-10 @(eSummarySheet is not null ? "govuk-input--error" : "")" value="@DateVal(Model.Case.SummarySheetReceivedDate)" />
