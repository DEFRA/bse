@page "{rbse}"
@using BSE.Host.Helpers
@model BSE.Host.Pages.Case.RelationsViewModel
@{
    ViewData["Title"] = $"Relations for {BseFormat.FormatRbse(Model.Rbse)}";
}

<h1 class="govuk-heading-l">Relations for <span class="bse-rbse">@BseFormat.FormatRbse(Model.Rbse)</span></h1>

<p class="govuk-body">
    <button type="button" class="govuk-button govuk-button--secondary" onclick="history.back()">Back</button>
</p>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-one-half">
        <h2 class="govuk-heading-m">Dam</h2>
        @if (Model.Details?.Dam is { } dam)
        {
            <dl class="govuk-summary-list">
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Eartag</dt><dd class="govuk-summary-list__value">@dam.Eartag</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Name</dt><dd class="govuk-summary-list__value">@dam.Name</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">RBSE</dt><dd class="govuk-summary-list__value">@BseFormat.FormatRbse(dam.Rbse)</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Herdbook</dt><dd class="govuk-summary-list__value">@dam.Herdbook</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Birth date</dt><dd class="govuk-summary-list__value">@($"{dam.BirthDay}/{dam.BirthMonth}/{dam.BirthYear}")</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Fate</dt><dd class="govuk-summary-list__value">@dam.Fate</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Final result</dt><dd class="govuk-summary-list__value">@dam.FinalResult</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Offspring count</dt><dd class="govuk-summary-list__value">@dam.ChildCount</dd></div>
            </dl>
        }
        else
        {
            <p class="govuk-body govuk-!-colour-secondary">No dam recorded.</p>
        }
    </div>

    <div class="govuk-grid-column-one-half">
        <h2 class="govuk-heading-m">Sire</h2>
        @if (Model.Details?.Sire is { } sire)
        {
            <dl class="govuk-summary-list">
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Eartag</dt><dd class="govuk-summary-list__value">@sire.Eartag</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Name</dt><dd class="govuk-summary-list__value">@sire.Name</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">RBSE</dt><dd class="govuk-summary-list__value">@BseFormat.FormatRbse(sire.Rbse)</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Herdbook</dt><dd class="govuk-summary-list__value">@sire.Herdbook</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Birth date</dt><dd class="govuk-summary-list__value">@($"{sire.BirthDay}/{sire.BirthMonth}/{sire.BirthYear}")</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Fate</dt><dd class="govuk-summary-list__value">@sire.Fate</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Offspring count</dt><dd class="govuk-summary-list__value">@sire.ChildCount</dd></div>
            </dl>
        }
        else
        {
            <p class="govuk-body govuk-!-colour-secondary">No sire recorded.</p>
        }
    </div>
</div>

<h2 class="govuk-heading-m">Related animals</h2>
@if (Model.Details?.Relations.Count > 0)
{
    <table class="govuk-table">
        <caption class="govuk-visually-hidden">Related animals for @BseFormat.FormatRbse(Model.Rbse)</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Relation Type</th>
                <th scope="col" class="govuk-table__header">RBSE</th>
                <th scope="col" class="govuk-table__header">Sex</th>
                <th scope="col" class="govuk-table__header">Birth Date</th>
                <th scope="col" class="govuk-table__header">Fate</th>
                <th scope="col" class="govuk-table__header">Date Left</th>
                <th scope="col" class="govuk-table__header">Eartag</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var r in Model.Details.Relations)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@(r.RelationTypeDesc ?? r.RelationType)</td>
                    <td class="govuk-table__cell">@BseFormat.FormatRbse(r.RelationRbse)</td>
                    <td class="govuk-table__cell">@(r.SexDesc ?? r.Sex)</td>
                    <td class="govuk-table__cell">@($"{r.BirthDay}/{r.BirthMonth}/{r.BirthYear}")</td>
                    <td class="govuk-table__cell">@(r.RelationFateDesc ?? r.RelationFate)</td>
                    <td class="govuk-table__cell">@r.LeftDate?.ToString("dd/MM/yyyy")</td>
                    <td class="govuk-table__cell">@r.EartagCountry @r.EartagHerdmark @r.Eartag</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="govuk-body govuk-!-colour-secondary">No related animals recorded.</p>
}
