@model BSE.Host.Models.FeedFormViewModel
@{
    string? Err(string key) => Model.FieldErrors.TryGetValue(key, out var m) ? m : null;
}
    <div class="govuk-form-group @(Err("YearFrom") is not null ? "govuk-form-group--error" : "")">
        <label class="govuk-label" for="feed-yearfrom">Year From</label>
        @if (Err("YearFrom") is { } yearFromError)
        {
            <p id="feed-yearfrom-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">Error:</span>@yearFromError
            </p>
        }
        <input id="feed-yearfrom" name="@(Model.Prefix).YearFrom" type="text" inputmode="numeric" maxlength="4"
               value="@Model.YearFrom"
               aria-describedby="@(Err("YearFrom") is not null ? "feed-yearfrom-error" : null)"
               class="govuk-input govuk-input--width-4 @(Err("YearFrom") is not null ? "govuk-input--error" : "")" />
    </div>

    <div class="govuk-form-group @(Err("YearTo") is not null ? "govuk-form-group--error" : "")">
        <label class="govuk-label" for="feed-yearto">Year To</label>
        @if (Err("YearTo") is { } yearToError)
        {
            <p id="feed-yearto-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">Error:</span>@yearToError
            </p>
        }
        <input id="feed-yearto" name="@(Model.Prefix).YearTo" type="text" inputmode="numeric" maxlength="4"
               value="@Model.YearTo"
               aria-describedby="@(Err("YearTo") is not null ? "feed-yearto-error" : null)"
               class="govuk-input govuk-input--width-4 @(Err("YearTo") is not null ? "govuk-input--error" : "")" />
    </div>

    <div class="govuk-form-group @(Err("RationType") is not null ? "govuk-form-group--error" : "")">
        <label class="govuk-label" for="feed-rationtype">Ration Type</label>
        @if (Err("RationType") is { } rationTypeError)
        {
            <p id="feed-rationtype-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">Error:</span>@rationTypeError
            </p>
        }
        <select id="feed-rationtype" name="@(Model.Prefix).RationType"
                aria-describedby="@(Err("RationType") is not null ? "feed-rationtype-error" : null)"
                class="govuk-select govuk-!-width-one-half @(Err("RationType") is not null ? "govuk-select--error" : "")">
            <option value=""></option>
            @foreach (var rt in Model.RationTypes)
            {
                <option value="@rt.Code" selected="@(rt.Code == Model.RationType)">@rt.Description</option>
            }
        </select>
    </div>

    <div class="govuk-form-group">
        <label class="govuk-label" for="feed-rationname">Ration Name</label>
        <input id="feed-rationname" name="@(Model.Prefix).RationName" maxlength="60" value="@Model.RationName"
               class="govuk-input govuk-!-width-two-thirds" />
    </div>

    <div class="govuk-form-group">
        <div class="govuk-checkboxes" data-module="govuk-checkboxes">
            <div class="govuk-checkboxes__item">
                <input id="feed-prepurchase" name="@(Model.Prefix).IsPrePurchase" type="checkbox"
                       class="govuk-checkboxes__input" value="true" checked="@Model.IsPrePurchase" />
                <label class="govuk-label govuk-checkboxes__label" for="feed-prepurchase">Is Pre-Purchase?</label>
            </div>
        </div>
    </div>

    <div class="govuk-form-group @(Err("SupplierId") is not null ? "govuk-form-group--error" : "")">
        <label class="govuk-label" for="feed-supplierid">Supplier</label>
        @if (Err("SupplierId") is { } supplierError)
        {
            <p id="feed-supplierid-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">Error:</span>@supplierError
            </p>
        }
        <select id="feed-supplierid" name="@(Model.Prefix).SupplierId"
                aria-describedby="@(Err("SupplierId") is not null ? "feed-supplierid-error" : null)"
                class="govuk-select govuk-!-width-two-thirds @(Err("SupplierId") is not null ? "govuk-select--error" : "")">
            <option value=""></option>
            @foreach (var s in Model.Suppliers)
            {
                <option value="@s.Id" selected="@(s.Id == Model.SupplierId)">@s.Description</option>
            }
        </select>
    </div>
