@page
@using BSE.Host.Helpers
@model DeleteModel
@{
    ViewData["Title"] = "Delete case";

    var errors = new List<(string Anchor, string Message)>();
    if (Model.RbseError is not null) { errors.Add(("rbse", Model.RbseError)); }
    if (Model.ErrorMessage is not null) { errors.Add(("rbse", Model.ErrorMessage)); }
}

<h1 class="govuk-heading-l">Delete Case</h1>

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Delete case</li>
    </ol>
</nav>

@if (errors.Count > 0)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var error in errors)
                    {
                        <li><a href="#@error.Anchor">@error.Message</a></li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

@* ── Step 1: look up the case to be deleted ─────────────────────────────── *@
<form method="post" asp-page-handler="LookUp" novalidate>
    <div class="govuk-form-group @(Model.RbseError is not null ? "govuk-form-group--error" : "")">
        <label class="govuk-label" for="rbse">RBSE</label>
        <div id="rbse-hint" class="govuk-hint">For example, 00/26/00001. Slashes are optional.</div>
        @if (Model.RbseError is not null)
        {
            <p id="rbse-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">Error:</span>@Model.RbseError
            </p>
        }
        <input id="rbse" name="Rbse" value="@Model.Rbse" type="text" maxlength="11" autocomplete="off"
               aria-describedby="rbse-hint @(Model.RbseError is not null ? "rbse-error" : "")"
               class="govuk-input govuk-input--width-10 @(Model.RbseError is not null ? "govuk-input--error" : "")" />
    </div>
    <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">Look Up</button>
</form>

@if (Model.CaseFound)
{
    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

    <h2 class="govuk-heading-m">Case @BseFormat.FormatRbse(Model.CaseRecord!.Rbse)</h2>
    <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Owner Name</dt>
            <dd class="govuk-summary-list__value">@Model.Farm?.OwnerName</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Address</dt>
            <dd class="govuk-summary-list__value">
                @Model.Farm?.Address1<br>
                @Model.Farm?.Address2<br>
                @Model.Farm?.Address3<br>
                @Model.Farm?.Postcode
            </dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">CPHH</dt>
            <dd class="govuk-summary-list__value">@BseFormat.FormatCphh(Model.CaseRecord.Cphh)</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Number of Cases on Farm</dt>
            <dd class="govuk-summary-list__value">@Model.NumberOfCasesOnFarm</dd>
        </div>
    </dl>

    @if (Model.FarmWillBeDeleted)
    {
        <div class="govuk-inset-text">@DeleteModel.FarmDeleteMessage</div>
    }

    @if (Model.HasVlaData)
    {
        <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                <span class="govuk-warning-text__assistive">Warning</span>
                @DeleteModel.VlaDataMessage
            </strong>
        </div>
        <p class="govuk-body"><a asp-page="/Home" class="govuk-link">Return to home</a></p>
    }
    else
    {
        <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                <span class="govuk-warning-text__assistive">Warning</span>
                Deleting this case cannot be undone.
            </strong>
        </div>

        <form method="post" asp-page-handler="Delete">
            <input type="hidden" name="Rbse" value="@Model.Rbse" />
            <div class="govuk-button-group">
                <button type="submit" class="govuk-button govuk-button--warning" data-module="govuk-button"
                        onclick="return confirm('Click OK to delete case');">OK</button>
                <a asp-page="/Home" class="govuk-link">Cancel</a>
            </div>
        </form>
    }
}
