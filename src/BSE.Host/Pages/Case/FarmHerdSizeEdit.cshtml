@page
@model BSE.Host.Pages.Case.FarmHerdSizeEditModel
@{
    ViewData["Title"] = "Edit herd size";
}

<h1 class="govuk-heading-l">Edit herd size</h1>

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Case/Farm" asp-route-rbse="@Model.Rbse">Farm</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Edit herd size</li>
    </ol>
</nav>

@await Html.PartialAsync("_ModelStateErrorSummary")

<form method="post" novalidate>
    <input type="hidden" asp-for="Rbse" />
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="RowStampBase64" />

    <partial name="_HerdSizeFormFields" model="Model" />
</form>