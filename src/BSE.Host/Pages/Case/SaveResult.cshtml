@page "{rbse}"
@model SaveResultModel
@{
    ViewData["Title"] = "Save Case Details";
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Save Case Details</li>
    </ol>
</nav>

<h1 class="govuk-heading-l">Save Case Details</h1>

<p class="govuk-body"><strong>RBSE: @BseFormat.FormatRbse(Model.Rbse)</strong></p>

<div class="govuk-error-summary" data-module="govuk-error-summary">
    <div role="alert">
        <h2 class="govuk-error-summary__title">@Model.IntroText</h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
                @foreach (var message in Model.Messages)
                {
                    <li>@message</li>
                }
            </ul>
        </div>
    </div>
</div>

<a asp-page="@Model.ReturnPage" asp-route-rbse="@Model.Rbse" role="button" draggable="false"
   class="govuk-button" data-module="govuk-button">@Model.ButtonText</a>
