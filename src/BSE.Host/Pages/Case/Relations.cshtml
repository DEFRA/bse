@page "{rbse}"
@model BSE.Host.Pages.Case.RelationsModel
@{
    ViewData["Title"] = $"Animal relations — {Model.Rbse}";
    string rbseNoSlash = Model.Rbse.Replace("/", "");
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Relations</li>
    </ol>
</nav>

<h1 class="govuk-heading-l">RBSE Number: <span class="bse-rbse">@BseFormat.FormatRbse(Model.Rbse)</span></h1>

@await Html.PartialAsync("_CaseTabs", new BSE.Host.Models.CaseTabsViewModel("Relations", Model.Rbse))

@if (TempData["Success"] is string successMsg)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
         aria-labelledby="relations-success-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="relations-success-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@successMsg</p>
        </div>
    </div>
}

@if (!ViewContext.ModelState.IsValid)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var e in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@e.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

@* ── Batch numbers ── *@
@if (User.IsInRole("DataEntry") && Model.BatchNumbers.Count > 0)
{
    var batchSortBase = "?" + string.Join("&", HttpContext.Request.Query
        .Where(k => !string.Equals(k.Key, "BSortColumn", StringComparison.OrdinalIgnoreCase)
                 && !string.Equals(k.Key, "BSortDesc", StringComparison.OrdinalIgnoreCase)
                 && !string.Equals(k.Key, "BPageNumber", StringComparison.OrdinalIgnoreCase))
        .SelectMany(k => k.Value, (k, v) => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}"));
    var batchSortColumn = HttpContext.Request.Query["BSortColumn"].ToString();
    var batchSortDesc = bool.TryParse(HttpContext.Request.Query["BSortDesc"], out var desc) && desc;
    var sortedBatchNumbers = batchSortColumn == "Document"
        ? (batchSortDesc ? Model.BatchNumbers.OrderByDescending(b => b.Document) : Model.BatchNumbers.OrderBy(b => b.Document))
        : (batchSortDesc ? Model.BatchNumbers.OrderByDescending(b => b.BatchNumber) : Model.BatchNumbers.OrderBy(b => b.BatchNumber));

    <div class="govuk-!-margin-bottom-4">
        <h2 class="govuk-heading-m">Batch numbers</h2>
        <table class="govuk-table">
            <caption class="govuk-visually-hidden">Batch numbers for @Model.Rbse</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    @{ ViewData["Label"] = "Batch Number"; ViewData["Column"] = "BatchNumber"; ViewData["SortColumn"] = batchSortColumn; ViewData["SortDesc"] = batchSortDesc; ViewData["BaseUrl"] = batchSortBase; ViewData["Prefix"] = "B"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Document"; ViewData["Column"] = "Document"; }
                    <partial name="_SortableHeader" />
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var b in sortedBatchNumbers)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@b.BatchNumber</td>
                        <td class="govuk-table__cell">@(string.IsNullOrWhiteSpace(b.Document) ? "—" : b.Document)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@{
    var canEditRelations = User.IsInRole("DataEntry");
    var d = Model.DamSire;
}

<h2 class="govuk-heading-m">Case Herdbook</h2>
<p class="govuk-body">@(string.IsNullOrWhiteSpace(Model.CaseHerdbook) ? "—" : Model.CaseHerdbook)</p>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-one-half">
        <h2 class="govuk-heading-m">Dam</h2>
        @if (d.HasDam)
        {
            <dl class="govuk-summary-list govuk-summary-list--no-border govuk-!-margin-bottom-4">
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Eartag</dt><dd class="govuk-summary-list__value">@d.DamEartag</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Name</dt><dd class="govuk-summary-list__value">@d.DamName</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">RBSE</dt><dd class="govuk-summary-list__value">@(string.IsNullOrWhiteSpace(d.DamRbse) ? "—" : BseFormat.FormatRbse(d.DamRbse))</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Herdbook</dt><dd class="govuk-summary-list__value">@d.DamHerdbook</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Birth date</dt><dd class="govuk-summary-list__value">@(d.DamBirthDay.HasValue ? $"{d.DamBirthDay}/{d.DamBirthMonth}/{d.DamBirthYear}" : "—")</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Fate</dt><dd class="govuk-summary-list__value">@d.DamFate</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Final result</dt><dd class="govuk-summary-list__value">@d.DamFinalResult</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Offspring count</dt><dd class="govuk-summary-list__value">@d.DamChildCount</dd></div>
            </dl>

            <div class="govuk-button-group">
                @if (!string.IsNullOrWhiteSpace(d.DamRbse))
                {
                    <a class="govuk-button govuk-button--secondary" asp-page="/Case/RelationsView" asp-route-rbse="@d.DamRbse">View Dam's Relations</a>
                }
                @if (canEditRelations)
                {
                    <form method="post" asp-page-handler="RemoveDam" novalidate>
                        <button type="submit" class="govuk-button govuk-button--warning"
                                onclick="return confirm('This will disassociate the dam from the case.  Do you wish to continue?');">Remove Dam</button>
                    </form>
                }
            </div>
        }
        else
        {
            <p class="govuk-body govuk-!-colour-secondary">No dam recorded.</p>
            @if (canEditRelations)
            {
                <a class="govuk-button govuk-button--secondary" asp-page="/Case/RelationParentAdd" asp-route-rbse="@Model.Rbse" asp-route-sex="F">Add Dam Details</a>
            }
        }
    </div>

    <div class="govuk-grid-column-one-half">
        <h2 class="govuk-heading-m">Sire</h2>
        @if (d.HasSire)
        {
            <dl class="govuk-summary-list govuk-summary-list--no-border govuk-!-margin-bottom-4">
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Eartag</dt><dd class="govuk-summary-list__value">@d.SireEartag</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Name</dt><dd class="govuk-summary-list__value">@d.SireName</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">RBSE</dt><dd class="govuk-summary-list__value">@(string.IsNullOrWhiteSpace(d.SireRbse) ? "—" : BseFormat.FormatRbse(d.SireRbse))</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Herdbook</dt><dd class="govuk-summary-list__value">@d.SireHerdbook</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Birth date</dt><dd class="govuk-summary-list__value">@(d.SireBirthDay.HasValue ? $"{d.SireBirthDay}/{d.SireBirthMonth}/{d.SireBirthYear}" : "—")</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Fate</dt><dd class="govuk-summary-list__value">@d.SireFate</dd></div>
                <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Offspring count</dt><dd class="govuk-summary-list__value">@d.SireChildCount</dd></div>
            </dl>

            <div class="govuk-button-group">
                @if (!string.IsNullOrWhiteSpace(d.SireRbse))
                {
                    <a class="govuk-button govuk-button--secondary" asp-page="/Case/RelationsView" asp-route-rbse="@d.SireRbse">View Sire's Relations</a>
                }
                @if (canEditRelations)
                {
                    <form method="post" asp-page-handler="RemoveSire" novalidate>
                        <button type="submit" class="govuk-button govuk-button--warning"
                                onclick="return confirm('This will disassociate the sire from the case.  Do you wish to continue?');">Remove Sire</button>
                    </form>
                }
            </div>
        }
        else
        {
            <p class="govuk-body govuk-!-colour-secondary">No sire recorded.</p>
            @if (canEditRelations)
            {
                <a class="govuk-button govuk-button--secondary" asp-page="/Case/RelationParentAdd" asp-route-rbse="@Model.Rbse" asp-route-sex="M">Add Sire Details</a>
            }
        }
    </div>
</div>


@* ── Related animals ── *@
<h2 class="govuk-heading-m">Related animals</h2>

@if (Model.TotalRelationsCount > 0)
{
    <table class="govuk-table">
        <caption class="govuk-visually-hidden">Related animals for @Model.Rbse</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                @{
                    var relBase = Url.Page("/Case/Relations", new { rbse = Model.Rbse });
                }
                @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"]="Relation Type", ["Column"]="RelationType", ["SortColumn"]=Model.SortColumn, ["SortDesc"]=Model.SortDesc, ["BaseUrl"]=relBase })
                @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"]="RBSE", ["Column"]="RelationRbse", ["SortColumn"]=Model.SortColumn, ["SortDesc"]=Model.SortDesc, ["BaseUrl"]=relBase })
                @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"]="Sex", ["Column"]="Sex", ["SortColumn"]=Model.SortColumn, ["SortDesc"]=Model.SortDesc, ["BaseUrl"]=relBase })
                @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"]="Birth Date", ["Column"]="BirthDate", ["SortColumn"]=Model.SortColumn, ["SortDesc"]=Model.SortDesc, ["BaseUrl"]=relBase })
                @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"]="Fate", ["Column"]="RelationFate", ["SortColumn"]=Model.SortColumn, ["SortDesc"]=Model.SortDesc, ["BaseUrl"]=relBase })
                @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"]="Date Left", ["Column"]="LeftDate", ["SortColumn"]=Model.SortColumn, ["SortDesc"]=Model.SortDesc, ["BaseUrl"]=relBase })
                @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"]="Eartag", ["Column"]="Eartag", ["SortColumn"]=Model.SortColumn, ["SortDesc"]=Model.SortDesc, ["BaseUrl"]=relBase })
                @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"]="Sire", ["Column"]="Sire", ["SortColumn"]=Model.SortColumn, ["SortDesc"]=Model.SortDesc, ["BaseUrl"]=relBase })
                @if (User.IsInRole("DataEntry"))
                {
                    <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Actions</span></th>
                }
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var r in Model.PagedRelations)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@(r.RelationTypeDesc ?? r.RelationType)</td>
                    <td class="govuk-table__cell">@BseFormat.FormatRbse(r.RelationRbse)</td>
                    <td class="govuk-table__cell">@(r.SexDesc ?? r.Sex)</td>
                    <td class="govuk-table__cell">@($"{r.BirthDay}/{r.BirthMonth}/{r.BirthYear}")</td>
                    <td class="govuk-table__cell">@(r.RelationFateDesc ?? r.RelationFate)</td>
                    <td class="govuk-table__cell">@r.LeftDate?.ToString("dd/MM/yyyy")</td>
                    <td class="govuk-table__cell">@r.EartagCountry @r.EartagHerdmark @r.Eartag</td>
                    <td class="govuk-table__cell">@r.Sire</td>
                    @if (User.IsInRole("DataEntry"))
                    {
                        <td class="govuk-table__cell">
                            <div class="bse-row-actions">
                                <a class="govuk-link" asp-page="/Case/RelationEdit"
                                   asp-route-rbse="@Model.Rbse" asp-route-relationId="@r.Id">Change<span class="govuk-visually-hidden"> relation @(r.RelationTypeDesc ?? r.RelationType)</span></a>
                                <form method="post" asp-page-handler="DeleteRelation" novalidate>
                                    <input type="hidden" name="RelationId" value="@r.Id" />
                                    <input type="hidden" name="RowStampBase64" value="@Convert.ToBase64String(r.RowStamp ?? [])" />
                                    <input type="hidden" asp-for="Rbse" />
                                    <button type="submit" class="govuk-button govuk-button--secondary"
                                            onclick="return confirm('Delete this relation?')">Delete<span class="govuk-visually-hidden"> relation @(r.RelationTypeDesc ?? r.RelationType)</span></button>
                                </form>
                            </div>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

    @await Html.PartialAsync("_Pagination", null, new ViewDataDictionary(ViewData) { ["CurrentPage"] = Model.PageNumber, ["TotalPages"] = Model.TotalPages })
}
else
{
    <p class="govuk-body govuk-!-colour-secondary">No related animals recorded.</p>
}

@* -- Actions --------------------------------------------------------------- *@
<div class="govuk-button-group govuk-!-margin-top-4">
    @if (User.IsInRole("DataEntry"))
    {
        <a asp-page="/Case/RelationAdd" asp-route-rbse="@Model.Rbse" class="govuk-button govuk-button--secondary">Add As New</a>
    }
    @if (!string.IsNullOrEmpty(Model.SpolSiteUrl))
    {
        <a href="@(Model.SpolSiteUrl)@rbseNoSlash" target="_blank" rel="noopener noreferrer" class="govuk-link">
            View docs<span class="govuk-visually-hidden"> (opens in new tab)</span>
        </a>
    }
</div>

