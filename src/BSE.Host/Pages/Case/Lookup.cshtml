@page
@model BSE.Host.Pages.Case.LookupModel
@{
    ViewData["Title"] = "Open case";
}

<h1 class="govuk-heading-l">Open case</h1>

<form method="get" novalidate>
    <div class="govuk-form-group">
        <label asp-for="Rbse" class="govuk-label">RBSE</label>
        <div class="govuk-hint">Enter 9 digits, for example 000000001.</div>
        <input asp-for="Rbse" class="govuk-input govuk-!-width-one-half" />
    </div>

    <button type="submit" class="govuk-button" data-module="govuk-button">Open case</button>
</form>

@if (Model.IsNotFound)
{
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-warning-text__assistive">Warning</span>
            No case found for RBSE @Model.Rbse.
        </strong>
    </div>
}
