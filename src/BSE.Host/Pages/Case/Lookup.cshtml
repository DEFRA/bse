@page
@model BSE.Host.Pages.Case.LookupModel
@{
    ViewData["Title"] = "Open case";
    var rbseError = Model.ModelState[nameof(Model.Rbse)]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<h1 class="govuk-heading-l">Open case</h1>

@if (rbseError is not null)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li><a href="#rbse-lookup">@rbseError</a></li>
                </ul>
            </div>
        </div>
    </div>
}

<form method="get" novalidate>
    <div class="govuk-form-group @(rbseError is not null ? "govuk-form-group--error" : "")">
        <label asp-for="Rbse" class="govuk-label" id="rbse-lookup-label">RBSE</label>
        @if (rbseError is not null)
        {
            <p id="rbse-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">Error:</span> @rbseError
            </p>
        }
        <input id="rbse-lookup" asp-for="Rbse"
               class="govuk-input govuk-!-width-one-half @(rbseError is not null ? "govuk-input--error" : "")"
               aria-describedby="@(rbseError is not null ? "rbse-error" : "")"
               maxlength="11" autocomplete="off" />
    </div>

    <button type="submit" class="govuk-button" data-module="govuk-button">Open case</button>
</form>

@if (Model.IsNotFound)
{
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-warning-text__assistive">Warning</span>
            No case found for RBSE @Model.Rbse.
        </strong>
    </div>
}
