@page "{rbse}"
@model VlaModel
@{
    ViewData["Title"] = $"Case (APHA) — {Model.Case.Rbse}";
    static bool IsSelected(string? optionCode, string? currentValue) =>
        string.Equals(optionCode, currentValue, StringComparison.OrdinalIgnoreCase);
    string rbseNoSlash = Model.Case.Rbse.Replace("/", "");
    var viewDocsUrl = string.IsNullOrWhiteSpace(Model.SpolSiteUrl)
        ? null
        : $"{Model.SpolSiteUrl}{rbseNoSlash}";

    string? E(string key) => ViewData.ModelState[key]?.Errors.FirstOrDefault()?.ErrorMessage;
    string DateVal(DateTime? d) => d?.ToString("dd/MM/yyyy") ?? string.Empty;
    string OwnersSortAria(string column)
    {
        if (Model.OSort != column) return "none";
        return Model.ODir == "asc" ? "ascending" : "descending";
    }
    // Prefer the raw text the user typed (preserved on failed/invalid binding) so it is
    // redisplayed unchanged after Save, matching legacy CalendarDate behaviour; otherwise
    // fall back to formatting the successfully bound value.
    string DateDisplay(string key, DateTime? d) =>
        ViewData.ModelState[key]?.AttemptedValue ?? DateVal(d);
    var vlaReadOnly = !Model.CanEditMainCase;

    var showInformDefraWarning = Model.Case.BirthDate.HasValue;
    var showOnsetDateWarning = Model.Case.OnsetDate.HasValue
        && Model.Case.FormADate.HasValue
        && Model.Case.OnsetDate.Value.Date < Model.Case.FormADate.Value.Date.AddMonths(-3);
    var showHerdDateWarning = Model.Case.HerdEntryDate.HasValue
        && Model.Case.BirthDate.HasValue
        && Model.Case.HerdEntryDate.Value.Date < Model.Case.BirthDate.Value.Date.AddMonths(18);
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Case (APHA)</li>
    </ol>
</nav>

@await Html.PartialAsync("_CaseTabs", new BSE.Host.Models.CaseTabsViewModel("Case (APHA)", Model.Case.Rbse, Model.BatchNumbers, viewDocsUrl, Model.CanEditMainCase))

@await Html.PartialAsync("_CaseEditNotifications", new BSE.Host.Models.CaseEditNotificationsViewModel(
    "vla", TempData["Success"] as string, TempData["Warning"] as string))

@if (!string.IsNullOrEmpty(Model.ConcurrencyError))
{
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-warning-text__assistive">Warning</span>
            @Model.ConcurrencyError
        </strong>
    </div>
}

<form id="edit-vla-form" method="post" novalidate>
    @if (!Model.CanEditMainCase)
    {
        <p class="govuk-body">You can view case details but cannot edit this page.</p>
    }

    @if (Model.CanEditMainCase)
    {
        <input type="hidden" name="Rbse" value="@Model.Rbse" />
        <input type="hidden" asp-for="OSort" />
        <input type="hidden" asp-for="ODir" />
        <input type="hidden" asp-for="OPage" />
    }

        <input type="hidden" asp-for="Case.Rbse" />
        <input type="hidden" asp-for="Case.EartagCountry" />
        <input type="hidden" asp-for="Case.EartagHerdmark" />
        <input type="hidden" asp-for="Case.Eartag" />
        <input type="hidden" asp-for="Case.PreviousEartag" />
        <input type="hidden" asp-for="Case.Bse1ReceivedDate" />
        <input type="hidden" asp-for="Case.FormADate" value="@DateVal(Model.Case.FormADate)" />
        <input type="hidden" asp-for="Case.FormAResubmittedDate" />
        <input type="hidden" asp-for="Case.FormBDate" />
        <input type="hidden" asp-for="Case.Fate" />
        <input type="hidden" asp-for="Case.FormCDate" />
        <input type="hidden" asp-for="Case.IsPurchaserBse1Received" />
        <input type="hidden" asp-for="Case.IsBreederBse1Received" />
        <input type="hidden" asp-for="Case.IsVendor1Bse1Received" />
        <input type="hidden" asp-for="Case.IsHomebredBse1Received" />
        <input type="hidden" asp-for="Case.IsSummarySheetReceived" />
        <input type="hidden" asp-for="Case.IsPaperworkComplete" />
        <input type="hidden" asp-for="Case.ReportedLocation" />
        <input type="hidden" asp-for="Case.Survey" />
        <input type="hidden" asp-for="Case.Notes" />
        <input type="hidden" asp-for="Case.DamStatus" />
        <input type="hidden" asp-for="Case.ValuationAge" />
        <input type="hidden" asp-for="Case.AlternateDiagnosis" />
        <input type="hidden" asp-for="Case.LabComment" />
        <input type="hidden" asp-for="Case.CaseType" />

        <fieldset class="bse-form-fieldset-reset" disabled="@(vlaReadOnly ? "disabled" : null)">
        <div class="vla-legacy-grid">
            <div class="vla-legacy-field @(E("Case.BirthDate") is not null ? "govuk-form-group--error" : "")">
                <label for="Case_BirthDate" class="govuk-label">Date Of Birth</label>
                <div>
                    @if (E("Case.BirthDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @E("Case.BirthDate")</p> }
                    <div class="bse-vla-help-inline">
                        <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                            <input asp-for="Case.BirthDate" id="Case_BirthDate" type="text" class="govuk-input vla-legacy-input moj-js-datepicker-input @(E("Case.BirthDate") is not null ? "govuk-input--error" : "")" autocomplete="off" placeholder="dd/mm/yyyy" value="@DateDisplay("Case.BirthDate", Model.Case.BirthDate)" />
                        </div>
                        <span id="birth-date-star" class="bse-vla-star-red" hidden="@(E("Case.BirthDate") is null)" title="@(E("Case.BirthDate") ?? "Please enter a valid date")">*</span>
                        <span id="vla-inform-defra-star" class="bse-vla-star-green" hidden="@(!showInformDefraWarning)" title="DEFRA may need informing if you change the Date Of Birth">*</span>
                    </div>
                </div>
            </div>
            <div class="vla-legacy-field @(E("Case.Sex") is not null ? "govuk-form-group--error" : "")">
                <label for="Case_Sex" class="govuk-label">Sex</label>
                <div>
                    @if (E("Case.Sex") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @E("Case.Sex")</p> }
                    <select asp-for="Case.Sex" id="Case_Sex" class="govuk-select vla-legacy-input @(E("Case.Sex") is not null ? "govuk-select--error" : "")">
                        <option value="">-- Select --</option>
                        @foreach (var o in Model.SexOptions)
                        {
                            <option value="@o.Code" selected="@IsSelected(o.Code, Model.Case.Sex)">@o.Description</option>
                        }
                    </select>
                </div>
            </div>

            <div class="vla-legacy-field @(E("Case.BirthDateSource") is not null ? "govuk-form-group--error" : "")">
                <label for="Case_BirthDateSource" class="govuk-label">Date Of Birth Source</label>
                <div>
                    @if (E("Case.BirthDateSource") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @E("Case.BirthDateSource")</p> }
                    <select asp-for="Case.BirthDateSource" id="Case_BirthDateSource" class="govuk-select vla-legacy-input @(E("Case.BirthDateSource") is not null ? "govuk-select--error" : "")">
                        <option value="">-- Select --</option>
                        @foreach (var o in Model.BirthDateSourceOptions)
                        {
                            <option value="@o.Code" selected="@IsSelected(o.Code, Model.Case.BirthDateSource)">@o.Description</option>
                        }
                    </select>
                </div>
            </div>
            <div class="vla-legacy-field @(E("Case.Breed") is not null ? "govuk-form-group--error" : "")">
                <label for="Case_Breed" class="govuk-label">Breed</label>
                <div>
                    @if (E("Case.Breed") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @E("Case.Breed")</p> }
                    <select asp-for="Case.Breed" id="Case_Breed" class="govuk-select vla-legacy-input @(E("Case.Breed") is not null ? "govuk-select--error" : "")">
                        <option value="">-- Select --</option>
                        @foreach (var o in Model.BreedOptions)
                        {
                            <option value="@o.Code" selected="@IsSelected(o.Code, Model.Case.Breed)">@o.Description</option>
                        }
                    </select>
                </div>
            </div>

            <div class="vla-legacy-field">
                <label for="Case_IsBirthDateEst" class="govuk-label">Date Of Birth Estimated?</label>
                <div><input asp-for="Case.IsBirthDateEst" id="Case_IsBirthDateEst" type="checkbox" class="vla-legacy-checkbox" /></div>
            </div>
            <div class="vla-legacy-field @(E("Case.Origin") is not null ? "govuk-form-group--error" : "")">
                <label for="Case_Origin" class="govuk-label">Origin</label>
                <div>
                    @if (E("Case.Origin") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @E("Case.Origin")</p> }
                    <select asp-for="Case.Origin" id="Case_Origin" class="govuk-select vla-legacy-input @(E("Case.Origin") is not null ? "govuk-select--error" : "")">
                        <option value="">-- Select --</option>
                        @foreach (var o in Model.OriginOptions)
                        {
                            <option value="@o.Code" selected="@IsSelected(o.Code, Model.Case.Origin)">@o.Description</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" />

        @{
            var purchaseFieldsDisabled = Model.Case.Origin != "P";
        }
        <div id="purchase-section">
            <div class="vla-legacy-grid">
                <div class="vla-legacy-field @(E("Case.PurchaseDate") is not null ? "govuk-form-group--error" : "")">
                    <label for="Case_PurchaseDate" class="govuk-label">Date Purchased</label>
                    <div>
                        @if (E("Case.PurchaseDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @E("Case.PurchaseDate")</p> }
                        <div class="bse-vla-help-inline">
                            <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                                <input asp-for="Case.PurchaseDate" id="Case_PurchaseDate" type="text" class="govuk-input vla-legacy-input moj-js-datepicker-input @(E("Case.PurchaseDate") is not null ? "govuk-input--error" : "")" autocomplete="off" placeholder="dd/mm/yyyy" value="@DateDisplay("Case.PurchaseDate", Model.Case.PurchaseDate)" disabled="@(purchaseFieldsDisabled ? "disabled" : null)" />
                            </div>
                            <span id="purchase-date-star" class="bse-vla-star-red" hidden="@(E("Case.PurchaseDate") is null)" title="@(E("Case.PurchaseDate") ?? "Please enter a valid date")">*</span>
                        </div>
                    </div>
                </div>
                <div class="vla-legacy-field">
                    <span class="govuk-label">Age Purchased</span>
                    <div class="vla-legacy-age-group vla-legacy-age-group--header">
                        <button type="button" id="btn-calc-age-purchased" class="govuk-button govuk-button--secondary vla-legacy-calc-button" disabled="@(purchaseFieldsDisabled ? "disabled" : null)">Calculate</button>
                    </div>
                </div>

                <div class="vla-legacy-field @(E("Case.PurchasedCounty") is not null ? "govuk-form-group--error" : "")">
                    <label for="Case_PurchasedCounty" class="govuk-label">Purchased County</label>
                    <div>
                        @if (E("Case.PurchasedCounty") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @E("Case.PurchasedCounty")</p> }
                        <select asp-for="Case.PurchasedCounty" id="Case_PurchasedCounty" class="govuk-select vla-legacy-input @(E("Case.PurchasedCounty") is not null ? "govuk-select--error" : "")" disabled="@(purchaseFieldsDisabled ? "disabled" : null)">
                            <option value="">-- Select --</option>
                            @foreach (var o in Model.PurchasedCountyOptions)
                            {
                                <option value="@o.Code" selected="@IsSelected(o.Code, Model.Case.PurchasedCounty)">@o.Description</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="vla-legacy-field @(E("Case.PurchaseAgeInMonths") is not null ? "govuk-form-group--error" : "")">
                    <label class="govuk-label" for="age-purchased-years">Years:</label>
                    <div class="vla-legacy-age-group">
                        @if (E("Case.PurchaseAgeInMonths") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @E("Case.PurchaseAgeInMonths")</p> }
                        <div class="vla-legacy-inline-parts">
                            <input class="govuk-input vla-legacy-mini-input" id="age-purchased-years" type="number" min="0" max="99" disabled="@(purchaseFieldsDisabled ? "disabled" : null)" />
                            <label class="govuk-label" for="Case_PurchaseAgeInMonths">Months:</label>
                            <input asp-for="Case.PurchaseAgeInMonths" id="Case_PurchaseAgeInMonths" class="govuk-input vla-legacy-mini-input @(E("Case.PurchaseAgeInMonths") is not null ? "govuk-input--error" : "")" type="number" min="0" disabled="@(purchaseFieldsDisabled ? "disabled" : null)" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" />

        <div class="vla-legacy-grid">
            <div class="vla-legacy-field @(E("Case.HerdEntryDate") is not null ? "govuk-form-group--error" : "")">
                <label for="Case_HerdEntryDate" class="govuk-label">Herd Entry Date</label>
                <div>
                    @if (E("Case.HerdEntryDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @E("Case.HerdEntryDate")</p> }
                    <div class="bse-vla-help-inline">
                        <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                            <input asp-for="Case.HerdEntryDate" id="Case_HerdEntryDate" type="text" class="govuk-input vla-legacy-input moj-js-datepicker-input @(E("Case.HerdEntryDate") is not null ? "govuk-input--error" : "")" autocomplete="off" placeholder="dd/mm/yyyy" value="@DateDisplay("Case.HerdEntryDate", Model.Case.HerdEntryDate)" />
                        </div>
                        <span id="herd-entry-date-star" class="bse-vla-star-red" hidden="@(E("Case.HerdEntryDate") is null)" title="@(E("Case.HerdEntryDate") ?? "Please enter a valid date")">*</span>
                        <span id="vla-herd-date-warning-star" class="bse-vla-star-green" hidden title="Are you sure the Herd Entry is less than 18 months after the Date of Birth">*</span>
                    </div>
                </div>
            </div>
            <div class="vla-legacy-field @(E("Case.OnsetDate") is not null ? "govuk-form-group--error" : "")">
                <label for="Case_OnsetDate" class="govuk-label">Onset Date</label>
                <div>
                    @if (E("Case.OnsetDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @E("Case.OnsetDate")</p> }
                    <div class="bse-vla-help-inline">
                        <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                            <input asp-for="Case.OnsetDate" id="Case_OnsetDate" type="text" class="govuk-input vla-legacy-input moj-js-datepicker-input @(E("Case.OnsetDate") is not null ? "govuk-input--error" : "")" autocomplete="off" placeholder="dd/mm/yyyy" value="@DateDisplay("Case.OnsetDate", Model.Case.OnsetDate)" />
                        </div>
                        <span id="onset-date-star" class="bse-vla-star-red" hidden="@(E("Case.OnsetDate") is null)" title="@(E("Case.OnsetDate") ?? "Please enter a valid date")">*</span>
                        <span id="vla-onset-date-warning-star" class="bse-vla-star-green" hidden title="Are you sure that the onset date was more than 3 months before the Form A Date?">*</span>
                    </div>
                </div>
            </div>

            <div class="vla-legacy-field">
                <label for="Case_IsOnsetDateEst" class="govuk-label">Onset Date Estimated?</label>
                <div><input asp-for="Case.IsOnsetDateEst" id="Case_IsOnsetDateEst" type="checkbox" class="vla-legacy-checkbox" /></div>
            </div>
            <div class="vla-legacy-field @(E("Case.MonthsPregnant") is not null ? "govuk-form-group--error" : "")">
                <label for="Case_MonthsPregnant" class="govuk-label">Months Pregnant</label>
                <div>
                    @if (E("Case.MonthsPregnant") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @E("Case.MonthsPregnant")</p> }
                    <div class="bse-vla-help-inline">
                        <input asp-for="Case.MonthsPregnant" id="Case_MonthsPregnant" type="number" class="govuk-input vla-legacy-input @(E("Case.MonthsPregnant") is not null ? "govuk-input--error" : "")" min="1" max="9" />
                        <span id="months-pregnant-star" class="bse-vla-star-red" hidden title="This must be a value between 1 and 9">*</span>
                    </div>
                </div>
            </div>

            <div class="vla-legacy-field @(E("Case.MonthsPostCalving") is not null ? "govuk-form-group--error" : "")">
                <label for="Case_MonthsPostCalving" class="govuk-label">Months Post Calving</label>
                <div>
                    @if (E("Case.MonthsPostCalving") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @E("Case.MonthsPostCalving")</p> }
                    <div class="bse-vla-help-inline">
                        <input asp-for="Case.MonthsPostCalving" id="Case_MonthsPostCalving" type="number" class="govuk-input vla-legacy-input @(E("Case.MonthsPostCalving") is not null ? "govuk-input--error" : "")" min="1" max="3" />
                        <span id="months-post-calving-star" class="bse-vla-star-red" hidden title="This must be a value between 1 and 3">*</span>
                        <span id="months-pregnant-error-star" class="bse-vla-star-red" hidden title="You cannot enter a value for Month's Post Calving and Months Pregnant">*</span>
                    </div>
                </div>
            </div>
            <div class="vla-legacy-field">
                <label class="govuk-label">Onset Age</label>
                <div class="vla-legacy-age-group vla-legacy-age-group--header">
                    <div class="bse-vla-help-inline">
                        <button type="button" id="btn-calc-onset-age" class="govuk-button govuk-button--secondary vla-legacy-calc-button">Calculate</button>
                        <span id="vla-onset-age-warning-star" class="bse-vla-star-green" hidden title="Are you sure that the onset age is less than 18 months?">*</span>
                    </div>
                </div>
            </div>

            <div class="vla-legacy-field @(E("Case.SlaughterDate") is not null ? "govuk-form-group--error" : "")">
                <label for="Case_SlaughterDate" class="govuk-label">Slaughter Date</label>
                <div>
                    @if (E("Case.SlaughterDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @E("Case.SlaughterDate")</p> }
                    <p id="slaughter-date-error-message" class="govuk-error-message" hidden><span class="govuk-visually-hidden">Error:</span> <span id="slaughter-date-error-text"></span></p>
                    <div class="bse-vla-help-inline">
                        <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                            <input asp-for="Case.SlaughterDate" id="Case_SlaughterDate" type="text" class="govuk-input vla-legacy-input moj-js-datepicker-input @(E("Case.SlaughterDate") is not null ? "govuk-input--error" : "")" autocomplete="off" placeholder="dd/mm/yyyy" value="@DateVal(Model.Case.SlaughterDate)" />
                        </div>
                        <span id="slaughter-date-star" class="bse-vla-star-red" hidden title="Please enter a valid date">*</span>
                    </div>
                </div>
            </div>
            <div class="vla-legacy-field @(E("Case.OnsetAgeInMonths") is not null ? "govuk-form-group--error" : "")">
                <label class="govuk-label" for="onset-age-years">Years:</label>
                <div class="vla-legacy-age-group">
                    @if (E("Case.OnsetAgeInMonths") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @E("Case.OnsetAgeInMonths")</p> }
                    <div class="vla-legacy-inline-parts">
                        <input class="govuk-input vla-legacy-mini-input" id="onset-age-years" type="number" min="0" max="99" />
                        <label class="govuk-label" for="Case_OnsetAgeInMonths">Months:</label>
                        <input asp-for="Case.OnsetAgeInMonths" id="Case_OnsetAgeInMonths" class="govuk-input vla-legacy-mini-input @(E("Case.OnsetAgeInMonths") is not null ? "govuk-input--error" : "")" type="number" min="0" />
                    </div>
                </div>
            </div>
        </div>

        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" />

        <h2 class="govuk-heading-m">Previous owners</h2>
        <table class="govuk-table">
            <caption class="govuk-visually-hidden">Previous owners for @BseFormat.FormatRbse(Model.Case.Rbse)</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header" aria-sort="@OwnersSortAria("type")">
                        <a class="govuk-link govuk-link--no-visited-state" href="@Model.OwnersSortUrl("type")">Owner type</a>
                    </th>
                    <th scope="col" class="govuk-table__header" aria-sort="@OwnersSortAria("name")">
                        <a class="govuk-link govuk-link--no-visited-state" href="@Model.OwnersSortUrl("name")">Name</a>
                    </th>
                    <th scope="col" class="govuk-table__header" aria-sort="@OwnersSortAria("cphh")">
                        <a class="govuk-link govuk-link--no-visited-state" href="@Model.OwnersSortUrl("cphh")">CPHH</a>
                    </th>
                    @if (Model.CanEditMainCase)
                    {
                        <th scope="col" class="govuk-table__header">Action</th>
                    }
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @if (!Model.OtherOwners.Any())
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell" colspan="@(Model.CanEditMainCase ? 4 : 3)">No owner records.</td>
                    </tr>
                }

                @foreach (var o in Model.OtherOwners)
                {
                    var editing = Model.CanEditMainCase && Model.ReopenEditOwnerId == o.Id;
                    var ownerEditKey = $"owner-{o.Id}";
                    <tr class="govuk-table__row">
                        @if (editing)
                        {
                            <td class="govuk-table__cell">
                                <label class="govuk-label" for="EditOwnerType_@ownerEditKey">Owner type</label>
                                <select id="EditOwnerType_@ownerEditKey" name="EditOwnerType" class="govuk-select govuk-!-width-one-half">
                                    <option value="">-- Select --</option>
                                    @foreach (var t in Model.OwnerTypeOptions)
                                    {
                                        <option value="@t.Code" selected="@VlaModel.SelectedIfMatches(Model.EditOwnerType, t.Code)">@t.Description</option>
                                    }
                                </select>
                                @if (E("EditOwnerType") is not null)
                                {
                                    <span class="bse-vla-star-red" title="@E("EditOwnerType")">*</span>
                                }
                            </td>
                            <td class="govuk-table__cell">
                                <label class="govuk-label" for="EditOwnerName_@ownerEditKey">Owner name</label>
                                <input id="EditOwnerName_@ownerEditKey" name="EditOwnerName" class="govuk-input govuk-!-width-two-thirds" maxlength="255" value="@Model.EditOwnerName" />
                                @if (E("EditOwnerName") is not null)
                                {
                                    <span class="bse-vla-star-red" title="@E("EditOwnerName")">*</span>
                                }
                            </td>
                            <td class="govuk-table__cell">
                                <label class="govuk-label" for="EditOwnerCphh_@ownerEditKey">CPHH</label>
                                <input id="EditOwnerCphh_@ownerEditKey" name="EditOwnerCphh" class="govuk-input vla-owner-cphh-input" maxlength="14" value="@Model.EditOwnerCphh" autocomplete="off"
                                       title="CPHH Format: NN[/]NNN[/]NNNN[/NN]" spellcheck="false" autocapitalize="off" />
                            </td>
                            <td class="govuk-table__cell">
                                <input type="hidden" name="EditingOwnerId" value="@o.Id" />
                                <input type="hidden" name="EditOwnerRowStampBase64" value="@(o.RowStamp is not null ? Convert.ToBase64String(o.RowStamp) : "")" />
                                <div class="govuk-button-group bse-row-actions govuk-!-margin-bottom-0">
                                    <button type="submit" asp-page-handler="UpdateOwnerRow" formnovalidate class="bse-inline-row-button bse-inline-row-button--confirm">Confirm</button>
                                    <button type="button" class="bse-inline-row-button bse-inline-row-button--secondary js-cancel-edit-owner-row">Cancel</button>
                                </div>
                            </td>
                        }
                        else
                        {
                            <td class="govuk-table__cell">@(Model.OwnerTypeOptions.FirstOrDefault(t => t.Code == o.Type)?.Description ?? o.Type)</td>
                            <td class="govuk-table__cell">@(o.Name ?? "—")</td>
                            <td class="govuk-table__cell">@BseFormat.FormatCphh(o.Cphh)</td>
                            @if (Model.CanEditMainCase)
                            {
                                <td class="govuk-table__cell">
                                    <div class="govuk-button-group bse-row-actions govuk-!-margin-bottom-0">
                                        <button type="submit" asp-page-handler="BeginEditOwnerRow" asp-route-ownerId="@o.Id" formnovalidate class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">Change</button>
                                        <button type="submit" asp-page-handler="DeleteOwner" asp-route-ownerId="@o.Id" asp-route-rowStampBase64="@(Convert.ToBase64String(o.RowStamp ?? []))" formnovalidate class="govuk-button govuk-button--warning govuk-!-margin-bottom-0" onclick="return confirm('Delete this owner record?')">Delete</button>
                                    </div>
                                </td>
                            }
                        }
                    </tr>
                }

                <tr id="add-owner-row-inline" class="govuk-table__row bse-herd-row--unsaved" hidden="@(!Model.CanEditMainCase || !Model.ShowAddOwnerRow)">
                    <td class="govuk-table__cell">
                        <label class="govuk-label" for="NewOwnerType">Owner type</label>
                        <select id="NewOwnerType" name="NewOwnerType" class="govuk-select govuk-!-width-one-half">
                            <option value="">-- Select --</option>
                            @foreach (var t in Model.OwnerTypeOptions)
                            {
                                <option value="@t.Code" selected="@VlaModel.SelectedIfMatches(Model.NewOwnerType, t.Code)">@t.Description</option>
                            }
                        </select>
                        @if (E("NewOwnerType") is not null)
                        {
                            <span class="bse-vla-star-red" title="@E("NewOwnerType")">*</span>
                        }
                    </td>
                    <td class="govuk-table__cell">
                        <label class="govuk-label" for="NewOwnerName">Owner name</label>
                        <input id="NewOwnerName" name="NewOwnerName" class="govuk-input govuk-!-width-two-thirds" maxlength="255" value="@Model.NewOwnerName" />
                        @if (E("NewOwnerName") is not null)
                        {
                            <span class="bse-vla-star-red" title="@E("NewOwnerName")">*</span>
                        }
                    </td>
                    <td class="govuk-table__cell">
                        <label class="govuk-label" for="NewOwnerCphh">CPHH</label>
                        <input id="NewOwnerCphh" name="NewOwnerCphh" class="govuk-input vla-owner-cphh-input" maxlength="14" value="@Model.NewOwnerCphh" autocomplete="off"
                               title="CPHH Format: NN[/]NNN[/]NNNN[/NN]" spellcheck="false" autocapitalize="off" />
                    </td>
                    <td class="govuk-table__cell">
                        <div class="govuk-button-group bse-row-actions govuk-!-margin-bottom-0">
                            <button type="submit" asp-page-handler="AddOwnerRow" formnovalidate class="bse-inline-row-button bse-inline-row-button--confirm">Confirm</button>
                            <button type="button" id="cancel-add-owner-row" class="bse-inline-row-button bse-inline-row-button--secondary">Cancel</button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>

        @await Html.PartialAsync("_Pagination", null, new ViewDataDictionary(ViewData) { ["CurrentPage"] = Model.OPage, ["TotalPages"] = Model.OtherOwnersTotalPages, ["PageNumberKey"] = "OPage" })

        @if (Model.CanEditMainCase)
        {
            <div class="govuk-button-group govuk-!-margin-bottom-4">
                <button type="button" id="show-add-owner-row" class="govuk-button govuk-button--secondary" data-module="govuk-button">Add previous owner</button>
            </div>
        }
        </fieldset>

        <div class="bse-case-bottom-row">
            <div class="govuk-button-group bse-case-bottom-row__left">
                <a asp-page="/AuditLog/ByCase" asp-route-rbse="@Model.Case.Rbse" asp-route-returnTo="/Case/Vla" draggable="false" class="govuk-button govuk-button--secondary" data-module="govuk-button">Case audit log</a>
            </div>

            <div class="bse-case-bottom-row__right">
                <div class="govuk-button-group bse-case-bottom-row__actions">
                    @if (!string.IsNullOrWhiteSpace(viewDocsUrl))
                    {
                        <a href="@viewDocsUrl" target="_blank" rel="noopener noreferrer" draggable="false" class="govuk-button govuk-button--secondary" data-module="govuk-button">
                            View docs<span class="govuk-visually-hidden"> (opens in new tab)</span>
                        </a>
                    }
                    @if (Model.CanEditMainCase)
                    {
                        <button type="submit" class="govuk-button" data-module="govuk-button">Save</button>
                        <a asp-page="/Case/Vla" asp-page-handler="CancelVlaEdit" asp-route-rbse="@Model.Rbse" draggable="false" class="govuk-button govuk-button--secondary bse-cancel-link" data-module="govuk-button">Cancel</a>
                    }
                </div>
            </div>
        </div>
</form>

<style>
    .bse-form-fieldset-reset {
        border: 0;
        margin: 0;
        padding: 0;
        min-width: 0;
    }

    .bse-case-bottom-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

    .bse-case-bottom-row__left,
    .bse-case-bottom-row__right {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin: 0;
    }

    .bse-case-bottom-row__right {
        gap: 20px;
        margin-left: auto;
    }

    .bse-case-bottom-row__actions {
        margin: 0;
    }

    .vla-legacy-grid {
        display: grid;
        grid-template-columns: 500px 500px;
        column-gap: 72px;
        row-gap: 12px;
        align-items: start;
        margin-bottom: 12px;
    }

    .vla-legacy-field {
        display: grid;
        grid-template-columns: 235px 252px;
        column-gap: 10px;
        align-items: center;
    }

    .vla-legacy-field .govuk-label {
        margin-bottom: 0;
        font-weight: 400;
        font-size: 19px;
        line-height: 1.25;
        white-space: nowrap;
    }

    .vla-legacy-input,
    .moj-datepicker__wrapper {
        width: 252px;
        max-width: 252px;
        margin-bottom: 0;
    }

    .vla-legacy-checkbox {
        width: 1.2rem;
        height: 1.2rem;
        margin: 0;
    }

    .vla-legacy-age-group {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        width: 252px;
    }

    .vla-legacy-inline-parts {
        display: grid;
        grid-template-columns: auto 64px auto 64px;
        align-items: center;
        column-gap: 10px;
        flex-wrap: nowrap;
    }

    .vla-legacy-calc-button {
        margin-bottom: 8px;
        min-height: 36px;
        padding: 4px 12px;
    }

    .vla-legacy-inline-parts .govuk-label {
        min-width: auto;
    }

    .vla-legacy-mini-input {
        width: 64px;
        max-width: 64px;
        margin-bottom: 0;
    }

    .vla-owner-cphh-input {
        width: 12rem;
        max-width: 12rem;
        margin-bottom: 0;
    }

    .bse-herd-row--unsaved { background: #fffbf2; }

    .bse-row-actions {
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: 8px;
    }

    .bse-inline-row-button {
        border: 1px solid #0b0c0c;
        background: #fff;
        color: #0b0c0c;
        padding: 4px 8px;
        min-height: 36px;
        font-size: 1rem;
        line-height: 1.1;
        cursor: pointer;
    }

    .bse-inline-row-button:hover { background: #f3f2f1; }
    .bse-inline-row-button:focus {
        outline: 3px solid #ffdd00;
        outline-offset: 0;
    }
    .bse-inline-row-button--secondary { border-color: #505a5f; }
    .bse-inline-row-button--confirm {
        background: #00703c;
        border-color: #00703c;
        color: #fff;
    }
    .bse-inline-row-button--confirm:hover {
        background: #005a30;
        border-color: #005a30;
    }

    .bse-vla-help-inline {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        position: relative;
    }

    @@media (max-width: 768px) {
        .vla-legacy-grid {
            grid-template-columns: 1fr;
            gap: 0.75rem;
        }

        .vla-legacy-field {
            grid-template-columns: 1fr;
            align-items: start;
        }

        .vla-legacy-inline-parts {
            flex-wrap: wrap;
        }
    }

    .bse-vla-star-red {
        color: #FF0000;
        font-weight: 700;
        font-size: 1.8rem;
        line-height: 1;
    }

    .bse-vla-star-green {
        color: #00703c;
        font-weight: 700;
        font-size: 1.8rem;
        line-height: 1;
    }
</style>

<script>
    (function () {
        var originSel = document.getElementById('Case_Origin');
        var purchaseSection = document.getElementById('purchase-section');
        var hasTracedBabDataOnLoad = @Html.Raw(Model.HasTracedBabData ? "true" : "false");
        var hadPurchasedOriginOnLoad = originSel ? originSel.value === 'P' : false;

        function hasPurchaseData() {
            var d = document.getElementById('Case_PurchaseDate');
            var m = document.getElementById('Case_PurchaseAgeInMonths');
            var y = document.getElementById('age-purchased-years');
            var c = document.getElementById('Case_PurchasedCounty');
            return (d && d.value) || (m && m.value) || (y && y.value) || (c && c.value);
        }

        function clearPurchaseData() {
            ['Case_PurchaseDate', 'Case_PurchaseAgeInMonths', 'age-purchased-years'].forEach(function (id) {
                var el = document.getElementById(id); if (el) el.value = '';
            });
            var c = document.getElementById('Case_PurchasedCounty');
            if (c) c.value = '';
        }

        function applyPurchaseVisibility() {
            if (!purchaseSection || !originSel) return;
            var isPurchased = originSel.value === 'P';
            var purchaseControlIds = ['Case_PurchaseDate', 'btn-calc-age-purchased', 'Case_PurchasedCounty', 'age-purchased-years', 'Case_PurchaseAgeInMonths'];
            purchaseControlIds.forEach(function (id) {
                var el = document.getElementById(id);
                if (el) el.disabled = !isPurchased;
            });
        }

        if (originSel) {
            originSel.addEventListener('change', function () {
                if (originSel.value !== 'P') {
                    clearPurchaseData();
                }
                applyPurchaseVisibility();
            });
        }
        applyPurchaseVisibility();

        var sexSel = document.getElementById('Case_Sex');
        var monthsPregnantEl = document.getElementById('Case_MonthsPregnant');
        var monthsPostCalvingEl = document.getElementById('Case_MonthsPostCalving');

        function applyPregnancyFieldAvailability() {
            if (!sexSel) return;
            var isFemale = sexSel.value === 'F';
            if (monthsPregnantEl) {
                monthsPregnantEl.disabled = !isFemale;
                if (!isFemale) monthsPregnantEl.value = '';
            }
            if (monthsPostCalvingEl) {
                monthsPostCalvingEl.disabled = !isFemale;
                if (!isFemale) monthsPostCalvingEl.value = '';
            }
            updateMonthsPregnantIndicators();
        }

        if (sexSel) {
            sexSel.addEventListener('change', applyPregnancyFieldAvailability);
        }

        function parseUkDate(value) {
            var text = (value || '').trim();
            if (!text) return null;

            var parts = text.split('/');
            if (parts.length === 3) {
                // Require a 4-digit year (matching the dd/mm/yyyy datepicker format) so that
                // incomplete/truncated years (e.g. "202") aren't silently accepted as valid dates.
                if (!/^\d{4}$/.test(parts[2])) return null;
                var day = parseInt(parts[0], 10);
                var month = parseInt(parts[1], 10);
                var year = parseInt(parts[2], 10);
                if (!day || !month || !year) return null;
                var ukDate = new Date(year, month - 1, day);
                if (ukDate.getFullYear() !== year || ukDate.getMonth() !== month - 1 || ukDate.getDate() !== day) return null;
                return ukDate;
            }

            return null;
        }

        // -- Instant range-validation red asterisk,
        //    *DateValid() functions which call CalendarDate.ascx's Validate(dDate, earliest, latest, message)
        //    overloads on AutoPostBack, setting the field-specific business-rule message as the tooltip. --
        function getBirthDate() {
            return parseUkDate((document.getElementById('Case_BirthDate') || {}).value);
        }
        function getFormADateOrNow() {
            var formADate = parseUkDate((document.getElementById('Case_FormADate') || {}).value);
            if (formADate) return formADate;
            var now = new Date();
            return new Date(now.getFullYear(), now.getMonth(), now.getDate());
        }

        function checkDateStar(inputId, starId, rangeCheck, invalidMessage) {
            var input = document.getElementById(inputId);
            var star = document.getElementById(starId);
            if (!input || !star) return;
            var value = input.value.trim();
            if (value === '') {
                star.hidden = true;
                return;
            }
            var date = parseUkDate(value);
            if (!date) {
                star.title = invalidMessage;
                star.hidden = false;
                return;
            }
            var message = rangeCheck ? rangeCheck(date) : null;
            if (message) {
                star.title = message;
                star.hidden = false;
            } else {
                star.title = invalidMessage;
                star.hidden = true;
            }
        }

        function birthDateRangeCheck(date) {
            var earliest = new Date(1970, 0, 1);
            var latest = getFormADateOrNow();
            if (date < earliest || date > latest) {
                return 'Birth Date must be after 31/12/1969 and before the Form A Date';
            }
            return null;
        }

        function purchaseDateRangeCheck(date) {
            var birthDate = getBirthDate();
            if (!birthDate) return null;
            var latest = getFormADateOrNow();
            if (date < birthDate || date > latest) {
                return 'Purchase Date must be after the birth date and before the Form A Date';
            }
            return null;
        }

        function herdEntryDateRangeCheck(date) {
            var birthDate = getBirthDate();
            if (!birthDate) return null;
            var latest = getFormADateOrNow();
            if (date > latest) {
                return 'The Herd Entry Date must be before the Form A Date.';
            }
            return null;
        }

        function onsetDateRangeCheck(date) {
            var birthDate = getBirthDate();
            var latest = getFormADateOrNow();
            if (birthDate) {
                if (date < birthDate || date > latest) {
                    return 'Onset Date must be after the Date Of Birth and before the Form A Date';
                }
                return null;
            }
            if (date > latest) {
                return 'Onset Date must be before the Form A Date';
            }
            return null;
        }

        function slaughterDateRangeCheck(date) {
            var today = new Date();
            today.setHours(0, 0, 0, 0);
            if (date > today) {
                return 'Slaughter date must not be in the future.';
            }
            var formADate = parseUkDate((document.getElementById('Case_FormADate') || {}).value);
            if (formADate) {
                if (date < formADate) {
                    return 'Slaughter date must be after the Form A date.';
                }
                return null;
            }
            var birthDate = getBirthDate();
            if (birthDate && date < birthDate) {
                return 'Slaughter date must be after the birth date.';
            }
            return null;
        }

        function updateSlaughterDateMessage() {
            var input = document.getElementById('Case_SlaughterDate');
            var messageBox = document.getElementById('slaughter-date-error-message');
            var messageText = document.getElementById('slaughter-date-error-text');
            if (!input || !messageBox || !messageText) return;
            var value = input.value.trim();
            var message = null;
            if (value !== '') {
                var date = parseUkDate(value);
                message = date ? slaughterDateRangeCheck(date) : 'Please enter a valid date';
            }
            messageText.textContent = message || '';
            messageBox.hidden = !message;
            input.classList.toggle('govuk-input--error', !!message);
        }

        var vlaDateStarFields = [
            ['Case_BirthDate', 'birth-date-star', birthDateRangeCheck, 'Please enter a valid date'],
            ['Case_PurchaseDate', 'purchase-date-star', purchaseDateRangeCheck, 'Please enter a valid date'],
            ['Case_HerdEntryDate', 'herd-entry-date-star', herdEntryDateRangeCheck, 'Please enter a valid date'],
            ['Case_OnsetDate', 'onset-date-star', onsetDateRangeCheck, 'Please enter a valid date'],
            ['Case_SlaughterDate', 'slaughter-date-star', slaughterDateRangeCheck, 'Please enter a valid date']
        ];

        function refreshAllVlaDateStars() {
            vlaDateStarFields.forEach(function (entry) {
                checkDateStar(entry[0], entry[1], entry[2], entry[3]);
            });
            updateSlaughterDateMessage();
        }

        vlaDateStarFields.forEach(function (pair) {
            var input = document.getElementById(pair[0]);
            if (!input) return;
            var check = function () { checkDateStar(pair[0], pair[1], pair[2], pair[3]); };
            input.addEventListener('blur', check);
            input.addEventListener('change', check);
            check();
        });
        updateSlaughterDateMessage();

        // Birth Date and Form A Date affect other fields' range bounds, so re-validate all on change.
        ['Case_BirthDate', 'Case_FormADate'].forEach(function (id) {
            var input = document.getElementById(id);
            if (!input) return;
            input.addEventListener('blur', refreshAllVlaDateStars);
            input.addEventListener('change', refreshAllVlaDateStars);
        });

        document.getElementById('Case_SlaughterDate')?.addEventListener('blur', updateSlaughterDateMessage);
        document.getElementById('Case_SlaughterDate')?.addEventListener('change', updateSlaughterDateMessage);

        function addMonthsSafe(sourceDate, monthsToAdd) {
            var year = sourceDate.getFullYear();
            var month = sourceDate.getMonth() + monthsToAdd;
            var day = sourceDate.getDate();
            var firstDay = new Date(year, month, 1);
            var lastDayOfTargetMonth = new Date(firstDay.getFullYear(), firstDay.getMonth() + 1, 0).getDate();
            return new Date(firstDay.getFullYear(), firstDay.getMonth(), Math.min(day, lastDayOfTargetMonth));
        }

        function setWarningVisibility(starId, shouldShow) {
            var star = document.getElementById(starId);
            if (star) {
                star.hidden = !shouldShow;
            }
        }

        function updateDateWarningIndicators() {
            var birthDate = parseUkDate(document.getElementById('Case_BirthDate')?.value);
            var herdEntryDate = parseUkDate(document.getElementById('Case_HerdEntryDate')?.value);
            var onsetDate = parseUkDate(document.getElementById('Case_OnsetDate')?.value);
            var formADate = parseUkDate(document.getElementById('Case_FormADate')?.value);

            var showHerdWarning = !!(birthDate && herdEntryDate && herdEntryDate < addMonthsSafe(birthDate, 18));
            var showOnsetWarning = !!(onsetDate && formADate && onsetDate < addMonthsSafe(formADate, -3));

            setWarningVisibility('vla-herd-date-warning-star', herdWarningArmed && showHerdWarning);
            setWarningVisibility('vla-onset-date-warning-star', onsetWarningArmed && showOnsetWarning);
        }

        function clearDateWarningIndicators() {
            setWarningVisibility('vla-herd-date-warning-star', false);
            setWarningVisibility('vla-onset-date-warning-star', false);
        }

        function completeMonthsBetween(fromDate, toDate) {
            var months = (toDate.getFullYear() - fromDate.getFullYear()) * 12 + (toDate.getMonth() - fromDate.getMonth());
            if (toDate.getDate() < fromDate.getDate()) months -= 1;
            return Math.max(0, months);
        }

        function updateOnsetWarning() {
            var total = parseInt(document.getElementById('Case_OnsetAgeInMonths')?.value || '', 10);
            setWarningVisibility('vla-onset-age-warning-star', onsetAgeWarningArmed && !isNaN(total) && total < 18);
        }

        function updateMonthsPregnantIndicators() {
            var pregnantEl = document.getElementById('Case_MonthsPregnant');
            var postCalvingEl = document.getElementById('Case_MonthsPostCalving');
            var pregnantStar = document.getElementById('months-pregnant-star');
            var postCalvingStar = document.getElementById('months-post-calving-star');
            var mutualExclusivityStar = document.getElementById('months-pregnant-error-star');

            var pregnantValue = parseInt(pregnantEl?.value || '', 10);
            var postCalvingValue = parseInt(postCalvingEl?.value || '', 10);
            var hasPregnant = !isNaN(pregnantValue) && pregnantEl.value.trim() !== '';
            var hasPostCalving = !isNaN(postCalvingValue) && postCalvingEl.value.trim() !== '';

            if (pregnantStar) pregnantStar.hidden = !(hasPregnant && (pregnantValue < 1 || pregnantValue > 9));
            if (postCalvingStar) postCalvingStar.hidden = !(hasPostCalving && (postCalvingValue < 1 || postCalvingValue > 3));
            if (mutualExclusivityStar) mutualExclusivityStar.hidden = !(hasPregnant && hasPostCalving);
        }

        function calendarMonthsBetween(fromDate, toDate) {
            return (toDate.getFullYear() - fromDate.getFullYear()) * 12 + (toDate.getMonth() - fromDate.getMonth());
        }

        function calculatePurchasedAge() {
            var birth = parseUkDate(document.getElementById('Case_BirthDate')?.value);
            var purchase = parseUkDate(document.getElementById('Case_PurchaseDate')?.value);
            var yearsEl = document.getElementById('age-purchased-years');
            var totalEl = document.getElementById('Case_PurchaseAgeInMonths');
            if (!totalEl) return;

            if (birth && purchase) {
                // Mirrors legacy CalculateAgePurchased: plain DateDiff(Month, ...) with
                // no day-of-month adjustment (unlike CalculateOnsetAge, which does adjust).
                totalEl.value = calendarMonthsBetween(birth, purchase);
                if (yearsEl) yearsEl.value = '';
                return;
            }

            var years = parseInt(yearsEl?.value || '0', 10);
            var months = parseInt(totalEl.value || '0', 10);
            if (!isNaN(years) && years > 0) {
                if (isNaN(months) || months < 0) months = 0;
                totalEl.value = years * 12 + months;
                yearsEl.value = '';
            }
        }

        function calculateOnsetAge() {
            var birth = parseUkDate(document.getElementById('Case_BirthDate')?.value);
            var onset = parseUkDate(document.getElementById('Case_OnsetDate')?.value);
            var yearsEl = document.getElementById('onset-age-years');
            var totalEl = document.getElementById('Case_OnsetAgeInMonths');
            if (!totalEl) return;

            if (birth && onset) {
                totalEl.value = completeMonthsBetween(birth, onset);
                if (yearsEl) yearsEl.value = '';
                onsetAgeWarningArmed = true;
                updateOnsetWarning();
                return;
            }

            var years = parseInt(yearsEl?.value || '0', 10);
            var months = parseInt(totalEl.value || '0', 10);
            if (!isNaN(years) && years > 0) {
                if (isNaN(months) || months < 0) months = 0;
                totalEl.value = years * 12 + months;
                yearsEl.value = '';
            }

            onsetAgeWarningArmed = true;
            updateOnsetWarning();
        }

        document.getElementById('btn-calc-age-purchased')?.addEventListener('click', calculatePurchasedAge);
        document.getElementById('btn-calc-onset-age')?.addEventListener('click', calculateOnsetAge);

        // Mirrors legacy: Age Purchased / Onset Age recalculate automatically whenever
        // Date of Birth, Purchase Date, or Onset Date change (not only on button click).
        ['Case_BirthDate', 'Case_PurchaseDate'].forEach(function (id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.addEventListener('change', calculatePurchasedAge);
            el.addEventListener('input', calculatePurchasedAge);
        });

        ['Case_BirthDate', 'Case_OnsetDate'].forEach(function (id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.addEventListener('change', calculateOnsetAge);
            el.addEventListener('input', calculateOnsetAge);
        });

        var herdWarningArmed = @(showHerdDateWarning ? "true" : "false");
        var onsetWarningArmed = @(showOnsetDateWarning ? "true" : "false");

        ['Case_BirthDate', 'Case_HerdEntryDate'].forEach(function (id) {
            var el = document.getElementById(id);
            if (!el) return;
            var armAndUpdate = function () {
                herdWarningArmed = true;
                updateDateWarningIndicators();
            };
            el.addEventListener('change', armAndUpdate);
            el.addEventListener('input', armAndUpdate);
        });

        ['Case_OnsetDate', 'Case_FormADate'].forEach(function (id) {
            var el = document.getElementById(id);
            if (!el) return;
            var armAndUpdate = function () {
                onsetWarningArmed = true;
                updateDateWarningIndicators();
            };
            el.addEventListener('change', armAndUpdate);
            el.addEventListener('input', armAndUpdate);
        });

        var onsetAgeWarningArmed = false;
        document.getElementById('Case_OnsetAgeInMonths')?.addEventListener('change', function () { onsetAgeWarningArmed = true; updateOnsetWarning(); });
        document.getElementById('Case_OnsetAgeInMonths')?.addEventListener('input', function () { onsetAgeWarningArmed = true; updateOnsetWarning(); });

        ['Case_MonthsPregnant', 'Case_MonthsPostCalving'].forEach(function (id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.addEventListener('blur', updateMonthsPregnantIndicators);
            el.addEventListener('change', updateMonthsPregnantIndicators);
            el.addEventListener('input', updateMonthsPregnantIndicators);
        });

        updateDateWarningIndicators();
        updateOnsetWarning();
        applyPregnancyFieldAvailability();

        var showAddOwnerBtn = document.getElementById('show-add-owner-row');
        var addOwnerRow = document.getElementById('add-owner-row-inline');
        var cancelAddOwnerBtn = document.getElementById('cancel-add-owner-row');

        if (showAddOwnerBtn && addOwnerRow) {
            showAddOwnerBtn.addEventListener('click', function () {
                addOwnerRow.hidden = false;
                showAddOwnerBtn.hidden = true;
                var firstInput = addOwnerRow.querySelector('select,input');
                if (firstInput) firstInput.focus();
            });
        }

        if (cancelAddOwnerBtn && addOwnerRow && showAddOwnerBtn) {
            cancelAddOwnerBtn.addEventListener('click', function () {
                addOwnerRow.hidden = true;
                showAddOwnerBtn.hidden = false;
                cancelAddOwnerBtn.blur();
            });
        }

        document.querySelectorAll('.js-cancel-edit-owner-row').forEach(function (btn) {
            btn.addEventListener('click', function () {
                window.location.href = window.location.pathname + window.location.search;
            });
        });

        var form = document.getElementById('edit-vla-form');
        var dirty = false;
        var submitting = false;
        if (form) {
            form.addEventListener('change', function () { dirty = true; });
            form.addEventListener('input', function () { dirty = true; });
            form.addEventListener('submit', function () {
                herdWarningArmed = false;
                onsetWarningArmed = false;
                clearDateWarningIndicators();
                submitting = true;
            });
        }

        document.querySelectorAll('.bse-cancel-link').forEach(function (lnk) {
            lnk.addEventListener('click', function (e) {
                e.preventDefault();
                var hasUnsavedHere = dirty || @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HasUnsavedOwnerChanges));
                // Legacy's dirty-check spans the whole shared session (every tab), not just this page.
                (hasUnsavedHere ? Promise.resolve(true) : (window.hasUnsavedChangesAcrossTabs ? window.hasUnsavedChangesAcrossTabs() : Promise.resolve(false)))
                    .then(function (hasUnsaved) {
                        if (!hasUnsaved || window.confirm('Are you sure you want to cancel? Any unsaved changes will be lost.')) {
                            submitting = true; // suppress the beforeunload prompt firing again on this navigation
                            window.location.href = lnk.href;
                        }
                    });
            });
        });

        window.addEventListener('beforeunload', function (e) {
            if (window.__bseCaseTabNavigationInProgress) return;
            var hasUnsaved = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HasUnsavedOwnerChanges));
            if ((dirty || hasUnsaved) && !submitting) {
                e.preventDefault();
                e.returnValue = '';
            }
        });
    })();
</script>
