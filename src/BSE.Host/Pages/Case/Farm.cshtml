@page "{rbse}"
@model BSE.Host.Pages.Case.FarmModel
@{
    ViewData["Title"] = Model.Case is null ? "Case" : $"RBSE Number: {Model.Rbse}";
}

@if (Model.Case is null)
{
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-warning-text__assistive">Warning</span>
            Case not found.
        </strong>
    </div>
    <a asp-page="/Case/Lookup" class="govuk-link">Back to case lookup</a>
    return;
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Case @Model.Rbse</li>
    </ol>
</nav>

<h1 class="govuk-heading-l">RBSE Number: <span class="bse-rbse">@BseFormat.FormatRbse(Model.Rbse)</span></h1>

@await Html.PartialAsync("_CaseTabs", new BSE.Host.Models.CaseTabsViewModel("Farm", Model.Rbse))

@* ── Notifications ────────────────────────────────────────────────────────────── *@
@if (TempData["Success"] is string successMsg)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
         aria-labelledby="farm-success-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="farm-success-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@successMsg</p>
        </div>
    </div>
}

@if (TempData["Warning"] is string warningMsg)
{
    <div class="govuk-notification-banner" role="region"
         aria-labelledby="farm-warning-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="farm-warning-title">Important</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-body">@warningMsg</p>
        </div>
    </div>
}

@if (!ViewContext.ModelState.IsValid)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var e in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@e.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

@if (Model.Farm is null)
{
    <div class="govuk-inset-text">
        No farm record is associated with CPHH <strong>@BseFormat.FormatCphh(Model.Case.Cphh)</strong>.
    </div>

    <p class="govuk-body">
        <a asp-page="/Farm/Details" asp-route-cphh="@Model.Case.Cphh" class="govuk-link">View farm record</a> &mdash;
        <a asp-page="/Case/Details" asp-route-rbse="@Model.Rbse" class="govuk-link">Back to case</a>
    </p>
    return;
}

@* ── Confirmed cases banner ───────────────────────────────────────────────────── *@
<div class="govuk-inset-text">
    <strong>Number of confirmed cases for this farm: @Model.ConfirmedCaseCount</strong>
</div>

@* ── Batch numbers (mirrors legacy BatchNumberDisplay control) ─────────────────────────────── *@
@if (User.IsInRole("DataEntry") && Model.BatchNumbers.Count > 0)
{
    <div class="govuk-summary-card govuk-!-margin-bottom-4">
        <div class="govuk-summary-card__title-wrapper">
            <h2 class="govuk-summary-card__title">Batch numbers</h2>
        </div>
        <div class="govuk-summary-card__content">
            <ul class="govuk-list">
                @foreach (var b in Model.BatchNumbers)
                {
                    <li>@b.BatchNumber@(b.Document is not null ? $" — {b.Document}" : "")</li>
                }
            </ul>
        </div>
    </div>
}

@* ── Action buttons ───────────────────────────────────────────────────────────── *@
<div class="govuk-button-group govuk-!-margin-bottom-4">
    @if (User.IsInRole("DataEntry"))
    {
        <a asp-page="/Farm/Edit" asp-route-cphh="@Model.Farm.CPHH" asp-route-rbse="@Model.Rbse" class="govuk-button govuk-button--secondary">Edit farm details</a>
    }
    <a asp-page="/AuditLog/ByFarm" asp-route-cphh="@Model.Farm.CPHH" asp-route-rbse="@Model.Rbse" class="govuk-link">Farm audit log</a>
    @if (!string.IsNullOrEmpty(Model.SpolSiteUrl))
    {
        string farmRbseNoSlash = Model.Rbse.Replace("/", "");
        <a href="@(Model.SpolSiteUrl)@farmRbseNoSlash" target="_blank" rel="noopener noreferrer" class="govuk-link">
            View docs<span class="govuk-visually-hidden"> (opens in new tab)</span>
        </a>
    }
</div>

@* ── Farm summary — two columns ───────────────────────────────────────────────── *@
<h2 class="govuk-heading-m">CPHH: @BseFormat.FormatCphh(Model.Farm.CPHH)</h2>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-one-half">

        <h3 class="govuk-heading-s">Address</h3>
        <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Owner name</dt>
                <dd class="govuk-summary-list__value">@Model.Farm.OwnerName</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Address</dt>
                <dd class="govuk-summary-list__value">
                    @Model.Farm.Address1<br />
                    @if (!string.IsNullOrWhiteSpace(Model.Farm.Address2)) { @Model.Farm.Address2 <br /> }
                    @if (!string.IsNullOrWhiteSpace(Model.Farm.Address3)) { @Model.Farm.Address3 <br /> }
                    @Model.Farm.Postcode
                </dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Parish</dt>
                <dd class="govuk-summary-list__value">@Model.Farm.Parish</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">District</dt>
                <dd class="govuk-summary-list__value">@Model.Farm.District</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">County</dt>
                <dd class="govuk-summary-list__value">@(Model.CountyName ?? Model.Farm.County)</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Map reference</dt>
                <dd class="govuk-summary-list__value">@Model.Farm.MapReference</dd>
            </div>
        </dl>

        <h3 class="govuk-heading-s">Correspondence address</h3>
        <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Correspondence address</dt>
                <dd class="govuk-summary-list__value">
                    @if (string.IsNullOrWhiteSpace(Model.Farm.CorrespondenceAddress1))
                    {
                        <span class="govuk-hint">Same as main address</span>
                    }
                    else
                    {
                        @Model.Farm.CorrespondenceAddress1<br />
                        @if (!string.IsNullOrWhiteSpace(Model.Farm.CorrespondenceAddress2)) { @Model.Farm.CorrespondenceAddress2 <br /> }
                        @if (!string.IsNullOrWhiteSpace(Model.Farm.CorrespondenceAddress3)) { @Model.Farm.CorrespondenceAddress3 <br /> }
                        @Model.Farm.CorrespondencePostcode
                    }
                </dd>
            </div>
        </dl>

    </div>
    <div class="govuk-grid-column-one-half">

        <h3 class="govuk-heading-s">Herd details</h3>
        <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Herdmark 1</dt>
                <dd class="govuk-summary-list__value">@Model.Farm.Herdmark1</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Numeric herdmark 1</dt>
                <dd class="govuk-summary-list__value">@Model.Farm.NumericHerdmark1</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Herdmark 2</dt>
                <dd class="govuk-summary-list__value">@Model.Farm.Herdmark2</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Numeric herdmark 2</dt>
                <dd class="govuk-summary-list__value">@Model.Farm.NumericHerdmark2</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Herdmark 3</dt>
                <dd class="govuk-summary-list__value">@Model.Farm.Herdmark3</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Herd type</dt>
                <dd class="govuk-summary-list__value">@(Model.HerdTypeName ?? Model.Farm.HerdType)</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Pedigree</dt>
                <dd class="govuk-summary-list__value">@(Model.PedigreeTypeName ?? Model.Farm.PedigreeType)</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">AHO</dt>
                <dd class="govuk-summary-list__value">@(Model.AHOName ?? Model.Farm.AHO)</dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.AuthorityCountyName))
            {
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Authority county</dt>
                    <dd class="govuk-summary-list__value">@Model.AuthorityCountyName</dd>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.LocalAuthorityName))
            {
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Local authority</dt>
                    <dd class="govuk-summary-list__value">@Model.LocalAuthorityName</dd>
                </div>
            }
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">ADNS region</dt>
                <dd class="govuk-summary-list__value">@Model.ADNSRegionName</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Is a dealer?</dt>
                <dd class="govuk-summary-list__value">@(Model.Farm.IsDealer ? "Yes" : "No")</dd>
            </div>
        </dl>

    </div>
</div>

<hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" />

@* ── Linked farms ─────────────────────────────────────────────────────────────── *@
<h2 class="govuk-heading-m">Linked farms</h2>
@{
    var editLfError = ViewData.ModelState[nameof(Model.EditLinkedFarmCphh)]?.Errors.FirstOrDefault()?.ErrorMessage;
    bool hasLfError = editLfError is not null;
}

@if (Model.LinkedFarmsTotalCount > 0)
{
    <table class="govuk-table">
        <caption class="govuk-visually-hidden">Linked farms for @Model.Farm.CPHH</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header" aria-sort="@(Model.LSort=="cphh" ? (Model.LDir=="asc" ? "ascending" : "descending") : "none")">
                    <a class="govuk-link govuk-link--no-visited-state" href="@Model.LinkedFarmsSortUrl("cphh")">CPHH</a>
                </th>
                <th scope="col" class="govuk-table__header" aria-sort="@(Model.LSort=="status" ? (Model.LDir=="asc" ? "ascending" : "descending") : "none")">
                    <a class="govuk-link govuk-link--no-visited-state" href="@Model.LinkedFarmsSortUrl("status")">Status</a>
                </th>
                @if (User.IsInRole("DataEntry"))
                {
                    <th scope="col" class="govuk-table__header">Action</th>
                }
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var lf in Model.LinkedFarms)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@BseFormat.FormatCphh(lf.RelatedCPHH)</td>
                    <td class="govuk-table__cell">@lf.Status</td>
                    <td class="govuk-table__cell">
                        @if (User.IsInRole("DataEntry"))
                        {
                            bool isLfEditRow = hasLfError && Model.EditLinkedFarmId == lf.ID;
                            <details class="govuk-details" data-module="govuk-details" @(isLfEditRow ? "open" : null)>
                                <summary class="govuk-details__summary">
                                    <span class="govuk-details__summary-text">Edit</span>
                                </summary>
                                <div class="govuk-details__text">
                                    @if (isLfEditRow)
                                    {
                                        <div class="govuk-error-summary" data-module="govuk-error-summary">
                                            <div role="alert"><h2 class="govuk-error-summary__title">There is a problem</h2>
                                            <div class="govuk-error-summary__body"><ul class="govuk-list govuk-error-summary__list">
                                                <li><a href="#edit-lf-cphh-@lf.ID">@editLfError</a></li>
                                            </ul></div></div>
                                        </div>
                                    }
                                    <form method="post" asp-page-handler="EditLinkedFarm" novalidate>
                                        <input type="hidden" name="EditLinkedFarmId" value="@lf.ID" />
                                        <input type="hidden" name="EditLinkedFarmRowStampBase64" value="@(lf.RowStamp is not null ? Convert.ToBase64String(lf.RowStamp) : "")" />
                                        <input type="hidden" name="Rbse" value="@Model.Rbse" />
                                        <div class="govuk-form-group @(isLfEditRow ? "govuk-form-group--error" : "")">
                                            <label class="govuk-label" for="edit-lf-cphh-@lf.ID">CPHH</label>
                                            @if (isLfEditRow) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @editLfError</p> }
                                            <input class="govuk-input govuk-!-width-one-third @(isLfEditRow ? "govuk-input--error" : "")"
                                                   id="edit-lf-cphh-@lf.ID" name="EditLinkedFarmCphh"
                                                   value="@(isLfEditRow ? Model.EditLinkedFarmCphh : BseFormat.FormatCphh(lf.RelatedCPHH))"
                                                   data-lf-lookup spellcheck="false" autocomplete="off" />
                                        </div>
                                        <p class="govuk-hint lf-lookup-status" style="display:none"></p>
                                        <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">Save changes</button>
                                    </form>
                                </div>
                            </details>
                            <form method="post" asp-page-handler="DeleteLinkedFarm" novalidate>
                                <input type="hidden" name="Rbse" value="@Model.Rbse" />
                                <input type="hidden" name="id" value="@lf.ID" />
                                <input type="hidden" name="rowStampBase64" value="@(lf.RowStamp is not null ? Convert.ToBase64String(lf.RowStamp) : "")" />
                                <button type="submit" class="govuk-button govuk-button--warning govuk-!-margin-bottom-0"
                                        data-module="govuk-button"
                                        onclick="return confirm('Remove linked farm @lf.RelatedCPHH?')">
                                    Remove
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.LinkedFarmsTotalPages > 1)
    {
        <nav class="govuk-pagination" role="navigation" aria-label="Linked farms pagination">
            @if (Model.LPage > 1)
            {
                <div class="govuk-pagination__prev">
                    <a class="govuk-link govuk-pagination__link" href="@Model.LinkedFarmsPageUrl(Model.LPage - 1)" rel="prev">
                        <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13"><path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"/></svg>
                        <span class="govuk-pagination__link-title">Previous<span class="govuk-visually-hidden"> page</span></span>
                    </a>
                </div>
            }
            <ul class="govuk-pagination__list">
                @{
                    int lfStart = Math.Max(1, Model.LPage - 4);
                    int lfEnd   = Math.Min(Model.LinkedFarmsTotalPages, lfStart + 9);
                    if (lfEnd - lfStart < 9) lfStart = Math.Max(1, lfEnd - 9);
                }
                @for (int p = lfStart; p <= lfEnd; p++)
                {
                    bool lfCur = p == Model.LPage;
                    <li class="govuk-pagination__item @(lfCur ? "govuk-pagination__item--current" : "")">
                        @if (lfCur)
                        {
                            <a class="govuk-link govuk-pagination__link" href="@Model.LinkedFarmsPageUrl(p)" aria-label="Page @p" aria-current="page">@p</a>
                        }
                        else
                        {
                            <a class="govuk-link govuk-pagination__link" href="@Model.LinkedFarmsPageUrl(p)" aria-label="Page @p">@p</a>
                        }
                    </li>
                }
            </ul>
            @if (Model.LPage < Model.LinkedFarmsTotalPages)
            {
                <div class="govuk-pagination__next">
                    <a class="govuk-link govuk-pagination__link" href="@Model.LinkedFarmsPageUrl(Model.LPage + 1)" rel="next">
                        <span class="govuk-pagination__link-title">Next<span class="govuk-visually-hidden"> page</span></span>
                        <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13"><path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7246z"/></svg>
                    </a>
                </div>
            }
        </nav>
    }
}
else
{
    <p class="govuk-body">No linked farms recorded.</p>
}

@if (User.IsInRole("DataEntry"))
{
<details class="govuk-details" data-module="govuk-details">
    <summary class="govuk-details__summary">
        <span class="govuk-details__summary-text">Add linked farm</span>
    </summary>
    <div class="govuk-details__text">
        <form method="post" asp-page-handler="AddLinkedFarm" novalidate>
            <input type="hidden" asp-for="Rbse" />
            <div class="govuk-form-group @(ViewContext.ModelState[nameof(Model.NewLinkedCphh)]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
                <label class="govuk-label" for="NewLinkedCphh">CPHH to link</label>
                <div class="govuk-hint">For example, 12/345/6789</div>
                <span asp-validation-for="NewLinkedCphh" class="govuk-error-message"></span>
                <input class="govuk-input govuk-!-width-one-third" id="NewLinkedCphh" asp-for="NewLinkedCphh"
                       autocomplete="off" spellcheck="false" data-lf-lookup />
                <p class="govuk-hint lf-lookup-status" style="display:none"></p>
            </div>
            <button type="submit" class="govuk-button" data-module="govuk-button">Add linked farm</button>
        </form>
    </div>
</details>
}

<hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" />

@* ── Herd size ────────────────────────────────────────────────────────────────── *@
<h2 class="govuk-heading-m">Herd size</h2>
@{
    var editHsYearError = ViewData.ModelState["EditHerdSize.HerdYear"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var editHsSizeError = ViewData.ModelState["EditHerdSize.TotalSize"]?.Errors.FirstOrDefault()?.ErrorMessage;
    bool hasHsError     = editHsYearError is not null || editHsSizeError is not null;
}

@if (Model.HerdSizesTotalCount > 0)
{
    <table class="govuk-table govuk-!-font-size-16">
            <caption class="govuk-visually-hidden">Annual herd size for @Model.Farm.CPHH</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" rowspan="2" class="govuk-table__header" aria-sort="@(Model.HSort=="year" ? (Model.HDir=="asc" ? "ascending" : "descending") : "none")">
                        <a class="govuk-link govuk-link--no-visited-state" href="@Model.HerdSizeSortUrl("year")">Year</a>
                    </th>
                    <th scope="col" rowspan="2" class="govuk-table__header govuk-table__header--numeric" aria-sort="@(Model.HSort=="total" ? (Model.HDir=="asc" ? "ascending" : "descending") : "none")">
                        <a class="govuk-link govuk-link--no-visited-state" href="@Model.HerdSizeSortUrl("total")">Total</a>
                    </th>
                    <th scope="colgroup" colspan="11" class="govuk-table__header" style="text-align: center">Lactation</th>
                    @if (User.IsInRole("DataEntry"))
                    {
                        <th scope="col" rowspan="2" class="govuk-table__header">Action</th>
                    }
                </tr>
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header govuk-table__header--numeric" aria-sort="@(Model.HSort=="lac1"   ? (Model.HDir=="asc" ? "ascending" : "descending") : "none")"><a class="govuk-link govuk-link--no-visited-state" href="@Model.HerdSizeSortUrl("lac1")">1</a></th>
                    <th scope="col" class="govuk-table__header govuk-table__header--numeric" aria-sort="@(Model.HSort=="lac2"   ? (Model.HDir=="asc" ? "ascending" : "descending") : "none")"><a class="govuk-link govuk-link--no-visited-state" href="@Model.HerdSizeSortUrl("lac2")">2</a></th>
                    <th scope="col" class="govuk-table__header govuk-table__header--numeric" aria-sort="@(Model.HSort=="lac3"   ? (Model.HDir=="asc" ? "ascending" : "descending") : "none")"><a class="govuk-link govuk-link--no-visited-state" href="@Model.HerdSizeSortUrl("lac3")">3</a></th>
                    <th scope="col" class="govuk-table__header govuk-table__header--numeric" aria-sort="@(Model.HSort=="lac4"   ? (Model.HDir=="asc" ? "ascending" : "descending") : "none")"><a class="govuk-link govuk-link--no-visited-state" href="@Model.HerdSizeSortUrl("lac4")">4</a></th>
                    <th scope="col" class="govuk-table__header govuk-table__header--numeric" aria-sort="@(Model.HSort=="lac5"   ? (Model.HDir=="asc" ? "ascending" : "descending") : "none")"><a class="govuk-link govuk-link--no-visited-state" href="@Model.HerdSizeSortUrl("lac5")">5</a></th>
                    <th scope="col" class="govuk-table__header govuk-table__header--numeric" aria-sort="@(Model.HSort=="lac6"   ? (Model.HDir=="asc" ? "ascending" : "descending") : "none")"><a class="govuk-link govuk-link--no-visited-state" href="@Model.HerdSizeSortUrl("lac6")">6</a></th>
                    <th scope="col" class="govuk-table__header govuk-table__header--numeric" aria-sort="@(Model.HSort=="lac7"   ? (Model.HDir=="asc" ? "ascending" : "descending") : "none")"><a class="govuk-link govuk-link--no-visited-state" href="@Model.HerdSizeSortUrl("lac7")">7</a></th>
