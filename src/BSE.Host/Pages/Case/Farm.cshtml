</table>
    @if (Model.HerdSizesTotalPages > 1)
    {
        <nav class="govuk-pagination" role="navigation" aria-label="Herd size pagination">
            @if (Model.HPage > 1)
            {
                <div class="govuk-pagination__prev">
                    <a class="govuk-link govuk-pagination__link" href="@Model.HerdSizesPageUrl(Model.HPage - 1)" rel="prev">
                        <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13"><path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"/></svg>
                        <span class="govuk-pagination__link-title">Previous<span class="govuk-visually-hidden"> page</span></span>
                    </a>
                </div>
            }
            <ul class="govuk-pagination__list">
                @{
                    int hsStart = Math.Max(1, Model.HPage - 4);
                    int hsEnd   = Math.Min(Model.HerdSizesTotalPages, hsStart + 9);
                    if (hsEnd - hsStart < 9) hsStart = Math.Max(1, hsEnd - 9);
                }
                @for (int p = hsStart; p <= hsEnd; p++)
                {
                    bool hsCur = p == Model.HPage;
                    <li class="govuk-pagination__item @(hsCur ? "govuk-pagination__item--current" : "")">
                        @if (hsCur)
                        {
                            <a class="govuk-link govuk-pagination__link" href="@Model.HerdSizesPageUrl(p)" aria-label="Page @p" aria-current="page">@p</a>
                        }
                        else
                        {
                            <a class="govuk-link govuk-pagination__link" href="@Model.HerdSizesPageUrl(p)" aria-label="Page @p">@p</a>
                        }
                    </li>
                }
            </ul>
            @if (Model.HPage < Model.HerdSizesTotalPages)
            {
                <div class="govuk-pagination__next">
                    <a class="govuk-link govuk-pagination__link" href="@Model.HerdSizesPageUrl(Model.HPage + 1)" rel="next">
