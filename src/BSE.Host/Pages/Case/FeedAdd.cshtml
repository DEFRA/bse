@page "{rbse}"
@model BSE.Host.Pages.Case.FeedAddModel
@{
    ViewData["Title"] = $"Add Feed Record — {Model.Rbse}";
    ViewData["Crumb"] = "Add Feed Record";
    var feed = Model.NewFeed;
    var form = new BSE.Host.Models.FeedFormViewModel("NewFeed", Model.FieldErrors, Model.RationTypes, Model.Suppliers,
        feed.YearFrom, feed.YearTo, feed.RationType, feed.RationName, feed.SupplierId, feed.IsPrePurchase);
}

<partial name="_FeedHeader" model="Model" />

<h2 class="govuk-heading-m">Add a feed record</h2>

<form method="post" novalidate>
    <input type="hidden" name="Rbse" value="@Model.Rbse" />

    <partial name="_FeedFormFields" model="form" />

    <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">Add As New</button>
        <a asp-page="/Case/Feeds" asp-route-rbse="@Model.Rbse" class="govuk-link">Cancel</a>
    </div>
</form>
