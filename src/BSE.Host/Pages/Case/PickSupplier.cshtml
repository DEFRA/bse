@page
@model BSE.Host.Pages.Case.PickSupplierModel
@{
    ViewData["Title"] = "Pick supplier";
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Case/Feeds" asp-route-rbse="@Model.Rbse">Case @BseFormat.FormatRbse(Model.Rbse)</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Pick supplier</li>
    </ol>
</nav>

<h1 class="govuk-heading-l">Pick supplier</h1>
<p class="govuk-body">An exact match for "@Model.Name" was not found.</p>

@if (!ViewContext.ModelState.IsValid)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var e in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@e.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

@if (!Model.Suppliers.Any())
{
    <div class="govuk-inset-text">No similar suppliers were found.</div>
}
else
{
    var pickBase = Url.Page("/Case/PickSupplier", new { rbse = Model.Rbse, name = Model.Name });

    <table class="govuk-table">
        <caption class="govuk-visually-hidden">Matching suppliers</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Name", ["Column"] = "Name", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = pickBase })
                @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Details", ["Column"] = "Details", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = pickBase })
                <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var s in Model.Suppliers)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@s.Name</td>
                    <td class="govuk-table__cell">@s.Details</td>
                    <td class="govuk-table__cell">
                        <form method="post" asp-page-handler="UseSelected" novalidate>
                            <input type="hidden" name="Rbse" value="@Model.Rbse" />
                            <input type="hidden" name="Name" value="@Model.Name" />
                            <input type="hidden" name="id" value="@s.Id" />
                            <input type="hidden" name="selectedName" value="@s.Name" />
                            <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">Use Selected</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @await Html.PartialAsync("_Pagination", null, new ViewDataDictionary(ViewData)
    {
        ["CurrentPage"] = Model.PageNumber,
        ["TotalPages"] = Model.TotalPages
    })
}

<form method="post" novalidate class="pick-supplier-footer">
    <input type="hidden" name="Rbse" value="@Model.Rbse" />
    <input type="hidden" name="Name" value="@Model.Name" />

    <div class="pick-supplier-footer__fields">
        <div class="pick-supplier-footer__field">
            <label class="govuk-label" for="new-supplier-name">Name</label>
            <div id="new-supplier-name" class="govuk-body govuk-!-margin-bottom-0">@Model.Name</div>
        </div>
        <div class="pick-supplier-footer__field @(ViewData.ModelState["NewSupplierDetails"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
            <label class="govuk-label" for="new-supplier-details">Details</label>
            <input id="new-supplier-details" name="NewSupplierDetails" class="govuk-input" value="@Model.NewSupplierDetails" maxlength="60" />
        </div>
    </div>

    <div class="govuk-button-group pick-supplier-footer__actions">
        <button type="submit" asp-page-handler="New" class="govuk-button govuk-button--secondary" data-module="govuk-button" disabled="@(!Model.CanCreateNew)">New</button>
        <button type="submit" asp-page-handler="Cancel" class="govuk-button govuk-button--secondary" data-module="govuk-button" formnovalidate>Return</button>
    </div>
</form>

<style>
    .pick-supplier-footer {
        margin-top: 1rem;
    }

    .pick-supplier-footer__fields {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        align-items: end;
    }

    .pick-supplier-footer__actions {
        justify-content: flex-end;
        margin-top: 0.75rem;
    }
</style>
