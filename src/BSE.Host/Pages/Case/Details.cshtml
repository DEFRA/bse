@page "{rbse}"
@model BSE.Host.Pages.Case.DetailsModel
@{
    ViewData["Title"] = Model.Case is null ? "Case details" : $"Case {Model.Case.Rbse}";
}

@if (Model.Case is null)
{
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-warning-text__assistive">Warning</span>
            Case not found.
        </strong>
    </div>
    <a asp-page="/Case/Lookup" class="govuk-link">Back to case lookup</a>
    return;
}

<h1 class="govuk-heading-l">Case: <span class="bse-rbse">@Model.Case.Rbse</span></h1>

<div class="govuk-button-group">
    <a asp-page="/Case/Edit" asp-route-rbse="@Model.Case.Rbse" class="govuk-button">Edit</a>
    <a asp-page="/Case/Delete" asp-route-rbse="@Model.Case.Rbse" class="govuk-link govuk-link--no-visited-state">Delete</a>
    <a asp-page="/Case/MoveCase" asp-route-rbse="@Model.Case.Rbse" class="govuk-link">Move case</a>
    <a asp-page="/Case/RbseChange" asp-route-rbse="@Model.Case.Rbse" class="govuk-link">Change RBSE</a>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-one-half">
        <h2 class="govuk-heading-m">Case details</h2>
        <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">CPHH</dt>
                <dd class="govuk-summary-list__value">@Model.Case.Cphh</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Eartag</dt>
                <dd class="govuk-summary-list__value">@Model.Case.EartagCountry @Model.Case.EartagHerdmark @Model.Case.Eartag</dd>
            </div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Sex</dt><dd class="govuk-summary-list__value">@Model.Case.Sex</dd></div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Breed</dt><dd class="govuk-summary-list__value">@Model.Case.Breed</dd></div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Birth date</dt>
                <dd class="govuk-summary-list__value">@Model.Case.BirthDate?.ToString("dd/MM/yyyy") @(Model.Case.IsBirthDateEst ? "(estimated)" : "")</dd>
            </div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Survey</dt><dd class="govuk-summary-list__value">@Model.Case.Survey</dd></div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Form A date</dt><dd class="govuk-summary-list__value">@Model.Case.FormADate?.ToString("dd/MM/yyyy")</dd></div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Fate</dt><dd class="govuk-summary-list__value">@Model.Case.Fate</dd></div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Final result</dt><dd class="govuk-summary-list__value">@Model.Case.FinalResult</dd></div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Final result date</dt><dd class="govuk-summary-list__value">@Model.Case.FinalResultDate?.ToString("dd/MM/yyyy")</dd></div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">DBSE</dt><dd class="govuk-summary-list__value">@Model.Case.Dbse</dd></div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Non-GB</dt><dd class="govuk-summary-list__value">@(Model.Case.IsNonGbCase ? "Yes" : "No")</dd></div>
        </dl>
    </div>
    <div class="govuk-grid-column-one-half">
        <h2 class="govuk-heading-m">Paperwork status</h2>
        <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Homebred BSE1</dt><dd class="govuk-summary-list__value">@(Model.Case.IsHomebredBse1Received ? "Received" : "Outstanding")</dd></div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Breeder BSE1</dt><dd class="govuk-summary-list__value">@(Model.Case.IsBreederBse1Received ? "Received" : "Outstanding")</dd></div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Purchaser BSE1</dt><dd class="govuk-summary-list__value">@(Model.Case.IsPurchaserBse1Received ? "Received" : "Outstanding")</dd></div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Vendor BSE1</dt><dd class="govuk-summary-list__value">@(Model.Case.IsVendor1Bse1Received ? "Received" : "Outstanding")</dd></div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Summary sheet</dt><dd class="govuk-summary-list__value">@(Model.Case.IsSummarySheetReceived ? "Received" : "Outstanding")</dd></div>
        </dl>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Case.Notes))
{
    <h2 class="govuk-heading-m">Notes</h2>
    <p class="govuk-body">@Model.Case.Notes</p>
}

@* ── Farm details (inline, matching legacy CaseEntryFarm) ─────────────────── *@
@if (Model.Farm is not null)
{
    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" />
    <h2 class="govuk-heading-m">
        Farm: <a asp-page="/Farm/Details" asp-route-cphh="@Model.Farm.CPHH" class="govuk-link">@Model.Farm.CPHH</a>
    </h2>
    <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Owner</dt><dd class="govuk-summary-list__value">@Model.Farm.OwnerName</dd></div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Address</dt>
            <dd class="govuk-summary-list__value">
                @Model.Farm.Address1<br />
                @Model.Farm.Address2<br />
                @Model.Farm.Address3<br />
                @Model.Farm.Postcode
            </dd>
        </div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">County</dt><dd class="govuk-summary-list__value">@Model.Farm.County</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Parish</dt><dd class="govuk-summary-list__value">@Model.Farm.Parish</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Herdmarks</dt><dd class="govuk-summary-list__value">@Model.Farm.Herdmark1 @Model.Farm.Herdmark2 @Model.Farm.Herdmark3</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">AHO</dt><dd class="govuk-summary-list__value">@Model.Farm.AHO</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Herd type</dt><dd class="govuk-summary-list__value">@Model.Farm.HerdType</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Dealer</dt><dd class="govuk-summary-list__value">@(Model.Farm.IsDealer ? "Yes" : "No")</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Non-GB</dt><dd class="govuk-summary-list__value">@(Model.Farm.IsNonGBFarm ? "Yes" : "No")</dd></div>
    </dl>
    <a asp-page="/Farm/Details" asp-route-cphh="@Model.Farm.CPHH" class="govuk-link govuk-!-font-size-19">View full farm details</a>
}
else if (!string.IsNullOrWhiteSpace(Model.Case.Cphh))
{
    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" />
    <p class="govuk-body">Farm <strong>@Model.Case.Cphh</strong> was not found.</p>
}
