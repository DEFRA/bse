@page "{rbse}"
@model BSE.Host.Pages.Case.OtherOwnersModel
@{
    ViewData["Title"] = $"Other owners — {Model.Rbse}";
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Case/Vla" asp-route-rbse="@Model.Rbse">@Model.Rbse</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Other owners</li>
    </ol>
</nav>

<h1 class="govuk-heading-l">Other owners — <span class="bse-rbse">@Model.Rbse</span></h1>

@if (TempData["Success"] is string successMsg)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
         aria-labelledby="owners-success-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="owners-success-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@successMsg</p>
        </div>
    </div>
}

@if (!ViewContext.ModelState.IsValid)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var e in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@e.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

<p class="govuk-body govuk-hint">Previous and other owners of this animal, used during BSE tracing.</p>

@{
    var editTypeError = ViewData.ModelState[nameof(Model.EditOwnerType)]?.Errors.FirstOrDefault()?.ErrorMessage;
    var editNameError = ViewData.ModelState[nameof(Model.EditOwnerName)]?.Errors.FirstOrDefault()?.ErrorMessage;
    bool hasEditError = editTypeError is not null || editNameError is not null;
    string TypeDesc(string? code) =>
        Model.OwnerTypes.FirstOrDefault(t => t.Code == code)?.Description ?? code ?? "—";
}

@if (Model.OtherOwnersTotalCount > 0)
{
    <table class="govuk-table">
        <caption class="govuk-visually-hidden">Other owners for @Model.Rbse</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header" aria-sort="@(Model.OSort=="type" ? (Model.ODir=="asc" ? "ascending" : "descending") : "none")">
                    <a class="govuk-link govuk-link--no-visited-state" href="@Model.OtherOwnersSortUrl("type")">Owner type</a>
                </th>
                <th scope="col" class="govuk-table__header">Name</th>
                <th scope="col" class="govuk-table__header" aria-sort="@(Model.OSort=="cphh" ? (Model.ODir=="asc" ? "ascending" : "descending") : "none")">
                    <a class="govuk-link govuk-link--no-visited-state" href="@Model.OtherOwnersSortUrl("cphh")">CPHH</a>
                </th>
                <th scope="col" class="govuk-table__header">Action</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var o in Model.OtherOwners)
            {
                bool isEditRow = hasEditError && Model.EditOwnerId == o.Id;
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@TypeDesc(o.Type)</td>
                    <td class="govuk-table__cell">@(o.Name ?? "—")</td>
                    <td class="govuk-table__cell">@BseFormat.FormatCphh(o.Cphh)</td>
                    <td class="govuk-table__cell">
                        <details class="govuk-details" data-module="govuk-details" @(isEditRow ? "open" : null)>
                            <summary class="govuk-details__summary"><span class="govuk-details__summary-text">Edit</span></summary>
                            <div class="govuk-details__text">
                                @if (isEditRow)
                                {
                                    <div class="govuk-error-summary" data-module="govuk-error-summary"><div role="alert"><h2 class="govuk-error-summary__title">There is a problem</h2><div class="govuk-error-summary__body"><ul class="govuk-list govuk-error-summary__list">
                                        @if (editTypeError is not null) { <li>@editTypeError</li> }
                                        @if (editNameError is not null) { <li>@editNameError</li> }
                                    </ul></div></div></div>
                                }
                                <form method="post" asp-page-handler="EditOwner" novalidate>
                                    <input type="hidden" name="EditOwnerId" value="@o.Id" />
                                    <input type="hidden" name="EditOwnerRowStampBase64" value="@Convert.ToBase64String(o.RowStamp ?? [])" />
                                    <input type="hidden" name="Rbse" value="@Model.Rbse" />
                                    <div class="govuk-form-group @(isEditRow && editTypeError is not null ? "govuk-form-group--error" : "")">
                                        <label class="govuk-label" for="edit-type-@o.Id">Owner type</label>
                                        @if (isEditRow && editTypeError is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @editTypeError</p> }
                                        <select class="govuk-select @(isEditRow && editTypeError is not null ? "govuk-select--error" : "")" id="edit-type-@o.Id" name="EditOwnerType">
                                            <option value="">— select —</option>
                                            @foreach (var ot in Model.OwnerTypes)
                                            {
                                                if (ot.Code == (isEditRow ? Model.EditOwnerType : o.Type))
                                                {
                                                    <option value="@ot.Code" selected="selected">@ot.Description</option>
                                                }
                                                else
                                                {
                                                    <option value="@ot.Code">@ot.Description</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="govuk-form-group @(isEditRow && editNameError is not null ? "govuk-form-group--error" : "")">
                                        <label class="govuk-label" for="edit-name-@o.Id">Name</label>
                                        @if (isEditRow && editNameError is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @editNameError</p> }
                                        <input class="govuk-input govuk-!-width-two-thirds @(isEditRow && editNameError is not null ? "govuk-input--error" : "")"
                                               id="edit-name-@o.Id" name="EditOwnerName"
                                               value="@(isEditRow ? Model.EditOwnerName : o.Name)" maxlength="30" />
                                    </div>
                                    <div class="govuk-form-group">
                                        <label class="govuk-label" for="edit-cphh-@o.Id">CPHH</label>
                                        <input class="govuk-input govuk-!-width-one-half" id="edit-cphh-@o.Id" name="EditOwnerCphh"
                                               value="@(isEditRow ? Model.EditOwnerCphh : o.Cphh)" maxlength="11" />
                                    </div>
                                    <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">Save changes</button>
                                </form>
                            </div>
                        </details>
                        <form method="post" asp-page-handler="DeleteOwner" style="display:inline" novalidate>
                            <input type="hidden" name="OwnerId" value="@o.Id" />
                            <input type="hidden" name="RowStampBase64" value="@Convert.ToBase64String(o.RowStamp ?? [])" />
                            <input type="hidden" asp-for="Rbse" />
                            <button type="submit" class="govuk-button govuk-button--warning govuk-!-margin-bottom-0"
                                    onclick="return confirm('Delete this owner record?')">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.OtherOwnersTotalPages > 1)
    {
        <nav class="govuk-pagination" role="navigation" aria-label="Other owners pagination">
            @if (Model.OPage > 1)
            {
                <div class="govuk-pagination__prev">
                    <a class="govuk-link govuk-pagination__link" href="@Model.OtherOwnersPageUrl(Model.OPage - 1)" rel="prev">
                        <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13"><path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"/></svg>
                        <span class="govuk-pagination__link-title">Previous<span class="govuk-visually-hidden"> page</span></span>
                    </a>
                </div>
            }
            <ul class="govuk-pagination__list">
                @{ int oStart = Math.Max(1, Model.OPage - 4); int oEnd = Math.Min(Model.OtherOwnersTotalPages, oStart + 9); if (oEnd - oStart < 9) oStart = Math.Max(1, oEnd - 9); }
                @for (int p = oStart; p <= oEnd; p++)
                {
                    bool oCur = p == Model.OPage;
                    <li class="govuk-pagination__item @(oCur ? "govuk-pagination__item--current" : "")">
                        @if (oCur) { <a class="govuk-link govuk-pagination__link" href="@Model.OtherOwnersPageUrl(p)" aria-label="Page @p" aria-current="page">@p</a> }
                        else       { <a class="govuk-link govuk-pagination__link" href="@Model.OtherOwnersPageUrl(p)" aria-label="Page @p">@p</a> }
                    </li>
                }
            </ul>
            @if (Model.OPage < Model.OtherOwnersTotalPages)
            {
                <div class="govuk-pagination__next">
                    <a class="govuk-link govuk-pagination__link" href="@Model.OtherOwnersPageUrl(Model.OPage + 1)" rel="next">
                        <span class="govuk-pagination__link-title">Next<span class="govuk-visually-hidden"> page</span></span>
                        <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13"><path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7246z"/></svg>
                    </a>
                </div>
            }
        </nav>
    }
}
else
{
    <p class="govuk-body govuk-!-colour-secondary">No other owner records.</p>
}

<details class="govuk-details" data-module="govuk-details">
    <summary class="govuk-details__summary">
        <span class="govuk-details__summary-text">Add an owner record</span>
    </summary>
    <div class="govuk-details__text">
        <form method="post" asp-page-handler="AddOwner" novalidate>
            <input type="hidden" asp-for="Rbse" />
            <div class="govuk-form-group">
                <label class="govuk-label" for="owner-type">Type</label>
                <select id="owner-type" name="NewOwner.Type" class="govuk-select govuk-!-width-one-half">
                    <option value="">— select —</option>
                    @foreach (var ot in Model.OwnerTypes)
                    {
                        <option value="@ot.Code">@ot.Description</option>
                    }
                </select>
            </div>
            <div class="govuk-form-group">
                <label class="govuk-label" for="owner-name">Name</label>
                <input id="owner-name" name="NewOwner.Name" class="govuk-input govuk-!-width-two-thirds" />
            </div>
            <div class="govuk-form-group">
                <label class="govuk-label" for="owner-cphh">CPHH</label>
                <input id="owner-cphh" name="NewOwner.Cphh" class="govuk-input govuk-!-width-one-half" />
            </div>
            <button type="submit" class="govuk-button" data-module="govuk-button">Add owner</button>
        </form>
    </div>
</details>

<div class="govuk-button-group govuk-!-margin-top-4">
    <a asp-page="/Case/Vla" asp-route-rbse="@Model.Rbse" class="govuk-link">Back to Case (VLA)</a>
</div>
