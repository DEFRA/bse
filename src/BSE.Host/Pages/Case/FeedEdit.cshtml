@page "{rbse}/{feedId:int}"
@model BSE.Host.Pages.Case.FeedEditModel
@{
    ViewData["Title"] = $"Edit feed record — {Model.Rbse}";
    ViewData["Crumb"] = "Edit Feed Record";
    var feed = Model.Feed;
    var form = new BSE.Host.Models.FeedFormViewModel("Feed", Model.FieldErrors, Model.RationTypes, Model.Suppliers,
        feed.YearFrom, feed.YearTo, feed.RationType, feed.RationName, feed.SupplierId, feed.IsPrePurchase);
}

<partial name="_FeedHeader" model="Model" />

<h2 class="govuk-heading-m">Edit feed record</h2>

<form method="post" novalidate>
    <input type="hidden" name="Feed.RowStamp" value="@Model.Feed.RowStamp" />

    <partial name="_FeedFormFields" model="form" />

    <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">Update Selected</button>
        <a asp-page="/Case/Feeds" asp-route-rbse="@Model.Rbse" class="govuk-link">Cancel</a>
    </div>
</form>
