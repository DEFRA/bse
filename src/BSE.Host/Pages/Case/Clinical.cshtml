@page "{rbse}"
@model BSE.Host.Pages.Case.ClinicalModel
@{
    ViewData["Title"] = $"Clinical signs and visits — {Model.Rbse}";
    string rbseNoSlash = Model.Rbse.Replace("/", "");
    var c = Model.Signs;
    var checkedSigns = new System.Collections.Generic.List<string>();
    if (c.Apprehension) checkedSigns.Add("Apprehension");
    if (c.HypersensitiveTouch) checkedSigns.Add("Hypersensitive to touch");
    if (c.HypersensitiveSound) checkedSigns.Add("Hypersensitive to sound");
    if (c.Maniacal) checkedSigns.Add("Maniacal");
    if (c.PanicStricken) checkedSigns.Add("Panic stricken");
    if (c.TemperamentChange) checkedSigns.Add("Temperament change");
    if (c.AbnormalHeadCarriage) checkedSigns.Add("Abnormal head carriage");
    if (c.EarTwitching) checkedSigns.Add("Ear twitching");
    if (c.EarsOddAngle) checkedSigns.Add("Ears at odd angle");
    if (c.AbnormalBehaviour) checkedSigns.Add("Abnormal behaviour");
    if (c.HeadShyness) checkedSigns.Add("Head shyness");
    if (c.LickingFlank) checkedSigns.Add("Licking flank");
    if (c.LickingNose) checkedSigns.Add("Licking nose");
    if (c.Kicking) checkedSigns.Add("Kicking");
    if (c.ReluctantDoorways) checkedSigns.Add("Reluctant to enter doorways");
    if (c.HeadPressing) checkedSigns.Add("Head pressing");
    if (c.HeadRubbing) checkedSigns.Add("Head rubbing");
    if (c.TeethGrinding) checkedSigns.Add("Teeth grinding");
    if (c.Blindness) checkedSigns.Add("Blindness");
    if (c.Circling) checkedSigns.Add("Circling");
    if (c.HindAtaxia) checkedSigns.Add("Hind ataxia");
    if (c.Falling) checkedSigns.Add("Falling");
    if (c.Paresis) checkedSigns.Add("Paresis");
    if (c.ForeAtaxia) checkedSigns.Add("Fore ataxia");
    if (c.Recumbent) checkedSigns.Add("Recumbent");
    if (c.Tremor) checkedSigns.Add("Tremor");
    if (c.KnucklingFetlock) checkedSigns.Add("Knuckling fetlock");
    if (c.WeightLoss) checkedSigns.Add("Weight loss");
    if (c.ConditionLoss) checkedSigns.Add("Condition loss");
    if (c.MilkYield) checkedSigns.Add("Milk yield loss");
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Clinical</li>
    </ol>
</nav>

<h1 class="govuk-heading-l">RBSE Number: <span class="bse-rbse">@BseFormat.FormatRbse(Model.Rbse)</span></h1>

@await Html.PartialAsync("_CaseTabs", new BSE.Host.Models.CaseTabsViewModel("Clinical", Model.Rbse))

@if (TempData["Success"] is string successMsg)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
         aria-labelledby="clinical-success-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="clinical-success-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@successMsg</p>
        </div>
    </div>
}

@* -- Batch numbers ------------------------------------------------------------ *@
@if (User.IsInRole("DataEntry") && Model.BatchNumbers.Count > 0)
{
    var batchSortBase = "?" + string.Join("&", HttpContext.Request.Query
        .Where(k => !string.Equals(k.Key, "BSortColumn", StringComparison.OrdinalIgnoreCase)
                 && !string.Equals(k.Key, "BSortDesc", StringComparison.OrdinalIgnoreCase)
                 && !string.Equals(k.Key, "BPageNumber", StringComparison.OrdinalIgnoreCase))
        .SelectMany(k => k.Value, (k, v) => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}"));
    var batchSortColumn = HttpContext.Request.Query["BSortColumn"].ToString();
    var batchSortDesc = bool.TryParse(HttpContext.Request.Query["BSortDesc"], out var desc) && desc;
    var sortedBatchNumbers = batchSortColumn == "Document"
        ? (batchSortDesc ? Model.BatchNumbers.OrderByDescending(b => b.Document) : Model.BatchNumbers.OrderBy(b => b.Document))
        : (batchSortDesc ? Model.BatchNumbers.OrderByDescending(b => b.BatchNumber) : Model.BatchNumbers.OrderBy(b => b.BatchNumber));

    <div class="govuk-!-margin-bottom-4">
        <h2 class="govuk-heading-m">Batch numbers</h2>
        <table class="govuk-table">
            <caption class="govuk-visually-hidden">Batch numbers for @Model.Rbse</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    @{ ViewData["Label"] = "Batch Number"; ViewData["Column"] = "BatchNumber"; ViewData["SortColumn"] = batchSortColumn; ViewData["SortDesc"] = batchSortDesc; ViewData["BaseUrl"] = batchSortBase; ViewData["Prefix"] = "B"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Document"; ViewData["Column"] = "Document"; }
                    <partial name="_SortableHeader" />
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var b in sortedBatchNumbers)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@b.BatchNumber</td>
                        <td class="govuk-table__cell">@(string.IsNullOrWhiteSpace(b.Document) ? "—" : b.Document)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* -- Clinical signs ----------------------------------------------------------- *@
<h2 class="govuk-heading-m">Clinical signs</h2>

@* -- READ-ONLY SIGNS VIEW --------------------------------------------------- *@
<div class="govuk-button-group govuk-!-margin-bottom-4">
    @if (User.IsInRole("DataEntry"))
    {
        <a asp-page="/Case/ClinicalEdit" asp-route-rbse="@Model.Rbse"
       class="govuk-button govuk-button--secondary">Edit clinical signs</a>
    }
    </div>

@if (checkedSigns.Count > 0)
{
    <ul class="govuk-list govuk-list--bullet">
        @foreach (var sign in checkedSigns)
        {
            <li>@sign</li>
        }
    </ul>
}
else
{
    <p class="govuk-body govuk-!-colour-secondary">No clinical signs recorded.</p>
}

@* -- Clinical visits ---------------------------------------------------------- *@
<h2 class="govuk-heading-m govuk-!-margin-top-6">Clinical visits</h2>

@if (Model.VisitsTotalCount > 0)
{
    <table class="govuk-table">
        <caption class="govuk-visually-hidden">Clinical visits for @BseFormat.FormatRbse(Model.Rbse)</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header"
                    aria-sort="@(Model.VDir == "asc" ? "ascending" : "descending")">
                    <a class="govuk-link govuk-link--no-visited-state" href="@Model.VisitsSortUrl()">Visit date</a>
                </th>
                @if (User.IsInRole("DataEntry"))
                {
                    <th scope="col" class="govuk-table__header">Action</th>
                }
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var v in Model.Visits)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@v.VisitDate?.ToString("dd/MM/yyyy")</td>
                    @if (User.IsInRole("DataEntry"))
                    {
                        <td class="govuk-table__cell">
                            <a class="govuk-link govuk-!-margin-right-3"
                               asp-page="/Case/ClinicalVisitEdit"
                               asp-route-rbse="@Model.Rbse"
                               asp-route-id="@v.Id">Edit</a>
                            <form method="post" asp-page-handler="DeleteVisit" style="display:inline" novalidate>
                                <input type="hidden" name="VisitId" value="@v.Id" />
                                <input type="hidden" asp-for="Rbse" />
                                <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0"
                                        onclick="return confirm('Delete this visit date?')">Delete</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

    @if (Model.VisitsTotalPages > 1)
    {
        <nav class="govuk-pagination" role="navigation" aria-label="Clinical visits pagination">
            @if (Model.VPage > 1)
            {
                <div class="govuk-pagination__prev">
                    <a class="govuk-link govuk-pagination__link" href="@Model.VisitsPageUrl(Model.VPage - 1)" rel="prev">
                        <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13"><path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"/></svg>
                        <span class="govuk-pagination__link-title">Previous<span class="govuk-visually-hidden"> page</span></span>
                    </a>
                </div>
            }
            <ul class="govuk-pagination__list">
                @{ int startPage = Math.Max(1, Model.VPage - 4); int endPage = Math.Min(Model.VisitsTotalPages, startPage + 9); }
                @for (int p = startPage; p <= endPage; p++)
                {
                    if (p == Model.VPage)
                    {
                        <li class="govuk-pagination__item govuk-pagination__item--current">
                            <a class="govuk-link govuk-pagination__link" href="@Model.VisitsPageUrl(p)" aria-label="Page @p" aria-current="page">@p</a>
                        </li>
                    }
                    else
                    {
                        <li class="govuk-pagination__item">
                            <a class="govuk-link govuk-pagination__link" href="@Model.VisitsPageUrl(p)" aria-label="Page @p">@p</a>
                        </li>
                    }
                }
            </ul>
            @if (Model.VPage < Model.VisitsTotalPages)
            {
                <div class="govuk-pagination__next">
                    <a class="govuk-link govuk-pagination__link" href="@Model.VisitsPageUrl(Model.VPage + 1)" rel="next">
                        <span class="govuk-pagination__link-title">Next<span class="govuk-visually-hidden"> page</span></span>
                        <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13"><path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7246z"/></svg>
                    </a>
                </div>
            }
        </nav>
    }
}
else
{
    <p class="govuk-body govuk-hint">No clinical visits recorded.</p>
}

@if (User.IsInRole("DataEntry"))
{
    <div class="govuk-button-group govuk-!-margin-top-4">
        <a asp-page="/Case/ClinicalVisitAdd" asp-route-rbse="@Model.Rbse" class="govuk-button govuk-button--secondary">Add a clinical visit</a>
    </div>
}

