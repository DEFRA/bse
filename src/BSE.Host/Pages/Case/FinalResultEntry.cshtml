@page
@model BSE.Host.Pages.Case.FinalResultEntryModel
@{
    ViewData["Title"] = "Final result entry";
    var c = Model.CaseDetails?.Case;
}

<h1 class="govuk-heading-l">Final result entry</h1>

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Final result entry</li>
    </ol>
</nav>

@* Step 1: RBSE lookup *@
@if (Model.CaseDetails is null && !Model.IsNotFound)
{
    <form method="get" novalidate>
        <div class="govuk-form-group">
            <label class="govuk-label" for="lookup-rbse">Enter RBSE</label>
            <div class="govuk-hint">Enter 9 digits with no slashes — for example, 002600001.</div>
            <input id="lookup-rbse" name="LookupRbse" type="text"
                   class="govuk-input govuk-input--width-10"
                   value="@Model.LookupRbse" autocomplete="off" />
        </div>
        <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">Look up</button>
    </form>
}

@* Not found *@
@if (Model.IsNotFound)
{
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-warning-text__assistive">Warning</span>
            No case found for RBSE @Model.LookupRbse.
        </strong>
    </div>
    <form method="get" novalidate>
        <div class="govuk-form-group">
            <label class="govuk-label" for="lookup-rbse-retry">Enter RBSE</label>
            <div class="govuk-hint">Enter 9 digits with no slashes — for example, 002600001.</div>
            <input id="lookup-rbse-retry" name="LookupRbse" type="text"
                   class="govuk-input govuk-input--width-10"
                   value="@Model.LookupRbse" autocomplete="off" />
        </div>
        <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">Look up</button>
    </form>
}

@* Step 2: Case details + edit form *@
@if (Model.CaseDetails is not null || (Model.Rbse?.Length > 0 && !ViewContext.ModelState.IsValid))
{
    @if (!ViewContext.ModelState.IsValid)
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list">
                        @foreach (var e in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@e.ErrorMessage</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    <h2 class="govuk-heading-m">Case @(c?.Rbse ?? Model.Rbse)</h2>

    @if (c is not null)
    {
        <dl class="govuk-summary-list govuk-summary-list--no-border govuk-!-margin-bottom-6">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Eartag</dt>
                <dd class="govuk-summary-list__value">@(c.Eartag ?? "—")</dd>
                <dt class="govuk-summary-list__key">Date of birth</dt>
                <dd class="govuk-summary-list__value">@(c.BirthDate?.ToString("dd/MM/yyyy") ?? "—")</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">CPHH</dt>
                <dd class="govuk-summary-list__value">@c.Cphh</dd>
                <dt class="govuk-summary-list__key">Case type</dt>
                <dd class="govuk-summary-list__value">@(c.CaseType ?? "—")</dd>
            </div>
            @if (Model.Farm is not null)
            {
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Farm owner</dt>
                    <dd class="govuk-summary-list__value">@(Model.Farm.OwnerName ?? "—")</dd>
                    <dt class="govuk-summary-list__key">Address</dt>
                    <dd class="govuk-summary-list__value">@(Model.Farm.Address1 ?? "—")</dd>
                </div>
            }
        </dl>

        <h3 class="govuk-heading-s">BSE1 paperwork</h3>
        <dl class="govuk-summary-list govuk-summary-list--no-border govuk-!-margin-bottom-6">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Purchaser BSE1 received</dt>
                <dd class="govuk-summary-list__value">@(c.IsPurchaserBse1Received ? "Yes" : "No")</dd>
                <dt class="govuk-summary-list__key">Breeder BSE1 received</dt>
                <dd class="govuk-summary-list__value">@(c.IsBreederBse1Received ? "Yes" : "No")</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Vendor 1 BSE1 received</dt>
                <dd class="govuk-summary-list__value">@(c.IsVendor1Bse1Received ? "Yes" : "No")</dd>
                <dt class="govuk-summary-list__key">Homebred BSE1 received</dt>
                <dd class="govuk-summary-list__value">@(c.IsHomebredBse1Received ? "Yes" : "No")</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Summary sheet received</dt>
                <dd class="govuk-summary-list__value">@(c.IsSummarySheetReceived ? "Yes" : "No")</dd>
                <dt class="govuk-summary-list__key">Paperwork complete</dt>
                <dd class="govuk-summary-list__value">@(c.IsPaperworkComplete ? "Yes" : "No")</dd>
            </div>
        </dl>

        @if (Model.CaseDetails?.Tests.Count > 0)
        {
            <h3 class="govuk-heading-s">Test results</h3>
            <table class="govuk-table govuk-!-margin-bottom-6">
                <caption class="govuk-visually-hidden">Test results for case @c.Rbse</caption>
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header">Test Type</th>
                        <th scope="col" class="govuk-table__header">Test Result</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    @foreach (var test in Model.CaseDetails!.Tests)
                    {
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">
                                @(Model.TestTypeDescriptions.TryGetValue(test.TestType, out var typeDesc) ? typeDesc : test.TestType)
                            </td>
                            <td class="govuk-table__cell">
                                @(test.TestResult is not null && Model.TestResultDescriptions.TryGetValue(test.TestResult, out var resDesc) ? resDesc : (test.TestResult ?? "—"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible govuk-!-margin-bottom-6" />

    <h3 class="govuk-heading-s">Record final result</h3>

    <form method="post" novalidate>
        <input type="hidden" asp-for="Rbse" />

        <div class="govuk-form-group @(ViewContext.ModelState[nameof(Model.FinalResult)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
            <label asp-for="FinalResult" class="govuk-label">Final result</label>
            <div class="govuk-hint">Enter the result code — for example, <samp>Pos</samp> for Positive or <samp>Neg</samp> for Negative.</div>
            @if (ViewContext.ModelState[nameof(Model.FinalResult)]?.Errors.Any() == true)
            {
                <p class="govuk-error-message">
                    <span class="govuk-visually-hidden">Error:</span>
                    @ViewContext.ModelState[nameof(Model.FinalResult)]!.Errors.First().ErrorMessage
                </p>
            }
            <input asp-for="FinalResult" class="govuk-input govuk-input--width-5" />
        </div>

        <div class="govuk-form-group @(ViewContext.ModelState[nameof(Model.FinalResultDate)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
            <label asp-for="FinalResultDate" class="govuk-label">Final result date</label>
            @if (ViewContext.ModelState[nameof(Model.FinalResultDate)]?.Errors.Any() == true)
            {
                <p class="govuk-error-message">
                    <span class="govuk-visually-hidden">Error:</span>
                    @ViewContext.ModelState[nameof(Model.FinalResultDate)]!.Errors.First().ErrorMessage
                </p>
            }
            <input asp-for="FinalResultDate" type="date"
                   class="govuk-input govuk-input--width-10"
                   value="@Model.FinalResultDate?.ToString("yyyy-MM-dd")" />
        </div>

        <div class="govuk-form-group">
            <label asp-for="Dbse" class="govuk-label">DBSE number</label>
            <div class="govuk-hint">Required for positive results. Leave blank to clear.</div>
            <input asp-for="Dbse" class="govuk-input govuk-input--width-10" />
        </div>

        <div class="govuk-button-group">
            <button type="submit" class="govuk-button" data-module="govuk-button">Save</button>
            <a asp-page="/Home" class="govuk-link">Cancel</a>
        </div>
    </form>
}
