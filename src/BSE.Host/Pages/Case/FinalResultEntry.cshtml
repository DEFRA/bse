@page "{rbse?}"
@model BSE.Host.Pages.Case.FinalResultEntryModel
@{
    ViewData["Title"] = "Final result entry";
    string Dt(DateTime? d) => d?.ToString("dd/MM/yyyy") ?? "—";
    bool hasCase = Model.FinalResultData is not null;
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Final result entry</li>
    </ol>
</nav>

<h1 class="govuk-heading-l">Final result entry</h1>

@* ── Success banner ─────────────────────────────────────────────────────────── *@
@if (TempData["Success"] is string successMsg)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
         aria-labelledby="fre-success-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="fre-success-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@successMsg</p>
        </div>
    </div>
}

@* ── Error summary ──────────────────────────────────────────────────────────── *@
@if (!ViewContext.ModelState.IsValid)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var kv in ViewContext.ModelState)
                    {
                        foreach (var err in kv.Value!.Errors)
                        {
                            var anchor = kv.Key == string.Empty ? null : kv.Key.ToLower().Replace(".", "-");
                            <li>@if (anchor is not null) { <a href="#@anchor">@err.ErrorMessage</a> } else { @err.ErrorMessage }</li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
}

@* ── RBSE lookup ────────────────────────────────────────────────────────────── *@
<form method="post" asp-page-handler="Lookup" class="govuk-!-margin-bottom-6" novalidate>
    @{
        var rbseError = Model.ModelState[nameof(Model.Rbse)]?.Errors.FirstOrDefault()?.ErrorMessage;
    }
    <div class="govuk-form-group @(rbseError is not null ? "govuk-form-group--error" : "")">
        <label class="govuk-label govuk-label--m" for="rbse-input">RBSE number</label>
        <div class="govuk-hint">For example, 00/26/00001.</div>
        @if (rbseError is not null)
        {
            <p id="rbse-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">Error:</span> @rbseError
            </p>
        }
        <div class="govuk-!-display-flex govuk-!-gap-3 govuk-!-align-items-end">
            <input id="rbse-input" name="Rbse" type="text"
                   class="govuk-input govuk-input--width-10 @(rbseError is not null ? "govuk-input--error" : "")"
                   value="@Model.Rbse" autocomplete="off" />
            <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0"
                    data-module="govuk-button">Look up</button>
        </div>
    </div>
</form>

@if (hasCase)
{
    var d = Model.FinalResultData!;

    @* ── Case summary ──────────────────────────────────────────────────────── *@
    <h2 class="govuk-heading-m">Case details</h2>
    <dl class="govuk-summary-list govuk-!-margin-bottom-6">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Eartag</dt>
            <dd class="govuk-summary-list__value">@(d.Eartag ?? "—")</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Date of birth</dt>
            <dd class="govuk-summary-list__value">@Dt(d.BirthDate)</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">CPHH</dt>
            <dd class="govuk-summary-list__value">@(d.Cphh ?? "—")</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Owner name</dt>
            <dd class="govuk-summary-list__value">@(d.OwnerName ?? "—")</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Address</dt>
            <dd class="govuk-summary-list__value">@(d.Address1 ?? "—")</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Case type</dt>
            <dd class="govuk-summary-list__value">@(d.CaseType ?? "—")</dd>
        </div>
    </dl>

    <h2 class="govuk-heading-m">BSE1 paperwork</h2>
    <dl class="govuk-summary-list govuk-!-margin-bottom-6">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Purchaser BSE1 received?</dt>
            <dd class="govuk-summary-list__value">
                @(d.IsPurchaserBse1Received ? "Yes" : "No")
                @if (d.PurchaserBse1ReceivedDate.HasValue) { <span class="govuk-!-margin-left-2 govuk-body-s govuk-!-colour-secondary">@Dt(d.PurchaserBse1ReceivedDate)</span> }
            </dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Vendor 1 BSE1 received?</dt>
            <dd class="govuk-summary-list__value">
                @(d.IsVendor1Bse1Received ? "Yes" : "No")
                @if (d.Vendor1Bse1ReceivedDate.HasValue) { <span class="govuk-!-margin-left-2 govuk-body-s govuk-!-colour-secondary">@Dt(d.Vendor1Bse1ReceivedDate)</span> }
            </dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Breeder BSE1 received?</dt>
            <dd class="govuk-summary-list__value">
                @(d.IsBreederBse1Received ? "Yes" : "No")
                @if (d.BreederBse1ReceivedDate.HasValue) { <span class="govuk-!-margin-left-2 govuk-body-s govuk-!-colour-secondary">@Dt(d.BreederBse1ReceivedDate)</span> }
            </dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Homebred BSE1 received?</dt>
            <dd class="govuk-summary-list__value">
                @(d.IsHomebredBse1Received ? "Yes" : "No")
                @if (d.HomebredBse1ReceivedDate.HasValue) { <span class="govuk-!-margin-left-2 govuk-body-s govuk-!-colour-secondary">@Dt(d.HomebredBse1ReceivedDate)</span> }
            </dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Summary sheet received?</dt>
            <dd class="govuk-summary-list__value">
                @(d.IsSummarySheetReceived ? "Yes" : "No")
                @if (d.SummarySheetReceivedDate.HasValue) { <span class="govuk-!-margin-left-2 govuk-body-s govuk-!-colour-secondary">@Dt(d.SummarySheetReceivedDate)</span> }
            </dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Paperwork complete?</dt>
            <dd class="govuk-summary-list__value">
                @(d.IsPaperworkComplete ? "Yes" : "No")
                @if (d.PaperworkCompleteDate.HasValue) { <span class="govuk-!-margin-left-2 govuk-body-s govuk-!-colour-secondary">@Dt(d.PaperworkCompleteDate)</span> }
            </dd>
        </div>
    </dl>

    @* ── Test results table ─────────────────────────────────────────────────── *@
    @if (Model.Tests.Count > 0)
    {
        <h2 class="govuk-heading-m">Test results</h2>
        <table class="govuk-table govuk-!-margin-bottom-6">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Test type</th>
                    <th scope="col" class="govuk-table__header">Test result</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var t in Model.Tests)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@(t.TestTypeDescription ?? t.TestType)</td>
                        <td class="govuk-table__cell">@(t.TestResultDescription ?? t.TestResult ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* ── Final result entry form ────────────────────────────────────────────── *@
    <form method="post" asp-page-handler="Save" novalidate>
        <input type="hidden" name="Rbse" value="@Model.Rbse" />
        <input type="hidden" name="RowStampBase64" value="@Model.RowStampBase64" />

        @{
            var frError = Model.ModelState[nameof(Model.FinalResult)]?.Errors.FirstOrDefault()?.ErrorMessage;
        }

        <h2 class="govuk-heading-m">Final result</h2>

        @if (d.FinalResultDate.HasValue)
        {
            <dl class="govuk-summary-list govuk-!-margin-bottom-4">
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Final result date</dt>
                    <dd class="govuk-summary-list__value">@Dt(d.FinalResultDate)</dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">DBSE</dt>
                    <dd class="govuk-summary-list__value">@(d.Dbse ?? "TBC")</dd>
                </div>
            </dl>
        }

        <div class="govuk-form-group @(frError is not null ? "govuk-form-group--error" : "")">
            <label class="govuk-label govuk-label--m" for="final-result">Final result</label>
            @if (frError is not null)
            {
                <p id="finalresult-error" class="govuk-error-message">
                    <span class="govuk-visually-hidden">Error:</span> @frError
                </p>
            }
            <select id="final-result" name="FinalResult"
                    class="govuk-select govuk-!-width-one-half @(frError is not null ? "govuk-select--error" : "")">
                <option value="">— select —</option>
                @foreach (var r in Model.TestResultOptions)
                {
                    <option value="@r.Code" selected="@(r.Code == Model.FinalResult ? "selected" : null)">@r.Description</option>
                }
            </select>
        </div>

        <div class="govuk-form-group">
            <label class="govuk-label govuk-label--m" for="lab-comment">Lab comment</label>
            <textarea id="lab-comment" name="LabComment" class="govuk-textarea govuk-!-width-two-thirds"
                      rows="3" maxlength="255">@Model.LabComment</textarea>
        </div>

        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" />

        <h2 class="govuk-heading-m">Retrospective test</h2>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group">
                    <label class="govuk-label" for="retro-test-type">Retrospective test type</label>
                    <select id="retro-test-type" name="RetrospectiveTestType" class="govuk-select govuk-!-width-full">
                        <option value="">— select —</option>
                        @foreach (var tt in Model.TestTypeOptions)
                        {
                            <option value="@tt.Code" selected="@(tt.Code == Model.RetrospectiveTestType ? "selected" : null)">@tt.Description</option>
                        }
                    </select>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group">
                    <label class="govuk-label" for="retro-result">Retrospective result</label>
                    <select id="retro-result" name="RetrospectiveResult" class="govuk-select govuk-!-width-full">
                        <option value="">— select —</option>
                        @foreach (var tr in Model.TestResultOptions)
                        {
                            <option value="@tr.Code" selected="@(tr.Code == Model.RetrospectiveResult ? "selected" : null)">@tr.Description</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="govuk-form-group">
            <label class="govuk-label" for="retro-date">Retrospective date</label>
            <input id="retro-date" name="RetrospectiveResultDate" type="date"
                   class="govuk-input govuk-input--width-10"
                   value="@(Model.RetrospectiveResultDate?.ToString("yyyy-MM-dd") ?? "")" />
        </div>

        <div class="govuk-form-group">
            <label class="govuk-label" for="retro-comments">Retrospective comments</label>
            <textarea id="retro-comments" name="RetrospectiveComment" class="govuk-textarea govuk-!-width-two-thirds"
                      rows="4" maxlength="500">@Model.RetrospectiveComment</textarea>
        </div>

        <div class="govuk-button-group">
            <button type="submit" class="govuk-button" data-module="govuk-button">Save final result</button>
            <a asp-page="/Home" class="govuk-link">Cancel</a>
        </div>
    </form>
}
