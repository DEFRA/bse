@page "{rbse}"
@model EditModel
@using BSE.Modules.CaseManagement.Models
@{
    ViewData["Title"] = $"Case {Model.Case.Rbse} — DEFRA tab";
    string DateVal(DateTime? d) => d?.ToString("dd/MM/yyyy") ?? "";
    string rbseNoSlash = Model.Case.Rbse.Replace("/", "");
    var viewDocsUrl = string.IsNullOrWhiteSpace(Model.SpolSiteUrl)
        ? null
        : $"{Model.SpolSiteUrl}{rbseNoSlash}";
    var hasFormA = Model.Case.FormADate.HasValue;
    var hasFormB = Model.Case.FormBDate.HasValue;
    var hasBirthDate = Model.Case.BirthDate.HasValue;

    string? eEartag       = ViewData.ModelState["Case.EartagCountry"]?.Errors.FirstOrDefault()?.ErrorMessage;
    string? eFormA         = ViewData.ModelState["Case.FormADate"]?.Errors.FirstOrDefault()?.ErrorMessage;
    string? eFormAResub    = ViewData.ModelState["Case.FormAResubmittedDate"]?.Errors.FirstOrDefault()?.ErrorMessage;
    string? eFormB         = ViewData.ModelState["Case.FormBDate"]?.Errors.FirstOrDefault()?.ErrorMessage;
    string? eFate          = ViewData.ModelState["Case.Fate"]?.Errors.FirstOrDefault()?.ErrorMessage;
    string? eFormC         = ViewData.ModelState["Case.FormCDate"]?.Errors.FirstOrDefault()?.ErrorMessage;
    string? eBirth         = ViewData.ModelState["Case.BirthDate"]?.Errors.FirstOrDefault()?.ErrorMessage;
    string? ePurchaserBse1 = ViewData.ModelState["Case.PurchaserBse1ReceivedDate"]?.Errors.FirstOrDefault()?.ErrorMessage;
    string? eBreederBse1   = ViewData.ModelState["Case.BreederBse1ReceivedDate"]?.Errors.FirstOrDefault()?.ErrorMessage;
    string? eVendor1Bse1   = ViewData.ModelState["Case.Vendor1Bse1ReceivedDate"]?.Errors.FirstOrDefault()?.ErrorMessage;
    string? eHomebredBse1  = ViewData.ModelState["Case.HomebredBse1ReceivedDate"]?.Errors.FirstOrDefault()?.ErrorMessage;
    string? eSummarySheet  = ViewData.ModelState["Case.SummarySheetReceivedDate"]?.Errors.FirstOrDefault()?.ErrorMessage;
    string? ePaperwork     = ViewData.ModelState["Case.PaperworkCompleteDate"]?.Errors.FirstOrDefault()?.ErrorMessage;

    var showFormCDateWarning = eFormC is null
        && Model.Case.FormCDate.HasValue
        && Model.Case.FormBDate.HasValue
        && Model.Case.FormCDate != Model.Case.FormBDate;

    var showHerdEntryDateWarning = false;
    if (Model.Case.HerdEntryDate.HasValue && Model.Case.BirthDate.HasValue)
    {
        var latestBirthDate = Model.Case.HerdEntryDate.Value.Date.AddMonths(-18);
        var birthDate = Model.Case.BirthDate.Value.Date;
        showHerdEntryDateWarning = !(birthDate >= new DateTime(1970, 1, 1) && birthDate <= latestBirthDate);
    }
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Case (DEFRA)</li>
    </ol>
</nav>

@await Html.PartialAsync("_CaseTabs", new BSE.Host.Models.CaseTabsViewModel("Case (DEFRA)", Model.Case.Rbse, Model.BatchNumbers, viewDocsUrl))

@if (TempData["Success"] is string successMsg)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="defra-success-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="defra-success-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@successMsg</p>
        </div>
    </div>
}

@if (TempData["Warning"] is string warningMsg)
{
    <div class="govuk-notification-banner" role="region"
         aria-labelledby="defra-warning-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="defra-warning-title">Important</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-body">@warningMsg</p>
        </div>
    </div>
}

@if (!ViewContext.ModelState.IsValid)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var e in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@e.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ConcurrencyError))
{
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-warning-text__assistive">Warning</span>
            @Model.ConcurrencyError
        </strong>
    </div>
}

@if (!User.IsInRole("DataEntry"))
{
    <p class="govuk-body">You can view case details but cannot edit this page.</p>
}
else
{
    <form method="post" novalidate id="case-edit-inline-form">
        <input type="hidden" name="Rbse" value="@Model.Rbse" />

        <div id="case-edit-unsaved-banner" class="govuk-inset-text bse-unsaved-banner" role="status" hidden="@(!Model.HasUnsavedChanges)">
            <strong>You have unsaved changes.</strong> Select <strong>Save</strong> to keep them, or <strong>Cancel</strong> to discard them.
        </div>

        <div class="govuk-button-group govuk-!-margin-bottom-4">
            <button type="submit" class="govuk-button" data-module="govuk-button">Save</button>
            <a asp-page="/Case/Edit" asp-page-handler="CancelEdit" asp-route-rbse="@Model.Rbse" class="govuk-link bse-cancel-link">Cancel</a>
        </div>

        <input type="hidden" asp-for="Case.Rbse" />
        <input type="hidden" asp-for="Case.HasCaseWork" />
        <input type="hidden" asp-for="Case.RbseDate" />
        <input type="hidden" asp-for="Case.Sex" />
        <input type="hidden" asp-for="Case.Breed" />
        <input type="hidden" asp-for="Case.Origin" />
        <input type="hidden" asp-for="Case.DamStatus" />
        <input type="hidden" asp-for="Case.SlaughterDate" />
        <input type="hidden" asp-for="Case.OnsetDate" />
        <input type="hidden" asp-for="Case.IsOnsetDateEst" />
        <input type="hidden" asp-for="Case.PurchaseDate" />
        <input type="hidden" asp-for="Case.PurchaseAgeInMonths" />
        <input type="hidden" asp-for="Case.PurchasedCounty" />
        <input type="hidden" asp-for="Case.HerdEntryDate" />
        <input type="hidden" asp-for="Case.MonthsPregnant" />
        <input type="hidden" asp-for="Case.MonthsPostCalving" />
        <input type="hidden" asp-for="Case.OnsetAgeInMonths" />
        <input type="hidden" asp-for="Case.AlternateDiagnosis" />
        <input type="hidden" asp-for="Case.FinalResultDate" />
        <input type="hidden" asp-for="Case.FinalResult" />
        <input type="hidden" asp-for="Case.Dbse" />

        <section class="defra-legacy-panel govuk-!-margin-bottom-6" aria-labelledby="defra-identification-heading">
            <h2 id="defra-identification-heading" class="govuk-visually-hidden">Animal identification</h2>
            <div class="defra-legacy-grid defra-legacy-grid--tight defra-legacy-grid--id">
                <div class="defra-legacy-field @(eEartag is not null ? "govuk-form-group--error" : "")">
                    <label class="govuk-label" for="Case_EartagCountry">Eartag</label>
                    <div>
                        @if (eEartag is not null)
                        {
                            <p id="eartag-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @eEartag</p>
                        }
                        <div class="defra-legacy-eartag-group" aria-describedby="@(eEartag is not null ? "eartag-error" : null)">
                            <label class="govuk-visually-hidden" for="Case_EartagCountry">Country</label>
                            <input asp-for="Case.EartagCountry" id="Case_EartagCountry" class="govuk-input defra-legacy-eartag-country" maxlength="4" spellcheck="false" autocomplete="off" style="text-transform:uppercase" />
                            <label class="govuk-visually-hidden" for="Case_EartagHerdmark">Herdmark</label>
                            <input asp-for="Case.EartagHerdmark" id="Case_EartagHerdmark" class="govuk-input defra-legacy-eartag-herdmark" maxlength="8" spellcheck="false" autocomplete="off" />
                            <label class="govuk-visually-hidden" for="Case_Eartag">Animal number</label>
                            <input asp-for="Case.Eartag" id="Case_Eartag" class="govuk-input defra-legacy-eartag-animal" maxlength="25" spellcheck="false" autocomplete="off" />
                            <span class="bse-eartag-help-inline">
                                <button type="button"
                                        class="bse-eartag-help__icon"
                                        data-eartag-tooltip-trigger
                                        aria-label="Help about eartag format"
                                        aria-controls="case-eartag-help-tooltip"
                                        aria-expanded="false">
                                    <span aria-hidden="true">*</span>
                                </button>
                                <span id="case-eartag-help-tooltip" class="bse-eartag-help__tooltip" role="tooltip" hidden>
                                    Enter the animal eartag in parts: country, herdmark and animal number.
                                </span>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="defra-legacy-field">
                    <label asp-for="Case.PreviousEartag" class="govuk-label">Previous Eartag</label>
                    <input asp-for="Case.PreviousEartag" class="govuk-input defra-legacy-input--md" maxlength="25" />
                </div>
            </div>

            <div class="defra-legacy-grid defra-legacy-grid--tight defra-legacy-grid--id">
                <div class="defra-legacy-field">
                    <label asp-for="Case.Bse1ReceivedDate" class="govuk-label">BSE1 Date Received</label>
                    <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                        <input asp-for="Case.Bse1ReceivedDate" type="text" class="govuk-input defra-legacy-date moj-js-datepicker-input" autocomplete="off" value="@DateVal(Model.Case.Bse1ReceivedDate)" />
                    </div>
                </div>
                <div class="defra-legacy-field"></div>
            </div>

            <div class="defra-legacy-grid">
                <div class="defra-legacy-field @(eFormA is not null ? "govuk-form-group--error" : "")">
                    <label asp-for="Case.FormADate" class="govuk-label">Form A Date</label>
                    @if (eFormA is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @eFormA</p> }
                    <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                        <input asp-for="Case.FormADate" type="text" class="govuk-input defra-legacy-date moj-js-datepicker-input @(eFormA is not null ? "govuk-input--error" : "")" autocomplete="off" value="@DateVal(Model.Case.FormADate)" disabled="@(Model.IsNonGbCase ? "disabled" : null)" />
                    </div>
                    @if (Model.IsNonGbCase)
                    {
                        <input type="hidden" asp-for="Case.FormADate" />
                    }
                </div>
                <div class="defra-legacy-field @(eFormAResub is not null ? "govuk-form-group--error" : "")">
                    <label asp-for="Case.FormAResubmittedDate" class="govuk-label">Form A Resubmitted Date</label>
                    @if (eFormAResub is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @eFormAResub</p> }
                    <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                        <input asp-for="Case.FormAResubmittedDate" type="text" class="govuk-input defra-legacy-date moj-js-datepicker-input @(eFormAResub is not null ? "govuk-input--error" : "")" autocomplete="off" value="@DateVal(Model.Case.FormAResubmittedDate)" disabled="@(!hasFormA)" />
                    </div>
                </div>
            </div>

            <div class="defra-legacy-grid">
                <div class="defra-legacy-field @(eFormB is not null ? "govuk-form-group--error" : "")">
                    <label asp-for="Case.FormBDate" class="govuk-label">Form B Date</label>
                    @if (eFormB is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @eFormB</p> }
                    <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                        <input asp-for="Case.FormBDate" type="text" class="govuk-input defra-legacy-date moj-js-datepicker-input @(eFormB is not null ? "govuk-input--error" : "")" autocomplete="off" value="@DateVal(Model.Case.FormBDate)" disabled="@(!hasFormA)" />
                    </div>
                </div>
                <div class="defra-legacy-field @(eFate is not null ? "govuk-form-group--error" : "")">
                    <label asp-for="Case.Fate" class="govuk-label">Fate (Form B reason)</label>
                    @if (eFate is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @eFate</p> }
                    <select asp-for="Case.Fate" class="govuk-select defra-legacy-input--sm @(eFate is not null ? "govuk-select--error" : "")" disabled="@(!hasFormB)">
                        <option value="">-- Select --</option>
                        @foreach (var o in Model.FateOptions)
                        {
                            <option value="@o.Code" selected="@(o.Code == Model.Case.Fate ? "selected" : null)">@o.Description</option>
                        }
                    </select>
                </div>
            </div>

            <div class="defra-legacy-grid">
                <div class="defra-legacy-field @(eFormC is not null ? "govuk-form-group--error" : "")">
                    <div class="bse-eartag-help-inline">
                        <label asp-for="Case.FormCDate" class="govuk-label">Form C Date</label>
                        @if (showFormCDateWarning)
                        {
                            <button type="button"
                                    class="bse-eartag-help__icon bse-eartag-help__icon--small"
                                    data-bse-tooltip-trigger
                                    aria-label="Form C date warning"
                                    aria-controls="case-formc-warning-tooltip"
                                    aria-expanded="false">
                                <span aria-hidden="true">*</span>
                            </button>
                            <span id="case-formc-warning-tooltip" class="bse-eartag-help__tooltip" role="tooltip" hidden>
                                Are you sure the Form C Date isn't the same as the Form B Date?
                            </span>
                        }
                    </div>
                    @if (eFormC is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @eFormC</p> }
                    @if (showFormCDateWarning)
                    {
                        <p class="govuk-warning-text govuk-!-margin-bottom-0 govuk-!-font-size-16">
                            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                            <strong class="govuk-warning-text__text"><span class="govuk-warning-text__assistive">Warning</span> Form C date differs from Form B date — please check.</strong>
                        </p>
                    }
                    <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                        <input asp-for="Case.FormCDate" type="text" class="govuk-input defra-legacy-date moj-js-datepicker-input @(eFormC is not null ? "govuk-input--error" : "")" autocomplete="off" value="@DateVal(Model.Case.FormCDate)" disabled="@(!hasFormB)" />
                    </div>
                </div>
                <div class="defra-legacy-field"></div>
            </div>

            <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" />

            <h2 class="govuk-visually-hidden">Test records</h2>
            <table class="govuk-table">
                <caption class="govuk-visually-hidden">Test records for @BseFormat.FormatRbse(Model.Case.Rbse)</caption>
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header" aria-sort="@(Model.TSort=="type" ? (Model.TDir=="asc" ? "ascending" : "descending") : "none")">
                            <a class="govuk-link govuk-link--no-visited-state" href="@Model.TestsSortUrl("type")">Test type</a>
                        </th>
                        <th scope="col" class="govuk-table__header" aria-sort="@(Model.TSort=="result" ? (Model.TDir=="asc" ? "ascending" : "descending") : "none")">
                            <a class="govuk-link govuk-link--no-visited-state" href="@Model.TestsSortUrl("result")">Test result</a>
                        </th>
                        <th scope="col" class="govuk-table__header">Action</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    @if (!Model.Tests.Any())
                    {
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell" colspan="3">No test records for this case.</td>
                        </tr>
                    }

                    @foreach (var t in Model.Tests)
                    {
                        var isEditingTest = Model.ReopenEditTestId == t.Id;
                        <tr class="govuk-table__row">
                            @if (isEditingTest)
                            {
                                <td class="govuk-table__cell">
                                    <label class="govuk-visually-hidden" for="edit-test-type-@t.Id">Test type</label>
                                    <select id="edit-test-type-@t.Id" name="EditTestType" class="govuk-select govuk-!-width-one-half">
                                        <option value="">-- Select --</option>
                                        @foreach (var o in Model.TestTypeOptions)
                                        {
                                            <option value="@o.Code" selected="@(string.Equals(Model.EditTestType, o.Code, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@o.Description</option>
                                        }
                                    </select>
                                </td>
                                <td class="govuk-table__cell">
                                    <label class="govuk-visually-hidden" for="edit-test-result-@t.Id">Test result</label>
                                    <select id="edit-test-result-@t.Id" name="EditTestResult" class="govuk-select govuk-!-width-one-half">
                                        <option value="">-- Select --</option>
                                        @foreach (var o in Model.TestResultOptions)
                                        {
                                            <option value="@o.Code" selected="@(string.Equals(Model.EditTestResult, o.Code, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@o.Description</option>
                                        }
                                    </select>
                                </td>
                            }
                            else
                            {
                                <td class="govuk-table__cell">@(t.TestTypeDescription ?? t.TestType)</td>
                                <td class="govuk-table__cell">@(t.TestResultDescription ?? t.TestResult)</td>
                            }
                            <td class="govuk-table__cell">
                                @if (isEditingTest)
                                {
                                    <input type="hidden" name="EditingTestId" value="@t.Id" />
                                    <input type="hidden" name="EditTestRowStampBase64" value="@(t.RowStamp is not null ? Convert.ToBase64String(t.RowStamp) : "")" />
                                    <div class="govuk-button-group bse-row-actions govuk-!-margin-bottom-0">
                                        <button type="submit" asp-page-handler="UpdateTestRow" class="bse-inline-row-button bse-inline-row-button--confirm" data-module="govuk-button">Confirm</button>
                                        <button type="button" class="bse-inline-row-button bse-inline-row-button--secondary js-cancel-edit-test-row" data-id="@t.Id">Cancel</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="govuk-button-group bse-row-actions govuk-!-margin-bottom-0">
                                        <button type="submit" asp-page-handler="BeginEditTestRow" asp-route-id="@t.Id" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">Change</button>
                                        <button type="submit" asp-page-handler="DeleteTest" asp-route-id="@t.Id" class="govuk-button govuk-button--warning govuk-!-margin-bottom-0" onclick="return confirm('Delete this test record?')">Delete</button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }

                    <tr id="add-test-row-inline" class="govuk-table__row bse-herd-row--unsaved" hidden="@(!Model.ShowAddTestRow)">
                        <td class="govuk-table__cell">
                            <label class="govuk-visually-hidden" for="new-test-type">Test type</label>
                            <select id="new-test-type" name="NewTestType" class="govuk-select govuk-!-width-one-half">
                                <option value="">-- Select --</option>
                                @foreach (var o in Model.TestTypeOptions)
                                {
                                    <option value="@o.Code" selected="@(string.Equals(Model.NewTestType, o.Code, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@o.Description</option>
                                }
                            </select>
                        </td>
                        <td class="govuk-table__cell">
                            <label class="govuk-visually-hidden" for="new-test-result">Test result</label>
                            <select id="new-test-result" name="NewTestResult" class="govuk-select govuk-!-width-one-half">
                                <option value="">-- Select --</option>
                                @foreach (var o in Model.TestResultOptions)
                                {
                                    <option value="@o.Code" selected="@(string.Equals(Model.NewTestResult, o.Code, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@o.Description</option>
                                }
                            </select>
                        </td>
                        <td class="govuk-table__cell">
                            <div class="govuk-button-group bse-row-actions govuk-!-margin-bottom-0">
                                <button type="submit" asp-page-handler="AddTestRow" class="bse-inline-row-button bse-inline-row-button--confirm" data-module="govuk-button">Confirm</button>
                                <button type="button" id="cancel-add-test-row" class="bse-inline-row-button bse-inline-row-button--secondary">Cancel</button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>

            @if (Model.TestsTotalPages > 1)
            {
                <nav class="govuk-pagination" role="navigation" aria-label="Test records pagination">
                    @if (Model.TPage > 1)
                    {
                        <div class="govuk-pagination__prev">
                            <a class="govuk-link govuk-pagination__link" href="@Model.TestsPageUrl(Model.TPage - 1)" rel="prev">
                                <span class="govuk-pagination__link-title">Previous<span class="govuk-visually-hidden"> page</span></span>
                            </a>
                        </div>
                    }
                    <ul class="govuk-pagination__list">
                        @{ int tStart = Math.Max(1, Model.TPage - 4); int tEnd = Math.Min(Model.TestsTotalPages, tStart + 9); if (tEnd - tStart < 9) tStart = Math.Max(1, tEnd - 9); }
                        @for (int p = tStart; p <= tEnd; p++)
                        {
                            bool tCur = p == Model.TPage;
                            <li class="govuk-pagination__item @(tCur ? "govuk-pagination__item--current" : "")">
                                @if (tCur) { <a class="govuk-link govuk-pagination__link" href="@Model.TestsPageUrl(p)" aria-label="Page @p" aria-current="page">@p</a> }
                                else       { <a class="govuk-link govuk-pagination__link" href="@Model.TestsPageUrl(p)" aria-label="Page @p">@p</a> }
                            </li>
                        }
                    </ul>
                    @if (Model.TPage < Model.TestsTotalPages)
                    {
                        <div class="govuk-pagination__next">
                            <a class="govuk-link govuk-pagination__link" href="@Model.TestsPageUrl(Model.TPage + 1)" rel="next">
                                <span class="govuk-pagination__link-title">Next<span class="govuk-visually-hidden"> page</span></span>
                            </a>
                        </div>
                    }
                </nav>
            }

            <div class="govuk-button-group govuk-!-margin-bottom-4">
                <button type="button" id="show-add-test-row" class="govuk-button govuk-button--secondary" data-module="govuk-button">Add test record</button>
            </div>

            <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

            <h2 class="govuk-visually-hidden">Case status</h2>
            <div class="defra-legacy-grid defra-legacy-grid--toprow">
                <div class="defra-legacy-field defra-legacy-field--inline">
                    <label class="govuk-label">Final result date</label>
                    <input type="text" class="govuk-input defra-legacy-status-input" value="@(Model.Case.FinalResultDate?.ToString("dd/MM/yyyy") ?? "")" readonly />
                </div>
                <div class="defra-legacy-field defra-legacy-field--inline">
                    <label class="govuk-label">Final result</label>
                    <input type="text" class="govuk-input defra-legacy-status-input" value="@(Model.Case.FinalResult ?? "")" readonly />
                </div>
            </div>

            <div class="defra-legacy-grid">
                <div class="defra-legacy-field">
                    <label asp-for="Case.CaseType" class="govuk-label">Case type</label>
                    <select asp-for="Case.CaseType" class="govuk-select defra-legacy-input--sm">
                        <option value="">-- Select --</option>
                        @foreach (var o in Model.CaseTypeOptions)
                        {
                            <option value="@o.Code" selected="@(o.Code == Model.Case.CaseType ? "selected" : null)">@o.Description</option>
                        }
                    </select>
                </div>
                <div class="defra-legacy-field">
                    <label asp-for="Case.LabComment" class="govuk-label">Lab comment</label>
                    <textarea asp-for="Case.LabComment" class="govuk-textarea defra-legacy-input--sm" rows="2" maxlength="255"></textarea>
                </div>
            </div>

            <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

            <div class="defra-legacy-grid">
                <div class="defra-legacy-field @(eBirth is not null ? "govuk-form-group--error" : "")">
                    <div class="bse-eartag-help-inline">
                        <label asp-for="Case.BirthDate" class="govuk-label">Date of Birth</label>
                        @if (eBirth is null && showHerdEntryDateWarning)
                        {
                            <button type="button"
                                    class="bse-eartag-help__icon bse-eartag-help__icon--small"
                                    data-bse-tooltip-trigger
                                    aria-label="Herd entry date warning"
                                    aria-controls="case-herdentry-warning-tooltip"
                                    aria-expanded="false">
                                <span aria-hidden="true">*</span>
                            </button>
                            <span id="case-herdentry-warning-tooltip" class="bse-eartag-help__tooltip" role="tooltip" hidden>
                                Are you sure the Herd Entry is less than 18 months after the Date of Birth
                            </span>
                        }
                    </div>
                    @if (eBirth is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @eBirth</p> }
                    <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                        <input asp-for="Case.BirthDate" type="text" class="govuk-input defra-legacy-date moj-js-datepicker-input @(eBirth is not null ? "govuk-input--error" : "")" autocomplete="off" value="@DateVal(Model.Case.BirthDate)" />
                    </div>
                </div>
                <div class="defra-legacy-field">
                    <label asp-for="Case.ReportedLocation" class="govuk-label">Reported Location</label>
                    <select asp-for="Case.ReportedLocation" class="govuk-select defra-legacy-input--sm">
                        <option value="">-- Select --</option>
                        @foreach (var o in Model.ReportedLocationOptions)
                        {
                            <option value="@o.Code" selected="@(o.Code == Model.Case.ReportedLocation ? "selected" : null)">@o.Description</option>
                        }
                    </select>
                </div>
            </div>

            <div class="defra-legacy-grid">
                <div class="defra-legacy-field">
                    <label asp-for="Case.BirthDateSource" class="govuk-label">Date Of Birth Source</label>
                    <select asp-for="Case.BirthDateSource" class="govuk-select defra-legacy-input--sm">
                        <option value="">-- Select --</option>
                        @foreach (var o in Model.BirthDateSourceOptions)
                        {
                            <option value="@o.Code" selected="@(o.Code == Model.Case.BirthDateSource ? "selected" : null)">@o.Description</option>
                        }
                    </select>
                </div>
                <div class="defra-legacy-field defra-legacy-field--inline">
                    <label class="govuk-label">DBSE</label>
                    <input type="text" class="govuk-input defra-legacy-status-input" value="@(Model.Case.Dbse ?? "")" disabled />
                </div>
            </div>

            <div class="defra-legacy-grid">
                <div class="defra-legacy-field defra-legacy-field--checkbox-inline">
                    <label asp-for="Case.IsBirthDateEst" class="govuk-label">Is Date Of Birth Estimated?</label>
                    <input asp-for="Case.IsBirthDateEst" type="checkbox" class="defra-legacy-receipt-check defra-legacy-inline-checkbox" />
                </div>
                <div class="defra-legacy-field">
                    <label asp-for="Case.Survey" class="govuk-label">Survey</label>
                    <select asp-for="Case.Survey" class="govuk-select defra-legacy-input--sm">
                        <option value="">-- Select --</option>
                        @foreach (var o in Model.SurveyOptions)
                        {
                            <option value="@o.Code" selected="@(o.Code == Model.Case.Survey ? "selected" : null)">@o.Description</option>
                        }
                    </select>
                </div>
            </div>

            <div class="defra-legacy-grid">
                <div class="defra-legacy-field">
                    <label asp-for="Case.ValuationAge" class="govuk-label">Valuation age</label>
                    <select asp-for="Case.ValuationAge" class="govuk-select defra-legacy-input--sm">
                        <option value="">-- Select --</option>
                        @foreach (var o in Model.ValuationAgeOptions)
                        {
                            <option value="@o.Code" selected="@(o.Code == Model.Case.ValuationAge ? "selected" : null)">@o.Description</option>
                        }
                    </select>
                </div>
                <div class="defra-legacy-field">
                    @if (Model.Case.HasCaseWork)
                    {
                        <label asp-for="Case.Barcode" class="govuk-label">Barcode</label>
                        <input asp-for="Case.Barcode" class="govuk-input defra-legacy-input--sm" maxlength="20" />
                    }
                </div>
            </div>

            <div class="defra-legacy-grid">
                <div class="defra-legacy-field"></div>
                <div class="defra-legacy-field">
                    @if (Model.Case.HasCaseWork)
                    {
                        <label asp-for="Case.AhfReference" class="govuk-label">AHF reference</label>
                        <input asp-for="Case.AhfReference" class="govuk-input defra-legacy-input--sm" maxlength="40" />
                    }
                </div>
            </div>

            <div class="govuk-form-group">
                <label asp-for="Case.Notes" class="govuk-label">Notes</label>
                <textarea asp-for="Case.Notes" class="govuk-textarea defra-legacy-notes" rows="3" maxlength="500"></textarea>
            </div>

            <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

            <h2 class="govuk-visually-hidden">BSE-1 receipts</h2>

            <div class="defra-legacy-receipts-grid">
                <div class="defra-legacy-receipt-row">
                    <label for="Case_IsPurchaserBse1Received" class="govuk-label defra-legacy-receipt-label">Is Purchaser BSE1 Received?</label>
                    <input asp-for="Case.IsPurchaserBse1Received" id="Case_IsPurchaserBse1Received" type="checkbox" class="defra-legacy-receipt-check" />
                    <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                        <input asp-for="Case.PurchaserBse1ReceivedDate" type="text" class="govuk-input defra-legacy-date moj-js-datepicker-input @(ePurchaserBse1 is not null ? "govuk-input--error" : "")" autocomplete="off" value="@DateVal(Model.Case.PurchaserBse1ReceivedDate)" aria-label="Purchaser BSE1 received date" disabled="@(!Model.Case.HasCaseWork)" />
                    </div>
                </div>
                <div class="defra-legacy-receipt-row">
                    <label for="Case_IsBreederBse1Received" class="govuk-label defra-legacy-receipt-label">Is Breeder BSE1 Received?</label>
                    <input asp-for="Case.IsBreederBse1Received" id="Case_IsBreederBse1Received" type="checkbox" class="defra-legacy-receipt-check" />
                    <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                        <input asp-for="Case.BreederBse1ReceivedDate" type="text" class="govuk-input defra-legacy-date moj-js-datepicker-input @(eBreederBse1 is not null ? "govuk-input--error" : "")" autocomplete="off" value="@DateVal(Model.Case.BreederBse1ReceivedDate)" aria-label="Breeder BSE1 received date" disabled="@(!Model.Case.HasCaseWork)" />
                    </div>
                </div>
                <div class="defra-legacy-receipt-row">
                    <label for="Case_IsVendor1Bse1Received" class="govuk-label defra-legacy-receipt-label">Is Vendor 1 BSE1 Received?</label>
                    <input asp-for="Case.IsVendor1Bse1Received" id="Case_IsVendor1Bse1Received" type="checkbox" class="defra-legacy-receipt-check" />
                    <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                        <input asp-for="Case.Vendor1Bse1ReceivedDate" type="text" class="govuk-input defra-legacy-date moj-js-datepicker-input @(eVendor1Bse1 is not null ? "govuk-input--error" : "")" autocomplete="off" value="@DateVal(Model.Case.Vendor1Bse1ReceivedDate)" aria-label="Vendor 1 BSE1 received date" disabled="@(!Model.Case.HasCaseWork)" />
                    </div>
                </div>
                <div class="defra-legacy-receipt-row">
                    <label for="Case_IsHomebredBse1Received" class="govuk-label defra-legacy-receipt-label">Is Homebred BSE1 Received?</label>
                    <input asp-for="Case.IsHomebredBse1Received" id="Case_IsHomebredBse1Received" type="checkbox" class="defra-legacy-receipt-check" />
                    <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                        <input asp-for="Case.HomebredBse1ReceivedDate" type="text" class="govuk-input defra-legacy-date moj-js-datepicker-input @(eHomebredBse1 is not null ? "govuk-input--error" : "")" autocomplete="off" value="@DateVal(Model.Case.HomebredBse1ReceivedDate)" aria-label="Homebred BSE1 received date" disabled="@(!Model.Case.HasCaseWork)" />
                    </div>
                </div>
                <div class="defra-legacy-receipt-row">
                    <label for="Case_IsSummarySheetReceived" class="govuk-label defra-legacy-receipt-label">Is Summary Sheet Received?</label>
                    <input asp-for="Case.IsSummarySheetReceived" id="Case_IsSummarySheetReceived" type="checkbox" class="defra-legacy-receipt-check" />
                    <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                        <input asp-for="Case.SummarySheetReceivedDate" type="text" class="govuk-input defra-legacy-date moj-js-datepicker-input @(eSummarySheet is not null ? "govuk-input--error" : "")" autocomplete="off" value="@DateVal(Model.Case.SummarySheetReceivedDate)" aria-label="Summary sheet received date" disabled="@(!Model.Case.HasCaseWork)" />
                    </div>
                </div>
                <div class="defra-legacy-receipt-row">
                    <label for="Case_IsPaperworkComplete" class="govuk-label defra-legacy-receipt-label">Is Paperwork Complete?</label>
                    <input asp-for="Case.IsPaperworkComplete" id="Case_IsPaperworkComplete" type="checkbox" class="defra-legacy-receipt-check" />
                    <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                        <input asp-for="Case.PaperworkCompleteDate" type="text" class="govuk-input defra-legacy-date moj-js-datepicker-input @(ePaperwork is not null ? "govuk-input--error" : "")" autocomplete="off" value="@DateVal(Model.Case.PaperworkCompleteDate)" aria-label="Paperwork complete date" disabled="@(!Model.Case.HasCaseWork)" />
                    </div>
                </div>
            </div>
        </section>

        <div class="govuk-button-group govuk-!-margin-top-4">
            <button type="submit" class="govuk-button" data-module="govuk-button">Save</button>
            <a asp-page="/Case/Edit" asp-page-handler="CancelEdit" asp-route-rbse="@Model.Rbse" class="govuk-link bse-cancel-link">Cancel</a>
        </div>

        <div class="govuk-!-margin-top-6">
            <ul class="govuk-list">
                @if (Model.HasCaseWorkLink)
                {
                    <li>
                        <a asp-page="/CaseWork/Entry" asp-route-rbse="@Model.Case.Rbse" class="govuk-link">Casework</a>
                    </li>
                }
                <li>
                    <a asp-page="/AuditLog/ByCase" asp-route-rbse="@Model.Case.Rbse" asp-route-returnTo="/Case/Edit" class="govuk-link">Case audit log</a>
                </li>
                @if (!string.IsNullOrWhiteSpace(viewDocsUrl))
                {
                    <li>
                        <a href="@viewDocsUrl" target="_blank" rel="noopener noreferrer" class="govuk-link">
                            View docs<span class="govuk-visually-hidden"> (opens in new tab)</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </form>
}

