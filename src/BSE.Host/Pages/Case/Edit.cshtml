<script>
    (function () {
        var showAddTestBtn = document.getElementById('show-add-test-row');
        var addTestRow = document.getElementById('add-test-row-inline');
        var cancelAddTestBtn = document.getElementById('cancel-add-test-row');
        var tooltipTriggers = Array.prototype.slice.call(document.querySelectorAll('[data-bse-tooltip-trigger], [data-eartag-tooltip-trigger]'));
        var eartagTooltipTrigger = document.querySelector('[data-eartag-tooltip-trigger]');
        var eartagTooltip = document.getElementById('case-eartag-help-tooltip');
        var eartagCountryInput = document.getElementById('Case_EartagCountry');
        var eartagHerdmarkInput = document.getElementById('Case_EartagHerdmark');
        var eartagAnimalInput = document.getElementById('Case_Eartag');
        var formBDateInput = document.getElementById('Case_FormBDate');
        var formCDateInput = document.getElementById('Case_FormCDate');
        var formCWarningTrigger = document.getElementById('case-formc-warning-trigger');
        var formADateInput = document.getElementById('Case_FormADate');
        var formAResubInput = document.getElementById('Case_FormAResubmittedDate');
        var fateSelect = document.getElementById('Case_Fate');
        var fateRequiredStar = document.getElementById('fate-required-star');
        var birthDateInput = document.getElementById('Case_BirthDate');
        var birthDateSourceSelect = document.getElementById('Case_BirthDateSource');
        var isBirthDateEstCheckbox = document.getElementById('Case_IsBirthDateEst');
        var eartagValidateTimer = null;
        var eartagValidateController = null;
        var receivedDatePairs = [
            ['Case_PurchaserBse1ReceivedDate', 'Case_IsPurchaserBse1Received'],
            ['Case_BreederBse1ReceivedDate', 'Case_IsBreederBse1Received'],
            ['Case_Vendor1Bse1ReceivedDate', 'Case_IsVendor1Bse1Received'],
            ['Case_HomebredBse1ReceivedDate', 'Case_IsHomebredBse1Received'],
            ['Case_SummarySheetReceivedDate', 'Case_IsSummarySheetReceived'],
            ['Case_PaperworkCompleteDate', 'Case_IsPaperworkComplete']
        ];

        function getTooltipForTrigger(trigger) {
            if (!trigger) {
                return null;
            }

            var id = trigger.getAttribute('aria-controls');
            return id ? document.getElementById(id) : null;
        }

        function hideTooltipFor(trigger) {
            var tooltip = getTooltipForTrigger(trigger);
            if (!trigger || !tooltip) {
                return;
            }

            tooltip.hidden = true;
            trigger.setAttribute('aria-expanded', 'false');
        }

        function hideAllTooltips(exceptTrigger) {
            tooltipTriggers.forEach(function (trigger) {
                if (exceptTrigger && trigger === exceptTrigger) {
                    return;
                }

                hideTooltipFor(trigger);
            });
        }

        function showTooltipFor(trigger) {
            var tooltip = getTooltipForTrigger(trigger);
            if (!trigger || !tooltip) {
                return;
            }

            if (trigger === eartagTooltipTrigger) {
                updateEartagTooltipText();
            }

            hideAllTooltips(trigger);
            tooltip.hidden = false;
            trigger.setAttribute('aria-expanded', 'true');
        }

        function norm(value) {
            return (value || '').trim().toUpperCase();
        }

        // Local, best-effort format name shown immediately while the authoritative check
        // (OnGetValidateEartag, below) confirms it — this never reports errors itself.
        function resolveEartagHintText(country, herdmark, animal) {
            if (!country && !herdmark && !animal) {
                return 'Enter the animal eartag in parts: country, herdmark and animal number.';
            }

            if (!country) {
                return herdmark ? 'PRE-Barimo' : 'Free format';
            }

            if (country.length > 2) {
                return /^\d/.test(country) ? 'ISO Numeric Country' : 'ISO Alpha Country';
            }

            if (country === 'UK') {
                return 'Mainland GB Numeric';
            }

            var ecCodes = ['AT', 'BE', 'DE', 'DK', 'EL', 'ES', 'FI', 'FR', 'IE', 'IT', 'LU', 'NL', 'PT', 'SE'];
            if (ecCodes.indexOf(country) >= 0) {
                return 'EC non-UK';
            }

            return 'Unknown format';
        }

        function updateEartagTooltipText() {
            if (!eartagTooltip) {
                return;
            }

            var country = norm(eartagCountryInput ? eartagCountryInput.value : '');
            var herdmark = norm(eartagHerdmarkInput ? eartagHerdmarkInput.value : '');
            var animal = norm(eartagAnimalInput ? eartagAnimalInput.value : '');

            function setInvalid(isInvalid) {
                if (eartagTooltipTrigger) {
                    eartagTooltipTrigger.classList.toggle('bse-eartag-help__icon--invalid', !!isInvalid);
                }
            }

            if (!country && !herdmark && !animal) {
                eartagTooltip.textContent = resolveEartagHintText(country, herdmark, animal);
                setInvalid(false);
                return;
            }

            // Show the local format guess immediately, then confirm against the server — which
            // runs the same BSELib.Eartag rules as Save — mirrors legacy's ThreePartEartag.Validate().
            eartagTooltip.textContent = resolveEartagHintText(country, herdmark, animal);
            setInvalid(false);

            if (eartagValidateTimer) {
                clearTimeout(eartagValidateTimer);
            }
            if (eartagValidateController) {
                eartagValidateController.abort();
            }

            eartagValidateTimer = setTimeout(function () {
                eartagValidateController = new AbortController();
                var url = window.location.pathname + '?handler=ValidateEartag'
                    + '&country=' + encodeURIComponent(country)
                    + '&herdmark=' + encodeURIComponent(herdmark)
                    + '&animal=' + encodeURIComponent(animal);

                fetch(url, { signal: eartagValidateController.signal })
                    .then(function (response) { return response.ok ? response.json() : null; })
                    .then(function (result) {
                        if (!result) {
                            return;
                        }
                        if (result.error) {
                            eartagTooltip.textContent = result.error;
                            setInvalid(true);
                        } else {
                            eartagTooltip.textContent = resolveEartagHintText(country, herdmark, animal);
                            setInvalid(false);
                        }
                    })
                    .catch(function () { /* request aborted or failed — local guess stands */ });
            }, 250);
        }

        function updateFormCWarningVisibility() {
            if (!formCWarningTrigger) {
                return;
            }

            var formB = formBDateInput ? formBDateInput.value : '';
            var formC = formCDateInput ? formCDateInput.value : '';
            var show = !!formB && !!formC && formB !== formC;

            formCWarningTrigger.hidden = !show;
            if (!show) {
                hideTooltipFor(formCWarningTrigger);
            }
        }

        // Legacy: lblrfvFate — visible whenever Form B Date has a value and Fate isn't picked yet.
        function updateFateStarVisibility() {
            if (!fateRequiredStar) {
                return;
            }

            var hasFormBValue = !!(formBDateInput && formBDateInput.value);
            var hasFateValue = !!(fateSelect && fateSelect.value);
            fateRequiredStar.hidden = !(hasFormBValue && !hasFateValue);
        }

        // Legacy ctlFormBDate_DateChanged + MakeControlsWritable: clearing Form B blanks and disables
        // Fate/Form C; a Form B value enables both.
        function applyFormBCascade() {
            var hasFormBValue = !!(formBDateInput && formBDateInput.value);

            if (fateSelect) {
                fateSelect.disabled = !hasFormBValue;
                if (!hasFormBValue) {
                    fateSelect.value = '';
                }
            }
            if (formCDateInput) {
                formCDateInput.disabled = !hasFormBValue;
                if (!hasFormBValue) {
                    formCDateInput.value = '';
                }
            }

            updateFateStarVisibility();
            updateFormCWarningVisibility();
        }

        // Legacy ctlFormADate_DateChanged + MakeControlsWritable: clearing Form A blanks and disables
        // Form A Resubmitted/Form B (which in turn cascades to Fate/Form C); a Form A value enables
        // Form A Resubmitted/Form B.
        function applyFormACascade() {
            var hasFormAValue = !!(formADateInput && formADateInput.value);

            if (formAResubInput) {
                formAResubInput.disabled = !hasFormAValue;
                if (!hasFormAValue) {
                    formAResubInput.value = '';
                }
            }
            if (formBDateInput) {
                formBDateInput.disabled = !hasFormAValue;
                if (!hasFormAValue) {
                    formBDateInput.value = '';
                }
            }

            applyFormBCascade();
        }

        // Legacy MakeControlsWritable: BirthDateSource/IsBirthDateEst enabled only once Date of Birth
        // has a value; clearing Date of Birth also un-ticks IsBirthDateEst.
        function applyBirthDateCascade() {
            var hasBirthDateValue = !!(birthDateInput && birthDateInput.value);

            if (birthDateSourceSelect) {
                birthDateSourceSelect.disabled = !hasBirthDateValue;
            }
            if (isBirthDateEstCheckbox) {
                isBirthDateEstCheckbox.disabled = !hasBirthDateValue;
                if (!hasBirthDateValue) {
                    isBirthDateEstCheckbox.checked = false;
                }
            }
        }

        function wireFieldCascades() {
            if (formADateInput) {
                ['input', 'change'].forEach(function (eventName) {
                    formADateInput.addEventListener(eventName, applyFormACascade);
                });
            }
            if (formBDateInput) {
                ['input', 'change'].forEach(function (eventName) {
                    formBDateInput.addEventListener(eventName, applyFormBCascade);
                });
            }
            if (fateSelect) {
                fateSelect.addEventListener('change', updateFateStarVisibility);
            }
            if (birthDateInput) {
                ['input', 'change'].forEach(function (eventName) {
                    birthDateInput.addEventListener(eventName, applyBirthDateCascade);
                });
            }
        }

        // Legacy: entering a received date auto-ticks its checkbox — never auto-unticks.
        function wireReceivedDateCascade() {
            receivedDatePairs.forEach(function (pair) {
                var dateInput = document.getElementById(pair[0]);
                var checkbox = document.getElementById(pair[1]);
                if (!dateInput || !checkbox) {
                    return;
                }

                ['input', 'change'].forEach(function (eventName) {
                    dateInput.addEventListener(eventName, function () {
                        if (dateInput.value) {
                            checkbox.checked = true;
                        }
                    });
                });
            });
        }

        if (eartagTooltipTrigger && eartagTooltip) {
            updateEartagTooltipText();
        }

        updateFormCWarningVisibility();
        wireReceivedDateCascade();
        wireFieldCascades();

        if (tooltipTriggers.length) {
            tooltipTriggers.forEach(function (trigger) {
                var tooltip = getTooltipForTrigger(trigger);
                if (!tooltip) {
                    return;
                }

                trigger.addEventListener('mouseenter', function () { showTooltipFor(trigger); });
                trigger.addEventListener('mouseleave', function () { hideTooltipFor(trigger); });
                trigger.addEventListener('focus', function () { showTooltipFor(trigger); });
                trigger.addEventListener('blur', function () { hideTooltipFor(trigger); });

                trigger.addEventListener('click', function (e) {
                    e.preventDefault();
                    if (tooltip.hidden) {
                        showTooltipFor(trigger);
                    } else {
                        hideTooltipFor(trigger);
                    }
                });

                tooltip.addEventListener('mouseenter', function () { showTooltipFor(trigger); });
                tooltip.addEventListener('mouseleave', function () { hideTooltipFor(trigger); });
            });

            [eartagCountryInput, eartagHerdmarkInput, eartagAnimalInput].forEach(function (el) {
                if (el) {
                    el.addEventListener('input', updateEartagTooltipText);
                    el.addEventListener('change', updateEartagTooltipText);
                }
            });

            [formBDateInput, formCDateInput].forEach(function (el) {
                if (el) {
                    el.addEventListener('input', updateFormCWarningVisibility);
                    el.addEventListener('change', updateFormCWarningVisibility);
                }
            });

            document.addEventListener('click', function (e) {
                var clickedInsideTooltipOrTrigger = tooltipTriggers.some(function (trigger) {
                    var tooltip = getTooltipForTrigger(trigger);
                    return trigger.contains(e.target) || (tooltip && tooltip.contains(e.target));
                });

                if (!clickedInsideTooltipOrTrigger) {
                    hideAllTooltips();
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    hideAllTooltips();
                }
            });
        }

        if (showAddTestBtn && addTestRow) {
            showAddTestBtn.addEventListener('click', function () {
                addTestRow.hidden = false;
                showAddTestBtn.hidden = true;
                var firstInput = addTestRow.querySelector('select');
                if (firstInput) { firstInput.focus(); }
            });
        }

        if (cancelAddTestBtn && addTestRow && showAddTestBtn) {
            cancelAddTestBtn.addEventListener('click', function () {
                addTestRow.hidden = true;
                showAddTestBtn.hidden = false;
                cancelAddTestBtn.blur();
            });
        }

        document.querySelectorAll('.js-cancel-edit-test-row').forEach(function (btn) {
            btn.addEventListener('click', function () {
                window.location.href = window.location.pathname + window.location.search;
            });
        });

        // Legacy's Cancel is a postback that captures the current form before checking for
        // changes, so edits typed on this tab but never staged anywhere must count as unsaved too.
        var cancelForm = document.getElementById('case-edit-inline-form');
        var formDirty = false;
        if (cancelForm) {
            cancelForm.addEventListener('input', function () { formDirty = true; });
            cancelForm.addEventListener('change', function () { formDirty = true; });
        }

        document.querySelectorAll('.bse-cancel-link').forEach(function (lnk) {
            lnk.addEventListener('click', function (e) {
                e.preventDefault();
                var hasUnsavedHere = formDirty || @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HasUnsavedChanges));
                // Legacy's dirty-check spans the whole shared session (every tab), not just this page.
                (hasUnsavedHere ? Promise.resolve(true) : (window.hasUnsavedChangesAcrossTabs ? window.hasUnsavedChangesAcrossTabs() : Promise.resolve(false)))
                    .then(function (hasUnsaved) {
                        if (!hasUnsaved || window.confirm('Are you sure you want to cancel? Any unsaved changes will be lost.')) {
                            window.location.href = lnk.href;
                        }
                    });
            });
        });
    })();
</script>

