               class="govuk-link">View docs<span class="govuk-visually-hidden"> (opens in new tab)</span></a>
        }
        <a id="cancel-link" asp-page="/Case/Vla" asp-route-rbse="@Model.Case.Rbse" class="govuk-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        // Origin = "P" (Purchased) controls purchase section visibility; mirrors legacy MakeControlsWritable + ddlOrigin_SelectedIndexChanged
        (function () {
            var originSel = document.getElementById('Case_Origin');
            var section   = document.getElementById('purchase-section');

            function hasPurchaseData() {
                var d = document.getElementById('Case_PurchaseDate');
                var m = document.getElementById('Case_PurchaseAgeInMonths');
                var y = document.getElementById('age-purchased-years');
                var c = document.getElementById('Case_PurchasedCounty');
                return (d && d.value) || (m && m.value) || (y && y.value) || (c && c.value);
            }

            function clearPurchaseData() {
                ['Case_PurchaseDate', 'Case_PurchaseAgeInMonths', 'age-purchased-years'].forEach(function (id) {
                    var el = document.getElementById(id); if (el) el.value = '';
                });
                var c = document.getElementById('Case_PurchasedCounty');
                if (c) c.value = '';
            }

            function applyVisibility() {
                if (!section || !originSel) return;
                section.style.display = (originSel.value === 'P') ? '' : 'none';
            }

            if (originSel) {
                originSel.addEventListener('change', function () {
                    if (originSel.value !== 'P') {
                        // mirrors legacy EmptyPurchaseFields + EmptyTracedFields warnings
                        var msgs = [];
                        if (hasPurchaseData())
                            msgs.push('Purchase data has been entered on this Case.  If you click Save then this data will be lost.');
                        msgs.push('Changing the origin away from Purchased may also affect the Traced data entered on the BAB tab.');
                        alert(msgs.join('\n\n'));
                        clearPurchaseData();
                    }
                    applyVisibility();
                });
            }
            applyVisibility();
        }());

        // Calculate Age Purchased and Onset Age; mirrors legacy btnCalculateAgePurchased/btnCalculateOnsetAge
        (function () {
            function monthsBetween(dateStr1, dateStr2) {
                var d1 = new Date(dateStr1), d2 = new Date(dateStr2);
                return (d2.getFullYear() - d1.getFullYear()) * 12 + (d2.getMonth() - d1.getMonth());
            }
            function updateOnsetWarning() {
                var total = parseInt(document.getElementById('Case_OnsetAgeInMonths').value || '');
                var warn = document.getElementById('onset-age-warning');
                if (warn) warn.style.display = (!isNaN(total) && total < 18) ? '' : 'none';
            }
            function calculate(birthId, refDateId, yearsId, totalId) {
                var birth = document.getElementById(birthId)?.value;
                var ref   = document.getElementById(refDateId)?.value;
                var yrs   = document.getElementById(yearsId);
                var tot   = document.getElementById(totalId);
                if (birth && ref) {
                    var m = monthsBetween(birth, ref);
                    if (tot) tot.value = Math.max(0, m);
                } else {
                    var years  = parseInt(yrs?.value || '0') || 0;
                    var months = parseInt(tot?.value || '0') || 0;
                    if (years > 0) {
                        if (tot) tot.value = years * 12 + months;
                    }
                }
                if (yrs) yrs.value = '';
                updateOnsetWarning();
            }
            document.getElementById('btn-calc-age-purchased')?.addEventListener('click', function () {
                calculate('Case_BirthDate', 'Case_PurchaseDate', 'age-purchased-years', 'Case_PurchaseAgeInMonths');
            });
            document.getElementById('btn-calc-onset-age')?.addEventListener('click', function () {
                calculate('Case_BirthDate', 'Case_OnsetDate', 'onset-age-years', 'Case_OnsetAgeInMonths');
            });
            document.getElementById('Case_OnsetAgeInMonths')?.addEventListener('change', updateOnsetWarning);
            updateOnsetWarning();
        }());

        // Legacy-style immediate green/red star indicators; mirrors legacy CaseEntryVLA.aspx.vb
        // (lblInformDEFRA, lblOnsetDateWarning, lblHerdDateWarning, lblPregnantError), which showed
        // these on postback triggered by AutoPostBack date controls. Here they update instantly as
        // the user edits the field, without waiting for Save.
        (function () {
            function parseDmy(value) {
                if (!value) return null;
                var parts = value.split('/');
                if (parts.length === 3) {
                    var yearPart = parts[2].trim().split(/\s/)[0];
                    var d = new Date(Number(yearPart), Number(parts[1]) - 1, Number(parts[0]));
                    if (!isNaN(d.getTime())) return d;
                }
                // Fallback for non-dd/mm/yyyy values (e.g. hidden pass-through fields rendered
                // in the server's default DateTime format, such as Case_FormADate).
                var fallback = new Date(value);
                return isNaN(fallback.getTime()) ? null : fallback;
            }
            function addMonths(date, months) {
                var d = new Date(date.getTime());
                d.setMonth(d.getMonth() + months);
                return d;
            }

            // Date of birth: mirrors legacy ctlDateOfBirth_DateChanged / lblInformDEFRA
            var birthDateInput = document.getElementById('Case_BirthDate');
            var informDefraStar = document.getElementById('birth-date-inform-defra');
            if (birthDateInput && informDefraStar) {
                birthDateInput.addEventListener('change', function () {
                    var hadOriginalValue = !!birthDateInput.getAttribute('data-original-value');
                    informDefraStar.style.display = hadOriginalValue ? '' : 'none';
                });
            }

            // Onset date vs Form A date: mirrors legacy CheckOnsetDate / lblOnsetDateWarning
            var onsetDateInput = document.getElementById('Case_OnsetDate');
            var onsetDateWarningStar = document.getElementById('onset-date-warning-star');
            var formADateInput = document.getElementById('Case_FormADate');
            function updateOnsetDateWarning() {
                if (!onsetDateInput || !onsetDateWarningStar) return;
                var onsetDate = parseDmy(onsetDateInput.value);
                var formADate = formADateInput ? parseDmy(formADateInput.value) : null;
                var show = false;
                if (onsetDate && formADate) {
                    show = onsetDate < addMonths(formADate, -3);
                }
                onsetDateWarningStar.style.display = show ? '' : 'none';
            }
            if (onsetDateInput) onsetDateInput.addEventListener('change', updateOnsetDateWarning);
            updateOnsetDateWarning();

            // Herd entry date vs Date of birth + 18 months: mirrors legacy CheckHerdEntryDate / lblHerdDateWarning
            var herdEntryDateInput = document.getElementById('Case_HerdEntryDate');
            var herdDateWarningStar = document.getElementById('herd-entry-date-warning-star');
            function updateHerdEntryDateWarning() {
                if (!herdEntryDateInput || !herdDateWarningStar) return;
                var herdEntryDate = parseDmy(herdEntryDateInput.value);
                var birthDate = birthDateInput ? parseDmy(birthDateInput.value) : null;
                var show = false;
                if (herdEntryDate && birthDate) {
                    show = herdEntryDate < addMonths(birthDate, 18);
                }
                herdDateWarningStar.style.display = show ? '' : 'none';
            }
            if (herdEntryDateInput) herdEntryDateInput.addEventListener('change', updateHerdEntryDateWarning);
            if (birthDateInput) birthDateInput.addEventListener('change', updateHerdEntryDateWarning);
            updateHerdEntryDateWarning();

            // Slaughter date vs birth date / Form A date / today: mirrors legacy CheckSlaughterDate server rules,
            // shown live instead of waiting for the Save postback.
            var slaughterDateInput = document.getElementById('Case_SlaughterDate');
            var slaughterDateErrorStar = document.getElementById('slaughter-date-error-star');
            var slaughterDateErrorMessage = document.getElementById('slaughter-date-error-message');
            var slaughterDateErrorText = document.getElementById('slaughter-date-error-text');
            var slaughterDateFormGroup = slaughterDateInput ? slaughterDateInput.closest('.govuk-form-group') : null;
            function updateSlaughterDateWarning() {
                if (!slaughterDateInput || !slaughterDateErrorStar) return;
                var slaughterDate = parseDmy(slaughterDateInput.value);
                var formADate = formADateInput ? parseDmy(formADateInput.value) : null;
                var birthDate = birthDateInput ? parseDmy(birthDateInput.value) : null;
                var message = '';

                if (slaughterDate) {
                    var today = new Date();
                    today.setHours(0, 0, 0, 0);
                    if (slaughterDate > today) {
                        message = 'Slaughter date must not be in the future.';
                    } else if (formADate && slaughterDate < formADate) {
                        message = 'Slaughter date must be after the Form A date.';
                    } else if (!formADate && birthDate && slaughterDate < birthDate) {
                        message = 'Slaughter date must be after the birth date.';
                    }
                }

                var show = message !== '';
                slaughterDateErrorStar.style.display = show ? '' : 'none';
                if (slaughterDateErrorMessage && slaughterDateErrorText) {
                    slaughterDateErrorText.textContent = message;
                    slaughterDateErrorMessage.style.display = show ? '' : 'none';
                }
                if (slaughterDateFormGroup) {
                    slaughterDateFormGroup.classList.toggle('govuk-form-group--error', show);
                }
                if (slaughterDateInput) {
                    slaughterDateInput.classList.toggle('govuk-input--error', show);
                }
            }
            if (slaughterDateInput) slaughterDateInput.addEventListener('change', updateSlaughterDateWarning);
            if (formADateInput) formADateInput.addEventListener('change', updateSlaughterDateWarning);
            if (birthDateInput) birthDateInput.addEventListener('change', updateSlaughterDateWarning);
            updateSlaughterDateWarning();

            // Months pregnant / Months post calving mutual exclusion: mirrors legacy lblPregnantError
            var monthsPregnantInput = document.getElementById('Case_MonthsPregnant');
            var monthsPostCalvingInput = document.getElementById('Case_MonthsPostCalving');
            var pregnantErrorStar = document.getElementById('pregnant-error-star');
            var calvingErrorStar = document.getElementById('calving-error-star');
            function updatePregnantCalvingError() {
                var show = !!(monthsPregnantInput && monthsPregnantInput.value && monthsPostCalvingInput && monthsPostCalvingInput.value);
                if (pregnantErrorStar) pregnantErrorStar.style.display = show ? '' : 'none';
                if (calvingErrorStar) calvingErrorStar.style.display = show ? '' : 'none';
            }
            if (monthsPregnantInput) monthsPregnantInput.addEventListener('input', updatePregnantCalvingError);
            if (monthsPostCalvingInput) monthsPostCalvingInput.addEventListener('input', updatePregnantCalvingError);
            updatePregnantCalvingError();

            // Instant numeric-format/range checks: mirrors legacy RegularExpressionValidators
            // (revMonthsPregnant, revMonthsPostCalving, revAgePurchasedYears, revAgePurchasedMonths,
            // revOnsetAgeYears, revOnsetAgeMonths) which validated purely client-side on blur/change.
            function wireIntegerCheck(inputId, starId, regex) {
                var input = document.getElementById(inputId);
                var star = document.getElementById(starId);
                if (!input || !star) return;
                function check() {
                    var value = input.value;
                    var show = value !== '' && !regex.test(value);
                    star.style.display = show ? '' : 'none';
                }
                input.addEventListener('input', check);
                input.addEventListener('blur', check);
                check();
            }
            wireIntegerCheck('Case_MonthsPregnant', 'pregnant-range-error-star', /^[1-9]$/);
            wireIntegerCheck('Case_MonthsPostCalving', 'calving-range-error-star', /^[1-3]$/);
            wireIntegerCheck('age-purchased-years', 'age-purchased-years-error-star', /^[0-9]{1,2}$/);
            wireIntegerCheck('Case_PurchaseAgeInMonths', 'age-purchased-months-error-star', /^[0-9]{1,4}$/);
            wireIntegerCheck('onset-age-years', 'onset-age-years-error-star', /^[0-9]{1,2}$/);
            wireIntegerCheck('Case_OnsetAgeInMonths', 'onset-age-months-error-star', /^[0-9]{1,4}$/);
        }());

        // Unsaved-changes prompt
        (function () {
            var form = document.getElementById('edit-vla-form');
            var saved = false;
            if (!form) return;
            form.addEventListener('submit', function () { saved = true; });
            window.addEventListener('beforeunload', function (e) {
                if (window.__bseCaseTabNavigationInProgress) return;
                if (!saved) { e.preventDefault(); e.returnValue = ''; }
            });
            var cancelLink = document.getElementById('cancel-link');
            if (cancelLink) {
                cancelLink.addEventListener('click', function (e) {
                    if (!saved && !confirm('You have unsaved changes. Are you sure you want to cancel?')) {
                        e.preventDefault();
                    } else { saved = true; }
                });
            }
        }());
    </script>
}
