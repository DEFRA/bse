    </div>@* end purchase-section *@

    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" />

    <h2 class="govuk-heading-m">Clinical details</h2>

    <div class="govuk-form-group @(ViewData.ModelState["Case.HerdEntryDate"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
        <label asp-for="Case.HerdEntryDate" class="govuk-label">Herd entry date</label>
        @if (ViewData.ModelState["Case.HerdEntryDate"]?.Errors.Count > 0)
        {
            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @ViewData.ModelState["Case.HerdEntryDate"]!.Errors[0].ErrorMessage</p>
        }
        <input asp-for="Case.HerdEntryDate" type="date" class="govuk-input govuk-input--width-10 @(ViewData.ModelState["Case.HerdEntryDate"]?.Errors.Count > 0 ? "govuk-input--error" : "")"
               value="@DateVal(Model.Case.HerdEntryDate)" />
    </div>
    <div class="govuk-form-group @(ViewData.ModelState["Case.OnsetDate"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
        <label asp-for="Case.OnsetDate" class="govuk-label">Onset date</label>
        @if (ViewData.ModelState["Case.OnsetDate"]?.Errors.Count > 0)
        {
            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @ViewData.ModelState["Case.OnsetDate"]!.Errors[0].ErrorMessage</p>
        }
        <input asp-for="Case.OnsetDate" type="date" class="govuk-input govuk-input--width-10 @(ViewData.ModelState["Case.OnsetDate"]?.Errors.Count > 0 ? "govuk-input--error" : "")"
               value="@DateVal(Model.Case.OnsetDate)" />
    </div>
    <div class="govuk-form-group">
        <div class="govuk-checkboxes" data-module="govuk-checkboxes">
            <div class="govuk-checkboxes__item">
                <input asp-for="Case.IsOnsetDateEst" type="checkbox" class="govuk-checkboxes__input" />
                <label asp-for="Case.IsOnsetDateEst" class="govuk-label govuk-checkboxes__label">Onset date estimated?</label>
            </div>
        </div>
    </div>
    <div class="govuk-form-group @(ViewData.ModelState["Case.MonthsPregnant"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
        <label asp-for="Case.MonthsPregnant" class="govuk-label">Months pregnant</label>
        @if (ViewData.ModelState["Case.MonthsPregnant"]?.Errors.Count > 0)
        {
            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @ViewData.ModelState["Case.MonthsPregnant"]!.Errors[0].ErrorMessage</p>
        }
        <input asp-for="Case.MonthsPregnant" type="number" class="govuk-input govuk-input--width-5 @(ViewData.ModelState["Case.MonthsPregnant"]?.Errors.Count > 0 ? "govuk-input--error" : "")" min="1" max="9" />
    </div>
    <div class="govuk-form-group @(ViewData.ModelState["Case.MonthsPostCalving"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
        <label asp-for="Case.MonthsPostCalving" class="govuk-label">Months post calving</label>
        @if (ViewData.ModelState["Case.MonthsPostCalving"]?.Errors.Count > 0)
        {
            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @ViewData.ModelState["Case.MonthsPostCalving"]!.Errors[0].ErrorMessage</p>
        }
        <input asp-for="Case.MonthsPostCalving" type="number" class="govuk-input govuk-input--width-5 @(ViewData.ModelState["Case.MonthsPostCalving"]?.Errors.Count > 0 ? "govuk-input--error" : "")" min="1" max="3" />
    </div>
    <div class="govuk-form-group @(ViewData.ModelState["Case.OnsetAgeInMonths"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
        <fieldset class="govuk-fieldset">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Onset age</legend>
            @if (ViewData.ModelState["Case.OnsetAgeInMonths"]?.Errors.Count > 0)
            {
                <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @ViewData.ModelState["Case.OnsetAgeInMonths"]!.Errors[0].ErrorMessage</p>
            }
            <div class="govuk-date-input">
                <div class="govuk-date-input__item">
                    <div class="govuk-form-group">
                        <label class="govuk-label govuk-date-input__label" for="onset-age-years">Years</label>
                        <input class="govuk-input govuk-date-input__input govuk-input--width-3"
                               id="onset-age-years" type="number" min="0" max="99" />
                    </div>
                </div>
                <div class="govuk-date-input__item">
                    <div class="govuk-form-group">
                        <label class="govuk-label govuk-date-input__label" for="Case_OnsetAgeInMonths">Total months</label>
                        <input asp-for="Case.OnsetAgeInMonths"
                               class="govuk-input govuk-date-input__input govuk-input--width-4 @(ViewData.ModelState["Case.OnsetAgeInMonths"]?.Errors.Count > 0 ? "govuk-input--error" : "")"
                               type="number" min="0" />
                    </div>
                </div>
            </div>
        </fieldset>
        <button type="button" id="btn-calc-onset-age"
                class="govuk-button govuk-button--secondary govuk-!-margin-top-2 govuk-!-margin-bottom-0"
                title="Calculate from Date of birth and Onset date">Calculate</button>
    </div>
    <div id="onset-age-warning" class="govuk-warning-text govuk-!-margin-bottom-2" style="@(Model.Case.OnsetAgeInMonths.HasValue && Model.Case.OnsetAgeInMonths.Value < 18 ? "" : "display:none")">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text"><span class="govuk-warning-text__assistive">Warning</span> Onset age appears to be less than 18 months &mdash; please check.</strong>
    </div>

    <div class="govuk-form-group @(ViewData.ModelState["Case.SlaughterDate"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
        <label asp-for="Case.SlaughterDate" class="govuk-label">Slaughter date</label>
        @if (ViewData.ModelState["Case.SlaughterDate"]?.Errors.Count > 0)
        {
            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @ViewData.ModelState["Case.SlaughterDate"]!.Errors[0].ErrorMessage</p>
        }
        <input asp-for="Case.SlaughterDate" type="date"
               class="govuk-input govuk-input--width-10 @(ViewData.ModelState["Case.SlaughterDate"]?.Errors.Count > 0 ? "govuk-input--error" : "")"
               value="@DateVal(Model.Case.SlaughterDate)" />
    </div>

    <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">Save</button>
        <a asp-page="/AuditLog/ByCase" asp-route-rbse="@Model.Case.Rbse"
           class="govuk-link">Case audit log</a>
        @if (!string.IsNullOrEmpty(Model.SpolSiteUrl))
        {
            <a href="@(Model.SpolSiteUrl)@rbseNoSlash" target="_blank" rel="noopener noreferrer"
               class="govuk-link">View docs<span class="govuk-visually-hidden"> (opens in new tab)</span></a>
        }
        <a id="cancel-link" asp-page="/Case/Vla" asp-route-rbse="@Model.Case.Rbse" class="govuk-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        // Origin = "P" (Purchased) controls purchase section visibility; mirrors legacy MakeControlsWritable + ddlOrigin_SelectedIndexChanged
        (function () {
            var originSel = document.getElementById('Case_Origin');
            var section   = document.getElementById('purchase-section');

            function hasPurchaseData() {
                var d = document.getElementById('Case_PurchaseDate');
                var m = document.getElementById('Case_PurchaseAgeInMonths');
                var y = document.getElementById('age-purchased-years');
                var c = document.getElementById('Case_PurchasedCounty');
                return (d && d.value) || (m && m.value) || (y && y.value) || (c && c.value);
            }

            function clearPurchaseData() {
                ['Case_PurchaseDate', 'Case_PurchaseAgeInMonths', 'age-purchased-years'].forEach(function (id) {
                    var el = document.getElementById(id); if (el) el.value = '';
                });
                var c = document.getElementById('Case_PurchasedCounty');
                if (c) c.value = '';
            }

            function applyVisibility() {
                if (!section || !originSel) return;
                section.style.display = (originSel.value === 'P') ? '' : 'none';
            }

            if (originSel) {
                originSel.addEventListener('change', function () {
                    if (originSel.value !== 'P') {
                        // mirrors legacy EmptyPurchaseFields + EmptyTracedFields warnings
                        var msgs = [];
                        if (hasPurchaseData())
                            msgs.push('Purchase data has been entered on this Case.  If you click Save then this data will be lost.');
                        msgs.push('Changing the origin away from Purchased may also affect the Traced data entered on the BAB tab.');
                        alert(msgs.join('\n\n'));
                        clearPurchaseData();
                    }
                    applyVisibility();
                });
            }
            applyVisibility();
        }());

        // Calculate Age Purchased and Onset Age; mirrors legacy btnCalculateAgePurchased/btnCalculateOnsetAge
        (function () {
            function monthsBetween(dateStr1, dateStr2) {
                var d1 = new Date(dateStr1), d2 = new Date(dateStr2);
                return (d2.getFullYear() - d1.getFullYear()) * 12 + (d2.getMonth() - d1.getMonth());
            }
            function updateOnsetWarning() {
                var total = parseInt(document.getElementById('Case_OnsetAgeInMonths').value || '');
                var warn = document.getElementById('onset-age-warning');
                if (warn) warn.style.display = (!isNaN(total) && total < 18) ? '' : 'none';
            }
            function calculate(birthId, refDateId, yearsId, totalId) {
                var birth = document.getElementById(birthId)?.value;
                var ref   = document.getElementById(refDateId)?.value;
                var yrs   = document.getElementById(yearsId);
                var tot   = document.getElementById(totalId);
                if (birth && ref) {
                    var m = monthsBetween(birth, ref);
                    if (tot) tot.value = Math.max(0, m);
                } else {
                    var years  = parseInt(yrs?.value || '0') || 0;
                    var months = parseInt(tot?.value || '0') || 0;
                    if (years > 0) {
                        if (tot) tot.value = years * 12 + months;
                    }
                }
                if (yrs) yrs.value = '';
                updateOnsetWarning();
            }
            document.getElementById('btn-calc-age-purchased')?.addEventListener('click', function () {
                calculate('Case_BirthDate', 'Case_PurchaseDate', 'age-purchased-years', 'Case_PurchaseAgeInMonths');
            });
            document.getElementById('btn-calc-onset-age')?.addEventListener('click', function () {
                calculate('Case_BirthDate', 'Case_OnsetDate', 'onset-age-years', 'Case_OnsetAgeInMonths');
            });
            document.getElementById('Case_OnsetAgeInMonths')?.addEventListener('change', updateOnsetWarning);
            updateOnsetWarning();
        }());

        // Unsaved-changes prompt
        (function () {
            var form = document.getElementById('edit-vla-form');
            var saved = false;
            if (!form) return;
            form.addEventListener('submit', function () { saved = true; });
            window.addEventListener('beforeunload', function (e) {
                if (!saved) { e.preventDefault(); e.returnValue = ''; }
            });
            var cancelLink = document.getElementById('cancel-link');
            if (cancelLink) {
                cancelLink.addEventListener('click', function (e) {
                    if (!saved && !confirm('You have unsaved changes. Are you sure you want to cancel?')) {
                        e.preventDefault();
                    } else { saved = true; }
                });
            }
        }());
    </script>
}
