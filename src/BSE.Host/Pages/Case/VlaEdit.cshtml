        <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
            <input asp-for="Case.SlaughterDate" type="text"
                   class="govuk-input govuk-input--width-10 moj-js-datepicker-input @(ViewData.ModelState["Case.SlaughterDate"]?.Errors.Count > 0 ? "govuk-input--error" : "")"
