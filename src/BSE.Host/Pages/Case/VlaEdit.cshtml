        <a asp-page="/AuditLog/ByCase" asp-route-rbse="@Model.Case.Rbse" asp-route-returnTo="/Case/VlaEdit"
           class="govuk-link">Case audit log</a>
        @if (!string.IsNullOrEmpty(Model.SpolSiteUrl))
        {
