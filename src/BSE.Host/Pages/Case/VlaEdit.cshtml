    <input type="hidden" asp-for="Case.PreviousEartag" />
    <input type="hidden" asp-for="Case.Bse1ReceivedDate" />
    <input type="hidden" id="Case_FormADate" name="Case.FormADate" value="@DateVal(Model.Case.FormADate)" />
    <input type="hidden" asp-for="Case.FormAResubmittedDate" />
    <input type="hidden" asp-for="Case.FormBDate" />
    <input type="hidden" asp-for="Case.Fate" />
    <input type="hidden" asp-for="Case.FormCDate" />
    <input type="hidden" asp-for="Case.IsPurchaserBse1Received" />
    <input type="hidden" asp-for="Case.IsBreederBse1Received" />
    <input type="hidden" asp-for="Case.IsVendor1Bse1Received" />
    <input type="hidden" asp-for="Case.IsHomebredBse1Received" />
    <input type="hidden" asp-for="Case.IsSummarySheetReceived" />
