@page "{rbse}"
@model BSE.Host.Pages.Case.VlaEditModel
@{
    static bool IsSelected(string? optionCode, string? currentValue) =>
        string.Equals(optionCode, currentValue, StringComparison.OrdinalIgnoreCase);
}
@{
    ViewData["Title"] = $"Edit Case (APHA) — {Model.Case.Rbse}";
    string DateVal(DateTime? d) => d?.ToString("dd/MM/yyyy") ?? "";
    string rbseNoSlash = Model.Case.Rbse.Replace("/", "");
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Case/Vla" asp-route-rbse="@Model.Case.Rbse">@BseFormat.FormatRbse(Model.Case.Rbse)</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Edit Case (APHA)</li>
    </ol>
</nav>

@await Html.PartialAsync("_CaseTabs", new BSE.Host.Models.CaseTabsViewModel("Case (VLA)", Model.Case.Rbse, Model.BatchNumbers))

@if (TempData["Success"] is string successMsg)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
         aria-labelledby="vla-edit-success-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="vla-edit-success-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@successMsg</p>
        </div>
    </div>
}

@if (!ViewContext.ModelState.IsValid)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var e in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@e.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ConcurrencyError))
{
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-warning-text__assistive">Warning</span>
            @Model.ConcurrencyError
        </strong>
    </div>
}

<form id="edit-vla-form" method="post" novalidate>

