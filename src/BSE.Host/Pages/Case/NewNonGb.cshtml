@page
@model BSE.Host.Pages.Case.NewNonGbModel
@{
    ViewData["Title"] = "Non-GB Case Creation";
    ViewData["BodyClass"] = "bse-non-gb-case-page";
    var rbseDisplay = BSE.SharedKernel.RbseHelper.Format(Model.Rbse) ?? Model.Rbse;
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Non-GB Case Creation</li>
    </ol>
</nav>

<h1 class="govuk-heading-l govuk-!-margin-bottom-4">Non-GB Case Creation</h1>
<p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-6">RBSE Number: @rbseDisplay</p>

@{
    var errorMessages = ViewContext.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .Distinct(StringComparer.Ordinal)
        .ToList();
}

@if (errorMessages.Count > 0)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var message in errorMessages)
                    {
                        <li>@message</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

<form method="post" asp-page="/Case/NewNonGb" asp-route-rbse="@Model.Rbse" novalidate>
    <input type="hidden" asp-for="Rbse" />

    <div class="bse-farm-legacy bse-non-gb-case-form">
        <section class="bse-farm-legacy__section govuk-!-margin-top-0">
            <div class="bse-farm-legacy__row">
                <div class="bse-farm-legacy__field">
            <div class="govuk-form-group @(ViewContext.ModelState[nameof(Model.Eartag)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                <label class="govuk-label">Eartag</label>
                <span asp-validation-for="Eartag" class="govuk-error-message"></span>
                <div class="bse-non-gb-case-form__eartag">
                    <label asp-for="EartagCountry" class="govuk-visually-hidden">Eartag country</label>
                    <input asp-for="EartagCountry" class="govuk-input bse-non-gb-case-form__eartag-country" maxlength="4" />
                    <label asp-for="EartagHerdmark" class="govuk-visually-hidden">Eartag herdmark</label>
                    <input asp-for="EartagHerdmark" class="govuk-input bse-non-gb-case-form__eartag-herdmark" maxlength="8" />
                    <label asp-for="Eartag" class="govuk-visually-hidden">Eartag animal number</label>
                    <input asp-for="Eartag" class="govuk-input bse-non-gb-case-form__eartag-animal" maxlength="25" />
                </div>
            </div>
                </div>

                <div class="bse-farm-legacy__field">
            <div class="govuk-form-group @(ViewContext.ModelState[nameof(Model.Fate)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                <label asp-for="Fate" class="govuk-label">Fate</label>
                <span asp-validation-for="Fate" class="govuk-error-message"></span>
                <select asp-for="Fate" class="govuk-select bse-farm-legacy__input">
                    @foreach (var option in Model.FateOptions)
                    {
                        <option value="@option.Code">@option.Description</option>
                    }
                </select>
            </div>
                </div>
            </div>

            <div class="bse-farm-legacy__row">
                <div class="bse-farm-legacy__field">
            <div class="govuk-form-group @(ViewContext.ModelState[nameof(Model.FinalResult)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                <label asp-for="FinalResult" class="govuk-label">Final Result</label>
                <span asp-validation-for="FinalResult" class="govuk-error-message"></span>
                <select asp-for="FinalResult" class="govuk-select bse-farm-legacy__input">
                    @foreach (var option in Model.FinalResultOptions)
                    {
                        <option value="@option.Code">@option.Description</option>
                    }
                </select>
            </div>
                </div>

                <div class="bse-farm-legacy__field">
            <div class="govuk-form-group @(ViewContext.ModelState[nameof(Model.FinalResultDate)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                <label asp-for="FinalResultDate" class="govuk-label">Final Result Date</label>
                <span asp-validation-for="FinalResultDate" class="govuk-error-message"></span>
                <input asp-for="FinalResultDate" type="date" class="govuk-input bse-farm-legacy__input"
                       value="@Model.FinalResultDate?.ToString("yyyy-MM-dd")" />
            </div>
                </div>
            </div>

            <div class="bse-farm-legacy__row">
                <div class="bse-farm-legacy__field">
            <div class="govuk-form-group @(ViewContext.ModelState[nameof(Model.SlaughterDate)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                <label asp-for="SlaughterDate" class="govuk-label">Slaughter Date</label>
                <span asp-validation-for="SlaughterDate" class="govuk-error-message"></span>
                <input asp-for="SlaughterDate" type="date" class="govuk-input bse-farm-legacy__input"
                       value="@Model.SlaughterDate?.ToString("yyyy-MM-dd")" />
            </div>
                </div>
                <div class="bse-farm-legacy__field bse-farm-legacy__field--continuation">
                    <label class="govuk-label" aria-hidden="true">&nbsp;</label>
                    <div></div>
                </div>
            </div>
        </section>

        <section class="bse-farm-legacy__section">
            <div class="bse-farm-legacy__row">
                <div class="bse-farm-legacy__field">
            <div class="govuk-form-group @(ViewContext.ModelState[nameof(Model.Cphh)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                <label asp-for="Cphh" class="govuk-label">CPHH</label>
                <span asp-validation-for="Cphh" class="govuk-error-message"></span>
                <div class="bse-non-gb-case-form__lookup-row">
                    <input asp-for="Cphh" class="govuk-input bse-farm-legacy__input" />
                    <button type="submit" asp-page-handler="Lookup" class="govuk-button govuk-button--secondary bse-non-gb-case-form__lookup-btn" data-module="govuk-button">Look Up</button>
                </div>
            </div>
                </div>
                <div class="bse-farm-legacy__field bse-farm-legacy__field--continuation">
                    <label class="govuk-label" aria-hidden="true">&nbsp;</label>
                    <div></div>
                </div>
            </div>

           

            <div class="bse-farm-legacy__row">
                <div class="bse-farm-legacy__field">
            <div class="govuk-form-group @(ViewContext.ModelState[nameof(Model.OwnerName)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                <label asp-for="OwnerName" class="govuk-label">Owner Name</label>
                <span asp-validation-for="OwnerName" class="govuk-error-message"></span>
                <input asp-for="OwnerName" class="govuk-input bse-farm-legacy__input" maxlength="100" readonly="@(!Model.FarmControlsEnabled)" />
            </div>
                </div>

                <div class="bse-farm-legacy__field">
            <div class="govuk-form-group @(ViewContext.ModelState[nameof(Model.County)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                <label asp-for="County" class="govuk-label">County</label>
                <span asp-validation-for="County" class="govuk-error-message"></span>
                <select asp-for="County" class="@("govuk-select bse-farm-legacy__input" + (!Model.FarmControlsEnabled ? " bse-non-gb-case-form__locked" : ""))">
                    <option value=""></option>
                    @foreach (var option in Model.CountyOptions)
                    {
                        <option value="@option.Code">@option.Description</option>
                    }
                </select>
            </div>
                </div>
            </div>

            <div class="bse-farm-legacy__row">
                <div class="bse-farm-legacy__field">
            <div class="govuk-form-group @(ViewContext.ModelState[nameof(Model.Address1)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                <label asp-for="Address1" class="govuk-label">Address</label>
                <span asp-validation-for="Address1" class="govuk-error-message"></span>
                <input asp-for="Address1" class="govuk-input bse-farm-legacy__input" maxlength="50" readonly="@(!Model.FarmControlsEnabled)" />
            </div>
                </div>
                <div class="bse-farm-legacy__field">
            <div class="govuk-form-group">
                <label asp-for="Herdmark1" class="govuk-label">Herdmark</label>
                <input asp-for="Herdmark1" class="govuk-input bse-farm-legacy__input" maxlength="8" readonly="@(!Model.FarmControlsEnabled)" />
            </div>
                </div>
            </div>

            <div class="bse-farm-legacy__row">
                <div class="bse-farm-legacy__field">
            <div class="govuk-form-group">
                <label asp-for="Address2" class="govuk-label govuk-visually-hidden">Address line 2</label>
                <input asp-for="Address2" class="govuk-input bse-farm-legacy__input" maxlength="50" readonly="@(!Model.FarmControlsEnabled)" />
            </div>
                </div>
                <div class="bse-farm-legacy__field">
            <div class="govuk-form-group @(ViewContext.ModelState[nameof(Model.NumericHerdmark1)]?.Errors.Any() == true ? "govuk-form-group--error" : "")">
                <label asp-for="NumericHerdmark1" class="govuk-label">Numeric Herdmark</label>
                <span asp-validation-for="NumericHerdmark1" class="govuk-error-message"></span>
                <input asp-for="NumericHerdmark1" class="govuk-input bse-farm-legacy__input" maxlength="6" readonly="@(!Model.FarmControlsEnabled)" />
            </div>
                </div>
            </div>

            <div class="bse-farm-legacy__row">
                <div class="bse-farm-legacy__field">
            <div class="govuk-form-group">
                <label asp-for="Address3" class="govuk-label govuk-visually-hidden">Address line 3</label>
                <input asp-for="Address3" class="govuk-input bse-farm-legacy__input" maxlength="50" readonly="@(!Model.FarmControlsEnabled)" />
            </div>
                </div>
                <div class="bse-farm-legacy__field bse-farm-legacy__field--continuation">
                    <label class="govuk-label" aria-hidden="true">&nbsp;</label>
                    <div></div>
                </div>
            </div>

            <div class="bse-farm-legacy__row">
                <div class="bse-farm-legacy__field">
            <div class="govuk-form-group">
                <label asp-for="Postcode" class="govuk-label">Postcode</label>
                <input asp-for="Postcode" class="govuk-input bse-farm-legacy__input" maxlength="10" readonly="@(!Model.FarmControlsEnabled)" />
            </div>
                </div>
                <div class="bse-farm-legacy__field bse-farm-legacy__field--continuation">
                    <label class="govuk-label" aria-hidden="true">&nbsp;</label>
                    <div></div>
                </div>
            </div>
        </section>
    </div>

    <div class="govuk-button-group bse-non-gb-case-form__actions">
        <button type="submit" class="govuk-button govuk-!-margin-bottom-0" data-module="govuk-button">Save</button>
        <a asp-page="/Home" class="govuk-link">Cancel</a>
    </div>
</form>
