@page
@model BSE.Host.Pages.Case.NewModel
@{
    ViewData["Title"] = "Create a new case";
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Create a new case</li>
    </ol>
</nav>

<h1 class="govuk-heading-l">Create a new case</h1>

@if (!ViewContext.ModelState.IsValid)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var modelError in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@modelError.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

<form method="post" novalidate>
    <div class="govuk-form-group">
        <label asp-for="Rbse" class="govuk-label">RBSE</label>
        <input asp-for="Rbse" class="govuk-input govuk-!-width-one-half" />
        <span asp-validation-for="Rbse" class="govuk-error-message"></span>
    </div>
    <div class="govuk-form-group">
        <label asp-for="Cphh" class="govuk-label">CPHH</label>
        <input asp-for="Cphh" class="govuk-input govuk-!-width-one-half" aria-describedby="cphh-hint" />
        <span asp-validation-for="Cphh" class="govuk-error-message"></span>
    </div>

    @if (Model.RequireFarmDetails)
    {
        <h2 class="govuk-heading-m">Farm details</h2>
        <p class="govuk-body">No farm record exists for this CPHH yet — enter its details below to create one.</p>
        <div class="govuk-form-group">
            <label asp-for="OwnerName" class="govuk-label">Owner name</label>
            <input asp-for="OwnerName" class="govuk-input govuk-!-width-two-thirds" />
            <span asp-validation-for="OwnerName" class="govuk-error-message"></span>
        </div>
        <div class="govuk-form-group">
            <label asp-for="Address1" class="govuk-label">Address line 1</label>
            <input asp-for="Address1" class="govuk-input govuk-!-width-two-thirds" />
            <span asp-validation-for="Address1" class="govuk-error-message"></span>
        </div>
        <div class="govuk-form-group">
            <label asp-for="Address2" class="govuk-label">Address line 2</label>
            <input asp-for="Address2" class="govuk-input govuk-!-width-two-thirds" />
        </div>
        <div class="govuk-form-group">
            <label asp-for="Address3" class="govuk-label">Address line 3</label>
            <input asp-for="Address3" class="govuk-input govuk-!-width-two-thirds" />
        </div>
        <div class="govuk-form-group">
            <label asp-for="Postcode" class="govuk-label">Postcode</label>
            <input asp-for="Postcode" class="govuk-input govuk-input--width-10" />
        </div>
        <div class="govuk-form-group">
            <label asp-for="Parish" class="govuk-label">Parish</label>
            <input asp-for="Parish" class="govuk-input govuk-!-width-one-half" />
            <span asp-validation-for="Parish" class="govuk-error-message"></span>
        </div>
        <div class="govuk-form-group">
            <label asp-for="County" class="govuk-label">County</label>
            <select asp-for="County" class="govuk-select">
                <option value=""></option>
                @foreach (var option in Model.CountyOptions)
                {
                    <option value="@option.Code">@option.Description</option>
                }
            </select>
            <span asp-validation-for="County" class="govuk-error-message"></span>
        </div>
        <div class="govuk-form-group">
            <label asp-for="Aho" class="govuk-label">AHO</label>
            <select asp-for="Aho" class="govuk-select">
                <option value=""></option>
                @foreach (var option in Model.AhoOptions)
                {
                    <option value="@option.Code">@option.Description</option>
                }
            </select>
            <span asp-validation-for="Aho" class="govuk-error-message"></span>
        </div>
        <div class="govuk-form-group">
            <label asp-for="AdnsRegionId" class="govuk-label">ADNS region</label>
            <select asp-for="AdnsRegionId" class="govuk-select">
                <option value=""></option>
                @foreach (var option in Model.AdnsOptions)
                {
                    <option value="@option.Id">@option.Name</option>
                }
            </select>
            <span asp-validation-for="AdnsRegionId" class="govuk-error-message"></span>
        </div>
    }
    <div class="govuk-form-group">
        <label asp-for="Survey" class="govuk-label">Survey</label>
        <input asp-for="Survey" class="govuk-input govuk-!-width-one-third" />
    </div>
    <div class="govuk-form-group">
        <label asp-for="Sex" class="govuk-label">Sex</label>
        <input asp-for="Sex" class="govuk-input govuk-!-width-one-quarter" />
    </div>
    <div class="govuk-form-group">
        <label asp-for="Breed" class="govuk-label">Breed</label>
        <input asp-for="Breed" class="govuk-input govuk-!-width-one-half" />
    </div>
    <div class="govuk-form-group">
        <label asp-for="EartagCountry" class="govuk-label">Eartag country</label>
        <input asp-for="EartagCountry" class="govuk-input govuk-!-width-one-quarter" />
    </div>
    <div class="govuk-form-group">
        <label asp-for="EartagHerdmark" class="govuk-label">Eartag herdmark</label>
        <input asp-for="EartagHerdmark" class="govuk-input govuk-!-width-one-half" />
    </div>
    <div class="govuk-form-group">
        <label asp-for="Eartag" class="govuk-label">Eartag</label>
        <input asp-for="Eartag" class="govuk-input govuk-!-width-two-thirds" />
        <span asp-validation-for="Eartag" class="govuk-error-message"></span>
    </div>
    <div class="govuk-form-group">
        <label asp-for="BirthDate" class="govuk-label">Birth date</label>
        <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
            <input asp-for="BirthDate" type="text" class="govuk-input govuk-input--width-10 moj-js-datepicker-input" autocomplete="off" value="@(Model.BirthDate?.ToString("dd/MM/yyyy") ?? "")" />
        </div>
    </div>
    <div class="govuk-form-group">
        <label asp-for="FormADate" class="govuk-label">Form A date</label>
        <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
            <input asp-for="FormADate" type="text" class="govuk-input govuk-input--width-10 moj-js-datepicker-input" autocomplete="off" value="@(Model.FormADate?.ToString("dd/MM/yyyy") ?? "")" />
        </div>
        <span asp-validation-for="FormADate" class="govuk-error-message"></span>
    </div>
    <div class="govuk-form-group">
        <label asp-for="Fate" class="govuk-label">Fate</label>
        <input asp-for="Fate" class="govuk-input govuk-!-width-one-half" />
    </div>
    <div class="govuk-form-group">
        <label asp-for="Origin" class="govuk-label">Origin</label>
        <input asp-for="Origin" class="govuk-input govuk-!-width-one-half" />
    </div>
    <div class="govuk-form-group">
        <label asp-for="Notes" class="govuk-label">Notes</label>
        <textarea asp-for="Notes" class="govuk-textarea" rows="4"></textarea>
    </div>

    <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">Create case</button>
        <a asp-page="/Home" class="govuk-link">Cancel</a>
    </div>
</form>
