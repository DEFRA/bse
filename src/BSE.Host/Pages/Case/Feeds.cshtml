@page "{rbse}"
@model BSE.Host.Pages.Case.FeedsModel
@{
    ViewData["Title"] = $"Feed history — {Model.Rbse}";
    string rbseNoSlash = Model.Rbse.Replace("/", "");
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Feeds</li>
    </ol>
</nav>

@await Html.PartialAsync("_CaseTabs", new BSE.Host.Models.CaseTabsViewModel("Feeds", Model.Rbse, Model.BatchNumbers))

@if (TempData["Success"] is string successMsg)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
         aria-labelledby="feeds-success-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="feeds-success-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@successMsg</p>
        </div>
    </div>
}

@if (!ViewContext.ModelState.IsValid)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var e in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@e.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}
@* -- Existing feed records -------------------------------------------------- *@
@if (Model.Feeds.Count > 0)
{
    <table class="govuk-table">
        <caption class="govuk-visually-hidden">Feed history for @Model.Rbse</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                @{
                    var feedsBase = Url.Page("/Case/Feeds", new { rbse = Model.Rbse });
                }
                @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"]="Year From", ["Column"]="YearFrom", ["SortColumn"]=Model.SortColumn, ["SortDesc"]=Model.SortDesc, ["BaseUrl"]=feedsBase })
                @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"]="Year To", ["Column"]="YearTo", ["SortColumn"]=Model.SortColumn, ["SortDesc"]=Model.SortDesc, ["BaseUrl"]=feedsBase })
                @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"]="Ration Type", ["Column"]="RationDescription", ["SortColumn"]=Model.SortColumn, ["SortDesc"]=Model.SortDesc, ["BaseUrl"]=feedsBase })
                @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"]="Supplier", ["Column"]="SupplierName", ["SortColumn"]=Model.SortColumn, ["SortDesc"]=Model.SortDesc, ["BaseUrl"]=feedsBase })
                @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"]="Ration Name", ["Column"]="RationName", ["SortColumn"]=Model.SortColumn, ["SortDesc"]=Model.SortDesc, ["BaseUrl"]=feedsBase })
                @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"]="Is Pre-purchase?", ["Column"]="IsPrePurchase", ["SortColumn"]=Model.SortColumn, ["SortDesc"]=Model.SortDesc, ["BaseUrl"]=feedsBase })
                @if (User.IsInRole("DataEntry"))
                {
                    <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Actions</span></th>
                }
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var f in Model.Feeds)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@f.YearFrom</td>
                    <td class="govuk-table__cell">@f.YearTo</td>
                    <td class="govuk-table__cell">@(f.RationDescription ?? f.RationType)</td>
                    <td class="govuk-table__cell">@f.SupplierName</td>
                    <td class="govuk-table__cell">@f.RationName</td>
                    <td class="govuk-table__cell">@(f.IsPrePurchase ? "Yes" : "No")</td>
                    @if (User.IsInRole("DataEntry"))
                    {
                    <td class="govuk-table__cell">
                        <div class="bse-row-actions">
                            <a class="govuk-link" asp-page="/Case/FeedEdit"
                               asp-route-rbse="@Model.Rbse" asp-route-feedId="@f.Id">Change<span class="govuk-visually-hidden"> feed record @f.YearFrom to @f.YearTo</span></a>
                            <form method="post" asp-page-handler="DeleteFeed" novalidate>
                                <input type="hidden" name="FeedId" value="@f.Id" />
                                <input type="hidden" asp-for="Rbse" />
                                <button type="submit" class="govuk-button govuk-button--secondary"
                                        onclick="return confirm('Delete this feed record?')">Delete<span class="govuk-visually-hidden"> feed record @f.YearFrom to @f.YearTo</span></button>
                            </form>
                        </div>
                    </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="govuk-body govuk-!-colour-secondary">No feed records.</p>
}


@* -- Actions --------------------------------------------------------------- *@
<div class="govuk-button-group govuk-!-margin-top-2">
    @if (User.IsInRole("DataEntry"))
    {
        <a asp-page="/Case/FeedAdd" asp-route-rbse="@Model.Rbse" class="govuk-button govuk-button--secondary">Add As New</a>
    }
    @if (!string.IsNullOrEmpty(Model.SpolSiteUrl))
    {
        <a href="@(Model.SpolSiteUrl)@rbseNoSlash" target="_blank" rel="noopener noreferrer" class="govuk-link">
            View docs<span class="govuk-visually-hidden"> (opens in new tab)</span>
        </a>
    }
</div>

