@page
@using BSE.Host.Helpers
@model MoveCaseModel
@{
    ViewData["Title"] = "Move case";

    var errors = new List<(string Anchor, string Message)>();
    if (Model.RbseError is not null) { errors.Add(("rbse", Model.RbseError)); }
    if (Model.CphhError is not null) { errors.Add(("new-cphh", Model.CphhError)); }
    if (Model.ErrorMessage is not null) { errors.Add(("rbse", Model.ErrorMessage)); }
}

<h1 class="govuk-heading-l">Move Case</h1>

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Move case</li>
    </ol>
</nav>

@if (errors.Count > 0)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var error in errors)
                    {
                        <li><a href="#@error.Anchor">@error.Message</a></li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

@* ── Step 1: look up the case to be moved ───────────────────────────────── *@
<form method="post" asp-page-handler="LookUp" novalidate class="bse-legacy-inline-form">
    <div class="govuk-form-group @(Model.RbseError is not null ? "govuk-form-group--error" : "")">
        <label class="govuk-label" for="rbse">RBSE</label>
        @if (Model.RbseError is not null)
        {
            <p id="rbse-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">Error:</span>@Model.RbseError
            </p>
        }
        <input id="rbse" name="Rbse" value="@Model.Rbse" type="text" maxlength="11" autocomplete="off"
               aria-describedby="rbse-hint @(Model.RbseError is not null ? "rbse-error" : "")"
               class="govuk-input govuk-input--width-10 @(Model.RbseError is not null ? "govuk-input--error" : "")" />
    </div>
    <button type="submit" class="govuk-button" data-module="govuk-button">Look Up</button>
</form>

@if (Model.CaseFound)
{
    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

    <div class="bse-rbse-summary-grid">
        <div class="bse-rbse-summary-row">
            <div class="bse-rbse-summary-item">
                <span class="bse-rbse-summary-label">Owner Name</span>
                <span class="bse-rbse-summary-value">@Model.CurrentFarm?.OwnerName</span>
            </div>
            <div class="bse-rbse-summary-item">
                <span class="bse-rbse-summary-label">Eartag</span>
                <span class="bse-rbse-summary-value">@Model.EartagDisplay</span>
            </div>
        </div>
        <div class="bse-rbse-summary-row">
            <div class="bse-rbse-summary-item">
                <span class="bse-rbse-summary-label">Address</span>
                <span class="bse-rbse-summary-value">
                    @Model.CurrentFarm?.Address1<br>
                    @Model.CurrentFarm?.Address2<br>
                    @Model.CurrentFarm?.Address3<br>
                    @Model.CurrentFarm?.Postcode
                </span>
            </div>
            <div class="bse-rbse-summary-item">
                <span class="bse-rbse-summary-label">CPHH</span>
                <span class="bse-rbse-summary-value">@BseFormat.FormatCphh(Model.CaseRecord.Cphh)</span>
            </div>
        </div>
        @if (Model.FarmWillBeDeleted)
        {
            <div class="bse-rbse-summary-row">
                <div class="bse-rbse-summary-item bse-rbse-summary-item--empty"></div>
                <div class="bse-rbse-summary-item bse-rbse-summary-item--full">
                    <span class="bse-farm-delete-message bse-farm-delete-message--wrap">This is the only case on this farm so the farm record will be removed</span>
                </div>
            </div>
        }
    </div>

    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

    @* ── Step 2: check the destination farm ─────────────────────────────── *@
    <form method="post" asp-page-handler="Check" novalidate class="bse-legacy-inline-form">
        <input type="hidden" name="Rbse" value="@Model.Rbse" />
        <div class="govuk-form-group @(Model.CphhError is not null ? "govuk-form-group--error" : "")">
            <label class="govuk-label" for="new-cphh">New CPHH</label>
            @if (Model.CphhError is not null)
            {
                <p id="new-cphh-error" class="govuk-error-message">
                    <span class="govuk-visually-hidden">Error:</span>@Model.CphhError
                </p>
            }
            <input id="new-cphh" name="NewCphh" value="@Model.NewCphh" type="text" inputmode="numeric" autocomplete="off"
                   aria-describedby="new-cphh-hint @(Model.CphhError is not null ? "new-cphh-error" : "")"
                   class="govuk-input govuk-input--width-20 @(Model.CphhError is not null ? "govuk-input--error" : "")" />
        </div>
        <button type="submit" class="govuk-button" data-module="govuk-button">Check</button>
    </form>

    @if (Model.ShowNewFarmPrompt)
    {
        <p class="govuk-body">
            <a asp-page="/Farm/MoveCaseNewFarm"
               asp-route-returnRbse="@Model.Rbse"
               asp-route-returnCphh="@Model.NewCphh"
               class="govuk-link">Create New Farm</a>
        </p>
    }

    @if (Model.CanMove)
    {
        <dl class="govuk-summary-list bse-legacy-summary-list">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">New Owners Name</dt>
                <dd class="govuk-summary-list__value">@Model.NewFarm.OwnerName</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Address</dt>
                <dd class="govuk-summary-list__value">
                    @Model.NewFarm.Address1<br>
                    @Model.NewFarm.Address2<br>
                    @Model.NewFarm.Address3<br>
                    @Model.NewFarm.Postcode
                </dd>
            </div>
        </dl>

        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

        <form method="post" asp-page-handler="Move">
            <input type="hidden" name="Rbse" value="@Model.Rbse" />
            <input type="hidden" name="NewCphh" value="@Model.NewCphh" />

            <div class="govuk-button-group bse-rbse-action-group">
                <button type="submit" class="govuk-button" data-module="govuk-button"
                        onclick="return confirm('Click OK to confirm change');">OK</button>
                <a asp-page="/Home" class="govuk-link">Cancel</a>
            </div>
        </form>
    }
}
