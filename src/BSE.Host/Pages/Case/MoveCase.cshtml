@page "{rbse}"
@model MoveCaseModel
@{
    ViewData["Title"] = "Move case";
}

<div>
    <h1 class="govuk-heading-l">Move case</h1>
    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Case/Details" asp-route-rbse="@Model.Rbse">Case @Model.Rbse</a></li>
            <li class="govuk-breadcrumbs__list-item" aria-current="page">Move</li>
        </ol>
    </nav>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list">
                        <li>@Model.ErrorMessage</li>
                    </ul>
                </div>
            </div>
        </div>
    }

    <h2 class="govuk-heading-m">Move case @Model.Rbse to a different farm</h2>
    <form method="post" novalidate>
        <input type="hidden" asp-for="Rbse" />
        <div class="govuk-form-group">
            <label asp-for="NewCphh" class="govuk-label">New CPHH</label>
            <div class="govuk-hint">For example, 12/345/6789/01.</div>
            <input asp-for="NewCphh" class="govuk-input govuk-!-width-one-half" />
            <span asp-validation-for="NewCphh" class="govuk-error-message"></span>
        </div>
        <div class="govuk-button-group">
            <button type="submit" class="govuk-button" data-module="govuk-button">Move case</button>
            <a asp-page="/Case/Details" asp-route-rbse="@Model.Rbse" class="govuk-link">Cancel</a>
        </div>
    </form>

    @if (Model.ShowNewFarmPrompt)
    {
        <div class="govuk-notification-banner" role="region" aria-labelledby="new-farm-banner-title"
             data-module="govuk-notification-banner">
            <div class="govuk-notification-banner__header">
                <h2 class="govuk-notification-banner__title" id="new-farm-banner-title">Farm not found</h2>
            </div>
            <div class="govuk-notification-banner__content">
                <p class="govuk-body">
                    Farm <strong>@Model.NewCphh</strong> does not exist.
                    <a asp-page="/Farm/New" asp-route-returnRbse="@Model.Rbse" asp-route-returnCphh="@Model.NewCphh"
                       class="govuk-link">Create a new farm with this CPHH</a>, then retry the move.
                </p>
            </div>
        </div>
    }
</div>
