@page
@model BSE.Host.Pages.UnauthorizedModel
@{
    ViewData["Title"] = "Unauthorized";
    Layout = "_Layout";
}

<h1 class="govuk-heading-l">There is a problem</h1>

<div class="govuk-error-summary" data-module="govuk-error-summary">
    <div role="alert">
        <h2 class="govuk-error-summary__title">Unauthorized</h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
                <li>You are not authorized to access the BSE system.</li>
            </ul>
        </div>
    </div>
</div>

<a asp-page="/Home" class="govuk-button">Return to home</a>
