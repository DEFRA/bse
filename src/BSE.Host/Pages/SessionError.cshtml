@page
@model BSE.Host.Pages.SessionErrorModel
@{
    ViewData["Title"] = "Session timed out";
    Layout = "_Layout";
}

<h1 class="govuk-heading-l">Your session has timed out</h1>

<div class="govuk-error-summary" data-module="govuk-error-summary">
    <div role="alert">
        <h2 class="govuk-error-summary__title">Session timed out</h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
                <li>Your session timed out after a period of inactivity, or required session information is no longer available.</li>
                <li>Please sign in again to continue.</li>
            </ul>
        </div>
    </div>
</div>

<a href="/signin" role="button" draggable="false" class="govuk-button" data-module="govuk-button">Sign in again</a>
