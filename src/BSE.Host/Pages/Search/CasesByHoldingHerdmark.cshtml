@page
@model BSE.Host.Pages.Search.CasesByHoldingHerdmarkModel
@{
    ViewData["Title"] = "List Of Cases For A Given Holding/Herdmark";
}

<h1 class="govuk-heading-l">List Of Cases For A Given Holding/Herdmark</h1>

@if (Model.NoCriteria)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li><a href="#Cphh">@BSE.Host.Pages.Search.CasesByHoldingHerdmarkModel.NoCriteriaMessage</a></li>
                </ul>
            </div>
        </div>
    </div>
}

<form method="get" novalidate>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <div class="govuk-form-group">
                <label asp-for="Cphh" class="govuk-label">CPH(H)</label>
                <div id="cphh-hint" class="govuk-hint">CPHH Format: NN[/]NNN[/]NNNN[/NN]</div>
                <input asp-for="Cphh" class="govuk-input govuk-!-width-two-thirds" aria-describedby="cphh-hint" />
                <span asp-validation-for="Cphh" class="govuk-error-message"></span>
            </div>

            <div class="govuk-form-group">
                <label asp-for="Herdmark" class="govuk-label">Herdmark</label>
                <input asp-for="Herdmark" class="govuk-input govuk-!-width-two-thirds" />
                <span asp-validation-for="Herdmark" class="govuk-error-message"></span>
            </div>

            <div class="govuk-form-group">
                <label asp-for="NumericHerdmark" class="govuk-label">Numeric Herdmark</label>
                <input asp-for="NumericHerdmark" class="govuk-input govuk-!-width-two-thirds" />
                <span asp-validation-for="NumericHerdmark" class="govuk-error-message"></span>
            </div>

            <div class="govuk-form-group">
                <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                    <div class="govuk-checkboxes__item">
                        <input asp-for="IncludeNonGb" class="govuk-checkboxes__input" />
                        <label asp-for="IncludeNonGb" class="govuk-label govuk-checkboxes__label">Include Non-GB Cases?</label>
                    </div>
                </div>
            </div>

            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
                <a asp-page="/Home" class="govuk-link">Search Menu</a>
            </div>
        </div>
    </div>
</form>

@if (Model.HasSearched)
{
    <p class="govuk-body">@Model.TotalCount result(s) found.</p>

    @if (Model.TotalCount > 0)
    {
        var sortBase = "?" + string.Join("&", HttpContext.Request.Query
            .Where(k => !string.Equals(k.Key, "SortColumn", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "SortDesc", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "PageNumber", StringComparison.OrdinalIgnoreCase))
            .SelectMany(k => k.Value, (k, v) => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}"));
        var sortCol  = Model.SortColumn;
        var sortDesc = Model.SortDesc;

        @await Html.PartialAsync("_ExportLink")
        <table class="govuk-table">
            <caption class="govuk-visually-hidden">Cases by holding or herdmark results</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    @{ ViewData["Label"] = "RBSE";             ViewData["Column"] = "Rbse";                 ViewData["SortColumn"] = sortCol; ViewData["SortDesc"] = sortDesc; ViewData["BaseUrl"] = sortBase; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "CPHH";             ViewData["Column"] = "Cphh"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Sex";              ViewData["Column"] = "Sex"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Eartag";           ViewData["Column"] = "Eartag"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Birth Date";       ViewData["Column"] = "BirthDate"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Origin";           ViewData["Column"] = "Origin"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Date Purchased";   ViewData["Column"] = "PurchaseDate"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Age at Purchase";  ViewData["Column"] = "PurchaseAgeInMonths"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Date Onset";       ViewData["Column"] = "OnsetDate"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Form A Date";      ViewData["Column"] = "FormADate"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Slaughter Date";   ViewData["Column"] = "SlaughterDate"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Final Result Date"; ViewData["Column"] = "FinalResultDate"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Age at Onset";     ViewData["Column"] = "OnsetAgeInMonths"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Fate";             ViewData["Column"] = "Fate"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Final Result";     ViewData["Column"] = "FinalResult"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Survey";           ViewData["Column"] = "Survey"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Case Status";      ViewData["Column"] = "CaseStatus"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Time Elapsed";     ViewData["Column"] = "TimeElapsed"; }
                    <partial name="_SortableHeader" />
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var r in Model.PagedResults)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell bse-rbse">@BseFormat.FormatRbse(r.Rbse)</td>
                        <td class="govuk-table__cell">@BseFormat.FormatCphh(r.Cphh)</td>
                        <td class="govuk-table__cell">@r.Sex</td>
                        <td class="govuk-table__cell">@r.Eartag</td>
                        <td class="govuk-table__cell">@r.BirthDate?.ToString("dd/MM/yyyy")</td>
                        <td class="govuk-table__cell">@r.Origin</td>
                        <td class="govuk-table__cell">@r.PurchaseDate?.ToString("dd/MM/yyyy")</td>
                        <td class="govuk-table__cell">@r.PurchaseAgeInMonths</td>
                        <td class="govuk-table__cell">@r.OnsetDate?.ToString("dd/MM/yyyy")</td>
                        <td class="govuk-table__cell">@r.FormADate?.ToString("dd/MM/yyyy")</td>
                        <td class="govuk-table__cell">@r.SlaughterDate?.ToString("dd/MM/yyyy")</td>
                        <td class="govuk-table__cell">@r.FinalResultDate?.ToString("dd/MM/yyyy")</td>
                        <td class="govuk-table__cell">@r.OnsetAgeInMonths</td>
                        <td class="govuk-table__cell">@r.Fate</td>
                        <td class="govuk-table__cell">@r.FinalResult</td>
                        <td class="govuk-table__cell">@r.Survey</td>
                        <td class="govuk-table__cell">@r.CaseStatus</td>
                        <td class="govuk-table__cell">@r.TimeElapsed</td>
                    </tr>
                }
            </tbody>
        </table>
        @await Html.PartialAsync("_Pagination", null, new ViewDataDictionary(ViewData) { ["CurrentPage"] = Model.PageNumber, ["TotalPages"] = Model.TotalPages })
    }
}
