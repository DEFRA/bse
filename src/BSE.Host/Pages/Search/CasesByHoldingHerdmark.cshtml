@page
@model BSE.Host.Pages.Search.CasesByHoldingHerdmarkModel
@{
    ViewData["Title"] = "List Of Cases For A Given Holding/Herdmark";
    ViewData["BodyClass"] = "bse-holding-herdmark-search-page";
}

<h1 class="govuk-heading-l">List Of Cases For A Given Holding/Herdmark</h1>
<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">List Of Cases For A Given Holding/Herdmark</li>
    </ol>
</nav>

@if (Model.NoCriteria)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li><a href="#Cphh">@BSE.Host.Pages.Search.CasesByHoldingHerdmarkModel.NoCriteriaMessage</a></li>
                </ul>
            </div>
        </div>
    </div>
}

<form method="get" novalidate data-bse-post-search>
    <input type="hidden" name="Searched" value="true" />
    <div class="bse-farm-legacy">
        <div class="bse-farm-legacy__row">
            <div class="bse-farm-legacy__field">
                <label asp-for="Cphh" class="govuk-label">CPH(H)</label>
                <div class="govuk-form-group">
                    <input asp-for="Cphh" class="govuk-input bse-farm-legacy__input"
                           maxlength="14" title="CPHH Format: NN[/]NNN[/]NNNN[/NN]" spellcheck="false" autocapitalize="off" />
                    <span asp-validation-for="Cphh" class="govuk-error-message"></span>
                </div>
            </div>
            <div class="bse-farm-legacy__field">
                <label asp-for="Herdmark" class="govuk-label">Herdmark</label>
                <div class="govuk-form-group">
                    <input asp-for="Herdmark" class="govuk-input bse-farm-legacy__input" maxlength="8" />
                    <span asp-validation-for="Herdmark" class="govuk-error-message"></span>
                </div>
            </div>
        </div>

        <div class="bse-farm-legacy__row">
            <div class="bse-farm-legacy__field">
                <label asp-for="NumericHerdmark" class="govuk-label">Numeric Herdmark</label>
                <div class="govuk-form-group">
                    <input asp-for="NumericHerdmark" class="govuk-input bse-farm-legacy__input" maxlength="6" />
                    <span asp-validation-for="NumericHerdmark" class="govuk-error-message"></span>
                </div>
            </div>
            <div class="bse-farm-legacy__field bse-farm-legacy__field--dealer-left">
                <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                    <div class="govuk-checkboxes__item">
                        <input asp-for="IncludeNonGb" class="govuk-checkboxes__input bse-farm-legacy__dealer-checkbox" />
                        <label asp-for="IncludeNonGb" class="govuk-label govuk-checkboxes__label">Include Non-GB Cases?</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="bse-farm-legacy__row">
            <div class="bse-farm-legacy__field bse-farm-legacy__field--continuation">
                <span class="govuk-label" aria-hidden="true">&nbsp;</span>
                <div class="govuk-button-group">
                    <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
                    <a asp-page="/Search/Menu" class="govuk-link">Search Menu</a>
                </div>
            </div>
        </div>
    </div>
</form>

@if (Model.HasSearched)
{
    <p id="holding-herdmark-search-results" class="govuk-body">@Model.TotalCount result(s) found.</p>

    @await Html.PartialAsync("_CaseDetailResults", Model, new ViewDataDictionary(ViewData)
    {
        ["Fragment"] = "holding-herdmark-search-results",
        ["WrapClass"] = "bse-holding-herdmark-search-table-wrap",
        ["TableClass"] = "bse-holding-herdmark-search-table",
        ["AriaLabel"] = "Cases by holding herdmark results",
        ["Caption"] = "Cases by holding or herdmark results"
    })
}
