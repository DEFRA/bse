@page
@model BSE.Host.Pages.Search.FarmsModel
@{
    ViewData["Title"] = "Farm Search";
}

<h1 class="govuk-heading-l">Farm Search</h1>

@if (Model.NoCriteria)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li><a href="#Filter_Cphh">@BSE.Host.Pages.Search.FarmsModel.NoCriteriaMessage</a></li>
                </ul>
            </div>
        </div>
    </div>
}

<form method="get" novalidate>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <div class="govuk-form-group">
                <label asp-for="Filter.Cphh" class="govuk-label">CPH(H)</label>
                <input asp-for="Filter.Cphh" class="govuk-input govuk-!-width-two-thirds" />
                <span asp-validation-for="Filter.Cphh" class="govuk-error-message"></span>
            </div>

            <div class="govuk-form-group">
                <label asp-for="Filter.OwnerName" class="govuk-label">Owner Name (partial search)</label>
                <input asp-for="Filter.OwnerName" class="govuk-input govuk-!-width-two-thirds" />
            </div>

            <div class="govuk-form-group">
                <label asp-for="Filter.Herdmark" class="govuk-label">Herdmark</label>
                <input asp-for="Filter.Herdmark" class="govuk-input govuk-!-width-two-thirds" />
            </div>

            <div class="govuk-form-group">
                <label asp-for="Filter.Address" class="govuk-label">Address (partial search)</label>
                <input asp-for="Filter.Address" class="govuk-input govuk-!-width-two-thirds" />
            </div>

            <div class="govuk-form-group">
                <label asp-for="Filter.NumericHerdmark" class="govuk-label">Numeric Herdmark</label>
                <input asp-for="Filter.NumericHerdmark" class="govuk-input govuk-!-width-two-thirds" />
                <span asp-validation-for="Filter.NumericHerdmark" class="govuk-error-message"></span>
            </div>

            <div class="govuk-form-group">
                <label asp-for="Filter.County" class="govuk-label">County</label>
                <select asp-for="Filter.County" class="govuk-select govuk-!-width-two-thirds">
                    <option value=""></option>
                    @foreach (var item in Model.CountyOptions)
                    {
                        <option value="@item.Code">@item.Description</option>
                    }
                </select>
            </div>

            <div class="govuk-form-group">
                <label asp-for="Filter.IsDealer" class="govuk-label">Dealer</label>
                <select asp-for="Filter.IsDealer" class="govuk-select govuk-!-width-two-thirds">
                    <option value=""></option>
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
            </div>

            <div class="govuk-form-group">
                <label asp-for="Filter.Aho" class="govuk-label">AHO</label>
                <select asp-for="Filter.Aho" class="govuk-select govuk-!-width-two-thirds">
                    <option value=""></option>
                    @foreach (var item in Model.AhoOptions)
                    {
                        <option value="@item.Code">@item.Description</option>
                    }
                </select>
            </div>

            <div class="govuk-form-group">
                <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                    <div class="govuk-checkboxes__item">
                        <input asp-for="Filter.IncludeNonGb" class="govuk-checkboxes__input" />
                        <label asp-for="Filter.IncludeNonGb" class="govuk-label govuk-checkboxes__label">Include Non-GB Farms?</label>
                    </div>
                </div>
            </div>

            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
                <a asp-page="/Home" class="govuk-link">Search Menu</a>
            </div>
        </div>
    </div>
</form>

@if (Model.Filter.HasSearched)
{
    <p class="govuk-body">@Model.Filter.TotalCount result(s) found.</p>

    @if (Model.Filter.TotalCount > 0)
    {
        var sortBase = "?" + string.Join("&", HttpContext.Request.Query
            .Where(k => !string.Equals(k.Key, "Filter.SortColumn", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "Filter.SortDesc", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "Filter.PageNumber", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "pageNumber", StringComparison.OrdinalIgnoreCase))
            .SelectMany(k => k.Value, (k, v) => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}"));
        var sortCol  = Model.Filter.SortColumn;
        var sortDesc = Model.Filter.SortDesc;

        @await Html.PartialAsync("_ExportLink")
        <table class="govuk-table">
            <caption class="govuk-visually-hidden">Farm search results</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    @{ ViewData["Label"] = "CPHH";                   ViewData["Column"] = "Cphh";                   ViewData["SortColumn"] = sortCol; ViewData["SortDesc"] = sortDesc; ViewData["BaseUrl"] = sortBase; ViewData["Prefix"] = "Filter."; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Owner Name";              ViewData["Column"] = "OwnerName"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Address";                 ViewData["Column"] = "Address"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Correspondence Address";  ViewData["Column"] = "CorrespondenceAddress"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "County";                  ViewData["Column"] = "County"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Herdmark(s)";             ViewData["Column"] = "Herdmark"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Numeric Herdmark(s)";     ViewData["Column"] = "NumericHerdmark"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Map Ref";                 ViewData["Column"] = "MapReference"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "AHO";                     ViewData["Column"] = "Aho"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Herd Type";               ViewData["Column"] = "HerdType"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Cases";                   ViewData["Column"] = "CasesCount"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Confirmed Cases";         ViewData["Column"] = "ConfirmedCasesCount"; }
                    <partial name="_SortableHeader" />
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var r in Model.Filter.PagedResults)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell"><a asp-page="/Farm/Details" asp-route-cphh="@r.Cphh" class="govuk-link">@BseFormat.FormatCphh(r.Cphh)</a></td>
                        <td class="govuk-table__cell">@r.OwnerName</td>
                        <td class="govuk-table__cell">@r.Address</td>
                        <td class="govuk-table__cell">@r.CorrespondenceAddress</td>
                        <td class="govuk-table__cell">@r.County</td>
                        <td class="govuk-table__cell">@r.Herdmark</td>
                        <td class="govuk-table__cell">@r.NumericHerdmark</td>
                        <td class="govuk-table__cell">@r.MapReference</td>
                        <td class="govuk-table__cell">@r.Aho</td>
                        <td class="govuk-table__cell">@r.HerdType</td>
                        <td class="govuk-table__cell">@r.CasesCount</td>
                        <td class="govuk-table__cell">@r.ConfirmedCasesCount</td>
                    </tr>
                }
            </tbody>
        </table>
        @await Html.PartialAsync("_Pagination", null, new ViewDataDictionary(ViewData) { ["CurrentPage"] = Model.Filter.PageNumber, ["TotalPages"] = Model.Filter.TotalPages, ["PageNumberKey"] = "Filter.PageNumber" })
    }
}
