@page
@model BSE.Host.Pages.Search.FarmsModel
@{
    ViewData["Title"] = "Search for a farm";
}

<h1 class="govuk-heading-l">Search for a farm</h1>

<form method="get" novalidate>
    <div class="govuk-form-group">
        <label asp-for="Filter.Cphh" class="govuk-label">CPHH</label>
        <div class="govuk-hint">For example, 12/345/0001.</div>
        <input asp-for="Filter.Cphh" class="govuk-input govuk-!-width-one-half" />
    </div>

    <div class="govuk-form-group">
        <label asp-for="Filter.OwnerName" class="govuk-label">Owner name</label>
        <input asp-for="Filter.OwnerName" class="govuk-input govuk-!-width-two-thirds" />
    </div>

    <div class="govuk-form-group">
        <label asp-for="Filter.Address" class="govuk-label">Address</label>
        <input asp-for="Filter.Address" class="govuk-input govuk-!-width-two-thirds" />
    </div>

    <div class="govuk-form-group">
        <label asp-for="Filter.County" class="govuk-label">County</label>
        <input asp-for="Filter.County" class="govuk-input govuk-!-width-one-half" />
    </div>

    <div class="govuk-form-group">
        <label asp-for="Filter.Herdmark" class="govuk-label">Herdmark</label>
        <input asp-for="Filter.Herdmark" class="govuk-input govuk-!-width-one-half" />
    </div>

    <div class="govuk-form-group">
        <div class="govuk-checkboxes" data-module="govuk-checkboxes">
            <div class="govuk-checkboxes__item">
                <input asp-for="Filter.IncludeNonGb" class="govuk-checkboxes__input" />
                <label asp-for="Filter.IncludeNonGb" class="govuk-label govuk-checkboxes__label">Include non-GB farms</label>
            </div>
        </div>
    </div>

    <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
        <a asp-page="/Search/Farms" class="govuk-link">Clear search</a>
    </div>
</form>

@if (Model.Filter.HasSearched)
{
    <p class="govuk-body">@Model.Filter.Results.Count result(s) found.</p>

    @if (Model.Filter.Results.Count > 0)
    {
        <table class="govuk-table">
            <caption class="govuk-visually-hidden">Farm search results</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">CPHH</th>
                    <th scope="col" class="govuk-table__header">Owner name</th>
                    <th scope="col" class="govuk-table__header">Address</th>
                    <th scope="col" class="govuk-table__header">County</th>
                    <th scope="col" class="govuk-table__header">Herdmark</th>
                    <th scope="col" class="govuk-table__header">Cases</th>
                    <th scope="col" class="govuk-table__header">Confirmed</th>
                    <th scope="col" class="govuk-table__header">Action</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var r in Model.Filter.Results)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@r.Cphh</td>
                        <td class="govuk-table__cell">@r.OwnerName</td>
                        <td class="govuk-table__cell">@r.Address</td>
                        <td class="govuk-table__cell">@r.County</td>
                        <td class="govuk-table__cell">@r.Herdmark</td>
                        <td class="govuk-table__cell">@r.CasesCount</td>
                        <td class="govuk-table__cell">@r.ConfirmedCasesCount</td>
                        <td class="govuk-table__cell">
                            <a asp-page="/Farm/Details" asp-route-cphh="@r.Cphh" class="govuk-link">Open</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
