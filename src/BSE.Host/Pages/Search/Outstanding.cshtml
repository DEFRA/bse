@page
@model BSE.Host.Pages.Search.OutstandingModel
@{
    ViewData["Title"] = "Outstanding Data Search";
}

<h1 class="govuk-heading-l">Outstanding Data Search</h1>

<form method="get" novalidate>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset" aria-describedby="outstanding-type-hint">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">Outstanding data type</legend>
                    <div id="outstanding-type-hint" class="govuk-hint">Select what you want to search for.</div>
                    <div class="govuk-radios govuk-radios--inline" data-module="govuk-radios">
                        <div class="govuk-radios__item">
                            <input asp-for="Filter.SearchType" class="govuk-radios__input" id="search-type-results" type="radio" value="Results" />
                            <label class="govuk-label govuk-radios__label" for="search-type-results">Outstanding Results</label>
                        </div>
                        <div class="govuk-radios__item">
                            <input asp-for="Filter.SearchType" class="govuk-radios__input" id="search-type-fates" type="radio" value="Fates" />
                            <label class="govuk-label govuk-radios__label" for="search-type-fates">Fate</label>
                        </div>
                        <div class="govuk-radios__item">
                            <input asp-for="Filter.SearchType" class="govuk-radios__input" id="search-type-bse1" type="radio" value="BSE1" />
                            <label class="govuk-label govuk-radios__label" for="search-type-bse1">BSE1s</label>
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset" role="group" aria-describedby="outstanding-date-hint">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">Form A Date Between</legend>
                    <div id="outstanding-date-hint" class="govuk-hint">Leave blank to search all dates.</div>
                    <div class="govuk-date-input">
                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label asp-for="Filter.EarliestFormADate" class="govuk-label govuk-date-input__label">From</label>
                                <input asp-for="Filter.EarliestFormADate" type="date" class="govuk-input govuk-date-input__input" />
                            </div>
                        </div>
                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label asp-for="Filter.LatestFormADate" class="govuk-label govuk-date-input__label">To</label>
                                <input asp-for="Filter.LatestFormADate" type="date" class="govuk-input govuk-date-input__input" />
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="govuk-form-group">
                <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                    <div class="govuk-checkboxes__item">
                        <input asp-for="Filter.IncludeNonGb" class="govuk-checkboxes__input" />
                        <label asp-for="Filter.IncludeNonGb" class="govuk-label govuk-checkboxes__label">Include Non-GB Cases?</label>
                    </div>
                </div>
            </div>

            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
                <a asp-page="/Home" class="govuk-link">Search Menu</a>
            </div>
        </div>
    </div>
</form>

@if (Model.Filter.HasSearched)
{
    <p class="govuk-body">@Model.Filter.TotalCount result(s) found.</p>

    @if (Model.Filter.TotalCount > 0)
    {
        var sortBase = "?" + string.Join("&", HttpContext.Request.Query
            .Where(k => !string.Equals(k.Key, "Filter.SortColumn", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "Filter.SortDesc", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "Filter.PageNumber", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "pageNumber", StringComparison.OrdinalIgnoreCase))
            .SelectMany(k => k.Value, (k, v) => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}"));
        var sortCol  = Model.Filter.SortColumn;
        var sortDesc = Model.Filter.SortDesc;

        @await Html.PartialAsync("_ExportLink")
        <table class="govuk-table">
            <caption class="govuk-visually-hidden">Outstanding search results</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    @{ ViewData["Label"] = "RBSE";         ViewData["Column"] = "Rbse";        ViewData["SortColumn"] = sortCol; ViewData["SortDesc"] = sortDesc; ViewData["BaseUrl"] = sortBase; ViewData["Prefix"] = "Filter."; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "CPHH";         ViewData["Column"] = "Cphh"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Eartag";       ViewData["Column"] = "Eartag"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Form A date";  ViewData["Column"] = "FormADate"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Birth date";   ViewData["Column"] = "BirthDate"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Fate";         ViewData["Column"] = "Fate"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Final result"; ViewData["Column"] = "FinalResult"; }
                    <partial name="_SortableHeader" />
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var r in Model.Filter.PagedResults)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell bse-rbse">@BseFormat.FormatRbse(r.Rbse)</td>
                        <td class="govuk-table__cell">@BseFormat.FormatCphh(r.Cphh)</td>
                        <td class="govuk-table__cell">@r.Eartag</td>
                        <td class="govuk-table__cell">@r.FormADate?.ToString("dd/MM/yyyy")</td>
                        <td class="govuk-table__cell">@r.BirthDate?.ToString("dd/MM/yyyy")</td>
                        <td class="govuk-table__cell">@r.Fate</td>
                        <td class="govuk-table__cell">@r.FinalResult</td>
                    </tr>
                }
            </tbody>
        </table>
        @await Html.PartialAsync("_Pagination", null, new ViewDataDictionary(ViewData) { ["CurrentPage"] = Model.Filter.PageNumber, ["TotalPages"] = Model.Filter.TotalPages, ["PageNumberKey"] = "Filter.PageNumber" })
    }
}
