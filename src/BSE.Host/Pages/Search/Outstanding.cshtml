@page
@model BSE.Host.Pages.Search.OutstandingModel
@{
    ViewData["Title"] = "Outstanding Data Search";
    ViewData["BodyClass"] = "bse-outstanding-search-page";
}

<h1 class="govuk-heading-l">Outstanding Data Search</h1>
<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Search/Menu">Search Menu</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Outstanding Data Search</li>
    </ol>
</nav>

@if (Model.Filter.EarliestFormADateError is not null || Model.Filter.LatestFormADateError is not null)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @if (Model.Filter.EarliestFormADateError is not null)
                    {
                        <li><a href="#Filter_EarliestFormADate">@Model.Filter.EarliestFormADateError</a></li>
                    }
                    @if (Model.Filter.LatestFormADateError is not null)
                    {
                        <li><a href="#Filter_LatestFormADate">@Model.Filter.LatestFormADateError</a></li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

<form method="get" novalidate>
    <div class="bse-farm-legacy">
        <div class="bse-farm-legacy__row">
            <div class="bse-farm-legacy__field bse-outstanding-legacy__field--wide">
                <label class="govuk-visually-hidden" for="search-type-results">Outstanding data type</label>
                <div class="govuk-radios govuk-radios--inline" data-module="govuk-radios">
                    <div class="govuk-radios__item">
                        <input asp-for="Filter.SearchType" class="govuk-radios__input" id="search-type-results" type="radio" value="Results" />
                        <label class="govuk-label govuk-radios__label" for="search-type-results">Outstanding Results</label>
                    </div>
                    <div class="govuk-radios__item">
                        <input asp-for="Filter.SearchType" class="govuk-radios__input" id="search-type-fates" type="radio" value="Fates" />
                        <label class="govuk-label govuk-radios__label" for="search-type-fates">Fate</label>
                    </div>
                    <div class="govuk-radios__item">
                        <input asp-for="Filter.SearchType" class="govuk-radios__input" id="search-type-bse1" type="radio" value="BSE1" />
                        <label class="govuk-label govuk-radios__label" for="search-type-bse1">BSE1s</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="bse-farm-legacy__row">
            <div class="bse-farm-legacy__field bse-outstanding-legacy__field--date bse-outstanding-legacy__field--wide">
                <label for="Filter_EarliestFormADate" class="govuk-label">Form A Date Between</label>
                <div class="bse-outstanding-legacy__date-range" role="group" aria-labelledby="Filter_EarliestFormADate">
                    <div class="govuk-form-group @(Model.Filter.EarliestFormADateError is not null ? "govuk-form-group--error" : "")">
                        <label asp-for="Filter.EarliestFormADate" class="govuk-visually-hidden">Form A date from</label>
                        @if (Model.Filter.EarliestFormADateError is not null)
                        {
                            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Model.Filter.EarliestFormADateError</p>
                        }
                        <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                            <input asp-for="Filter.EarliestFormADate" type="text" class="govuk-input bse-outstanding-legacy__date-input moj-js-datepicker-input @(Model.Filter.EarliestFormADateError is not null ? "govuk-input--error" : "")" autocomplete="off" />
                        </div>
                    </div>
                    <span class="bse-outstanding-legacy__and">and</span>
                    <div class="govuk-form-group @(Model.Filter.LatestFormADateError is not null ? "govuk-form-group--error" : "")">
                        <label asp-for="Filter.LatestFormADate" class="govuk-visually-hidden">Form A date to</label>
                        @if (Model.Filter.LatestFormADateError is not null)
                        {
                            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Model.Filter.LatestFormADateError</p>
                        }
                        <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                            <input asp-for="Filter.LatestFormADate" type="text" class="govuk-input bse-outstanding-legacy__date-input moj-js-datepicker-input @(Model.Filter.LatestFormADateError is not null ? "govuk-input--error" : "")" autocomplete="off" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="bse-farm-legacy__row bse-outstanding-legacy__row--actions">
            <div class="bse-farm-legacy__field bse-farm-legacy__field--dealer-left bse-outstanding-legacy__field--include">
                <label asp-for="Filter.IncludeNonGb" class="govuk-label">Include Non-GB Cases?</label>
                <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                    <div class="govuk-checkboxes__item">
                        <input asp-for="Filter.IncludeNonGb" class="govuk-checkboxes__input bse-farm-legacy__dealer-checkbox" />
                        <label asp-for="Filter.IncludeNonGb" class="govuk-label govuk-checkboxes__label"><span class="govuk-visually-hidden">Include Non-GB Cases?</span></label>
                    </div>
                </div>
                <div class="govuk-button-group">
                    <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
                    <a asp-page="/Search/Menu" class="govuk-link">Search Menu</a>
                </div>
            </div>
        </div>
    </div>
</form>

@if (Model.Filter.HasSearched)
{
    <p id="outstanding-search-results" class="govuk-body">@Model.Filter.TotalCount result(s) found.</p>

    @if (Model.Filter.TotalCount > 0)
    {
        var sortBase = "?" + string.Join("&", HttpContext.Request.Query
            .Where(k => !string.Equals(k.Key, "Filter.SortColumn", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "Filter.SortDesc", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "Filter.PageNumber", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "pageNumber", StringComparison.OrdinalIgnoreCase))
            .SelectMany(k => k.Value, (k, v) => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}"));
        var sortCol  = Model.Filter.SortColumn;
        var sortDesc = Model.Filter.SortDesc;

        @await Html.PartialAsync("_ExportLink")
        <div class="bse-outstanding-search-table-wrap">
        <table class="govuk-table bse-outstanding-search-table">
            <caption class="govuk-visually-hidden">Outstanding search results</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    @{ ViewData["Label"] = "RBSE";         ViewData["Column"] = "Rbse";        ViewData["SortColumn"] = sortCol; ViewData["SortDesc"] = sortDesc; ViewData["BaseUrl"] = sortBase; ViewData["Prefix"] = "Filter."; ViewData["Fragment"] = "outstanding-search-results"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "CPHH";         ViewData["Column"] = "Cphh"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Eartag";       ViewData["Column"] = "Eartag"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Form A Date";  ViewData["Column"] = "FormADate"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Birth Date";   ViewData["Column"] = "BirthDate"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Fate";         ViewData["Column"] = "Fate"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Final Result"; ViewData["Column"] = "FinalResult"; }
                    <partial name="_SortableHeader" />
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var r in Model.Filter.PagedResults)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell bse-rbse">@BseFormat.FormatRbse(r.Rbse)</td>
                        <td class="govuk-table__cell">@BseFormat.FormatCphh(r.Cphh)</td>
                        <td class="govuk-table__cell">@r.Eartag</td>
                        <td class="govuk-table__cell">@r.FormADate?.ToString("dd/MM/yyyy")</td>
                        <td class="govuk-table__cell">@r.BirthDate?.ToString("dd/MM/yyyy")</td>
                        <td class="govuk-table__cell">@r.Fate</td>
                        <td class="govuk-table__cell">@r.FinalResult</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        @await Html.PartialAsync("_Pagination", null, new ViewDataDictionary(ViewData) { ["CurrentPage"] = Model.Filter.PageNumber, ["TotalPages"] = Model.Filter.TotalPages, ["PageNumberKey"] = "Filter.PageNumber", ["Fragment"] = "outstanding-search-results" })
    }
}
