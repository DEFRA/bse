@page
@model BSE.Host.Pages.Search.RelatedAnimalsModel
@{
    ViewData["Title"] = "Related Animal Search";
}

<h1 class="govuk-heading-l">Related Animal Search</h1>
<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Search/Menu">Search Menu</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Related Animal Search</li>
    </ol>
</nav>

@if (Model.NoCriteria)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li><a href="#Rbse">@BSE.Host.Pages.Search.RelatedAnimalsModel.NoCriteriaMessage</a></li>
                </ul>
            </div>
        </div>
    </div>
}

<form method="get" novalidate>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <div class="govuk-form-group">
                <label asp-for="Rbse" class="govuk-label">RBSE Of Case</label>
                <input asp-for="Rbse" class="govuk-input govuk-!-width-two-thirds" aria-describedby="rbse-hint" maxlength="11" />
                <span asp-validation-for="Rbse" class="govuk-error-message"></span>
            </div>

            <div class="govuk-form-group">
                <label asp-for="Eartag" class="govuk-label">Eartag of Related Animal (starting with...)</label>
                <input asp-for="Eartag" class="govuk-input govuk-!-width-two-thirds" />
            </div>

            <div class="govuk-form-group">
                <label asp-for="RelationRbse" class="govuk-label">RBSE of Related Animal</label>
                <input asp-for="RelationRbse" class="govuk-input govuk-!-width-two-thirds" aria-describedby="relation-rbse-hint" maxlength="11" />
                <span asp-validation-for="RelationRbse" class="govuk-error-message"></span>
            </div>

            <div class="govuk-form-group">
                <label asp-for="RelationType" class="govuk-label">Relation Type</label>
                <select asp-for="RelationType" class="govuk-select govuk-!-width-two-thirds">
                    <option value=""></option>
                    @foreach (var item in Model.RelationTypeOptions)
                    {
                        <option value="@item.Code">@item.Description</option>
                    }
                </select>
            </div>

            <div class="govuk-form-group">
                <label asp-for="Name" class="govuk-label">Name of Related Animal (starting with...)</label>
                <input asp-for="Name" class="govuk-input govuk-!-width-two-thirds" />
            </div>

            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
                <a asp-page="/Search/Menu" class="govuk-link">Search Menu</a>
            </div>
        </div>
    </div>
</form>

@if (Model.HasSearched)
{
    <p id="related-animals-search-results" class="govuk-body">@Model.TotalCount result(s) found.</p>

    @if (Model.TotalCount > 0)
    {
        var sortBase = "?" + string.Join("&", HttpContext.Request.Query
            .Where(k => !string.Equals(k.Key, "SortColumn", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "SortDesc", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "PageNumber", StringComparison.OrdinalIgnoreCase))
            .SelectMany(k => k.Value, (k, v) => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}"));
        var sortCol  = Model.SortColumn;
        var sortDesc = Model.SortDesc;

        @await Html.PartialAsync("_ExportLink")
        <div class="bse-related-animals-search-table-wrap">
        <table class="govuk-table bse-related-animals-search-table">
            <caption class="govuk-visually-hidden">Related animal results</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    @{ ViewData["Label"] = "RBSE";                ViewData["Column"] = "Rbse";         ViewData["SortColumn"] = sortCol; ViewData["SortDesc"] = sortDesc; ViewData["BaseUrl"] = sortBase; ViewData["Fragment"] = "related-animals-search-results"; ViewData["HeaderClass"] = "bse-w-8"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "CPHH";                ViewData["Column"] = "Cphh"; ViewData["HeaderClass"] = "bse-w-8"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Relation";       ViewData["Column"] = "RelationType"; ViewData["HeaderClass"] = "bse-w-9"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Sex";            ViewData["Column"] = "RelSex"; ViewData["HeaderClass"] = "bse-w-5"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Eartag";         ViewData["Column"] = "Eartag"; ViewData["HeaderClass"] = "bse-w-9"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Rel Birth Date"; ViewData["Column"] = "RelBirthDate"; ViewData["HeaderClass"] = "bse-w-13"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Rel Fate";       ViewData["Column"] = "RelFate"; ViewData["HeaderClass"] = "bse-w-9"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Date Left";      ViewData["Column"] = "LeftDate"; ViewData["HeaderClass"] = "bse-w-10"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Rel Name";       ViewData["Column"] = "RelName"; ViewData["HeaderClass"] = "bse-w-9"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Rel Eartag";     ViewData["Column"] = "RelEartag"; ViewData["HeaderClass"] = "bse-w-11"; }
                    <partial name="_SortableHeader" />
                    @{ ViewData["Label"] = "Rel RBSE";       ViewData["Column"] = "RelationRbse"; ViewData["HeaderClass"] = "bse-w-9"; }
                    <partial name="_SortableHeader" />
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var r in Model.PagedResults)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell bse-rbse">@BseFormat.FormatRbse(r.Rbse)</td>
                        <td class="govuk-table__cell">@BseFormat.FormatCphh(r.Cphh)</td>
                        <td class="govuk-table__cell">@r.RelationType</td>
                        <td class="govuk-table__cell">@r.RelSex</td>
                        <td class="govuk-table__cell">@r.Eartag</td>
                        <td class="govuk-table__cell">@r.RelBirthDate</td>
                        <td class="govuk-table__cell">@r.RelFate</td>
                        <td class="govuk-table__cell">@r.LeftDate?.ToString("dd/MM/yyyy")</td>
                        <td class="govuk-table__cell">@r.RelName</td>
                        <td class="govuk-table__cell">@r.RelEartag</td>
                        <td class="govuk-table__cell bse-rbse">@BseFormat.FormatRbse(r.RelationRbse)</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        @await Html.PartialAsync("_Pagination", null, new ViewDataDictionary(ViewData) { ["CurrentPage"] = Model.PageNumber, ["TotalPages"] = Model.TotalPages, ["Fragment"] = "related-animals-search-results" })
    }
}
