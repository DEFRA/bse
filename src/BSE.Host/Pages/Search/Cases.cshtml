@page
@model BSE.Host.Pages.Search.CasesModel
@{
    ViewData["Title"] = "Case Search";
}

<h1 class="govuk-heading-l">Case Search</h1>

@if (!ViewContext.ModelState.IsValid && Model.Filter.HasSearched)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var modelError in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@modelError.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

<form method="get" novalidate>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <div class="govuk-form-group">
                <label asp-for="Filter.Rbse" class="govuk-label">RBSE</label>
                <div id="rbse-hint" class="govuk-hint">Enter 9 digits with no slashes — for example, 002600001.</div>
                <input asp-for="Filter.Rbse" class="govuk-input govuk-!-width-two-thirds" aria-describedby="rbse-hint" />
                <span asp-validation-for="Filter.Rbse" class="govuk-error-message"></span>
            </div>

            <div class="govuk-form-group">
                <label asp-for="Filter.Eartag" class="govuk-label">Eartag (starting with...)</label>
                <input asp-for="Filter.Eartag" class="govuk-input govuk-!-width-two-thirds" />
            </div>

            <div class="govuk-form-group">
                <label asp-for="Filter.Dbse" class="govuk-label">DBSE</label>
                <input asp-for="Filter.Dbse" class="govuk-input govuk-!-width-two-thirds" />
                <span asp-validation-for="Filter.Dbse" class="govuk-error-message"></span>
            </div>

            <div class="govuk-form-group">
                <label asp-for="Filter.Fate" class="govuk-label">Fate</label>
                <select asp-for="Filter.Fate" class="govuk-select govuk-!-width-two-thirds">
                    <option value=""></option>
                    @foreach (var item in Model.FateOptions)
                    {
                        <option value="@item.Id">@item.Description</option>
                    }
                </select>
            </div>

            <div class="govuk-form-group">
                <label asp-for="Filter.FinalResult" class="govuk-label">Final Result</label>
                <select asp-for="Filter.FinalResult" class="govuk-select govuk-!-width-two-thirds">
                    <option value=""></option>
                    @foreach (var item in Model.FinalResultOptions)
                    {
                        <option value="@item.Id">@item.Description</option>
                    }
                </select>
            </div>

            <div class="govuk-form-group">
                <label asp-for="Filter.Sex" class="govuk-label">Sex</label>
                <select asp-for="Filter.Sex" class="govuk-select govuk-!-width-two-thirds">
                    <option value=""></option>
                    @foreach (var item in Model.SexOptions)
                    {
                        <option value="@item.Id">@item.Description</option>
                    }
                </select>
            </div>

            <div class="govuk-form-group">
                <label asp-for="Filter.Survey" class="govuk-label">Survey</label>
                <select asp-for="Filter.Survey" class="govuk-select govuk-!-width-two-thirds">
                    <option value=""></option>
                    @foreach (var item in Model.SurveyOptions)
                    {
                        <option value="@item.Id">@item.Description</option>
                    }
                </select>
            </div>

            <div class="govuk-form-group">
                <label asp-for="Filter.PassiveActive" class="govuk-label">Passive/Active</label>
                <select asp-for="Filter.PassiveActive" class="govuk-select govuk-!-width-two-thirds">
                    <option value=""></option>
                    <option value="P">Passive</option>
                    <option value="A">Active</option>
                </select>
            </div>

            <div class="govuk-form-group">
                <label asp-for="Filter.Notes" class="govuk-label">Notes (partial search)</label>
                <textarea asp-for="Filter.Notes" class="govuk-textarea govuk-!-width-two-thirds" rows="5"></textarea>
            </div>
            <p class="govuk-body"><em>Note: % character can be used as wildcard character in text fields</em></p>

            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset" role="group" aria-describedby="form-a-date-hint">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">Form A Date Between</legend>
                    <div id="form-a-date-hint" class="govuk-hint">Leave blank to search all dates.</div>
                    <div class="govuk-date-input" id="form-a-dates">
                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label asp-for="Filter.EarliestFormADate" class="govuk-label govuk-date-input__label">From</label>
                                <input asp-for="Filter.EarliestFormADate" type="date" class="govuk-input govuk-date-input__input" />
                            </div>
                        </div>
                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label asp-for="Filter.LatestFormADate" class="govuk-label govuk-date-input__label">To</label>
                                <input asp-for="Filter.LatestFormADate" type="date" class="govuk-input govuk-date-input__input" />
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset" role="group" aria-describedby="final-result-date-hint">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">Final Result Date Between</legend>
                    <div id="final-result-date-hint" class="govuk-hint">Leave blank to search all dates.</div>
                    <div class="govuk-date-input" id="final-result-dates">
                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label asp-for="Filter.EarliestFinalResultDate" class="govuk-label govuk-date-input__label">From</label>
                                <input asp-for="Filter.EarliestFinalResultDate" type="date" class="govuk-input govuk-date-input__input" />
                            </div>
                        </div>
                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label asp-for="Filter.LatestFinalResultDate" class="govuk-label govuk-date-input__label">To</label>
                                <input asp-for="Filter.LatestFinalResultDate" type="date" class="govuk-input govuk-date-input__input" />
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset" role="group" aria-describedby="birth-date-hint">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">Birth Date Between</legend>
                    <div id="birth-date-hint" class="govuk-hint">Leave blank to search all dates.</div>
                    <div class="govuk-date-input" id="birth-dates">
                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label asp-for="Filter.EarliestBirthDate" class="govuk-label govuk-date-input__label">From</label>
                                <input asp-for="Filter.EarliestBirthDate" type="date" class="govuk-input govuk-date-input__input" />
                            </div>
                        </div>
                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label asp-for="Filter.LatestBirthDate" class="govuk-label govuk-date-input__label">To</label>
                                <input asp-for="Filter.LatestBirthDate" type="date" class="govuk-input govuk-date-input__input" />
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="govuk-form-group">
                <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                    <div class="govuk-checkboxes__item">
                        <input asp-for="Filter.IncludeNonGb" class="govuk-checkboxes__input" />
                        <label asp-for="Filter.IncludeNonGb" class="govuk-label govuk-checkboxes__label">Include Non-GB Cases?</label>
                    </div>
                    <div class="govuk-checkboxes__item">
                        <input asp-for="Filter.IsImportedCase" class="govuk-checkboxes__input" />
                        <label asp-for="Filter.IsImportedCase" class="govuk-label govuk-checkboxes__label">Imported Cases</label>
                    </div>
                </div>
            </div>

            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
                <a asp-page="/Home" class="govuk-link">Search Menu</a>
            </div>
        </div>
    </div>
</form>

@if (Model.Filter.HasSearched)
{
    <p class="govuk-body">@Model.Filter.TotalCount result(s) found.</p>

    @if (Model.Filter.TotalCount > 0)
    {
        <table class="govuk-table">
            <caption class="govuk-visually-hidden">Case search results</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">RBSE</th>
                    <th scope="col" class="govuk-table__header">CPHH</th>
                    <th scope="col" class="govuk-table__header">Sex</th>
                    <th scope="col" class="govuk-table__header">Survey</th>
                    <th scope="col" class="govuk-table__header">Eartag</th>
                    <th scope="col" class="govuk-table__header">Birth date</th>
                    <th scope="col" class="govuk-table__header">Birth date est</th>
                    <th scope="col" class="govuk-table__header">Form A date</th>
                    <th scope="col" class="govuk-table__header">Fate</th>
                    <th scope="col" class="govuk-table__header">Final result</th>
                    <th scope="col" class="govuk-table__header">Final result date</th>
                    <th scope="col" class="govuk-table__header">DBSE</th>
                    <th scope="col" class="govuk-table__header">Notes</th>
                    <th scope="col" class="govuk-table__header">BAB notes</th>
                    <th scope="col" class="govuk-table__header">Origin</th>
                    <th scope="col" class="govuk-table__header">Valuation age</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var r in Model.Filter.PagedResults)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell bse-rbse"><a asp-page="/Case/Details" asp-route-rbse="@r.Rbse" class="govuk-link">@r.Rbse</a></td>
                        <td class="govuk-table__cell">@r.Cphh</td>
                        <td class="govuk-table__cell">@r.Sex</td>
                        <td class="govuk-table__cell">@r.Survey</td>
                        <td class="govuk-table__cell">@r.Eartag</td>
                        <td class="govuk-table__cell">@r.BirthDate?.ToString("dd/MM/yyyy")</td>
                        <td class="govuk-table__cell">@r.IsBirthDateEst</td>
                        <td class="govuk-table__cell">@r.FormADate?.ToString("dd/MM/yyyy")</td>
                        <td class="govuk-table__cell">@r.Fate</td>
                        <td class="govuk-table__cell">@r.FinalResult</td>
                        <td class="govuk-table__cell">@r.FinalResultDate?.ToString("dd/MM/yyyy")</td>
                        <td class="govuk-table__cell">@r.Dbse</td>
                        <td class="govuk-table__cell">@r.Notes</td>
                        <td class="govuk-table__cell">@r.BabNotes</td>
                        <td class="govuk-table__cell">@r.Origin</td>
                        <td class="govuk-table__cell">@r.ValuationAge</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Filter.TotalPages > 1)
        {
            @* Build a query-string helper that preserves all current filter params *@
            var qs = HttpContext.Request.Query
                .Where(k => !string.Equals(k.Key, "Filter.PageNumber", StringComparison.OrdinalIgnoreCase)
                         && !string.Equals(k.Key, "pageNumber", StringComparison.OrdinalIgnoreCase))
                .SelectMany(k => k.Value, (k, v) => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}")
                .ToList();
            Func<int, string> PageUrl = p => "?" + string.Join("&", qs) + "&Filter.PageNumber=" + p;
            int currentPage = Model.Filter.PageNumber;
            int totalPages  = Model.Filter.TotalPages;
            <nav class="govuk-pagination" aria-label="Pagination">
                @if (currentPage > 1)
                {
                    <div class="govuk-pagination__prev">
                        <a class="govuk-link govuk-pagination__link" href="@PageUrl(currentPage - 1)" rel="prev">
                            <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13">
                                <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z" />
                            </svg>
                            <span class="govuk-pagination__link-title">Previous<span class="govuk-visually-hidden"> page</span></span>
                        </a>
                    </div>
                }
                <ul class="govuk-pagination__list">
                    @for (var p = 1; p <= totalPages; p++)
                    {
                        if (p == currentPage)
                        {
                            <li class="govuk-pagination__item govuk-pagination__item--current">
                                <a class="govuk-link govuk-pagination__link" href="@PageUrl(p)" aria-label="Page @p" aria-current="page">@p</a>
                            </li>
                        }
                        else if (p == 1 || p == totalPages || Math.Abs(p - currentPage) <= 1)
                        {
                            <li class="govuk-pagination__item">
                                <a class="govuk-link govuk-pagination__link" href="@PageUrl(p)" aria-label="Page @p">@p</a>
                            </li>
                        }
                        else if (Math.Abs(p - currentPage) == 2)
                        {
                            <li class="govuk-pagination__item govuk-pagination__item--ellipsis">&ctdot;</li>
                        }
                    }
                </ul>
                @if (currentPage < totalPages)
                {
                    <div class="govuk-pagination__next">
                        <a class="govuk-link govuk-pagination__link" href="@PageUrl(currentPage + 1)" rel="next">
                            <span class="govuk-pagination__link-title">Next<span class="govuk-visually-hidden"> page</span></span>
                            <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13">
                                <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7246z" />
                            </svg>
                        </a>
                    </div>
                }
            </nav>
        }

        <p class="govuk-body">
            <a href="?@(string.Join("&", HttpContext.Request.Query
                .Where(k => !string.Equals(k.Key, "Filter.PageNumber", StringComparison.OrdinalIgnoreCase))
                .SelectMany(k => k.Value, (k, v) => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}")
                .Append("handler=Export")))"
               class="govuk-link">Export to Excel</a>
        </p>
    }
}
