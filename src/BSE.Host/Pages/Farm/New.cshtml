@page
@model BSE.Host.Pages.Farm.NewModel
@{
    ViewData["Title"] = "Create a new farm";
}

<h1 class="govuk-heading-l">Create a new farm</h1>

<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="govuk-error-summary"></div>
    @await Html.PartialAsync("_FarmFormFields", Model.Farm)

    <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">Save farm</button>
        <a asp-page="/Home" class="govuk-link">Cancel</a>
    </div>
</form>
