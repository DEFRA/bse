@page
@using BSE.Host.Helpers
@model BSE.Host.Pages.Farm.NewModel
@{
    var pageTitle = Model.ReturnToCaseFarm ? "New Farm" : "Create a new farm";
    ViewData["Title"] = pageTitle;
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">@pageTitle</li>
    </ol>
</nav>

<h1 class="govuk-heading-l">@pageTitle</h1>

@if (Model.ReturnToCaseFarm)
{
    <p class="govuk-body"><strong>CPH:</strong> @BseFormat.FormatCphh(Model.Farm.CPHH ?? Model.ReturnCphh)</p>
}

@if (!string.IsNullOrWhiteSpace(Model.VetnetMessage))
{
    <p class="govuk-body">@Model.VetnetMessage</p>
}

@if (Model.ReturnToCaseFarm && Model.VetnetFound)
{
    <p class="govuk-body">Found on Vetnet</p>
    <dl class="govuk-summary-list govuk-!-margin-bottom-4">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Herdmark</dt>
            <dd class="govuk-summary-list__value">@Model.VetnetHerdmark</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Numeric Herdmark</dt>
            <dd class="govuk-summary-list__value">@Model.VetnetNumericHerdmark</dd>
        </div>
    </dl>

    <div class="govuk-form-group">
        <div class="govuk-checkboxes" data-module="govuk-checkboxes">
            <div class="govuk-checkboxes__item">
                <input asp-for="AcceptVetnetDetails" class="govuk-checkboxes__input" />
                <label asp-for="AcceptVetnetDetails" class="govuk-label govuk-checkboxes__label">Accept Vetnet Details?</label>
            </div>
        </div>
    </div>
}

@if (Model.ShowBrusselsWarning)
{
    <p class="govuk-body govuk-!-font-weight-bold">@Model.BrusselsWarningText</p>
}

@if (!ViewContext.ModelState.IsValid)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var modelError in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@modelError.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

<form method="post" novalidate id="farm-new-form">
    <input type="hidden" asp-for="ReturnRbse" />
    <input type="hidden" asp-for="ReturnCphh" />
    <input type="hidden" asp-for="ReturnToCaseFarm" />

    @if (Model.ReturnToCaseFarm)
    {
        <input type="hidden" asp-for="Farm.CPHH" />
    }
    else
    {
        <div class="govuk-form-group @(ViewData.ModelState.ContainsKey("Farm.CPHH") && ViewData.ModelState["Farm.CPHH"]!.Errors.Count > 0 ? "govuk-form-group--error" : "")">
            <label asp-for="Farm.CPHH" class="govuk-label">CPHH</label>
            @if (ViewData.ModelState.ContainsKey("Farm.CPHH") && ViewData.ModelState["Farm.CPHH"]!.Errors.Count > 0)
            {
                <p id="farm-cphh-error" class="govuk-error-message">
                    <span class="govuk-visually-hidden">Error:</span>@ViewData.ModelState["Farm.CPHH"]!.Errors[0].ErrorMessage
                </p>
            }
            <input asp-for="Farm.CPHH"
                   id="farm-cphh"
                   class="govuk-input govuk-input--width-20 @(ViewData.ModelState.ContainsKey("Farm.CPHH") && ViewData.ModelState["Farm.CPHH"]!.Errors.Count > 0 ? "govuk-input--error" : "")"
                   autocomplete="off"
                   maxlength="14" />
        </div>
    }

    @if (!Model.ReturnToCaseFarm)
    {
        @await Html.PartialAsync("_FarmFormFields", Model.Farm, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "Farm" } })
    }

    <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">@(Model.ReturnToCaseFarm ? "Create Farm" : "OK")</button>
        @if (!string.IsNullOrWhiteSpace(Model.ReturnRbse) && Model.ReturnToCaseFarm)
        {
            <a id="cancel-link" asp-page="/Case/Farm" asp-route-rbse="@Model.ReturnRbse" class="govuk-link">Cancel</a>
        }
        else if (!string.IsNullOrWhiteSpace(Model.ReturnRbse))
        {
            <a id="cancel-link" asp-page="/Case/Farm" asp-route-rbse="@Model.ReturnRbse" asp-route-newCphh="@Model.ReturnCphh" class="govuk-link">Cancel</a>
        }
        else
        {
            <a id="cancel-link" asp-page="/Home" class="govuk-link">Cancel</a>
        }
    </div>
</form>
