@page "{cphh}"
@model BSE.Host.Pages.Farm.EditModel
@{
    ViewData["Title"] = "Edit farm";
}

<h1 class="govuk-heading-l">Edit farm: <span class="bse-rbse">@Model.Farm?.CPHH</span></h1>

@if (!ViewContext.ModelState.IsValid)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var modelError in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@modelError.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

<form method="post" novalidate>
    @await Html.PartialAsync("_FarmFormFields", Model.Farm)

    <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">Save changes</button>
        <a asp-page="/Farm/Details" asp-route-cphh="@Model.Farm?.CPHH" class="govuk-link">Cancel</a>
    </div>
</form>
