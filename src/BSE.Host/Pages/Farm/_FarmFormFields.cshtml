@model BSE.Host.Models.ViewModels.FarmEditViewModel

<div class="govuk-form-group">
    <label asp-for="CPHH" class="govuk-label">CPHH</label>
    <input asp-for="CPHH" class="govuk-input govuk-!-width-one-half" />
    <span asp-validation-for="CPHH" class="govuk-error-message"></span>
</div>
<div class="govuk-form-group">
    <label asp-for="OwnerName" class="govuk-label">Owner name</label>
    <input asp-for="OwnerName" class="govuk-input govuk-!-width-two-thirds" />
</div>
<div class="govuk-form-group">
    <label asp-for="County" class="govuk-label">County</label>
    <input asp-for="County" class="govuk-input govuk-!-width-one-half" />
</div>
<div class="govuk-form-group">
    <label asp-for="Address1" class="govuk-label">Address line 1</label>
    <input asp-for="Address1" class="govuk-input govuk-!-width-two-thirds" />
</div>
<div class="govuk-form-group">
    <label asp-for="Address2" class="govuk-label">Address line 2</label>
    <input asp-for="Address2" class="govuk-input govuk-!-width-two-thirds" />
</div>
<div class="govuk-form-group">
    <label asp-for="Address3" class="govuk-label">Address line 3</label>
    <input asp-for="Address3" class="govuk-input govuk-!-width-two-thirds" />
</div>
<div class="govuk-form-group">
    <label asp-for="Postcode" class="govuk-label">Postcode</label>
    <input asp-for="Postcode" class="govuk-input govuk-!-width-one-third" />
</div>
<div class="govuk-form-group">
    <label asp-for="Parish" class="govuk-label">Parish</label>
    <input asp-for="Parish" class="govuk-input govuk-!-width-one-half" />
</div>
<div class="govuk-form-group">
    <label asp-for="Herdmark1" class="govuk-label">Herdmark</label>
    <input asp-for="Herdmark1" class="govuk-input govuk-!-width-one-half" />
</div>
<div class="govuk-form-group">
    <label asp-for="AHO" class="govuk-label">AHO</label>
    <input asp-for="AHO" class="govuk-input govuk-!-width-one-half" />
</div>
<div class="govuk-form-group">
    <label asp-for="HerdType" class="govuk-label">Herd type</label>
    <input asp-for="HerdType" class="govuk-input govuk-!-width-one-half" />
</div>
<div class="govuk-form-group">
    <div class="govuk-checkboxes" data-module="govuk-checkboxes">
        <div class="govuk-checkboxes__item">
            <input asp-for="IsDealer" class="govuk-checkboxes__input" />
            <label asp-for="IsDealer" class="govuk-label govuk-checkboxes__label">Dealer</label>
        </div>
    </div>
</div>
