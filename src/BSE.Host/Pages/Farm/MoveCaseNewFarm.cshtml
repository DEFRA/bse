@page
@model BSE.Host.Pages.Farm.MoveCaseNewFarmModel
@{
    ViewData["Title"] = "Move case to new farm";
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Move case to new farm</li>
    </ol>
</nav>

<h1 class="govuk-heading-l">Move case to new farm</h1>

@if (!string.IsNullOrWhiteSpace(Model.DisplayRbse))
{
    <p class="govuk-body govuk-!-margin-bottom-4">
        <strong>RBSE:</strong> @Model.DisplayRbse
        <span class="govuk-!-margin-left-4"><strong>CPHH:</strong> @BSE.Host.Helpers.BseFormat.FormatCphh(Model.Farm.CPHH)</span>
    </p>
}

@if (!ViewContext.ModelState.IsValid)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var modelError in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@modelError.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

<form method="post" novalidate id="farm-new-form">
    <input type="hidden" asp-for="ReturnRbse" />
    <input type="hidden" asp-for="ReturnCphh" />
    <input type="hidden" asp-for="Farm.CPHH" />

    @await Html.PartialAsync("_FarmFormFields", Model.Farm, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "Farm" } })

    <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">Save farm</button>
        <a id="cancel-link" asp-page="/Case/MoveCase" asp-route-rbse="@Model.ReturnRbse" class="govuk-link">Cancel</a>
    </div>
</form>
