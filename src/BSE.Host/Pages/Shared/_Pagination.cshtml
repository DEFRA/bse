@* GDS govuk-pagination partial.
   Parameters (passed via ViewData):
     ViewData["CurrentPage"]   — int
     ViewData["TotalPages"]    — int
     ViewData["PageNumberKey"] — string (optional, default: "pageNumber")
                                 Pass "Filter.PageNumber" for pages that bind
                                 PageNumber inside a Filter view-model (Farms, Outstanding).
     ViewData["MaxPageLinks"]  — int (optional)
                                 When set (>0), renders a fixed-size numeric page block
                                 (e.g. 1..10, then 11..20), instead of compact/ellipsis mode.
     ViewData["SlidingWindow"] — bool (optional, default: true)
                                 Keeps the numeric links as a window that follows the current
                                 page (3 pages ahead where available, the rest behind) rather
                                 than jumping a block at a time, so page 10 of 20 shows 4..13.
                                 Set false for fixed blocks (1..10, then 11..20).
     ViewData["ArrowsOnly"]    — bool (optional, default: true)
                                 Renders Previous/Next as ‹ / › chevrons so all four controls are
                                 symbols (« ‹ › »), instead of mixing symbols with text labels.
     ViewData["Fragment"]      — string (optional) anchor id to jump back to the results
                                 table instead of the top of the page.
     ViewData["AlwaysShow"]    — bool (optional, default: false) legacy's DataGridPager
                                 always displayed its page bar, even with a single page
                                 (e.g. Pick List Maintenance). Set true to keep that parity;
                                 other callers keep the default of hiding a single-page control.

   Every caller of this partial gets, unconditionally, full parity with legacy's
   DataGridPager (e.g. UserMaintenance.aspx): First («) / Last (») links either side
   of Previous/Next so a sliding page window can jump straight to the first or last
   block, and a "Page X of Y" indicator above the nav so users can see how many pages
   exist in total (the GOV.UK Design System's pagination component has no built-in
   total-page count, so this is rendered as plain GDS body text, matching the
   documented GDS pattern for showing result context alongside pagination). *@
@{
    int currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    int totalPages  = (int)(ViewData["TotalPages"]  ?? 1);
    string pageKey  = (string?)ViewData["PageNumberKey"] ?? "pageNumber";
    int maxPageLinks = (int?)ViewData["MaxPageLinks"] ?? 10;
    bool slidingWindow = (bool?)ViewData["SlidingWindow"] ?? true;
    bool arrowsOnly = (bool?)ViewData["ArrowsOnly"] ?? true;
    string fragment = (string?)ViewData["Fragment"] ?? "";
    bool alwaysShow = (bool?)ViewData["AlwaysShow"] ?? false;

    if (totalPages <= 1 && !alwaysShow) { return; }

    // Strip BOTH possible page-number keys so neither leaks into generated links.
    var qs = ViewContext.HttpContext.Request.Query
        .Where(k => !string.Equals(k.Key, "pageNumber",        StringComparison.OrdinalIgnoreCase)
                 && !string.Equals(k.Key, "Filter.PageNumber", StringComparison.OrdinalIgnoreCase)
                 && !string.Equals(k.Key, pageKey,               StringComparison.OrdinalIgnoreCase))
        .SelectMany(k => k.Value, (k, v) => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}")
        .ToList();

    string PageUrl(int p)
    {
        var url = "?" + string.Join("&", qs) + $"&{Uri.EscapeDataString(pageKey)}={p}";
        return string.IsNullOrWhiteSpace(fragment) ? url : url + "#" + Uri.EscapeDataString(fragment);
    }

    int blockStart = 1;
    int blockEnd = totalPages;

    if (maxPageLinks > 0)
    {
        // Clamp currentPage-derived bounds so the page-link loop below can never iterate
        // more than maxPageLinks times, regardless of unsanitized page-number input.
        var safePage = Math.Max(1, Math.Min(currentPage, totalPages));

        if (slidingWindow)
        {
            // Keep up to 3 pages visible ahead of the current one; the window fills backwards.
            const int pagesAhead = 3;
            blockEnd = Math.Min(totalPages, safePage + pagesAhead);
            blockStart = Math.Max(1, blockEnd - maxPageLinks + 1);
            blockEnd = Math.Min(totalPages, blockStart + maxPageLinks - 1);
        }
        else
        {
            blockStart = ((safePage - 1) / maxPageLinks) * maxPageLinks + 1;
            blockStart = Math.Max(1, Math.Min(blockStart, totalPages));
            blockEnd = Math.Min(totalPages, blockStart + maxPageLinks - 1);
        }
    }
}

<div class="bse-pagination-bar">
<p class="govuk-body govuk-!-margin-bottom-2 bse-pagination__count">Page @currentPage of @totalPages</p>

<nav class="govuk-pagination bse-pagination" aria-label="Pagination">
    @if (currentPage > 1)
    {
        <div class="govuk-pagination__prev bse-pagination__first">
            <a class="govuk-link govuk-pagination__link" href="@PageUrl(1)" title="Go to first page" rel="first">
                <span class="govuk-pagination__link-title" aria-hidden="true">&laquo;</span>
                <span class="govuk-visually-hidden">First page</span>
            </a>
        </div>
    }
    @if (currentPage > 1)
    {
        <div class="govuk-pagination__prev">
            <a class="govuk-link govuk-pagination__link" href="@PageUrl(currentPage - 1)" title="Go to previous page (page @(currentPage - 1))" rel="prev">
                @if (arrowsOnly)
                {
                    <span class="govuk-pagination__link-title" aria-hidden="true">&lsaquo;</span>
                    <span class="govuk-visually-hidden">Previous page</span>
                }
                else
                {
                    <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13">
                        <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z" />
                    </svg>
                    <span class="govuk-pagination__link-title">Previous<span class="govuk-visually-hidden"> page</span></span>
                }
            </a>
        </div>
    }
    <ul class="govuk-pagination__list">
        @if (maxPageLinks > 0)
        {
            for (var p = blockStart; p <= blockEnd; p++)
            {
                if (p == currentPage)
                {
                    <li class="govuk-pagination__item govuk-pagination__item--current">
                        <a class="govuk-link govuk-pagination__link" href="@PageUrl(p)" title="Page @p of @totalPages (current page)" aria-label="Page @p" aria-current="page">@p</a>
                    </li>
                }
                else
                {
                    <li class="govuk-pagination__item">
                        <a class="govuk-link govuk-pagination__link" href="@PageUrl(p)" title="Go to page @p of @totalPages" aria-label="Page @p">@p</a>
                    </li>
                }
            }
        }
        else
        {
            for (var p = 1; p <= totalPages; p++)
            {
                if (p == currentPage)
                {
                    <li class="govuk-pagination__item govuk-pagination__item--current">
                        <a class="govuk-link govuk-pagination__link" href="@PageUrl(p)" title="Page @p of @totalPages (current page)" aria-label="Page @p" aria-current="page">@p</a>
                    </li>
                }
                else if (p == 1 || p == totalPages || Math.Abs(p - currentPage) <= 1)
                {
                    <li class="govuk-pagination__item">
                        <a class="govuk-link govuk-pagination__link" href="@PageUrl(p)" title="Go to page @p of @totalPages" aria-label="Page @p">@p</a>
                    </li>
                }
                else if (Math.Abs(p - currentPage) == 2)
                {
                    <li class="govuk-pagination__item govuk-pagination__item--ellipsis">&ctdot;</li>
                }
            }
        }
    </ul>
    @if (currentPage < totalPages)
    {
        <div class="govuk-pagination__next">
            <a class="govuk-link govuk-pagination__link" href="@PageUrl(currentPage + 1)" title="Go to next page (page @(currentPage + 1))" rel="next">
                @if (arrowsOnly)
                {
                    <span class="govuk-visually-hidden">Next page</span>
                    <span class="govuk-pagination__link-title" aria-hidden="true">&rsaquo;</span>
                }
                else
                {
                    <span class="govuk-pagination__link-title">Next<span class="govuk-visually-hidden"> page</span></span>
                    <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13">
                        <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7246z" />
                    </svg>
                }
            </a>
        </div>
    }
    @if (currentPage < totalPages)
    {
        <div class="govuk-pagination__next bse-pagination__last">
            <a class="govuk-link govuk-pagination__link" href="@PageUrl(totalPages)" title="Go to last page (page @totalPages)" rel="last">
                <span class="govuk-visually-hidden">Last page</span>
                <span class="govuk-pagination__link-title" aria-hidden="true">&raquo;</span>
            </a>
        </div>
    }
</nav>
</div>
