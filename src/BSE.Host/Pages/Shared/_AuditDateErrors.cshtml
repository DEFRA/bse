@model BSE.Host.Models.ViewModels.AuditDateRangeViewModel
@{
    // NewFarms historically ends each message with a full stop; the other reports do not.
    var suffix = (string?)ViewData["ErrorSuffix"] ?? "";
}
    @if (Model.StartDateError is not null || Model.EndDateError is not null)
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list">
                        @if (Model.StartDateError is not null)
                        {
                            <li><a href="#audit-start-date">@(Model.StartDateError + suffix)</a></li>
                        }
                        @if (Model.EndDateError is not null)
                        {
                            <li><a href="#audit-end-date">@(Model.EndDateError + suffix)</a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
