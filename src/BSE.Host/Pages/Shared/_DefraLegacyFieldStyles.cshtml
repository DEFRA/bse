.defra-legacy-grid--toprow {
    margin-bottom: 1rem;
}

.defra-legacy-field {
    display: grid;
    grid-template-columns: 235px 252px;
    column-gap: 10px;
    align-items: start;
    margin-bottom: 0;
}

.defra-legacy-field .govuk-label {
    margin-bottom: 0;
    font-weight: 400;
    font-size: 19px;
    line-height: 1.25;
    white-space: nowrap;
}
