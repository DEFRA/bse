.bse-eartag-help__tooltip {
    position: absolute;
    left: calc(100% + 0.35rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    max-width: 24rem;
    background: #ffffff;
    border: 1px solid #b1b4b6;
    box-shadow: 0 2px 6px rgba(11, 12, 12, 0.15);
    padding: 0.5rem 0.65rem;
    font-size: 0.95rem;
    line-height: 1.3;
}
