@* Shared partial — case-edit tab success/warning banners + GDS error summary.
   Usage: @await Html.PartialAsync("_CaseEditNotifications",
       new BSE.Host.Models.CaseEditNotificationsViewModel("feeds", TempData["Success"] as string, TempData["Warning"] as string, Model.FieldErrors.Values))
*@
@model BSE.Host.Models.CaseEditNotificationsViewModel

@if (Model.SuccessMessage is not null)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
         aria-labelledby="@(Model.IdPrefix)-success-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="@(Model.IdPrefix)-success-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@Model.SuccessMessage</p>
        </div>
    </div>
}

@if (Model.WarningMessage is not null)
{
    <section class="govuk-notification-banner"
             aria-labelledby="@(Model.IdPrefix)-warning-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="@(Model.IdPrefix)-warning-title">Important</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-body">@Model.WarningMessage</p>
        </div>
    </section>
}

@if (!ViewContext.ModelState.IsValid || Model.ExtraFieldErrors is { Count: > 0 })
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var e in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@e.ErrorMessage</li>
                    }
                    @if (Model.ExtraFieldErrors is not null)
                    {
                        @foreach (var e in Model.ExtraFieldErrors)
                        {
                            <li>@e</li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
}
