    .bse-inline-row-button {
        border: 1px solid #0b0c0c;
        background: #fff;
        color: #0b0c0c;
        padding: 4px 8px;
        min-height: 36px;
        font-size: 1rem;
        line-height: 1.1;
        cursor: pointer;
    }

    .bse-inline-row-button:hover {
        background: #f3f2f1;
    }

    .bse-inline-row-button:focus {
        outline: 3px solid #ffdd00;
        outline-offset: 0;
    }

    .bse-inline-row-button--secondary {
        border-color: #505a5f;
    }

    .bse-inline-row-button--confirm {
        background: #00703c;
        border-color: #00703c;
        color: #fff;
    }

    .bse-inline-row-button--confirm:hover {
        background: #005a30;
        border-color: #005a30;
    }
