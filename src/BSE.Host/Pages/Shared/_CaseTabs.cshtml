@* Shared partial — case section tab bar (mirrors legacy 7-tab bar)
   Usage: @await Html.PartialAsync("_CaseTabs", new BSE.Host.Models.CaseTabsViewModel("Farm", rbse))
*@
@model BSE.Host.Models.CaseTabsViewModel
@inject BSE.SharedKernel.IUserContext UserContext
@{
    var showConfidentialData = !User.IsInRole("DataEntry")
        && (string.Equals(Model.ActiveTab, "Farm", StringComparison.OrdinalIgnoreCase)
            || string.Equals(Model.ActiveTab, "Feeds", StringComparison.OrdinalIgnoreCase));

    var tabs = new[]
    {
        new { Label = "Farm",        Page = "/Case/Farm"     },
        new { Label = "Case (DEFRA)", Page = "/Case/Edit"    },
        new { Label = "BAB",         Page = "/Case/Bab"      },
        new { Label = "Case (APHA)",  Page = "/Case/Vla"      },
        new { Label = "Clinical",    Page = "/Case/Clinical" },
        new { Label = "Feeds",       Page = "/Case/Feeds"    },
        new { Label = "Relations",   Page = "/Case/Relations"},
    };

    // Farm, Case (DEFRA), Case (APHA), BAB and Clinical stage their scalar fields into the
    // shared cross-tab draft (BSE.Host.Services.CaseScalarDraftState) before navigating away,
    // so an invalid field blocks the tab switch, and the edit is not silently lost when Save
    // is eventually pressed on a different tab. Feeds and Relations are pure row-editing grids
    // with no scalar "form" state at risk, so their tab links are unchanged (plain navigation).
    string? stageAndGotoFormId = Model.ActiveTab switch
    {
        "Farm" => "case-farm-inline-form",
        "Case (DEFRA)" => "case-edit-inline-form",
        "Case (APHA)" => "edit-vla-form",
        "BAB" => "case-bab-inline-form",
        "Clinical" => "case-clinical-inline-form",
        _ => null
    };

    // Reuses the per-tab form id below via the "form" attribute, so the common Save/Cancel actions
    // rendered here (next to View docs) submit the active tab's own form even though they sit
    // outside it in the DOM. Separate from stageAndGotoFormId above: all 7 tabs have their own
    // Save/Cancel, but only the 5 scalar-field tabs support staging mid-navigation.
    string? saveCancelFormId = Model.ActiveTab switch
    {
        "Farm" => "case-farm-inline-form",
        "Case (DEFRA)" => "case-edit-inline-form",
        "Case (APHA)" => "edit-vla-form",
        "BAB" => "case-bab-inline-form",
        "Clinical" => "case-clinical-inline-form",
        "Feeds" => "case-feeds-inline-form",
        "Relations" => "case-relations-inline-form",
        _ => null
    };
    string? topSaveHandler = Model.SaveHandlerOverride ?? Model.ActiveTab switch
    {
        "Farm" => "SaveFarm",
        "BAB" => "SaveBab",
        "Clinical" => "SaveSigns",
        "Feeds" => "SaveFeeds",
        "Relations" => "SaveRelations",
        _ => null
    };
    (string Page, string? Handler)? topCancel = Model.CancelPageOverride is not null
        ? (Model.CancelPageOverride, Model.CancelHandlerOverride)
        : Model.ActiveTab switch
    {
        "Farm" => ("/Case/Farm", "CancelFarmEdit"),
        "Case (DEFRA)" => ("/Case/Edit", "CancelEdit"),
        "Case (APHA)" => ("/Case/Vla", "CancelVlaEdit"),
        "BAB" => ("/Case/Bab", "CancelBabEdit"),
        "Clinical" => ("/Case/Clinical", "CancelClinicalEdit"),
        "Feeds" => ("/Case/Feeds", "CancelFeedsEdit"),
        "Relations" => ("/Case/Relations", "CancelRelationsEdit"),
        _ => ((string, string?)?)null
    };
    var showTopSaveCancel = Model.CanEditCurrentTab && saveCancelFormId is not null && topCancel is not null;
}

@* RBSE heading + batch numbers panel side-by-side (GOV.UK grid — stacks on narrow screens),
   mirroring legacy's RBSE number / BatchNumberDisplay1 header row. *@
<div class="govuk-grid-row govuk-!-margin-bottom-2">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-l govuk-!-margin-bottom-2">Case Details</h1>
        <p class="govuk-body bse-case-header-meta govuk-!-margin-bottom-0">
            <strong>RBSE Number: <span class="bse-rbse">@BseFormat.FormatRbse(Model.Rbse)</span></strong>
            @if (showConfidentialData)
            {
                <span class="bse-case-header-confidential govuk-!-margin-left-4">CONFIDENTIAL DATA</span>
            }
        </p>
    </div>

<script>
    (function () {
        var caseFormSelector = '#case-farm-inline-form, #case-edit-inline-form, #case-bab-inline-form, #edit-vla-form, #case-clinical-inline-form, #case-feeds-inline-form, #case-relations-inline-form';
        var storagePrefix = 'bse:case-tab-draft:';
        var initialSnapshot = null;
        var restoredFromDraft = false;

        function normalizeRbse(rbse) {
            return (rbse || '').replace(/\//g, '').trim();
        }

        function getCurrentCaseForm() {
            return document.querySelector(caseFormSelector);
        }

        function getCurrentTabPath() {
            var match = window.location.pathname.match(/^\/Case\/[A-Za-z]+/i);
            return match ? match[0].toLowerCase() : null;
        }

        function getDraftStorageKey(tabPath, rbse) {
            return storagePrefix + tabPath + ':' + normalizeRbse(rbse);
        }

        function serializeForm(form) {
            var payload = {};
            if (!form) {
                return payload;
            }

            form.querySelectorAll('input, select, textarea').forEach(function (el) {
                var name = el.name || el.id;
                if (!name) {
                    return;
                }

                if (el.tagName === 'INPUT') {
                    var type = (el.type || '').toLowerCase();
                    if (type === 'hidden' || type === 'submit' || type === 'button' || type === 'reset' || type === 'file' || type === 'image') {
                        return;
                    }

                    if (type === 'checkbox') {
                        payload[name] = !!el.checked;
                        return;
                    }

                    if (type === 'radio') {
                        if (el.checked) {
                            payload[name] = el.value;
                        }
                        return;
                    }
                }

                payload[name] = el.value;
            });

            return payload;
        }

        function restoreForm(form, payload) {
            if (!form || !payload) {
                return;
            }

            form.querySelectorAll('input, select, textarea').forEach(function (el) {
                var name = el.name || el.id;
                if (!name || !(name in payload)) {
                    return;
                }

                if (el.tagName === 'INPUT') {
                    var type = (el.type || '').toLowerCase();
                    if (type === 'checkbox') {
                        el.checked = !!payload[name];
                        return;
                    }

                    if (type === 'radio') {
                        el.checked = (el.value === payload[name]);
                        return;
                    }
                }

                el.value = payload[name] ?? '';
            });

            form.querySelectorAll('select, input[type="checkbox"], input[type="radio"]').forEach(function (el) {
                el.dispatchEvent(new Event('change', { bubbles: true }));
            });
        }

        function showUnsavedBanner() {
            // Unsaved-changes banner removed from the UI; cross-tab detection still relies on
            // the server-side draft-state check in hasUnsavedChangesAcrossTabs().
        }

        function hasUnsavedBannerOnPage() {
            return false;
        }

        function extractRbseFromPath() {
            var match = window.location.pathname.match(/\/Case\/[A-Za-z]+\/(\d{9}|\d{3}\/\d{2}\/\d{4})/i);
            return match ? match[1] : null;
        }

        function clearClientSideDrafts(rbse) {
            var normalized = normalizeRbse(rbse);
            if (!normalized) {
                return;
            }

            for (var i = sessionStorage.length - 1; i >= 0; i--) {
                var key = sessionStorage.key(i);
                if (!key || !key.startsWith(storagePrefix)) {
                    continue;
                }

                if (key.endsWith(':' + normalized)) {
                    sessionStorage.removeItem(key);
                }
            }
        }

        function persistCurrentTabDraft() {
            var form = getCurrentCaseForm();
            var rbse = extractRbseFromPath();
            var tabPath = getCurrentTabPath();
            if (!form || !rbse || !tabPath) {
                return;
            }

            var key = getDraftStorageKey(tabPath, rbse);
            var snapshot = JSON.stringify(serializeForm(form));

            if (restoredFromDraft || snapshot !== initialSnapshot) {
                sessionStorage.setItem(key, snapshot);
                showUnsavedBanner();
            } else {
                sessionStorage.removeItem(key);
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            var form = getCurrentCaseForm();
            var rbse = extractRbseFromPath();
            var tabPath = getCurrentTabPath();
            if (!form || !rbse || !tabPath) {
                return;
            }

            var key = getDraftStorageKey(tabPath, rbse);
            var hasSuccessBanner = !!document.querySelector('.govuk-notification-banner--success');

            if (hasSuccessBanner) {
                sessionStorage.removeItem(key);
                initialSnapshot = JSON.stringify(serializeForm(form));
                restoredFromDraft = false;
                return;
            }

            initialSnapshot = JSON.stringify(serializeForm(form));
            var raw = sessionStorage.getItem(key);
            if (!raw) {
                return;
            }

            try {
                restoreForm(form, JSON.parse(raw));
                restoredFromDraft = true;
                showUnsavedBanner();
            } catch {
                sessionStorage.removeItem(key);
            }
        });

        // Legacy parity: CancelCaseEdit()/the Home link both stage the CURRENT tab's just-typed
        // field values before checking DataSetHasChanges, so an edit never-staged-anywhere (no tab
        // switch, no Save) still triggers the confirm. Reuses the same form snapshot already taken
        // for the sessionStorage draft-restore feature above, rather than tracking dirty state twice.
        function isCurrentFormDirty() {
            var form = getCurrentCaseForm();
            if (!form) {
                return false;
            }

            return restoredFromDraft || JSON.stringify(serializeForm(form)) !== initialSnapshot;
        }

        async function hasUnsavedChangesAcrossTabs() {
            if (hasUnsavedBannerOnPage() || isCurrentFormDirty()) {
                return true;
            }

            var rbse = extractRbseFromPath();
            if (!rbse) {
                return false;
            }

            try {
                var response = await fetch('/case/' + encodeURIComponent(rbse) + '/unsaved-status', {
                    method: 'GET',
                    headers: { 'Accept': 'application/json' },
                    credentials: 'same-origin'
                });

                if (!response.ok) {
                    return false;
                }

                var payload = await response.json();
                return !!(payload && payload.hasUnsavedChanges === true);
            } catch {
                return false;
            }
        }

        async function clearUnsavedChangesAcrossTabs() {
            var rbse = extractRbseFromPath();
            if (!rbse) {
                return;
            }

            try {
                await fetch('/case/' + encodeURIComponent(rbse) + '/discard-unsaved', {
                    method: 'POST',
                    headers: { 'Accept': 'application/json' },
                    credentials: 'same-origin'
                });
                clearClientSideDrafts(rbse);
            } catch {
                // Navigation should still proceed even if draft-clear call fails.
            }
        }

        // Exposed so each tab's own Cancel-link confirm can see cross-tab staged edits too.
        window.hasUnsavedChangesAcrossTabs = hasUnsavedChangesAcrossTabs;
        window.clearUnsavedChangesAcrossTabs = clearUnsavedChangesAcrossTabs;

        function isHomeLink(anchor) {
            if (!anchor) {
                return false;
            }

            var href = anchor.getAttribute('href') || '';
            return href === '/Home' || href === '/' || /\/Home(?:\?|$)/i.test(href);
        }

        function isCaseAuditLogLink(anchor) {
            if (!anchor) {
                return false;
            }

            var href = anchor.getAttribute('href') || '';
            return /\/AuditLog\/ByCase(?:\?|$)/i.test(href);
        }

        // Mirrors legacy behaviour: a tab with outstanding red-star validation errors
        // (live client-side warning/error stars) cannot be navigated away from until
        // the problem is fixed. Currently only the Case (APHA)/Vla tab implements the
        // red-star/green-star live validation, so the blocker only applies to that form.
        function isStarVisible(star) {
            if (star.hidden) {
                return false;
            }

            if (star.style.display === 'none') {
                return false;
            }

            return true;
        }

        function hasVisibleValidationErrors() {
            var form = getCurrentCaseForm();
            if (!form || form.id !== 'edit-vla-form') {
                return false;
            }

            var stars = form.querySelectorAll('.bse-star-error, .bse-vla-star-red');
            for (var i = 0; i < stars.length; i++) {
                if (isStarVisible(stars[i])) {
                    return true;
                }
            }

            return false;
        }

        document.addEventListener('click', async function (event) {
            var tabLink = event.target.closest('a.bse-case-tabs__link');
            if (tabLink) {
                if (hasVisibleValidationErrors()) {
                    event.preventDefault();
                    return;
                }
                window.__bseCaseTabNavigationInProgress = true;
                persistCurrentTabDraft();
                return;
            }

            var link = event.target.closest('a');

            if (isCaseAuditLogLink(link) && hasVisibleValidationErrors()) {
                event.preventDefault();
                return;
            }

            if (!isHomeLink(link)) {
                return;
            }

            // Keep parity with tab navigation: persist current tab edits before leaving.
            persistCurrentTabDraft();

            var unsaved = await hasUnsavedChangesAcrossTabs();
            if (!unsaved) {
                return;
            }

            event.preventDefault();
            var confirmed = window.confirm('You have unsaved changes. Click OK to discard them and leave, or Cancel to go back and save.');
            if (confirmed) {
                await clearUnsavedChangesAcrossTabs();
                window.location.href = link.href;
            }
        });
    })();
</script>
    <div class="govuk-grid-column-full">
        <div class="bse-batch-docs-row govuk-!-margin-top-2">
            <div class="bse-batch-docs-row__actions govuk-button-group">
                @if (User.IsInRole("VLAAccess"))
                {
                    <div class="bse-batch-docs-row__batch">
                        @await Html.PartialAsync("_BatchNumbersPanel", new BSE.Host.Models.BatchNumbersPanelViewModel(Model.Rbse, Model.BatchNumbers ?? []))
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ViewDocsUrl))
                {
                    <a href="@Model.ViewDocsUrl" target="_blank" rel="noopener noreferrer" role="button" draggable="false"
                       class="govuk-button govuk-button--secondary" data-module="govuk-button">
                        View docs<span class="govuk-visually-hidden"> (opens in new tab)</span>
                    </a>
                }
                @if (showTopSaveCancel)
                {
                    @if (topSaveHandler is not null)
                    {
                        <button type="submit" form="@saveCancelFormId" asp-page-handler="@topSaveHandler" class="govuk-button" data-module="govuk-button">Save</button>
                    }
                    else
                    {
                        <button type="submit" form="@saveCancelFormId" class="govuk-button" data-module="govuk-button">Save</button>
                    }
                    <a asp-page="@topCancel!.Value.Page" asp-page-handler="@topCancel!.Value.Handler" asp-route-rbse="@Model.Rbse"
                       class="govuk-button govuk-button--secondary bse-cancel-link" data-module="govuk-button" role="button" draggable="false">Cancel</a>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .bse-case-header-meta {
        font-size: 1.1875rem;
        line-height: 1.3157894737;
    }

    .bse-case-header-confidential {
        display: inline-block;
        color: #d4351c;
        font-weight: 700;
        font-size: 1.1875rem;
        line-height: 1.3157894737;
    }

    .bse-batch-docs-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }

    .bse-batch-docs-row__actions {
        display: flex;
        align-items: center;
        margin: 0 0 0 auto;
        white-space: nowrap;
    }

    .bse-batch-docs-row__actions .bse-batch-docs-row__batch {
        margin: 0 15px 10px 0;
    }

    .bse-batch-docs-row__batch .bse-batch-panel {
        margin-bottom: 0;
    }

    .bse-batch-docs-row__batch .govuk-details {
        margin-bottom: 0;
    }

    @@media (max-width: 40.0525em) {
        .bse-batch-docs-row {
            flex-wrap: wrap;
            gap: 10px;
            align-items: flex-start;
        }
    }
</style>

<div class="bse-case-tabs-wrap">
    <nav class="bse-case-tabs govuk-!-margin-bottom-6" aria-label="Case sections">
        <ul class="bse-case-tabs__list" role="list">
            @foreach (var tab in tabs)
            {
                bool isActive = string.Equals(tab.Label, Model.ActiveTab, StringComparison.OrdinalIgnoreCase);
                if (isActive)
                {
                    <li class="bse-case-tabs__item bse-case-tabs__item--active" aria-current="page">
                        <span class="bse-case-tabs__link">@tab.Label</span>
                    </li>
                }
                else
                {
                    <li class="bse-case-tabs__item">
                        @if (stageAndGotoFormId is not null)
                        {
                            <button type="submit" form="@stageAndGotoFormId"
                                    formmethod="post"
                                    formaction="?handler=StageAndGoto&amp;rbse=@Uri.EscapeDataString(Model.Rbse)&amp;targetPage=@Uri.EscapeDataString(tab.Page)"
                                    class="bse-case-tabs__link bse-case-tabs__link--button govuk-link govuk-link--no-visited-state">@tab.Label</button>
                        }
                        else
                        {
                            <a class="bse-case-tabs__link govuk-link govuk-link--no-visited-state"
                               asp-page="@tab.Page" asp-route-rbse="@Model.Rbse">@tab.Label</a>
                        }
                    </li>
                }
            }
        </ul>
    </nav>
</div>

