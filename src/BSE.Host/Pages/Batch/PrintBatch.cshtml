@page
@model BSE.Host.Pages.Batch.PrintBatchModel
@{
    ViewData["Title"] = "Print batch";
    var batchYearError   = Model.ModelState[nameof(Model.BatchYear)]?.Errors.FirstOrDefault()?.ErrorMessage;
    var batchNumberError = Model.ModelState[nameof(Model.BatchNumber)]?.Errors.FirstOrDefault()?.ErrorMessage;
    var batchCombinedError = batchYearError ?? batchNumberError;
    var reportTypeError  = Model.ModelState[nameof(Model.ReportType)]?.Errors.FirstOrDefault()?.ErrorMessage;
    var generalError     = Model.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
    bool hasError = batchCombinedError is not null
                    || reportTypeError is not null || generalError is not null;
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Print batch</li>
    </ol>
</nav>

<h1 class="govuk-heading-l">Print batch</h1>

@if (hasError)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @if (batchCombinedError is not null) { <li><a href="#batch-year">@batchCombinedError</a></li> }
                    @if (reportTypeError is not null)  { <li><a href="#report-type">@reportTypeError</a></li> }
                    @if (generalError is not null)     { <li>@generalError</li> }
                </ul>
            </div>
        </div>
    </div>
}

<form method="post" asp-page-handler="Download" novalidate>
    <div class="bse-printbatch-panel govuk-form-group @((batchCombinedError is not null || reportTypeError is not null) ? "govuk-form-group--error" : "")">
        @if (batchCombinedError is not null)
        {
            <p id="batch-year-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @batchCombinedError</p>
        }
        @if (reportTypeError is not null)
        {
            <p id="report-type-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @reportTypeError</p>
        }

        <div class="bse-printbatch-row">
            <label class="govuk-label bse-printbatch-label bse-printbatch-label--batch" for="batch-year">Enter Batch Number</label>
            <label class="govuk-visually-hidden" for="batch-year">Batch year</label>
            <input id="batch-year" name="BatchYear" type="text" inputmode="numeric" maxlength="4"
                   class="govuk-input bse-printbatch-year @(batchCombinedError is not null ? "govuk-input--error" : "")"
                   value="@Model.BatchYear" autocomplete="off" />

            <label class="govuk-visually-hidden" for="batch-number">Batch number</label>
            <input id="batch-number" name="BatchNumber" type="text" inputmode="numeric" maxlength="6"
                   class="govuk-input bse-printbatch-serial @(batchCombinedError is not null ? "govuk-input--error" : "")"
                   value="@Model.BatchNumber" autocomplete="off" />

            <label class="govuk-label bse-printbatch-label bse-printbatch-label--report" for="report-type">Report type:</label>
            <select id="report-type" name="ReportType"
                    class="govuk-select bse-printbatch-select @(reportTypeError is not null ? "govuk-select--error" : "")">
                <option value="">— select —</option>
                @foreach (var (value, label) in BSE.Host.Pages.Batch.PrintBatchModel.ReportTypes)
                {
                    <option value="@value" selected="@(Model.ReportType == value ? "selected" : null)">@label</option>
                }
            </select>
        </div>
    </div>

    <button type="submit" class="govuk-button" data-module="govuk-button">Download</button>
</form>

<style>
    .bse-printbatch-panel {
        border-top: 1px solid #b1b4b6;
        border-bottom: 1px solid #b1b4b6;
        padding: 14px 10px;
        margin-bottom: 14px;
    }

    .bse-printbatch-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .bse-printbatch-label {
        margin-bottom: 0;
    }

    .bse-printbatch-label--batch {
        min-width: 215px;
    }

    .bse-printbatch-label--report {
        min-width: 110px;
    }

    .bse-printbatch-year {
        box-sizing: border-box;
        width: 62px;
        min-width: 62px;
        max-width: 62px;
        flex: 0 0 62px;
    }

    .bse-printbatch-serial {
        box-sizing: border-box;
        width: 72px;
        min-width: 72px;
        max-width: 72px;
        flex: 0 0 72px;
    }

    .bse-printbatch-select {
        width: 250px;
    }
</style>
