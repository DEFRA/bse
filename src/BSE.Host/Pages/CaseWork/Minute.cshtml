@page "{rbse}/{type}"
@model MinuteModel
@{
    ViewData["Title"] = $"Casework Minute Confirmation — {Model.MinuteTypeLabel}";
}

<div>
    <h1 class="govuk-heading-l">Casework minute confirmation</h1>

    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/CaseWork/Menu" asp-route-rbse="@Model.Rbse">Case work</a></li>
            <li class="govuk-breadcrumbs__list-item" aria-current="page">Minute confirmation</li>
        </ol>
    </nav>

    @if (Model.Details is null)
    {
        <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                <span class="govuk-warning-text__assistive">Warning</span>
                No details found for @Model.Rbse / @Model.Type.
            </strong>
        </div>
    }
    else
    {
        <dl class="govuk-summary-list govuk-summary-list--no-border">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">RBSE</dt>
                <dd class="govuk-summary-list__value">@BseFormat.FormatRbse(Model.Details.Rbse)</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Minute</dt>
                <dd class="govuk-summary-list__value">@Model.MinuteTypeLabel</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Date</dt>
                <dd class="govuk-summary-list__value">@(Model.MinuteDate?.ToString("dd/MM/yyyy") ?? "-")</dd>
            </div>
        </dl>
        @* move this block outside the `else` that depends on Model.Details *@
        @if (Model.ShowOutstandingForms)
        {
            <div class="govuk-form-group @(ViewData.ModelState.ContainsKey("OutstandingForms") ? "govuk-form-group--error" : "")">
                <fieldset class="govuk-fieldset">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">Outstanding forms</legend>
                    @if (ViewData.ModelState.ContainsKey("OutstandingForms"))
                    {
                        <p class="govuk-error-message">
                            <span class="govuk-visually-hidden">Error:</span>
                            @ViewData.ModelState["OutstandingForms"]?.Errors.FirstOrDefault()?.ErrorMessage
                        </p>
                    }
                    <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                        <!-- existing 6 checkboxes unchanged -->
                    </div>
                </fieldset>
            </div>
        }
        <form method="post" novalidate>
            <input type="hidden" asp-for="Rbse" />
            <input type="hidden" asp-for="Type" />

            @if (Model.ShowOutstandingForms)
            {
                <div class="govuk-form-group @(ViewData.ModelState.ContainsKey("OutstandingForms") ? "govuk-form-group--error" : "")">
                    <fieldset class="govuk-fieldset">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">Outstanding forms</legend>

                        @if (ViewData.ModelState.ContainsKey("OutstandingForms"))
                        {
                            <p class="govuk-error-message">
                                <span class="govuk-visually-hidden">Error:</span>
                                @ViewData.ModelState["OutstandingForms"]?.Errors.FirstOrDefault()?.ErrorMessage
                            </p>
                        }

                        <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" asp-for="OutstandingHomebred" />
                                <label class="govuk-label govuk-checkboxes__label" asp-for="OutstandingHomebred">Homebred</label>
                            </div>
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" asp-for="OutstandingBreeder" />
                                <label class="govuk-label govuk-checkboxes__label" asp-for="OutstandingBreeder">Breeder</label>
                            </div>
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" asp-for="OutstandingPurchaser" />
                                <label class="govuk-label govuk-checkboxes__label" asp-for="OutstandingPurchaser">Purchaser</label>
                            </div>
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" asp-for="OutstandingVendor" />
                                <label class="govuk-label govuk-checkboxes__label" asp-for="OutstandingVendor">Vendor</label>
                            </div>
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" asp-for="OutstandingSummarySheet" />
                                <label class="govuk-label govuk-checkboxes__label" asp-for="OutstandingSummarySheet">Summary sheet</label>
                            </div>
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" asp-for="OutstandingAllPaperwork" />
                                <label class="govuk-label govuk-checkboxes__label" asp-for="OutstandingAllPaperwork">All paperwork</label>
                            </div>
                        </div>
                    </fieldset>
                </div>
            }

            <div class="govuk-button-group govuk-!-margin-top-6">
                <button type="submit" asp-page-handler="Download" class="govuk-button govuk-button--secondary" data-module="govuk-button">
                    Download
                </button>

                <button type="submit" asp-page-handler="PrintMemo" class="govuk-button govuk-button--secondary" data-module="govuk-button">
                    Print memo
                </button>

                <a asp-page="/CaseWork/Entry"
                   asp-route-rbse="@Model.Rbse"
                   class="govuk-button govuk-button--secondary"
                   role="button"
                   draggable="false">
                    Casework Entry
                </a>

                <a asp-page="/Home"
                   class="govuk-button govuk-button--secondary"
                   role="button"
                   draggable="false">
                    Home
                </a>
            </div>
        </form>
    }
</div>

@if (Model.TriggerPrint)
{
    <script>
        window.addEventListener('load', function() {
            window.print();
        });
    </script>
}