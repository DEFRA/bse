@page "{rbse}/{type}"
@model BSE.Host.Pages.CaseWork.MinuteDocumentModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Minute document</title>
    <style>
            body {
                font-size: medium;
                font-family: Arial, Helvetica, sans-serif;
            }

            h1 {
                font-size: medium;
                font-weight: bold;
            }

            li {
                margin: 1em 10% 1em 0;
            }

            table.ScheduleTable {
                font-size: medium;
                width: 100%;
                border: 2px black solid;
                border-collapse: collapse;
            }

            tr.ScheduleTableHeader {
                font-weight: bold;
            }

            td.ScheduleTableCell {
                border: 1px black solid;
            }

            table.HeaderLayout {
                font-size: medium;
                width: 100%;
                border-collapse: collapse;
            }

            td.HeaderLeft {
                width: 50%;
                vertical-align: top;
                text-align: left;
            }

            td.HeaderRight {
                width: 50%;
                vertical-align: top;
                text-align: right;
            }

            table.InformationTable {
                font-size: medium;
                width: 100%;
                border: 2px black solid;
                border-collapse: collapse;
            }

            tr.InformationTableHeader {
                font-weight: bold;
                vertical-align: top;
            }

            td.InformationTableCell {
                border: 1px black solid;
                text-align: left;
                vertical-align: top;
            }

            td.InformationTableLeft {
                width: 30%;
                border: 1px black solid;
                text-align: left;
                vertical-align: top;
            }

            td.InformationTableRight {
                width: 70%;
                border: 1px black solid;
                text-align: center;
                vertical-align: top;
            }

            hr {
                border: 1px black solid;
                height: 1px;
            }

            #textAddress {
                margin-left: 46px;
            }
    </style>
</head>
<body>
    @switch (Model.MinuteType)
    {
        case "ActiveMemo":
            <partial name="_MinuteDocActiveMemo" model="Model" />
            break;
        case "AMFS":
            <partial name="_MinuteDocActiveMemoFs" model="Model" />
            break;
        case "AnnexA":
            <partial name="_MinuteDocAnnexA" model="Model" />
            break;
        case "AnnexB":
            <partial name="_MinuteDocAnnexB" model="Model" />
            break;
        case "AnnexC":
            <partial name="_MinuteDocAnnexC" model="Model" />
            break;
        case "AnnexD":
            <partial name="_MinuteDocAnnexD" model="Model" />
            break;
    }

    @if (Model.IsPrintMode)
    {
        <script>
                if (window.print) window.print();
        </script>
    }
</body>
</html>