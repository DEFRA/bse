@page "{rbse}"
@model CaseWorkEntryModel
@{
    ViewData["Title"] = "Casework Entry";
}

<div>
    <h1 class="govuk-heading-l bse-wide-page">Casework Entry — @BseFormat.FormatRbse(Model.Rbse)</h1>
    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/CaseWork/Menu">Case work</a></li>
            <li class="govuk-breadcrumbs__list-item" aria-current="page">Entry</li>
        </ol>
    </nav>

    @if (Model.Entry is null)
    {
        <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                <span class="govuk-warning-text__assistive">Warning</span>
                No case work entry found for @BseFormat.FormatRbse(Model.Rbse).
            </strong>
        </div>
    }
    else
    {
        <form method="post" novalidate id="casework-entry-form">
            <input type="hidden" asp-for="Rbse" />
            <input type="hidden" asp-for="ClosedOnLoad" />

            @{
                string? Err(string key) =>
                    ViewData.ModelState.TryGetValue(key, out var state) && state.Errors.Count > 0
                        ? state.Errors[0].ErrorMessage
                        : null;
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="govuk-error-summary" data-module="govuk-error-summary">
                    <div role="alert">
                        <h2 class="govuk-error-summary__title">There is a problem</h2>
                        <div class="govuk-error-summary__body">
                            <ul class="govuk-list govuk-error-summary__list">
                                @foreach (var entry in ViewData.ModelState.Where(m => m.Value?.Errors.Count > 0))
                                {
                                    <li><a href="#@entry.Key">@entry.Value!.Errors[0].ErrorMessage</a></li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }

            <div class="govuk-button-group bse-casework-entry-buttons">
                <button type="submit" asp-page-handler="Save" class="govuk-button" data-module="govuk-button">Save</button>
                <button type="submit" asp-page-handler="Cancel" class="govuk-button govuk-button--secondary" data-module="govuk-button" formnovalidate>Cancel</button>
            </div>

            <div class="govuk-grid-row bse-casework-entry-row">
                <div class="govuk-grid-column-one-third bse-casework-entry-left">
                    <dl class="govuk-summary-list govuk-summary-list--no-border bse-casework-entry-group">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Status</dt>
                            <dd class="govuk-summary-list__value">@(Model.ClosedOnLoad ? "Closed" : "Open")</dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">RBSE</dt>
                            <dd class="govuk-summary-list__value">
                                <a asp-page="/Case/DefraEdit" asp-route-rbse="@Model.Rbse" class="govuk-link">@BseFormat.FormatRbse(Model.Entry.Rbse)</a>
                            </dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">RBSE Date</dt>
                            <dd class="govuk-summary-list__value">@(Model.Entry.RbseDate?.ToString("dd/MM/yyyy"))</dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Form A Date</dt>
                            <dd class="govuk-summary-list__value">@(Model.Entry.FormADate?.ToString("dd/MM/yyyy"))</dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Form B Date</dt>
                            <dd class="govuk-summary-list__value">@(Model.Entry.FormBDate?.ToString("dd/MM/yyyy"))</dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Slaughter Date</dt>
                            <dd class="govuk-summary-list__value">@(Model.Entry.SlaughterDate?.ToString("dd/MM/yyyy"))</dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Fate</dt>
                            <dd class="govuk-summary-list__value">@Model.FateDescription</dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Origin</dt>
                            <dd class="govuk-summary-list__value">@Model.OriginDescription</dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Survey</dt>
                            <dd class="govuk-summary-list__value">@Model.SurveyDescription</dd>
                        </div>
                    </dl>

                    <div class="bse-casework-entry-edit-block bse-casework-entry-group">
                        <div class="govuk-form-group @(Err("Barcode") is not null ? "govuk-form-group--error" : "")">
                            <label class="govuk-label" for="Barcode">Barcode</label>
                            @if (Err("Barcode") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("Barcode")</p> }
                            <input id="Barcode" asp-for="Barcode" maxlength="20" class="govuk-input" />
                        </div>
                        <div class="govuk-form-group @(Err("AhfReference") is not null ? "govuk-form-group--error" : "")">
                            <label class="govuk-label" for="AhfReference">AHF Reference</label>
                            @if (Err("AhfReference") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("AhfReference")</p> }
                            <input id="AhfReference" asp-for="AhfReference" maxlength="40" class="govuk-input" />
                        </div>
                    </div>

                    <div class="bse-casework-entry-edit-block bse-casework-entry-group">
                        <div class="govuk-form-group @(Err("RegionalLab") is not null ? "govuk-form-group--error" : "")">
                            <label class="govuk-label" for="RegionalLab">Regional Lab</label>
                            @if (Err("RegionalLab") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("RegionalLab")</p> }
                            <select id="RegionalLab" asp-for="RegionalLab" asp-items="Model.RegionalLabOptions" class="govuk-select">
                                <option value=""></option>
                            </select>
                        </div>
                        <div class="govuk-form-group @(Err("ReceivedByRegionalLabDate") is not null ? "govuk-form-group--error" : "")">
                            <label class="govuk-label" for="ReceivedByRegionalLabDate">Regional Lab Received</label>
                            @if (Err("ReceivedByRegionalLabDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("ReceivedByRegionalLabDate")</p> }
                            <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                                <input id="ReceivedByRegionalLabDate" name="ReceivedByRegionalLabDate" type="text" class="govuk-input moj-js-datepicker-input" autocomplete="off" value="@(Model.ReceivedByRegionalLabDate?.ToString("dd/MM/yyyy") ?? "")" />
                            </div>
                        </div>
                        <div class="govuk-form-group @(Err("InitialReceivedDate") is not null ? "govuk-form-group--error" : "")">
                            <label class="govuk-label" for="InitialReceivedDate">Initial Received</label>
                            @if (Err("InitialReceivedDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("InitialReceivedDate")</p> }
                            <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                                <input id="InitialReceivedDate" name="InitialReceivedDate" type="text" class="govuk-input moj-js-datepicker-input" autocomplete="off" value="@(Model.InitialReceivedDate?.ToString("dd/MM/yyyy") ?? "")" />
                            </div>
                        </div>
                        <div class="govuk-form-group @(Err("FinalReceivedDate") is not null ? "govuk-form-group--error" : "")">
                            <label class="govuk-label" for="FinalReceivedDate">Final Received</label>
                            @if (Err("FinalReceivedDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("FinalReceivedDate")</p> }
                            <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                                <input id="FinalReceivedDate" name="FinalReceivedDate" type="text" class="govuk-input moj-js-datepicker-input" autocomplete="off" value="@(Model.FinalReceivedDate?.ToString("dd/MM/yyyy") ?? "")" />
                            </div>
                        </div>
                    </div>

                    <dl class="govuk-summary-list govuk-summary-list--no-border bse-casework-entry-group">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Final Result</dt>
                            <dd class="govuk-summary-list__value">@Model.FinalResultDescription</dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Final Result Date</dt>
                            <dd class="govuk-summary-list__value">@(Model.Entry.FinalResultDate?.ToString("dd/MM/yyyy"))</dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">DBSE</dt>
                            <dd class="govuk-summary-list__value">@Model.Entry.Dbse</dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Alternate Diagnosis</dt>
                            <dd class="govuk-summary-list__value">@Model.Entry.AlternateDiagnosis</dd>
                        </div>
                    </dl>

                    <div class="bse-casework-entry-edit-block bse-casework-entry-group bse-casework-entry-group--attached">
                        <div class="govuk-form-group @(Err("FinalSentDate") is not null ? "govuk-form-group--error" : "")">
                            <label class="govuk-label" for="FinalSentDate">Final Sent Date</label>
                            @if (Err("FinalSentDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("FinalSentDate")</p> }
                            <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                                <input id="FinalSentDate" name="FinalSentDate" type="text" class="govuk-input moj-js-datepicker-input" autocomplete="off" value="@(Model.FinalSentDate?.ToString("dd/MM/yyyy") ?? "")" />
                            </div>
                        </div>
                    </div>

                    <dl class="govuk-summary-list govuk-summary-list--no-border bse-casework-entry-group">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Birth Date</dt>
                            <dd class="govuk-summary-list__value">@(Model.Entry.BirthDate?.ToString("dd/MM/yyyy"))</dd>
                        </div>
                    </dl>

                </div>

                <div class="govuk-grid-column-two-thirds bse-casework-entry-main">
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-two-thirds bse-casework-entry-middle">
                            <h2 class="govuk-heading-m">Paperwork Received</h2>

                            <div class="govuk-form-group @(Err("PurchaserBse1ReceivedDate") is not null ? "govuk-form-group--error" : "")">
                                <label class="govuk-label" for="PurchaserBse1ReceivedDate">Purchaser BSE1</label>
                                @if (Err("PurchaserBse1ReceivedDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("PurchaserBse1ReceivedDate")</p> }
                                <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                                    <input id="PurchaserBse1ReceivedDate" name="PurchaserBse1ReceivedDate" type="text" class="govuk-input moj-js-datepicker-input" autocomplete="off" value="@(Model.PurchaserBse1ReceivedDate?.ToString("dd/MM/yyyy") ?? "")" />
                                </div>
                            </div>
                            <div class="govuk-form-group @(Err("BreederBse1ReceivedDate") is not null ? "govuk-form-group--error" : "")">
                                <label class="govuk-label" for="BreederBse1ReceivedDate">Breeder BSE1</label>
                                @if (Err("BreederBse1ReceivedDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("BreederBse1ReceivedDate")</p> }
                                <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                                    <input id="BreederBse1ReceivedDate" name="BreederBse1ReceivedDate" type="text" class="govuk-input moj-js-datepicker-input" autocomplete="off" value="@(Model.BreederBse1ReceivedDate?.ToString("dd/MM/yyyy") ?? "")" />
                                </div>
                            </div>
                            <div class="govuk-form-group @(Err("Vendor1Bse1ReceivedDate") is not null ? "govuk-form-group--error" : "")">
                                <label class="govuk-label" for="Vendor1Bse1ReceivedDate">Vendor BSE1</label>
                                @if (Err("Vendor1Bse1ReceivedDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("Vendor1Bse1ReceivedDate")</p> }
                                <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                                    <input id="Vendor1Bse1ReceivedDate" name="Vendor1Bse1ReceivedDate" type="text" class="govuk-input moj-js-datepicker-input" autocomplete="off" value="@(Model.Vendor1Bse1ReceivedDate?.ToString("dd/MM/yyyy") ?? "")" />
                                </div>
                            </div>
                            <div class="govuk-form-group @(Err("HomebredBse1ReceivedDate") is not null ? "govuk-form-group--error" : "")">
                                <label class="govuk-label" for="HomebredBse1ReceivedDate">Homebred BSE1</label>
                                @if (Err("HomebredBse1ReceivedDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("HomebredBse1ReceivedDate")</p> }
                                <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                                    <input id="HomebredBse1ReceivedDate" name="HomebredBse1ReceivedDate" type="text" class="govuk-input moj-js-datepicker-input" autocomplete="off" value="@(Model.HomebredBse1ReceivedDate?.ToString("dd/MM/yyyy") ?? "")" />
                                </div>
                            </div>
                            <div class="govuk-form-group @(Err("SummarySheetReceivedDate") is not null ? "govuk-form-group--error" : "")">
                                <label class="govuk-label" for="SummarySheetReceivedDate">Summary Sheet</label>
                                @if (Err("SummarySheetReceivedDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("SummarySheetReceivedDate")</p> }
                                <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                                    <input id="SummarySheetReceivedDate" name="SummarySheetReceivedDate" type="text" class="govuk-input moj-js-datepicker-input" autocomplete="off" value="@(Model.SummarySheetReceivedDate?.ToString("dd/MM/yyyy") ?? "")" />
                                </div>
                            </div>
                            <div class="govuk-form-group @(Err("PaperworkCompleteDate") is not null ? "govuk-form-group--error" : "")">
                                <label class="govuk-label" for="PaperworkCompleteDate">Paperwork Complete</label>
                                @if (Err("PaperworkCompleteDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("PaperworkCompleteDate")</p> }
                                <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                                    <input id="PaperworkCompleteDate" name="PaperworkCompleteDate" type="text" class="govuk-input moj-js-datepicker-input" autocomplete="off" value="@(Model.PaperworkCompleteDate?.ToString("dd/MM/yyyy") ?? "")" />
                                </div>
                            </div>
                            <div class="govuk-form-group @(Err("DataCompleteDate") is not null ? "govuk-form-group--error" : "")">
                                <label class="govuk-label" for="DataCompleteDate">Data Complete</label>
                                @if (Err("DataCompleteDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("DataCompleteDate")</p> }
                                <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                                    <input id="DataCompleteDate" name="DataCompleteDate" type="text" class="govuk-input moj-js-datepicker-input" autocomplete="off" value="@(Model.DataCompleteDate?.ToString("dd/MM/yyyy") ?? "")" />
                                </div>
                            </div>

                            @if (Model.ShowTseFields)
                            {
                                <div class="govuk-form-group @(Err("TseTestingSite") is not null ? "govuk-form-group--error" : "")">
                                    <label class="govuk-label" for="TseTestingSite">TSE Testing Site</label>
                                    @if (Err("TseTestingSite") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("TseTestingSite")</p> }
                                    <select id="TseTestingSite" asp-for="TseTestingSite" asp-items="Model.TseTestingSiteOptions" class="govuk-select">
                                        <option value=""></option>
                                    </select>
                                </div>
                                <div class="govuk-form-group @(Err("SamplingDate") is not null ? "govuk-form-group--error" : "")">
                                    <label class="govuk-label" for="SamplingDate">Sampling Date</label>
                                    @if (Err("SamplingDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("SamplingDate")</p> }
                                    <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                                        <input id="SamplingDate" name="SamplingDate" type="text" class="govuk-input moj-js-datepicker-input" autocomplete="off"
                                               value="@(Model.SamplingDate?.Date == DateTime.MaxValue.Date ? "unknown" : Model.SamplingDate?.ToString("dd/MM/yyyy") ?? "")" />
                                    </div>
                                </div>
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="AhroId">AHRO</label>
                                    <select id="AhroId" asp-for="AhroId" asp-items="Model.AhroOptions" class="govuk-select">
                                        <option value=""></option>
                                    </select>
                                </div>
                            }

                            <table class="govuk-table govuk-table--small-text-until-tablet bse-casework-entry-minutes-table">
                                <caption class="govuk-visually-hidden">Minutes due and sent</caption>
                                <thead class="govuk-table__head">
                                    <tr class="govuk-table__row">
                                        <th scope="col" colspan="2" class="govuk-table__header">Minutes Due</th>
                                        <th scope="col" class="govuk-table__header"></th>
                                        <th scope="col" class="govuk-table__header">Minute Sent On</th>
                                    </tr>
                                </thead>
                                <tbody class="govuk-table__body">
                                    @{
                                        // Legacy hides the due date once the minute has been sent, and reddens it when overdue.
                                        var minutes = new (string Label, string Type, DateTime? Due, DateTime? Sent, string? Disabled)[]
                                        {
                                            ("Active Memo", "ActiveMemo", Model.Entry.ActiveMemoDueDate, Model.Entry.ActiveMemoDate, null),
                                            ("Annex A",     "AnnexA",     Model.Entry.AnnexADueDate,     Model.Entry.AnnexADate,     Model.AnnexADisabledReason),
                                            ("Annex B",     "AnnexB",     Model.Entry.AnnexBDueDate,     Model.Entry.AnnexBDate,     Model.AnnexBDisabledReason),
                                            ("Annex C",     "AnnexC",     Model.Entry.AnnexCDueDate,     Model.Entry.AnnexCDate,     Model.AnnexCDisabledReason),
                                            ("Annex D",     "AnnexD",     Model.Entry.AnnexDDueDate,     Model.Entry.AnnexDDate,     Model.AnnexDDisabledReason),
                                        };
                                    }
                                    @foreach (var m in minutes)
                                    {
                                        var overdue = m.Sent is null && m.Due is not null && m.Due <= DateTime.Today;
                                        <tr class="govuk-table__row">
                                            <th scope="row" class="govuk-table__header">@m.Label</th>
                                            <td class="govuk-table__cell">
                                                @if (m.Sent is null && m.Due is not null)
                                                {
                                                    @if (overdue)
                                                    {
                                                        <strong class="govuk-tag govuk-tag--red">@m.Due?.ToString("dd/MM/yyyy")</strong>
                                                    }
                                                    else
                                                    {
                                                        @m.Due?.ToString("dd/MM/yyyy")
                                                    }
                                                }
                                            </td>
                                            <td class="govuk-table__cell">@(m.Sent?.ToString("dd/MM/yyyy"))</td>
                                            <td class="govuk-table__cell">
                                                <button type="submit" asp-page-handler="SendMinute" name="minuteType" value="@m.Type"
                                                        class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0"
                                                        data-module="govuk-button"
                                                        title="@m.Disabled"
                                                        disabled="@(m.Disabled is not null)">
                                                    Send
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <div class="govuk-form-group bse-casework-entry-minute-sent-row @(Err("LabChasedDate") is not null ? "govuk-form-group--error" : "")">
                                <span class="govuk-body bse-minute-name">Chase lab results</span>
                                <span class="bse-minute-status">
                                    @if (Model.Entry.LabChaseDueDate is not null)
                                    {
                                        <strong class="govuk-tag govuk-tag--red">@Model.Entry.LabChaseDueDate?.ToString("dd/MM/yyyy")</strong>
                                    }
                                </span>
                                <label class="govuk-label bse-minute-sent-on-label" for="LabChasedDate">Chased on</label>
                                @if (Err("LabChasedDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("LabChasedDate")</p> }
                                <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                                    <input id="LabChasedDate" name="LabChasedDate" type="text" class="govuk-input moj-js-datepicker-input" autocomplete="off" value="@(Model.LabChasedDate?.ToString("dd/MM/yyyy") ?? "")" />
                                </div>
                            </div>

                            <div class="govuk-form-group bse-casework-entry-minute-sent-row @(Err("BarbMinuteSentDate") is not null ? "govuk-form-group--error" : "")">
                                <span class="govuk-body bse-minute-name">BARB Minute</span>
                                <span class="bse-minute-status">
                                    @if (string.Equals(Model.Entry.BarbMemoDue, "Yes", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <strong class="govuk-tag govuk-tag--red">Yes</strong>
                                    }
                                </span>
                                <label class="govuk-label bse-minute-sent-on-label" for="BarbMinuteSentDate">Sent on</label>
                                @if (Err("BarbMinuteSentDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("BarbMinuteSentDate")</p> }
                                <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                                    <input id="BarbMinuteSentDate" name="BarbMinuteSentDate" type="text" class="govuk-input moj-js-datepicker-input" autocomplete="off" value="@(Model.BarbMinuteSentDate?.ToString("dd/MM/yyyy") ?? "")" />
                                </div>
                            </div>

                        </div>

                        <div class="govuk-grid-column-one-third bse-casework-entry-right">
                            <div class="govuk-form-group bse-casework-entry-comments">
                                <div class="govuk-form-group bse-casework-entry-close-case">
                                    <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                                        <div class="govuk-checkboxes__item">
                                            <input class="govuk-checkboxes__input" id="ToggleCaseStatus" asp-for="ToggleCaseStatus" type="checkbox" />
                                            <label class="govuk-label govuk-checkboxes__label" for="ToggleCaseStatus">
                                                @(Model.ClosedOnLoad ? "Open Case" : "Close Case")
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <label class="govuk-label govuk-label--m bse-casework-entry-comments-label" for="CaseWorkNotes">Casework Comments</label>
                                <textarea id="CaseWorkNotes" asp-for="CaseWorkNotes" maxlength="500" class="govuk-textarea" rows="5"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.ShowPost2000Warning)
            {
                <div class="govuk-form-group bse-casework-entry-post2000-row @(Err("Post2000SentDate") is not null ? "govuk-form-group--error" : "")">
                    <span class="govuk-body bse-casework-entry-post2000-warning-inline">Born after December 2000 - Inform Defra if positive</span>
                    <label class="govuk-label bse-casework-entry-post2000-label" for="Post2000SentDate">DEFRA informed on</label>
                    @if (Err("Post2000SentDate") is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Err("Post2000SentDate")</p> }
                    <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                        <input id="Post2000SentDate" name="Post2000SentDate" type="text" class="govuk-input moj-js-datepicker-input" autocomplete="off" value="@(Model.Post2000SentDate?.ToString("dd/MM/yyyy") ?? "")" />
                    </div>
                </div>
            }

            <div class="govuk-button-group govuk-!-margin-top-4 bse-casework-entry-buttons">
                <button type="submit" asp-page-handler="Save" class="govuk-button" data-module="govuk-button">Save</button>
                <button type="submit" asp-page-handler="Cancel" class="govuk-button govuk-button--secondary" data-module="govuk-button" formnovalidate>Cancel</button>
            </div>
        </form>
    }
</div>

<script>
(function () {
    var form = document.getElementById('casework-entry-form');
    if (!form) return;

    var dirty = false;
    var submitting = false;
    var cancelButtons = form.querySelectorAll('button[formnovalidate][type="submit"]');

    function markDirty() { dirty = true; }

    form.addEventListener('change', markDirty);
    form.addEventListener('input', markDirty);
    form.addEventListener('submit', function () { submitting = true; });

    cancelButtons.forEach(function (button) {
        button.addEventListener('click', function (e) {
            if (dirty) {
                e.preventDefault();
                if (window.confirm('You have unsaved changes. Click OK to discard them and leave, or Cancel to go back and save.')) {
                    submitting = true;
                    button.form.submit();
                }
            }
        });
    });

    window.addEventListener('beforeunload', function (e) {
        if (dirty && !submitting) {
            e.preventDefault();
            e.returnValue = '';
        }
    });
}());
</script>

