@page
@model BSE.Host.Pages.CaseWork.OpenCasesModel
@{
    ViewData["Title"] = "View all open cases";

    var sortBaseParams = ViewContext.HttpContext.Request.Query
        .Where(k => !string.Equals(k.Key, "SortColumn", StringComparison.OrdinalIgnoreCase)
                 && !string.Equals(k.Key, "SortDesc", StringComparison.OrdinalIgnoreCase)
                 && !string.Equals(k.Key, "PageNumber", StringComparison.OrdinalIgnoreCase))
        .SelectMany(k => k.Value, (k, v) => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}")
        .ToList();

    var sortBaseUrl = "?" + string.Join("&", sortBaseParams);
}

<h1 class="govuk-heading-l bse-wide-page">View all open cases</h1>

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/CaseWork/Menu">Casework menu</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">View all open cases</li>
    </ol>
</nav>

<p class="govuk-body">
    <a asp-page="/CaseWork/ClosedCases" class="govuk-link">See closed cases</a>
</p>

@if (Model.Cases.Any())
{
    <p class="govuk-body">Total open cases: <strong>@Model.TotalCount</strong></p>

    <div id="open-cases-results" class="bse-open-cases-table-wrap">
        <table class="govuk-table bse-open-cases-table govuk-table--small-text-until-tablet">
            <caption class="govuk-visually-hidden">Open cases</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "RBSE", ["Column"] = "Rbse", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Survey", ["Column"] = "Survey", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Barcode", ["Column"] = "Barcode", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "AHF Reference", ["Column"] = "AhfReference", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Form A Date", ["Column"] = "FormADate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "RBSE Date", ["Column"] = "RbseDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Slaughter Date", ["Column"] = "SlaughterDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Fate", ["Column"] = "Fate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Active Memo Due", ["Column"] = "ActiveMemoDueDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Active Memo Date", ["Column"] = "ActiveMemoDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Annex A Due", ["Column"] = "AnnexADueDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Annex A Date", ["Column"] = "AnnexADate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Annex B Due", ["Column"] = "AnnexBDueDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Annex B Date", ["Column"] = "AnnexBDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Paperwork Complete Date", ["Column"] = "PaperworkCompleteDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Annex C Due", ["Column"] = "AnnexCDueDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Annex C Date", ["Column"] = "AnnexCDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Annex D Due", ["Column"] = "AnnexDDueDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Annex D Date", ["Column"] = "AnnexDDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Regional Lab", ["Column"] = "RegionalLab", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results", ["WrapWords"] = true })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Regional Lab Received Date", ["Column"] = "ReceivedByRegionalLabDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Initial Received Date", ["Column"] = "InitialReceivedDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Final Received Date", ["Column"] = "FinalReceivedDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Final Sent Date", ["Column"] = "FinalSentDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Lab Chase Due Date", ["Column"] = "LabChaseDueDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Lab Chased Date", ["Column"] = "LabChasedDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Final Result", ["Column"] = "FinalResult", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results", ["WrapWords"] = true })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Final Result Date", ["Column"] = "FinalResultDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Birth Date", ["Column"] = "BirthDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Post 2000 Sent Date", ["Column"] = "Post2000SentDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results", ["WrapWords"] = true })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Barb Memo Due", ["Column"] = "BarbMemoDue", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results", ["WrapWords"] = true })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Barb Minute Sent Date", ["Column"] = "BarbMinuteSentDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "Data Complete Date", ["Column"] = "DataCompleteDate", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                    @await Html.PartialAsync("_SortableHeader", null, new ViewDataDictionary(ViewData) { ["Label"] = "CaseWorkNotes", ["Column"] = "CaseWorkNotes", ["SortColumn"] = Model.SortColumn, ["SortDesc"] = Model.SortDesc, ["BaseUrl"] = sortBaseUrl, ["Fragment"] = "open-cases-results" })
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var caseRecord in Model.PagedCases)
                {
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">
                            <a asp-page="/CaseWork/Entry" asp-route-rbse="@caseRecord.Rbse" class="govuk-link">@BseFormat.FormatRbse(caseRecord.Rbse)</a>
                        </th>
                        <td class="govuk-table__cell">@(caseRecord.Survey ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.Barcode ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.AhfReference ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.FormADate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.RbseDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.SlaughterDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.Fate ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.ActiveMemoDueDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.ActiveMemoDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.AnnexADueDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.AnnexADate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.AnnexBDueDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.AnnexBDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.PaperworkCompleteDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.AnnexCDueDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.AnnexCDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.AnnexDDueDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.AnnexDDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.RegionalLab ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.ReceivedByRegionalLabDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.InitialReceivedDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.FinalReceivedDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.FinalSentDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.LabChaseDueDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.LabChasedDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.FinalResult ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.FinalResultDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.BirthDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.Post2000SentDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.BarbMemoDue ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.BarbMinuteSentDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.DataCompleteDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="govuk-table__cell">@(caseRecord.CaseWorkNotes ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination", null, new ViewDataDictionary(ViewData)
    {
        ["CurrentPage"] = Model.PageNumber,
        ["TotalPages"] = Model.TotalPages,
        ["Fragment"] = "open-cases-results"
    })
}
else
{
    <div class="govuk-inset-text">
        <p class="govuk-body">No open cases found.</p>
    </div>
}

<p class="govuk-body govuk-!-margin-top-6">
    <a asp-page="/CaseWork/Menu" class="govuk-link">Back to casework menu</a>
</p>
