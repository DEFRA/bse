@page
@model BSE.Host.Pages.CaseWork.PrintBatchModel
@{
    ViewData["Title"] = "Print batch";
}

<h1 class="govuk-heading-l">Print batch</h1>

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Print batch</li>
    </ol>
</nav>

@if (!ViewContext.ModelState.IsValid)
{
    <div class="govuk-error-summary" id="print-batch-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var e in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@e.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

<form method="post" asp-page-handler="Download" novalidate>
    <div class="bse-printbatch-panel govuk-form-group">
        <div class="bse-printbatch-row">
            <span class="govuk-label bse-printbatch-label bse-printbatch-label--batch">Enter Batch Number</span>

            <span class="bse-printbatch-item">
                <label class="govuk-label bse-printbatch-sublabel" for="batch-year">Year</label>
                <input id="batch-year" asp-for="BatchYear" type="text" inputmode="numeric" maxlength="4"
                       class="govuk-input bse-printbatch-year" autocomplete="off" />
            </span>

            <span class="bse-printbatch-item">
                <label class="govuk-label bse-printbatch-sublabel" for="batch-number">Number</label>
                <input id="batch-number" asp-for="BatchNumber" type="text" inputmode="numeric" maxlength="6"
                       class="govuk-input bse-printbatch-serial" autocomplete="off" />
            </span>

            <label asp-for="SelectedReportType" class="govuk-label bse-printbatch-label bse-printbatch-label--report">Report type:</label>
            <select asp-for="SelectedReportType" class="govuk-select bse-printbatch-select">
                <option value="0"></option>
                <option value="1">Clinical</option>
                <option value="2">Farm and Case</option>
                <option value="3">Feeds</option>
                <option value="4">Offspring</option>
                <option value="5">Pedigree</option>
            </select>
        </div>
    </div>

    <button type="submit" class="govuk-button" data-module="govuk-button">Download</button>
</form>

<style>
    .bse-printbatch-panel {
        border-top: 1px solid #b1b4b6;
        border-bottom: 1px solid #b1b4b6;
        padding: 14px 10px;
        margin-bottom: 14px;
    }

    .bse-printbatch-row {
        display: flex;
        align-items: flex-end;
        gap: 10px;
        flex-wrap: wrap;
    }

    .bse-printbatch-label {
        margin-bottom: 0;
    }

    .bse-printbatch-label--batch {
        min-width: 215px;
    }

    .bse-printbatch-label--report {
        min-width: 110px;
    }

    .bse-printbatch-item {
        display: flex;
        flex-direction: column;
    }

    .bse-printbatch-sublabel {
        margin-bottom: 2px;
        font-size: 0.875rem;
    }

    .bse-printbatch-year {
        box-sizing: border-box;
        width: 62px;
        min-width: 62px;
        max-width: 62px;
    }

    .bse-printbatch-serial {
        box-sizing: border-box;
        width: 72px;
        min-width: 72px;
        max-width: 72px;
    }

    .bse-printbatch-select {
        width: 250px;
    }
</style>

<script>
    // A successful download response never navigates the browser away from this page
    // (Content-Disposition: attachment), so a stale error banner from an earlier failed
    // attempt would otherwise stay on screen. Intercept the submit to control both outcomes.
    document.querySelector('form[method="post"]')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        try {
            const response = await fetch(form.action || window.location.href, {
                method: 'POST',
                body: new FormData(form)
            });

            const disposition = response.headers.get('Content-Disposition');
            if (response.ok && disposition && disposition.includes('attachment')) {
                const blob = await response.blob();
                const match = /filename="?([^";]+)"?/.exec(disposition);
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = match ? match[1] : 'BatchReport.doc';
                document.body.appendChild(a);
                a.click();
                a.remove();
                URL.revokeObjectURL(url);
                document.getElementById('print-batch-error-summary')?.remove();
            }
            else {
                // Validation failed or the batch was not found — replace the page with the
                // freshly server-rendered error state.
                document.open();
                document.write(await response.text());
                document.close();
            }
        }
        catch {
            form.submit();
        }
    });
</script>
