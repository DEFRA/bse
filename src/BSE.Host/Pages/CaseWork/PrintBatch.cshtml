@page
@model BSE.Host.Pages.CaseWork.PrintBatchModel
@{
    ViewData["Title"] = "Print batch";
}

<h1 class="govuk-heading-l">Print batch</h1>

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Print batch</li>
    </ol>
</nav>

@if (!ViewContext.ModelState.IsValid)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var e in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@e.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

<form method="post" asp-page-handler="Download" novalidate>
    <div class="govuk-form-group">
        <fieldset class="govuk-fieldset">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Enter batch number</legend>
            <div class="govuk-hint">Year and number — for example, 2026 and 1.</div>
            <div class="govuk-!-display-flex govuk-!-gap-3 govuk-!-align-items-end">
                <div>
                    <label class="govuk-label govuk-!-font-weight-bold" for="batch-year">Year</label>
                    <input id="batch-year" asp-for="BatchYear" type="text" inputmode="numeric"
                           class="govuk-input govuk-input--width-4" autocomplete="off" />
                </div>
                <div>
                    <label class="govuk-label govuk-!-font-weight-bold" for="batch-number">Number</label>
                    <input id="batch-number" asp-for="BatchNumber" type="text" inputmode="numeric"
                           class="govuk-input govuk-input--width-5" autocomplete="off" />
                </div>
            </div>
        </fieldset>
    </div>

    <div class="govuk-form-group">
        <label asp-for="SelectedReportType" class="govuk-label">Report type</label>
        <select asp-for="SelectedReportType" class="govuk-select">
            <option value="0"></option>
            <option value="1">Clinical</option>
            <option value="2">Farm and Case</option>
            <option value="3">Feeds</option>
            <option value="4">Offspring</option>
            <option value="5">Pedigree</option>
        </select>
    </div>

    <button type="submit" class="govuk-button" data-module="govuk-button">Download</button>
</form>