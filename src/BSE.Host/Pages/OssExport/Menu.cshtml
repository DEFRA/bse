@page
@model OssExportMenuModel
@{
    ViewData["Title"] = "OSS export";
}

<div>
    <h1 class="govuk-heading-l">OSS export</h1>
    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
            <li class="govuk-breadcrumbs__list-item" aria-current="page">OSS export</li>
        </ol>
    </nav>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary"><div role="alert"><h2 class="govuk-error-summary__title">There is a problem</h2><div class="govuk-error-summary__body"><ul class="govuk-list govuk-error-summary__list"><li>@Model.ErrorMessage</li></ul></div></div></div>
    }

    <h2 class="govuk-heading-m">OSS export</h2>
    <p class="govuk-body">Populates OSS staging tables and allows cover-sheet generation per case.</p>
    <form method="post" asp-page-handler="Populate" novalidate>
        <button type="submit" class="govuk-button" data-module="govuk-button">Populate staging tables</button>
    </form>

    @if (Model.BatchResult is not null)
    {
        <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="oss-success-title" data-module="govuk-notification-banner">
            <div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title" id="oss-success-title">Success</h2></div>
            <div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">Batch number created: @Model.BatchResult.BatchYear/@Model.BatchResult.BatchNumber (ID: @Model.BatchResult.BatchId)</p></div>
        </div>
    }

    <h2 class="govuk-heading-m">Look up RBSE cover sheet</h2>
    <form method="get" novalidate>
        <div class="govuk-form-group">
            <label asp-for="Rbse" class="govuk-label">RBSE</label>
            <input asp-for="Rbse" class="govuk-input govuk-!-width-one-half" />
        </div>
        <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">Look up</button>
    </form>

    @if (Model.ExportRecord is not null)
    {
        <h2 class="govuk-heading-m">Cover sheet — @Model.ExportRecord.Rbse</h2>
        <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">RBSE</dt><dd class="govuk-summary-list__value">@Model.ExportRecord.Rbse</dd></div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">CPHH</dt><dd class="govuk-summary-list__value">@Model.ExportRecord.Cphh</dd></div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Owner</dt><dd class="govuk-summary-list__value">@Model.ExportRecord.OwnerName</dd></div>
            <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Address</dt><dd class="govuk-summary-list__value">@Model.ExportRecord.Address1</dd></div>
        </dl>
    }
    else if (Model.HasSearched)
    {
        <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text"><span class="govuk-warning-text__assistive">Warning</span>No OSS export record found for @Model.Rbse.</strong>
        </div>
    }
</div>
