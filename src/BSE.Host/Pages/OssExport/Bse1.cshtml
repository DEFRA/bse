@page
@model OssExportBse1Model
@{
    ViewData["Title"] = "OSS export — BSE1";
}

<h1 class="govuk-heading-l">BSE1 — OSS export</h1>
<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/OssExport/Menu">OSS export</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">BSE1</li>
    </ol>
</nav>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li>@Model.ErrorMessage</li>
                </ul>
            </div>
        </div>
    </div>
}

<p class="govuk-body">Populate the OSS staging tables. A new BSE1 batch number is created automatically.</p>

<form method="post" novalidate>
    <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">Populate staging tables</button>
</form>

@if (Model.BatchResult is not null)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="oss-success-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title" id="oss-success-title">Success</h2></div>
        <div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">Staging tables populated. Batch @Model.BatchResult.BatchYear/@Model.BatchResult.BatchNumber created (ID: @Model.BatchResult.BatchId).</p></div>
    </div>
}
