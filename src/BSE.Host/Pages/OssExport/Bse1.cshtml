@page
@model OssExportBse1Model
@{
    ViewData["Title"] = "OSS export — BSE1";
}

<h1 class="govuk-heading-l">BSE1 — OSS export</h1>
<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/OssExport/Menu">OSS export</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">BSE1</li>
    </ol>
</nav>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li>@Model.ErrorMessage</li>
                </ul>
            </div>
        </div>
    </div>
}

<h2 class="govuk-heading-m">Download by batch</h2>
<p class="govuk-body">Enter batch year and batch number, then download the BSE1 export file.</p>
<form method="post" asp-page-handler="Download" novalidate>
    <div class="govuk-form-group">
        <label asp-for="BatchYear" class="govuk-label">Batch year</label>
        <input asp-for="BatchYear" class="govuk-input govuk-input--width-5" inputmode="numeric" />
        <span asp-validation-for="BatchYear" class="govuk-error-message"></span>
    </div>
    <div class="govuk-form-group">
        <label asp-for="BatchNumber" class="govuk-label">Batch number</label>
        <input asp-for="BatchNumber" class="govuk-input govuk-input--width-5" inputmode="numeric" />
        <span asp-validation-for="BatchNumber" class="govuk-error-message"></span>
    </div>
    <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">Download</button>
</form>
