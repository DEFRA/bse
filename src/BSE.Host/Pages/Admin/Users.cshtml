@page
@model UsersModel
@{
    ViewData["Title"] = "User management";
}

<div>
    <h1 class="govuk-heading-l">User management</h1>
    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
            <li class="govuk-breadcrumbs__list-item" aria-current="page">Users</li>
        </ol>
    </nav>

    <details class="govuk-details" data-module="govuk-details">
        <summary class="govuk-details__summary"><span class="govuk-details__summary-text">Add user</span></summary>
        <div class="govuk-details__text">
            <form method="post" asp-page-handler="Add" novalidate>
                <div class="govuk-form-group"><label class="govuk-label">NT login</label><input name="NTLogin" class="govuk-input govuk-!-width-one-half" required /></div>
                <div class="govuk-form-group"><label class="govuk-label">UPN</label><input name="Upn" type="email" class="govuk-input govuk-!-width-two-thirds" /></div>
                <div class="govuk-form-group"><label class="govuk-label">Display name</label><input name="UserName" class="govuk-input govuk-!-width-two-thirds" required /></div>
                <div class="govuk-form-group"><label class="govuk-label">Email</label><input name="Email" type="email" class="govuk-input govuk-!-width-two-thirds" /></div>
                <div class="govuk-form-group"><label class="govuk-label">User group ID</label><input name="UserGroupId" type="number" class="govuk-input govuk-input--width-5" value="1" /></div>
                <div class="govuk-form-group"><div class="govuk-checkboxes" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input name="IsActive" type="checkbox" class="govuk-checkboxes__input" checked /><label class="govuk-label govuk-checkboxes__label">Active</label></div></div></div>
                <button type="submit" class="govuk-button" data-module="govuk-button">Save user</button>
            </form>
        </div>
    </details>

    <h2 class="govuk-heading-m">Users</h2>
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row"><th scope="col" class="govuk-table__header">ID</th><th scope="col" class="govuk-table__header">NT login</th><th scope="col" class="govuk-table__header">UPN</th><th scope="col" class="govuk-table__header">Name</th><th scope="col" class="govuk-table__header">Email</th><th scope="col" class="govuk-table__header">Group</th><th scope="col" class="govuk-table__header">Active</th></tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var u in Model.Users)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@u.UserId</td>
                    <td class="govuk-table__cell">@u.NTLogin</td>
                    <td class="govuk-table__cell">@u.Upn</td>
                    <td class="govuk-table__cell">@u.UserName</td>
                    <td class="govuk-table__cell">@u.Email</td>
                    <td class="govuk-table__cell">@u.UserGroup</td>
                    <td class="govuk-table__cell">@(u.IsActive ? "Yes" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
