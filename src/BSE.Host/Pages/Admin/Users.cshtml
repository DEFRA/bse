@page
@model UsersModel
@using BSE.SharedKernel
@{
    ViewData["Title"] = "User Maintenance";
}

<div>
    <h1 class="govuk-heading-l">User Maintenance</h1>
    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
            <li class="govuk-breadcrumbs__list-item" aria-current="page">Users</li>
        </ol>
    </nav>

    @if (TempData["Success"] is string successMsg)
    {
        <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
            <div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">Success</h2></div>
            <div class="govuk-notification-banner__content"><p class="govuk-body">@successMsg</p></div>
        </div>
    }

    @if (User.IsInRole("VLAMaintenance"))
    {
        <div class="govuk-button-group">
            <a asp-page="/Admin/UsersAdd" class="govuk-button govuk-button--secondary">Add user</a>
        </div>
    }

    <details class="govuk-details" data-module="govuk-details" @(addHasErrors ? "open" : null)>
        <summary class="govuk-details__summary"><span class="govuk-details__summary-text">Add user</span></summary>
        <div class="govuk-details__text">
            <form method="post" asp-page-handler="Add" novalidate>
            
                <div class="govuk-form-group @(addNameError is not null ? "govuk-form-group--error" : "")">
                    <label class="govuk-label" for="user-name">Display name</label>
                    @if (addNameError is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @addNameError</p> }
                    <input id="user-name" name="UserName" class="govuk-input govuk-!-width-two-thirds @(addNameError is not null ? "govuk-input--error" : "")" value="@Model.UserName" />
                </div>
                <div class="govuk-form-group @(addEmailError is not null ? "govuk-form-group--error" : "")">
                    <label class="govuk-label" for="email">Email</label>
                    @if (addEmailError is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @addEmailError</p> }
                    <input id="email" name="Email" type="email" class="govuk-input govuk-!-width-two-thirds @(addEmailError is not null ? "govuk-input--error" : "")" value="@Model.Email" />
                </div>
                <div class="govuk-form-group @(addGroupError is not null ? "govuk-form-group--error" : "")">
                    <label class="govuk-label" for="user-group-id">User group</label>
                    @if (addGroupError is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @addGroupError</p> }
                    <select id="user-group-id" name="UserGroupId" class="govuk-select @(addGroupError is not null ? "govuk-select--error" : "")">
                        <option value="0">— Select —</option>
                        @foreach (var g in Model.UserGroups)
                        {
                            <option value="@g.Id" selected="@(Model.UserGroupId == g.Id ? "selected" : null)">@g.Name</option>
                        }
                    </select>
                </div>
                <div class="govuk-form-group"><div class="govuk-checkboxes" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input type="hidden" name="IsActive" value="false" /><input id="is-active" name="IsActive" value="true" type="checkbox" class="govuk-checkboxes__input" checked /><label class="govuk-label govuk-checkboxes__label" for="is-active">Active</label></div></div></div>
                <button type="submit" class="govuk-button" data-module="govuk-button">Save user</button>
            </form>
        </div>
    </details>

    <h2 class="govuk-heading-m">Users</h2>
    @{
        var usersSortBase = "?" + string.Join("&", HttpContext.Request.Query
            .Where(k => !string.Equals(k.Key, "SortColumn", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "SortDesc", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "PageNumber", StringComparison.OrdinalIgnoreCase))
            .SelectMany(k => k.Value, (k, v) => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}"));
        var usersSortCol  = Model.SortColumn;
        var usersSortDesc = Model.SortDesc;
    }
    <table class="govuk-table">
        <caption class="govuk-visually-hidden">Users</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                @{ ViewData["Label"] = "ID";       ViewData["Column"] = "UserId";   ViewData["SortColumn"] = usersSortCol; ViewData["SortDesc"] = usersSortDesc; ViewData["BaseUrl"] = usersSortBase; ViewData["Prefix"] = ""; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "Name";     ViewData["Column"] = "UserName"; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "Email";    ViewData["Column"] = "Email"; }
                <partial name="_SortableHeader" />
                @{
                    ViewData["Label"] = "User Group"; ViewData["Column"] = "User Group";
                }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "Active";   ViewData["Column"] = "IsActive"; }
                <partial name="_SortableHeader" />
                <th scope="col" class="govuk-table__header">Actions</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var u in Model.PagedUsers)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@u.UserId</td>
                    <td class="govuk-table__cell">@u.UserName</td>
                    <td class="govuk-table__cell">@u.Email</td>
                    <td class="govuk-table__cell">@(Model.UserGroups.FirstOrDefault(g => g.Id == u.UserGroupId)?.Name)</td>
                    <td class="govuk-table__cell">@(u.IsActive ? "Yes" : "No")</td>
                    <td class="govuk-table__cell">
                        <a asp-page="/Admin/UsersEdit" asp-route-id="@u.UserId" class="govuk-link">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pagination", null, new ViewDataDictionary(ViewData) { ["CurrentPage"] = Model.PageNumber, ["TotalPages"] = Model.TotalPages })
</div>
