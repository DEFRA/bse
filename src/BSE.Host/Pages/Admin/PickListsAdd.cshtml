@page
@model BSE.Host.Pages.Admin.PickListsAddModel
@{
    ViewData["Title"] = "Add pick list record";
    ViewData["Breadcrumb"] = "Add record";
}

<partial name="_PickListHeading" model="Model" />

<partial name="_PickListErrorSummary" model="Model" />

<form method="post" novalidate>
    <input type="hidden" asp-for="TableId" />
    <input type="hidden" asp-for="SortColumn" />
    <input type="hidden" asp-for="SortDesc" />
    <input type="hidden" asp-for="PageNumber" />

    <partial name="_PickListFields" model="Model" view-data='new ViewDataDictionary(ViewData) { ["TickBlankBooleans"] = true }' />

    <partial name="_PickListButtons" model="Model" />
</form>
