@page
@model BSE.Host.Pages.Admin.UsersEditModel
@{
    ViewData["Title"] = "Edit user";
    var nameError = ViewData.ModelState[nameof(Model.EditUserName)]?.Errors.FirstOrDefault()?.ErrorMessage;
    var groupError = ViewData.ModelState[nameof(Model.EditUserGroupId)]?.Errors.FirstOrDefault()?.ErrorMessage;
    var emailError = ViewData.ModelState[nameof(Model.EditEmail)]?.Errors.FirstOrDefault()?.ErrorMessage;
    bool hasErrors = nameError is not null || groupError is not null || emailError is not null;
}

<h1 class="govuk-heading-l">Edit user</h1>

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
        <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Admin/Users">Users</a></li>
        <li class="govuk-breadcrumbs__list-item" aria-current="page">Edit user</li>
    </ol>
</nav>

@if (hasErrors)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @if (nameError is not null) { <li><a href="#edit-user-name">@nameError</a></li> }
                    @if (groupError is not null) { <li><a href="#edit-user-group-id">@groupError</a></li> }
                    @if (emailError is not null) { <li><a href="#edit-email">@emailError</a></li> }
                </ul>
            </div>
        </div>
    </div>
}

<form method="post" novalidate>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="EditNTLogin" />

    <div class="govuk-form-group @(nameError is not null ? "govuk-form-group--error" : "")">
        <label class="govuk-label" for="edit-user-name">Display name</label>
        @if (nameError is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @nameError</p> }
        <input id="edit-user-name" asp-for="EditUserName" class="govuk-input govuk-!-width-two-thirds @(nameError is not null ? "govuk-input--error" : "")" />
    </div>

    <div class="govuk-form-group @(emailError is not null ? "govuk-form-group--error" : "")">
        <label class="govuk-label" for="edit-email">Email</label>
        @if (emailError is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @emailError</p> }
        <input id="edit-email" asp-for="EditEmail" type="email" class="govuk-input govuk-!-width-two-thirds @(emailError is not null ? "govuk-input--error" : "")" />
    </div>

    <div class="govuk-form-group @(groupError is not null ? "govuk-form-group--error" : "")">
        <label class="govuk-label" for="edit-user-group-id">User group</label>
        @if (groupError is not null) { <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @groupError</p> }
        <select id="edit-user-group-id" asp-for="EditUserGroupId" class="govuk-select @(groupError is not null ? "govuk-select--error" : "")">
            @foreach (var g in Model.UserGroups)
            {
                <option value="@g.Id">@g.Name</option>
            }
        </select>
    </div>

    <div class="govuk-form-group">
        <div class="govuk-checkboxes" data-module="govuk-checkboxes">
            <div class="govuk-checkboxes__item">
                <input type="hidden" name="EditIsActive" value="false" />
                <input id="edit-is-active" name="EditIsActive" value="true" type="checkbox" class="govuk-checkboxes__input" @(Model.EditIsActive ? "checked" : "") />
                <label class="govuk-label govuk-checkboxes__label" for="edit-is-active">Active</label>
            </div>
        </div>
    </div>

    <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">Save</button>
        <a asp-page="/Admin/Users" class="govuk-link">Cancel</a>
    </div>
</form>