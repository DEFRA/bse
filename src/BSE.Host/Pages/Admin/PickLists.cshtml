@page
@model PickListsModel
@{
    ViewData["Title"] = "Pick lists";
}

<div>
    <h1 class="govuk-heading-l">Pick lists</h1>
    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
            <li class="govuk-breadcrumbs__list-item" aria-current="page">Pick lists</li>
        </ol>
    </nav>

    <h2 class="govuk-heading-m">Editable reference tables</h2>
    @{
        var sortBase = "?" + string.Join("&", HttpContext.Request.Query
            .Where(k => !string.Equals(k.Key, "SortColumn", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "SortDesc", StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(k.Key, "PageNumber", StringComparison.OrdinalIgnoreCase))
            .SelectMany(k => k.Value, (k, v) => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}"));
        ViewData["SortColumn"] = Model.SortColumn;
        ViewData["SortDesc"] = Model.SortDesc;
        ViewData["BaseUrl"] = sortBase;
    }
    <table class="govuk-table">
        <caption class="govuk-visually-hidden">Editable reference tables</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                @{ ViewData["Label"] = "ID"; ViewData["Column"] = "Id"; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "Table"; ViewData["Column"] = "Table"; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "Description"; ViewData["Column"] = "Description"; }
                <partial name="_SortableHeader" />
                <th scope="col" class="govuk-table__header">Action</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var lookup in Model.PagedLookups)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@lookup.Id</td>
                    <td class="govuk-table__cell">@lookup.TableName</td>
                    <td class="govuk-table__cell">@lookup.Description</td>
                    <td class="govuk-table__cell"><a asp-page="/Admin/PickListEdit" asp-route-tableId="@lookup.Id" class="govuk-link">Edit</a></td>
                </tr>
            }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pagination", null, new ViewDataDictionary(ViewData) { ["CurrentPage"] = Model.PageNumber, ["TotalPages"] = Model.TotalPages })
</div>
