@page
@model PickListsModel
@{
    ViewData["Title"] = "Pick lists";
}

<div>
    <h1 class="govuk-heading-l">Pick lists</h1>
    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
            <li class="govuk-breadcrumbs__list-item" aria-current="page">Pick lists</li>
        </ol>
    </nav>

    <h2 class="govuk-heading-m">Editable reference tables</h2>
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row"><th scope="col" class="govuk-table__header">ID</th><th scope="col" class="govuk-table__header">Table</th><th scope="col" class="govuk-table__header">Description</th><th scope="col" class="govuk-table__header">Action</th></tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var lookup in Model.Lookups)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@lookup.Id</td>
                    <td class="govuk-table__cell">@lookup.TableName</td>
                    <td class="govuk-table__cell">@lookup.Description</td>
                    <td class="govuk-table__cell"><a asp-page="/Admin/PickListEdit" asp-route-tableId="@lookup.Id" class="govuk-link">Edit</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
