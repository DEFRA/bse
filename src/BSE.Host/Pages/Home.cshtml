@page
@model BSE.Host.Pages.HomeModel
@{
    ViewData["Title"] = "BSE Database System";
    var batchYearError   = Model.ModelState[nameof(Model.BatchYear)]?.Errors.FirstOrDefault()?.ErrorMessage;
    var batchNumberError = Model.ModelState[nameof(Model.BatchNumber)]?.Errors.FirstOrDefault()?.ErrorMessage;
    var hasBatchError    = batchYearError is not null || batchNumberError is not null;
    var rbseError        = Model.ModelState[nameof(Model.LookupRbse)]?.Errors.FirstOrDefault()?.ErrorMessage;
    var hasAnyError      = hasBatchError || rbseError is not null;
}

<h1 class="govuk-heading-l">BSE Database System</h1>

@* ── Error summary (batch panel validation) ──────────────────────────────────── *@
@if (hasBatchError)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @if (batchYearError is not null)
                    {
                        <li><a href="#batch-year">@batchYearError</a></li>
                    }
                    @if (batchNumberError is not null)
                    {
                        <li><a href="#batch-number">@batchNumberError</a></li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

@* ── Batch Number panel — VLA Data Entry + VLA Maintenance ────────────────────── *@
@if (User.IsInRole("VLAAccess"))
{
    <section aria-labelledby="batch-panel-heading" class="bse-home-panel govuk-!-margin-bottom-4">
        <div class="bse-home-batch-layout">
            <div class="bse-home-batch-layout__form">
                <h2 class="govuk-heading-m govuk-!-margin-bottom-3" id="batch-panel-heading">Batch Number</h2>
                <p class="govuk-body govuk-!-margin-bottom-4">Only enter a batch number if you are entering a batch of case details</p>

                <form method="post">
                    <div class="govuk-form-group @(hasBatchError ? "govuk-form-group--error" : "")">
                        @if (hasBatchError)
                        {
                            <p id="batch-error" class="govuk-error-message">
                                <span class="govuk-visually-hidden">Error:</span>
                                @(batchYearError ?? batchNumberError)
                            </p>
                        }

                        <div class="bse-home-batch-entry" aria-describedby="@(hasBatchError ? "batch-error" : "")">
                            <label class="govuk-label govuk-!-margin-bottom-0" for="batch-year">Enter Batch Number</label>

                            <input id="batch-year" name="BatchYear" type="text" inputmode="numeric"
                                   form="case-entry-form" aria-label="Batch year"
                                   class="govuk-input bse-home-batch-year @(batchYearError is not null || Model.BatchNotFound ? "govuk-input--error" : "")"
                                   value="@Model.BatchYear" autocomplete="off" />

                            <input id="batch-number" name="BatchNumber" type="text" inputmode="numeric"
                                   form="case-entry-form" aria-label="Batch number"
                                   class="govuk-input bse-home-batch-number @(batchNumberError is not null || Model.BatchNotFound ? "govuk-input--error" : "")"
                                   value="@Model.BatchNumber" autocomplete="off" />

                            <span class="govuk-body govuk-!-margin-bottom-0">Or</span>

                            <button type="submit" asp-page-handler="CreateBatch"
                                    class="govuk-button"
                                    data-module="govuk-button">Create New</button>
                        </div>
                    </div>
                </form>
            </div>

            @if (Model.LatestBatches.Count > 0)
            {
                <div class="bse-home-batch-layout__table">
                    <table class="govuk-table govuk-!-font-size-16 bse-home-batch-table">
                        <caption class="govuk-table__caption govuk-table__caption--s govuk-visually-hidden">Recent batches</caption>
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header">Batch Number</th>
                                <th scope="col" class="govuk-table__header govuk-table__header--numeric">Cases</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            @foreach (var b in Model.LatestBatches)
                            {
                                <tr class="govuk-table__row">
                                    <td class="govuk-table__cell">@b.Batch</td>
                                    <td class="govuk-table__cell govuk-table__cell--numeric">@b.CaseCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible govuk-!-margin-top-4 govuk-!-margin-bottom-4" />
}

@* ── RBSE Number panel — all DEFRA groups + VLA Data Entry + VLA Maintenance ─── *@
@if (User.IsInRole("DEFRAAccess") || User.IsInRole("VLAAccess"))
{
    <section aria-labelledby="rbse-panel-heading" class="bse-home-panel govuk-!-margin-bottom-4">
        <h2 class="govuk-heading-m govuk-!-margin-bottom-3" id="rbse-panel-heading">RBSE Number</h2>

        <form id="case-entry-form" method="post" asp-page-handler="RbseLookup" class="govuk-!-margin-bottom-4">
            <div class="govuk-form-group bse-home-rbse-entry @(rbseError is not null ? "govuk-form-group--error" : "")">
                <label class="govuk-label govuk-!-margin-bottom-0" for="rbse-lookup-input">RBSE</label>
                @if (rbseError is not null)
                {
                    <p id="rbse-error" class="govuk-error-message">
                        <span class="govuk-visually-hidden">Error:</span>
                        @rbseError
                    </p>
                }
                <input id="rbse-lookup" name="LookupRbse" type="hidden" value="@Model.LookupRbse" />

                <div id="rbse-combobox" class="bse-home-rbse-combobox"
                     data-seed-current="@Model.LatestRbseCurrentYear"
                     data-seed-previous="@Model.LatestRbsePreviousYear">
                    <input id="rbse-lookup-input" name="LookupRbseInput" type="text"
                           class="govuk-input bse-home-rbse-input @(rbseError is not null ? "govuk-input--error" : "")"
                           value="@Model.LookupRbse" autocomplete="new-password" spellcheck="false" autocapitalize="off"
                           role="combobox" aria-haspopup="listbox" aria-controls="rbse-recent-listbox"
                           aria-expanded="false" aria-autocomplete="list" aria-activedescendant=""
                           aria-describedby="@(rbseError is not null ? "rbse-error" : "")" />
                    <ul id="rbse-recent-listbox" class="bse-home-rbse-suggestions" role="listbox" hidden></ul>
                </div>

                <button type="submit" class="govuk-button"
                        data-module="govuk-button">Go</button>
            </div>

<script>
    (function () {
        var form = document.getElementById('case-entry-form');
        var hidden = document.getElementById('rbse-lookup');
        var combo = document.getElementById('rbse-combobox');
        var input = document.getElementById('rbse-lookup-input');
        var listbox = document.getElementById('rbse-recent-listbox');
        if (!form || !hidden || !combo || !input || !listbox) return;

        var storageKey = 'bse.recent.rbse';
        var maxItems = 10;
        var allValues = [];
        var filteredValues = [];
        var activeIndex = -1;

        function normalise(value) {
            return (value || '').replace(/\D/g, '').trim();
        }

        function formatRbse(raw) {
            var digits = normalise(raw);
            if (digits.length !== 9) return (raw || '').trim();
            return digits.substring(0, 2) + '/' + digits.substring(2, 4) + '/' + digits.substring(4);
        }

        function readRecent() {
            try {
                var parsed = JSON.parse(localStorage.getItem(storageKey) || '[]');
                return Array.isArray(parsed) ? parsed : [];
            } catch {
                return [];
            }
        }

        function writeRecent(values) {
            localStorage.setItem(storageKey, JSON.stringify(values.slice(0, maxItems)));
        }

        function mergeUnique(values) {
            var seen = new Set();
            var merged = [];
            for (var i = 0; i < values.length; i++) {
                var v = normalise(values[i]);
                if (v.length === 9 && !seen.has(v)) {
                    seen.add(v);
                    merged.push(v);
                }
            }
            return merged.slice(0, maxItems);
        }

        function closeList() {
            listbox.hidden = true;
            input.setAttribute('aria-expanded', 'false');
            input.setAttribute('aria-activedescendant', '');
            activeIndex = -1;
        }

        function openList() {
            if (!filteredValues.length) {
                closeList();
                return;
            }
            listbox.hidden = false;
            input.setAttribute('aria-expanded', 'true');
        }

        function selectValue(raw) {
            var formatted = formatRbse(raw);
            input.value = formatted;
            hidden.value = formatted;
            closeList();
        }

        function setActive(index) {
            var options = listbox.querySelectorAll('[role="option"]');
            if (!options.length) {
                activeIndex = -1;
                input.setAttribute('aria-activedescendant', '');
                return;
            }

            if (index < 0) index = options.length - 1;
            if (index >= options.length) index = 0;
            activeIndex = index;

            for (var i = 0; i < options.length; i++) {
                var selected = i === activeIndex;
                options[i].setAttribute('aria-selected', selected ? 'true' : 'false');
                options[i].classList.toggle('bse-home-rbse-suggestions__item--active', selected);
            }

            var active = options[activeIndex];
            input.setAttribute('aria-activedescendant', active.id);
            active.scrollIntoView({ block: 'nearest' });
        }

        function renderList() {
            listbox.innerHTML = '';
            for (var i = 0; i < filteredValues.length; i++) {
                var raw = filteredValues[i];
                var li = document.createElement('li');
                li.id = 'rbse-option-' + i;
                li.className = 'bse-home-rbse-suggestions__item';
                li.setAttribute('role', 'option');
                li.setAttribute('aria-selected', 'false');
                li.textContent = formatRbse(raw);
                li.dataset.rawValue = raw;
                li.addEventListener('mousedown', function (e) {
                    e.preventDefault();
                    selectValue(this.dataset.rawValue || '');
                });
                listbox.appendChild(li);
            }

            activeIndex = -1;
            input.setAttribute('aria-activedescendant', '');
            openList();
        }

        function applyFilter() {
            var q = normalise(input.value);
            filteredValues = q
                ? allValues.filter(function (x) { return x.indexOf(q) === 0; })
                : allValues.slice();
            renderList();
        }

        var seeded = [combo.dataset.seedCurrent || '', combo.dataset.seedPrevious || ''];
        allValues = mergeUnique(readRecent().concat(seeded));
        writeRecent(allValues);

        if (!input.value && hidden.value) {
            input.value = hidden.value;
        }

        input.addEventListener('focus', function () {
            applyFilter();
        });

        input.addEventListener('click', function () {
            applyFilter();
        });

        input.addEventListener('input', function () {
            hidden.value = input.value || '';
            applyFilter();
        });

        input.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                if (listbox.hidden) applyFilter();
                setActive(activeIndex + 1);
                return;
            }
            if (e.key === 'ArrowUp') {
                e.preventDefault();
                if (listbox.hidden) applyFilter();
                setActive(activeIndex - 1);
                return;
            }
            if (e.key === 'Enter' && !listbox.hidden && activeIndex >= 0) {
                e.preventDefault();
                selectValue(filteredValues[activeIndex]);
                return;
            }
            if (e.key === 'Escape') {
                closeList();
            }
        });

        document.addEventListener('click', function (e) {
            if (!combo.contains(e.target)) closeList();
        });

        form.addEventListener('submit', function () {
            hidden.value = input.value || '';
            var entered = normalise(input.value);
            if (entered.length !== 9) return;
            allValues = mergeUnique([entered].concat(readRecent(), seeded));
            writeRecent(allValues);
        });
    })();
</script>
        </form>

        <table class="govuk-table govuk-!-font-size-16 bse-home-rbse-table">
            <caption class="govuk-table__caption govuk-table__caption--s govuk-visually-hidden">Latest RBSE and DBSE references</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header"></th>
                    <th scope="col" class="govuk-table__header">RBSE</th>
                    <th scope="col" class="govuk-table__header">DBSE</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header govuk-!-font-weight-regular">Latest in current year</th>
                    <td class="govuk-table__cell">@(Model.LatestRbseCurrentYear ?? "—")</td>
                    <td class="govuk-table__cell">@(Model.LatestDbseCurrentYear ?? "—")</td>
                </tr>
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header govuk-!-font-weight-regular">Latest in previous year</th>
                    <td class="govuk-table__cell">@(Model.LatestRbsePreviousYear ?? "—")</td>
                    <td class="govuk-table__cell">@(Model.LatestDbsePreviousYear ?? "—")</td>
                </tr>
            </tbody>
        </table>
    </section>
    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible govuk-!-margin-top-4 govuk-!-margin-bottom-4" />
}

@* Quick-case and quick-farm inputs removed — Home now exposes only Batch and RBSE inputs per migration requirement *@

<div class="govuk-grid-row bse-home-links-panel">
    @* Column 1: Search *@
    <div class="govuk-grid-column-one-third">
        <h2 class="govuk-heading-m">Search</h2>
        <ul class="govuk-list">
            <li><a asp-page="/Search/Farms" class="govuk-link">Farms</a></li>
            <li><a asp-page="/Search/Cases" class="govuk-link">Cases</a></li>
            <li><a asp-page="/Search/CasesByHerdmark" class="govuk-link">Cases by herdmark(includes animals sold off)</a></li>
            <li><a asp-page="/Search/CasesByHoldingHerdmark" class="govuk-link">Cases by holding/herdmark(for organic farmer checks)</a></li>
            <li><a asp-page="/Search/RelatedAnimals" class="govuk-link">Related animals</a></li>
            <li><a asp-page="/Search/Outstanding" class="govuk-link">Outstanding data</a></li>
        </ul>
    </div>

    @* Column 2: Casework and reports *@
    <div class="govuk-grid-column-one-third">
        @if (User.IsInRole("DEFRAAccess") || User.IsInRole("VLAAccess") || User.IsInRole("VLAMaintenance") || User.IsInRole("DEFRAMaintenance"))
        {
            <h2 class="govuk-heading-m">Casework and reports</h2>
        }
        
        <ul class="govuk-list">
            @if (User.IsInRole("VLAMaintenance"))
            {
                <li><a asp-page="/CaseWork/Menu" class="govuk-link">Casework</a></li>
            }
            @if (User.IsInRole("VLAAccess"))
            {
                <li><a asp-page="/CaseWork/PrintBatch" class="govuk-link">Print batch</a></li>
            }
            @if (User.IsInRole("DEFRAAccess") || User.IsInRole("VLAAccess"))
            {
                <li><a asp-page="/Bsess/Menu" class="govuk-link">TSES check</a></li>
            }
            @if (User.IsInRole("DEFRAMaintenance"))
            {
                <li><a asp-page="/Case/FinalResultEntry" class="govuk-link">Final result entry</a></li>
                <li><a asp-page="/Farm/CphhChange" class="govuk-link">CPHH change</a></li>
                <li><a asp-page="/Case/RbseChange" class="govuk-link">RBSE change</a></li>
                <li><a asp-page="/Case/MoveCase" class="govuk-link">Move case</a></li>
                <li><a asp-page="/Case/Delete" class="govuk-link">Delete case</a></li>
            }
        </ul>
    </div>

    @* Column 3: Exports + Administration *@
    <div class="govuk-grid-column-one-third">
        @if (User.IsInRole("DEFRAMaintenance") || User.IsInRole("VLAAccess"))
        {
            <h2 class="govuk-heading-m">Exports</h2>
            <ul class="govuk-list">
                @if (User.IsInRole("DEFRAMaintenance"))
                {
                    <li><a asp-page="/AdnsExport/Menu" class="govuk-link">Export to ADNS</a></li>
                }
                @if (User.IsInRole("VLAAccess"))
                {
                    <li><a asp-page="/OssExport/Menu" class="govuk-link">Export to OSS</a></li>
                }
            </ul>
        }

        @if (User.IsInRole("VLAMaintenance") || User.IsInRole("PickListAccess") || User.IsInRole("DEFRAAccess") || User.IsInRole("VLAAccess"))
        {
            <h2 class="govuk-heading-m">Maintenance</h2>
            <ul class="govuk-list">
                @if (User.IsInRole("VLAMaintenance"))
                {
                    <li><a asp-page="/Admin/Users" class="govuk-link">User Maintenance</a></li>
                }
                @if (User.IsInRole("PickListAccess"))
                {
                    <li><a asp-page="/Admin/PickLists" class="govuk-link">Pick List Maintenance</a></li>
                }
                @if (User.IsInRole("DEFRAAccess") || User.IsInRole("VLAAccess"))
                {
                    <li><a asp-page="/AuditLog/Menu" class="govuk-link">Audit log</a></li>
                }
            </ul>
        }
    </div>
</div>

