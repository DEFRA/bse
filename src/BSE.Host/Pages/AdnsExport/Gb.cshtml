@page
@model GbModel
@{
    ViewData["Title"] = "ADNS export — Great Britain";
}

<div>
    <h1 class="govuk-heading-l">ADNS export — Great Britain</h1>
    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/AdnsExport/Menu">ADNS export</a></li>
            <li class="govuk-breadcrumbs__list-item" aria-current="page">GB</li>
        </ol>
    </nav>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body"><ul class="govuk-list govuk-error-summary__list"><li>@Model.ErrorMessage</li></ul></div>
            </div>
        </div>
    }

    @if (Model.Preview is null)
    {
        <h2 class="govuk-heading-m">Generate GB export preview</h2>
        <form method="post" asp-page-handler="Preview" novalidate>
            <div class="govuk-form-group">
                <label asp-for="EmailReference" class="govuk-label">Email reference</label>
                <input asp-for="EmailReference" class="govuk-input govuk-!-width-one-half" />
                <span asp-validation-for="EmailReference" class="govuk-error-message"></span>
            </div>
            <div class="govuk-form-group">
                <label asp-for="AdnsYear" class="govuk-label">ADNS year</label>
                <input asp-for="AdnsYear" type="number" class="govuk-input govuk-input--width-5" />
            </div>
            <div class="govuk-form-group">
                <label asp-for="StartAdnsNumber" class="govuk-label">Start ADNS number</label>
                <input asp-for="StartAdnsNumber" type="number" class="govuk-input govuk-input--width-5" />
            </div>
            <button type="submit" class="govuk-button" data-module="govuk-button">Preview</button>
        </form>

        @if (Model.LastReference is not null)
        {
            <div class="govuk-notification-banner" role="region" aria-labelledby="gb-last-export-title" data-module="govuk-notification-banner">
                <div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title" id="gb-last-export-title">Information</h2></div>
                <div class="govuk-notification-banner__content">
                    <p class="govuk-notification-banner__heading">Last export: ref @Model.LastReference.LastEmailReference, year @Model.LastReference.LastAdnsReferenceYear, number @Model.LastReference.LastAdnsReferenceNumber.</p>
                </div>
            </div>
        }
    }
    else
    {
        <h2 class="govuk-heading-m">Preview — @Model.Preview.Cases.Count cases</h2>
        <p class="govuk-body"><strong>Subject:</strong> @Model.Preview.EmailSubject</p>

        @if (Model.Preview.MissingCases.Any())
        {
            <div class="govuk-warning-text">
                <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                <strong class="govuk-warning-text__text">
                    <span class="govuk-warning-text__assistive">Warning</span>
                    @Model.Preview.MissingCases.Count cases missing ADNS region: @string.Join(", ", Model.Preview.MissingCases.Select(c => c.Rbse))
                </strong>
            </div>
        }

        <table class="govuk-table">
            <caption class="govuk-visually-hidden">Great Britain ADNS preview cases</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row"><th scope="col" class="govuk-table__header">RBSE</th><th scope="col" class="govuk-table__header">ADNS ref</th><th scope="col" class="govuk-table__header">Region</th><th scope="col" class="govuk-table__header">Confirmation date</th></tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var c in Model.Preview.Cases)
                {
                    <tr class="govuk-table__row"><td class="govuk-table__cell">@c.Rbse</td><td class="govuk-table__cell">@c.AdnsReference</td><td class="govuk-table__cell">@c.AdnsRegionName</td><td class="govuk-table__cell">@c.ConfirmationDate.ToShortDateString()</td></tr>
                }
            </tbody>
        </table>

        <h3 class="govuk-heading-s">Summary by region</h3>
        <table class="govuk-table">
            <caption class="govuk-visually-hidden">Great Britain ADNS summary by region</caption>
            <thead class="govuk-table__head"><tr class="govuk-table__row"><th scope="col" class="govuk-table__header">Region</th><th scope="col" class="govuk-table__header">Cases</th></tr></thead>
            <tbody class="govuk-table__body">
                @foreach (var s in Model.Preview.Summary)
                {
                    <tr class="govuk-table__row"><td class="govuk-table__cell">@s.AdnsRegionName</td><td class="govuk-table__cell">@s.CasesCount</td></tr>
                }
            </tbody>
        </table>

        <form method="post" asp-page-handler="Dispatch" novalidate>
            <input type="hidden" asp-for="EmailReference" />
            <div class="govuk-form-group">
                <label asp-for="UserEmailAddress" class="govuk-label">Your email address (CC copy)</label>
                <input asp-for="UserEmailAddress" type="email" class="govuk-input govuk-!-width-one-half" />
                <span asp-validation-for="UserEmailAddress" class="govuk-error-message"></span>
            </div>
            <div class="govuk-form-group">
                <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                    <div class="govuk-checkboxes__item">
                        <input asp-for="SaveAdnsData" type="checkbox" class="govuk-checkboxes__input" checked />
                        <label asp-for="SaveAdnsData" class="govuk-label govuk-checkboxes__label">Save ADNS data to database</label>
                    </div>
                </div>
            </div>
            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button">Dispatch</button>
                <a asp-page="/AdnsExport/Gb" class="govuk-link">Start over</a>
            </div>
        </form>
    }
</div>
