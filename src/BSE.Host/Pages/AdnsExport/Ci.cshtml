@page
@model CiModel
@{
    ViewData["Title"] = "ADNS Export : Channel Island Cases";
    ViewData["Crumb"] = "CI";
}

<div>
    <partial name="_AdnsHeading" model="Model" />

    @if (Model.Preview is null)
    {
        <form method="post" asp-page-handler="GenerateReport" novalidate>
            <div class="bse-adns-form-row">
                <div class="govuk-form-group bse-adns-field @(ViewContext.ModelState["EmailReference"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
                    <label asp-for="EmailReference" class="govuk-label">Email reference</label>
                    <input asp-for="EmailReference" class="govuk-input govuk-input--width-10" />
                    <span asp-validation-for="EmailReference" class="govuk-error-message"></span>
                </div>

                <fieldset class="govuk-fieldset bse-adns-group" aria-labelledby="ci-adns-reference-legend">
                    <span id="ci-adns-reference-legend" class="govuk-label">ADNS Reference</span>
                    <div class="bse-inline-fields">
                        <div class="govuk-form-group bse-adns-field @(ViewContext.ModelState["AdnsYear"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
                            <label asp-for="AdnsYear" class="govuk-label govuk-visually-hidden">Year</label>
                            <input asp-for="AdnsYear" type="number" class="govuk-input govuk-input--width-5" />
                            <span asp-validation-for="AdnsYear" class="govuk-error-message"></span>
                        </div>
                        <div class="govuk-form-group bse-adns-field @(ViewContext.ModelState["StartAdnsNumber"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
                            <label asp-for="StartAdnsNumber" class="govuk-label govuk-visually-hidden">Start number</label>
                            <input asp-for="StartAdnsNumber" type="number" class="govuk-input govuk-input--width-5" />
                            <span asp-validation-for="StartAdnsNumber" class="govuk-error-message"></span>
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="bse-adns-form-row">
                <fieldset class="govuk-fieldset bse-adns-group" aria-labelledby="ci-cases-in-legend">
                    <span id="ci-cases-in-legend" class="govuk-label">Number of cases in:</span>
                    <div class="bse-inline-fields">
                        <div class="govuk-form-group bse-adns-field @(ViewContext.ModelState["JerseyCases"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
                            <label asp-for="JerseyCases" class="govuk-label">Jersey</label>
                            <input asp-for="JerseyCases" type="number" class="govuk-input govuk-input--width-4" min="0" />
                            <span asp-validation-for="JerseyCases" class="govuk-error-message"></span>
                        </div>
                        <div class="govuk-form-group bse-adns-field @(ViewContext.ModelState["GuernseyCases"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
                            <label asp-for="GuernseyCases" class="govuk-label">Guernsey</label>
                            <input asp-for="GuernseyCases" type="number" class="govuk-input govuk-input--width-4" min="0" />
                            <span asp-validation-for="GuernseyCases" class="govuk-error-message"></span>
                        </div>
                        <div class="govuk-form-group bse-adns-field @(ViewContext.ModelState["IsleOfManCases"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
                            <label asp-for="IsleOfManCases" class="govuk-label">Isle of Man</label>
                            <input asp-for="IsleOfManCases" type="number" class="govuk-input govuk-input--width-4" min="0" />
                            <span asp-validation-for="IsleOfManCases" class="govuk-error-message"></span>
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="bse-adns-form-row">
                <div class="moj-datepicker" data-module="moj-date-picker" data-leading-zeros="true">
                    <div class="govuk-form-group bse-adns-field @(ViewContext.ModelState["ConfirmationDate"]?.Errors.Count > 0 ? "govuk-form-group--error" : "")">
                        <label asp-for="ConfirmationDate" class="govuk-label">Confirmation date</label>
                        <span asp-validation-for="ConfirmationDate" class="govuk-error-message"></span>
                        <input asp-for="ConfirmationDate" type="text" class="govuk-input moj-js-datepicker-input" autocomplete="off" placeholder="dd/mm/yyyy" />
                    </div>
                </div>
            </div>

            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button">Generate Report</button>
                <a asp-page="/AdnsExport/Menu" class="govuk-button govuk-button--secondary" data-module="govuk-button">ADNS Export Menu</a>
            </div>
        </form>
    }
    else
    {
        <partial name="_AdnsPreviewSummary" model="Model" />

        <form method="post" asp-page-handler="Dispatch" novalidate>
            <input type="hidden" asp-for="EmailReference" />
            <input type="hidden" asp-for="SaveAdnsData" value="false" />

            <partial name="_AdnsEmailFields" model="Model" view-data='new ViewDataDictionary(ViewData) { ["IdPrefix"] = "ci" }' />

            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button">Send Email</button>
            </div>
        </form>
    }
</div>