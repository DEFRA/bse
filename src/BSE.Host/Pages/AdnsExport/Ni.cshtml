@page
@model NiModel
@{
    ViewData["Title"] = "ADNS export — Northern Ireland";
}

<div>
    <h1 class="govuk-heading-l">ADNS export — Northern Ireland</h1>
    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/Home">Home</a></li>
            <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" asp-page="/AdnsExport/Menu">ADNS export</a></li>
            <li class="govuk-breadcrumbs__list-item" aria-current="page">NI</li>
        </ol>
    </nav>

    @if (!ViewContext.ModelState.IsValid || !string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list">
                        @foreach (var entry in ViewContext.ModelState.Where(x => x.Value?.Errors.Count > 0))
                        {
                            foreach (var err in entry.Value!.Errors)
                            {
                                <li>@err.ErrorMessage</li>
                            }
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                        {
                            <li>@Model.ErrorMessage</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    @if (Model.Preview is null)
    {
        <h2 class="govuk-heading-m">NI export — add case to grid</h2>

        <form method="post" novalidate>
            <div class="govuk-form-group">
                <label asp-for="EmailReference" class="govuk-label">Email reference</label>
                <input asp-for="EmailReference" class="govuk-input govuk-!-width-one-half" />
                <span asp-validation-for="EmailReference" class="govuk-error-message"></span>
            </div>

            <div class="govuk-form-group">
                <label asp-for="InputAdnsYear" class="govuk-label">ADNS year</label>
                <input asp-for="InputAdnsYear" type="number" class="govuk-input govuk-input--width-5" />
                <span asp-validation-for="InputAdnsYear" class="govuk-error-message"></span>
            </div>

            <div class="govuk-form-group">
                <label asp-for="InputAdnsNumber" class="govuk-label">ADNS reference number</label>
                <input asp-for="InputAdnsNumber" type="number" class="govuk-input govuk-input--width-5" />
                <span asp-validation-for="InputAdnsNumber" class="govuk-error-message"></span>
            </div>

            <div class="govuk-form-group">
                <label asp-for="InputAdnsRegionId" class="govuk-label">Region</label>
                <div id="ni-region-hint" class="govuk-hint">
                    Enter a five digit number, with two zeroes at the end and one at the front eg. 073 = 07300
                </div>
                <input asp-for="InputAdnsRegionId" type="number" class="govuk-input govuk-input--width-5" aria-describedby="ni-region-hint" />
                <span asp-validation-for="InputAdnsRegionId" class="govuk-error-message"></span>
            </div>

            <div class="govuk-form-group">
                <label asp-for="InputConfirmationDate" class="govuk-label">Confirmation date</label>
                <input asp-for="InputConfirmationDate" type="date" class="govuk-input govuk-input--width-10" />
                <span asp-validation-for="InputConfirmationDate" class="govuk-error-message"></span>
            </div>

            <div class="govuk-button-group">
                <button type="submit" asp-page-handler="AddToGrid" class="govuk-button govuk-button--secondary" data-module="govuk-button">Add to grid</button>
            </div>
        </form>

        @if (Model.CurrentRows.Any())
        {
            var sortBase = "?" + string.Join("&", HttpContext.Request.Query
                .Where(k => !string.Equals(k.Key, "SortColumn", StringComparison.OrdinalIgnoreCase)
                         && !string.Equals(k.Key, "SortDesc", StringComparison.OrdinalIgnoreCase)
                         && !string.Equals(k.Key, "PageNumber", StringComparison.OrdinalIgnoreCase))
                .SelectMany(k => k.Value, (k, v) => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}"));

            ViewData["SortColumn"] = Model.SortColumn;
            ViewData["SortDesc"] = Model.SortDesc;
            ViewData["BaseUrl"] = sortBase;

            <h3 class="govuk-heading-s">Cases in grid — @Model.TotalCount</h3>

            <table class="govuk-table">
                <caption class="govuk-visually-hidden">Northern Ireland ADNS cases grid</caption>
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        @{
                            ViewData["Label"] = "ADNS reference"; ViewData["Column"] = "AdnsReference";
                        }
                        <partial name="_SortableHeader" />
                        @{
                            ViewData["Label"] = "Region"; ViewData["Column"] = "Region";
                        }
                        <partial name="_SortableHeader" />
                        @{
                            ViewData["Label"] = "Confirmation date"; ViewData["Column"] = "ConfirmationDate";
                        }
                        <partial name="_SortableHeader" />
                        <th scope="col" class="govuk-table__header">Action</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    @foreach (var c in Model.PagedRows)
                    {
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">@c.AdnsReference</td>
                            <td class="govuk-table__cell">@c.RegionName</td>
                            <td class="govuk-table__cell">@c.ConfirmationDate.ToString("dd/MM/yyyy")</td>
                            <td class="govuk-table__cell">
                                <form method="post" asp-page-handler="DeleteFromGrid" novalidate>
                                    <input type="hidden" asp-for="EmailReference" />
                                    <input type="hidden" asp-for="InputAdnsYear" />
                                    <button type="submit"
                                            name="rowKey"
                                            value="@c.RowKey"
                                            class="govuk-button govuk-button--warning govuk-!-margin-bottom-0"
                                            data-module="govuk-button">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @await Html.PartialAsync("_Pagination", null, new ViewDataDictionary(ViewData)
            {
                ["CurrentPage"] = Model.PageNumber,
                ["TotalPages"] = Model.TotalPages
            })

            <form method="post" asp-page-handler="GenerateReport" novalidate>
                <input type="hidden" asp-for="EmailReference" />
                <input type="hidden" asp-for="InputAdnsYear" />
                <button type="submit" class="govuk-button" data-module="govuk-button">Generate report</button>
            </form>
        }
    }
    else
    {
        <h2 class="govuk-heading-m">Generated report — @Model.Preview.Cases.Count cases</h2>

        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" />

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <p class="govuk-body"><strong>Starting ADNS Reference:</strong> @Model.Preview.StartAdnsReference</p>
            </div>
            <div class="govuk-grid-column-one-half">
                <p class="govuk-body"><strong>Ending ADNS Reference:</strong> @Model.Preview.EndAdnsReference</p>
            </div>
        </div>

        <table class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">ADNS Number</th>
                    <th scope="col" class="govuk-table__header">Region Name</th>
                    <th scope="col" class="govuk-table__header">Reported Cases</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var s in Model.Preview.Summary)
                {
                    var firstNumber = Model.Preview.Cases
                        .Where(c => c.AdnsRegionId == s.AdnsRegionId)
                        .Select(c => c.AdnsNumber)
                        .OrderBy(n => n)
                        .FirstOrDefault();

                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@firstNumber.ToString("00000")</td>
                        <td class="govuk-table__cell">@s.AdnsRegionName</td>
                        <td class="govuk-table__cell">@s.CasesCount</td>
                    </tr>
                }
            </tbody>
        </table>

        <form method="post" asp-page-handler="Dispatch" novalidate>
            <input type="hidden" asp-for="EmailReference" />
            <input type="hidden" asp-for="SaveAdnsData" value="true" />

            <div class="govuk-form-group">
                <label class="govuk-label">From:</label>
                <input class="govuk-input govuk-!-width-two-thirds" value="@Model.FromAddress" readonly />
            </div>

            <div class="govuk-form-group">
                <label asp-for="UserEmailAddress" class="govuk-label">To:</label>
                <input asp-for="UserEmailAddress" type="email" class="govuk-input govuk-!-width-two-thirds" />
                <span asp-validation-for="UserEmailAddress" class="govuk-error-message"></span>
            </div>

            <div class="govuk-form-group">
                <label class="govuk-label">Subject:</label>
                <input class="govuk-input govuk-!-width-two-thirds" value="@Model.Preview.EmailSubject" readonly />
            </div>

            <div class="govuk-form-group">
                <label class="govuk-label">Message:</label>
                <textarea class="govuk-textarea govuk-!-width-two-thirds" rows="8" readonly>@Model.Preview.EmailBody</textarea>
            </div>

            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button">Send Email</button>
                <a asp-page="/AdnsExport/Menu" class="govuk-link">Start over</a>
            </div>
        </form>
    }
</div>